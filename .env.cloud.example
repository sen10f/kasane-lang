# Claude Code のクラウド環境の「環境変数」に貼る用 (KEY=VALUE を 1 行ずつ)。
# 秘密の値 (NVIDIA_API_KEY) はここに書いてコミットしない。環境設定の画面で直接入れる。

# LLM ベンチ (bench/run_bench.py --provider nim)。ホスト版 NVIDIA NIM の API キー (nvapi- で始まる)
NVIDIA_API_KEY=

# ksn のビルドキャッシュをリポジトリの外の固定の場所に置く (セッションをまたいで再利用されやすい)
KSN_CACHE_DIR=/tmp/ksn-cache

# cargo の出力を落ち着かせる (ログが読みやすい)
CARGO_TERM_COLOR=never
CARGO_TERM_PROGRESS_WHEN=never

# 手元の開発機専用の KSN_AVOID_CPUS はクラウドでは設定しない (不安定なコアの回避用)
