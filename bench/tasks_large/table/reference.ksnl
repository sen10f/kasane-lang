fn bench.column_widths(rows: &std.vec.Vec<std.vec.Vec<alloc.string.String>>) -> Result<std.vec.Vec<usize>, alloc.alloc.AllocError> uses [alloc] panics never
    let mut widths = std.vec.Vec.new()
    let mut ncols = 0usize
    let mut i = 0usize
    while i < rows.len() {
        match rows.get(i) {
            Some(row) => {
                if row.len() > ncols {
                    ncols = row.len()
                }
                ()
            }
            None => break
        }
        i = i.wrapping_add(1usize)
    }
    let mut j = 0usize
    while j < ncols {
        let mut w = 0usize
        let mut r = 0usize
        while r < rows.len() {
            match rows.get(r) {
                Some(row) => {
                    match row.get(j) {
                        Some(cell) => {
                            if cell.len() > w {
                                w = cell.len()
                            }
                            ()
                        }
                        None => ()
                    }
                    ()
                }
                None => break
            }
            r = r.wrapping_add(1usize)
        }
        widths.push(w)?
        j = j.wrapping_add(1usize)
    }
    Ok(widths)
end bench.column_widths

fn bench.copy_row(row: &std.vec.Vec<alloc.string.String>) -> Result<std.vec.Vec<alloc.string.String>, alloc.alloc.AllocError> uses [alloc] panics never
    let mut out = std.vec.Vec.new()
    let mut i = 0usize
    while i < row.len() {
        match row.get(i) {
            Some(c) => out.push(c.try_clone()?)?
            None => break
        }
        i = i.wrapping_add(1usize)
    }
    Ok(out)
end bench.copy_row

fn bench.dashes(n: usize) -> Result<alloc.string.String, alloc.alloc.AllocError> uses [alloc] panics never
    let mut s = std.string.String.new()
    let mut i = 0usize
    while i < n {
        s.push_str("-")?
        i = i.wrapping_add(1usize)
    }
    Ok(s)
end bench.dashes

fn bench.mkrow(cells: &[&str]) -> Result<std.vec.Vec<alloc.string.String>, alloc.alloc.AllocError> uses [alloc] panics never
    let mut row = std.vec.Vec.new()
    let mut i = 0usize
    while i < cells.len() {
        match cells.get(i) {
            Some(c) => row.push(alloc.string.String.from_str(std.alloc.SYSTEM, *c)?)?
            None => break
        }
        i = i.wrapping_add(1usize)
    }
    Ok(row)
end bench.mkrow

fn bench.pad_right(text: &str, width: usize) -> Result<alloc.string.String, alloc.alloc.AllocError> uses [alloc] panics never
    let mut s = std.string.String.new()
    s.push_str(text)?
    while s.len() < width {
        s.push_str(" ")?
    }
    Ok(s)
end bench.pad_right

fn bench.render_row(cells: &std.vec.Vec<alloc.string.String>, widths: &std.vec.Vec<usize>) -> Result<alloc.string.String, alloc.alloc.AllocError> uses [alloc] panics never
    let mut line = std.string.String.new()
    line.push_str("| ")?
    let mut j = 0usize
    while j < widths.len() {
        if j > 0usize {
            line.push_str(" | ")?
        }
        let w = match widths.get(j) {
            Some(w) => *w
            None => 0usize
        }
        let text = match cells.get(j) {
            Some(c) => c.as_str()
            None => ""
        }
        let padded = bench.pad_right(text, w)?
        line.push_str(padded.as_str())?
        j = j.wrapping_add(1usize)
    }
    line.push_str(" |")?
    Ok(line)
end bench.render_row

fn bench.separator(widths: &std.vec.Vec<usize>) -> Result<alloc.string.String, alloc.alloc.AllocError> uses [alloc] panics never
    let mut line = std.string.String.new()
    line.push_str("+")?
    let mut j = 0usize
    while j < widths.len() {
        let w = match widths.get(j) {
            Some(w) => *w
            None => 0usize
        }
        let d = bench.dashes(w.wrapping_add(2usize))?
        line.push_str(d.as_str())?
        line.push_str("+")?
        j = j.wrapping_add(1usize)
    }
    Ok(line)
end bench.separator

fn bench.table(headers: &std.vec.Vec<alloc.string.String>, rows: &std.vec.Vec<std.vec.Vec<alloc.string.String>>) -> Result<alloc.string.String, alloc.alloc.AllocError> uses [alloc] panics never
    let mut all = std.vec.Vec.new()
    all.push(bench.copy_row(headers)?)?
    let mut i = 0usize
    while i < rows.len() {
        match rows.get(i) {
            Some(row) => all.push(bench.copy_row(row)?)?
            None => break
        }
        i = i.wrapping_add(1usize)
    }
    let widths = bench.column_widths(&all)?
    let header = bench.render_row(headers, &widths)?
    let sep = bench.separator(&widths)?
    let mut out = std.string.String.new()
    out.push_str(header.as_str())?
    out.push_str("\n")?
    out.push_str(sep.as_str())?
    let mut k = 0usize
    while k < rows.len() {
        out.push_str("\n")?
        match rows.get(k) {
            Some(row) => {
                let line = bench.render_row(row, &widths)?
                out.push_str(line.as_str())?
                ()
            }
            None => break
        }
        k = k.wrapping_add(1usize)
    }
    Ok(out)
end bench.table
