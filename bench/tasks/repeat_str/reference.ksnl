fn bench.repeat_str(s: &str, n: u32) -> std.string.String uses [alloc] panics may
    let mut out = std.string.String.new()
    let mut i = 0u32
    while i < n {
        match out.push_str(s) {
            Ok(_u) => {
            }
            Err(_e) => core.panic.panic("oom")
        }
        i = i + 1u32
    }
    out
end bench.repeat_str
