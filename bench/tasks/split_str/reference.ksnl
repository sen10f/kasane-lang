fn bench.main() -> Result<(), std.io.Error> uses [alloc, io.console] panics may
    let r = bench.split_str("a,b,c", ",")
    core.check.eq(r.len(), 3usize)
    match r.get(0usize) {
        Some(s) => core.check.eq(s.as_str(), "a")
        None => core.check.eq(0usize, 1usize)
    }
    match r.get(1usize) {
        Some(s) => core.check.eq(s.as_str(), "b")
        None => core.check.eq(0usize, 1usize)
    }
    match r.get(2usize) {
        Some(s) => core.check.eq(s.as_str(), "c")
        None => core.check.eq(0usize, 1usize)
    }
    let empty = bench.split_str("", ",")
    core.check.eq(empty.len(), 1usize)
    std.io.print_line("split ok")?
    Ok(())
end bench.main

fn bench.split_str(text: &str, sep: &str) -> std.vec.Vec<std.string.String> uses [alloc] panics never pub
    let mut out = std.vec.Vec.new()
    let mut rest = text
    let sep_len = sep.len()
    loop {
        let cur = rest
        match cur.find(sep) {
            Some(pos) => match cur.split_at(pos) {
                Some((head, _tail)) => {
                    match alloc.string.String.from_str(std.alloc.SYSTEM, head) {
                        Ok(s) => match out.push(s) {
                            Ok(_) => ()
                            Err(_) => ()
                        }
                        Err(_) => ()
                    }
                    match cur.split_at(pos.wrapping_add(sep_len)) {
                        Some((_h, tail)) => {
                            rest = tail
                            ()
                        }
                        None => break
                    }
                }
                None => break
            }
            None => {
                match alloc.string.String.from_str(std.alloc.SYSTEM, rest) {
                    Ok(s) => match out.push(s) {
                        Ok(_) => ()
                        Err(_) => ()
                    }
                    Err(_) => ()
                }
                break
            }
        }
    }
    out
end bench.split_str
