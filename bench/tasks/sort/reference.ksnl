fn bench.at(xs: &alloc.vec.Vec<u32, std.alloc.System>, i: usize) -> u32 uses [] panics never
    *xs.as_slice().get(i).unwrap_or(&0u32)
end bench.at

fn bench.insertion_sort(xs: &mut alloc.vec.Vec<u32, std.alloc.System>) -> () uses [] panics never pub
    let n = xs.len()
    for i in core.iter.range(1usize, n) {
        let key = bench.at(xs, i)
        let mut j = i
        while j > 0usize && bench.at(xs, j.wrapping_sub(1usize)) > key {
            let prev = bench.at(xs, j.wrapping_sub(1usize))
            bench.set(xs, j, prev)
            j = j.wrapping_sub(1usize)
        }
        bench.set(xs, j, key)
    }
end bench.insertion_sort

fn bench.main() -> Result<(), std.io.Error> uses [alloc, io.console] panics may
    let mut v = alloc.vec.Vec.new(std.alloc.SYSTEM)
    match v.push(5u32) {
        Ok(_) => ()
        Err(_e) => core.panic.panic("oom")
    }
    match v.push(2u32) {
        Ok(_) => ()
        Err(_e) => core.panic.panic("oom")
    }
    match v.push(9u32) {
        Ok(_) => ()
        Err(_e) => core.panic.panic("oom")
    }
    match v.push(1u32) {
        Ok(_) => ()
        Err(_e) => core.panic.panic("oom")
    }
    match v.push(3u32) {
        Ok(_) => ()
        Err(_e) => core.panic.panic("oom")
    }
    bench.insertion_sort(&mut v)
    core.check.eq(v.len(), 5usize)
    core.check.eq(*v.as_slice().get(0usize).unwrap_or(&0u32), 1u32)
    core.check.eq(*v.as_slice().get(4usize).unwrap_or(&0u32), 9u32)
    core.check.eq(bench.at(&v, 1usize), 2u32)
    core.check.eq(bench.at(&v, 2usize), 3u32)
    core.check.eq(bench.at(&v, 3usize), 5u32)
    std.io.print_line("sort ok")?
    Ok(())
end bench.main

fn bench.set(xs: &mut alloc.vec.Vec<u32, std.alloc.System>, i: usize, x: u32) -> () uses [] panics never
    if let Some(p) = xs.as_mut_slice().get_mut(i) {
        *p = x
    }
end bench.set
