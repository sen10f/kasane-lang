type bench.Stack
    items: std.vec.Vec<u32>
end bench.Stack

fn bench.Stack.len(self: &bench.Stack) -> usize uses [] panics never
    self.items.len()
end bench.Stack.len

fn bench.Stack.new() -> bench.Stack uses [] panics never
    let items = std.vec.Vec.new()
    bench.Stack { items: items }
end bench.Stack.new

fn bench.Stack.pop(self: &mut bench.Stack) -> Option<u32> uses [] panics never
    self.items.pop()
end bench.Stack.pop

fn bench.Stack.push(self: &mut bench.Stack, v: u32) -> bool uses [alloc] panics never
    match self.items.push(v) {
        Ok(_) => true
        Err(_) => false
    }
end bench.Stack.push
