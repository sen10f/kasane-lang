fn bench.count_bytes(text: &str) -> std.collections.HashMap<u8, u32> uses [alloc] panics never pub
    let mut m = std.collections.HashMap.new()
    let bytes = text.as_bytes()
    let mut i = 0usize
    while i < bytes.len() {
        match bytes.get(i) {
            Some(c) => {
                match m.get(c) {
                    Some(_cnt) => match m.get_mut(c) {
                        Some(n) => {
                            let old: u32 = *n
                            *n = old.wrapping_add(1u32)
                            ()
                        }
                        None => ()
                    }
                    None => match m.insert(*c, 1u32) {
                        Ok(_old) => ()
                        Err(_e) => ()
                    }
                }
                i = i.wrapping_add(1usize)
            }
            None => break
        }
    }
    m
end bench.count_bytes

fn bench.main() -> Result<(), std.io.Error> uses [alloc, io.console] panics may
    let m = bench.count_bytes("aba")
    match m.get(&97u8) {
        Some(v) => core.check.eq(*v, 2u32)
        None => core.check.eq(0usize, 1usize)
    }
    match m.get(&98u8) {
        Some(v) => core.check.eq(*v, 1u32)
        None => core.check.eq(0usize, 1usize)
    }
    core.check.eq(m.len(), 2usize)
    std.io.print_line("count ok")?
    Ok(())
end bench.main
