fn bench.distinct_count(xs: &[u32]) -> usize uses [alloc] panics may
    let mut seen = alloc.collections.HashMap.new(std.alloc.SYSTEM)
    let mut i = 0usize
    while i < xs.len() {
        match xs.get(i) {
            Some(v) => {
                match seen.insert(*v, true) {
                    Ok(_old) => {
                    }
                    Err(_e) => core.panic.panic("oom")
                }
            }
            None => break
        }
        i = i + 1usize
    }
    seen.len()
end bench.distinct_count
