type t.Rec derive [Debug] pub
    name: alloc.string.String<std.alloc.System>
    xs: alloc.vec.Vec<u32, std.alloc.System>
end t.Rec

fn t.main() -> Result<(), alloc.alloc.AllocError> uses [alloc, io.console] panics never
    let mut m = alloc.collections.HashMap.new(std.alloc.SYSTEM)
    let one = alloc.string.String.from_str(std.alloc.SYSTEM, "one")?
    core.mem.drop(m.insert(one, 1u32)?)
    let two = alloc.string.String.from_str(std.alloc.SYSTEM, "two")?
    core.mem.drop(m.insert(two, 2u32)?)
    let mut out = alloc.string.String.new(std.alloc.SYSTEM)
    match m.get_str("one") {
        Some(v) => out.push_u64(u64.from_u32(*v))?
        None => out.push_str("none")?
    }
    out.push_str(" ")?
    match m.get_str("three") {
        Some(v) => out.push_u64(u64.from_u32(*v))?
        None => out.push_str("none")?
    }
    out.push_str(" ")?
    if m.contains_key_str("two") {
        out.push_str("has-two")?
    }
    if !m.contains_key_str("tw") {
        out.push_str(" no-tw")?
    }
    match m.get_mut_str("two") {
        Some(v) => {
            *v = 20u32
        }
        None => {
        }
    }
    out.push_str(" ")?
    match m.remove_str("two") {
        Some(v) => out.push_u64(u64.from_u32(v))?
        None => out.push_str("none")?
    }
    match m.remove_str("two") {
        Some(v) => out.push_u64(u64.from_u32(v))?
        None => out.push_str(" gone")?
    }
    out.push_str(" len=")?
    out.push_u64(u64.from_usize(m.len()))?
    core.mem.drop(std.io.print_line(out.as_str()))
    let name = alloc.string.String.from_str(std.alloc.SYSTEM, "hi")?
    let copy = name.try_clone()?
    let mut xs = alloc.vec.Vec.new(std.alloc.SYSTEM)
    xs.push(1u32)?
    xs.push(2u32)?
    let r = t.Rec { name: copy, xs: xs }
    let mut line = alloc.string.String.new(std.alloc.SYSTEM)
    line.push_debug(&r)?
    line.push_str(" ")?
    line.push_str(name.as_str())?
    core.mem.drop(std.io.print_line(line.as_str()))
    Ok(())
end t.main
