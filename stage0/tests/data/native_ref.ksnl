fn t.biggest['a](a: &'a u32, b: &'a u32) -> &'a u32 uses [] panics never
    if *a > *b {
        return a
    }
    b
end t.biggest

fn t.empty_bytes() -> &'static [u8] uses [] panics never
    b""
end t.empty_bytes

fn t.head(bytes: &[u8]) -> &[u8] uses [] panics never
    bytes
end t.head

fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console] panics may
    core.check.eq(t.name_of(0u32), "zero")
    core.check.eq(t.name_of(1u32), "one")
    core.check.eq(t.name_of(7u32), "many")
    core.check.eq(t.trimmed("  padded  "), "padded")
    core.check.eq(t.pick(true, "left", "right"), "left")
    core.check.eq(t.pick(false, "left", "right"), "right")
    core.check.eq(t.head(b"abc").len(), 3usize)
    core.check.eq(t.empty_bytes().len(), 0usize)
    core.check.eq(t.biggest(&3u32, &9u32), 9u32)
    let mut owner = alloc.string.String.new(std.alloc.SYSTEM)
    core.mem.drop(owner.push_str("owned text"))
    core.check.eq(t.view(&owner), "owned text")
    let mut line = alloc.string.String.new(std.alloc.SYSTEM)
    core.mem.drop(line.push_str(t.name_of(1u32)))
    core.mem.drop(line.push_str(", "))
    core.mem.drop(line.push_str(t.trimmed("  and  ")))
    std.io.print_line(line.as_str())
end t.main

fn t.name_of(n: u32) -> &'static str uses [] panics never
    match n {
        0u32 => "zero"
        1u32 => "one"
        _ => "many"
    }
end t.name_of

fn t.pick['a](flag: bool, a: &'a str, b: &'a str) -> &'a str uses [] panics never
    if flag {
        return a
    }
    b
end t.pick

fn t.trimmed(text: &str) -> &str uses [] panics never
    text.trim()
end t.trimmed

fn t.view(buf: &alloc.string.String<std.alloc.System>) -> &str uses [] panics never
    buf.as_str()
end t.view
