fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console, thread] panics may
    let made = std.sync.channel::<u32, std.alloc.System>(std.alloc.SYSTEM, 2usize)
    let (tx, rx) = made.map_err(t.oom)?
    let spawned = std.thread.spawn(
        std.alloc.SYSTEM,
        fn() -> () capture [move tx] {
            t.produce(tx, 1000u32)
        },
    )
    let producer = match spawned {
        Ok(handle) => handle
        Err(_e) => core.panic.panic("spawn failed")
    }
    let mut sum = 0u64
    loop {
        match rx.recv() {
            Ok(n) => {
                sum = sum + u64.from_u32(n)
            }
            Err(_e) => break
        }
    }
    producer.join()
    core.check.eq(sum, 333833500u64)

    let made_text = std.sync.channel::<alloc.string.String, std.alloc.System>(
        std.alloc.SYSTEM,
        3usize,
    )
    let (text_tx, text_rx) = made_text.map_err(t.oom)?
    let counting = std.thread.spawn(
        std.alloc.SYSTEM,
        fn() -> usize capture [move text_rx] {
            let mut total = 0usize
            loop {
                match text_rx.recv() {
                    Ok(s) => {
                        total = total + s.len()
                    }
                    Err(_e) => break
                }
            }
            total
        },
    )
    let consumer = match counting {
        Ok(handle) => handle
        Err(_e) => core.panic.panic("spawn failed")
    }
    let mut i = 0u32
    while i < 50u32 {
        core.mem.drop(match text_tx.send(t.message(i)) {
            Ok(_u) => 0u32
            Err(_e) => core.panic.panic("send failed")
        })
        i = i + 1u32
    }
    core.mem.drop(text_tx)
    let total = consumer.join()
    core.check.eq(total, 50usize * 5usize + 10usize + 40usize * 2usize)
    core.mem.drop(std.io.print_line("channel ok"))
    Ok(())
end t.main

fn t.message(i: u32) -> alloc.string.String uses [alloc] panics may
    let mut s = alloc.string.String.new(std.alloc.SYSTEM)
    core.mem.drop(match s.push_str("hello") {
        Ok(_u) => 0u32
        Err(_e) => core.panic.panic("oom")
    })
    core.mem.drop(match s.push_u64(u64.from_u32(i)) {
        Ok(_u) => 0u32
        Err(_e) => core.panic.panic("oom")
    })
    s
end t.message

fn t.oom(_e: alloc.alloc.AllocError) -> std.io.Error uses [] panics never
    std.io.Error { kind: std.io.ErrorKind.OutOfMemory, code: 0i32 }
end t.oom

fn t.produce(tx: std.sync.Sender<u32>, count: u32) -> () uses [thread] panics may
    let mut i = 1u32
    while i <= count {
        core.mem.drop(match tx.send(i.wrapping_mul(i)) {
            Ok(_u) => 0u32
            Err(_e) => core.panic.panic("send failed")
        })
        i = i + 1u32
    }
end t.produce
