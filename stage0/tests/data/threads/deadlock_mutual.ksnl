fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console, thread] panics may
    let made = std.sync.channel::<u32, std.alloc.System>(std.alloc.SYSTEM, 1usize)
    let (a_tx, a_rx) = made.map_err(t.oom)?
    let made2 = std.sync.channel::<u32, std.alloc.System>(std.alloc.SYSTEM, 1usize)
    let (b_tx, b_rx) = made2.map_err(t.oom)?
    let spawned = std.thread.spawn(
        std.alloc.SYSTEM,
        fn() -> () capture [move a_rx, move b_tx] {
            match a_rx.recv() {
                Ok(n) => match b_tx.send(n) {
                    Ok(_u) => core.check.eq(n, n)
                    Err(_e) => core.panic.panic("send failed")
                }
                Err(_e) => core.panic.panic("recv failed")
            }
        },
    )
    let worker = match spawned {
        Ok(h) => h
        Err(_e) => core.panic.panic("spawn failed")
    }
    match b_rx.recv() {
        Ok(n) => core.check.eq(n, 1u32)
        Err(_e) => core.panic.panic("recv failed")
    }
    worker.join()
    core.mem.drop(a_tx)
    Ok(())
end t.main

fn t.oom(_e: alloc.alloc.AllocError) -> std.io.Error uses [] panics never
    std.io.Error { kind: std.io.ErrorKind.OutOfMemory, code: 0i32 }
end t.oom
