fn t.deep(n: u64) -> u64 uses [] panics never stack 1_000_000
    if n == 0u64 {
        0u64
    } else {
        t.deep(n.wrapping_sub(1u64)).wrapping_add(1u64)
    }
end t.deep

fn t.main() -> Result<(), std.io.Error> uses [io.console] panics may
    core.mem.drop(std.io.print_line("start"))
    core.mem.drop(t.deep(1_000_000_000u64))
    core.mem.drop(std.io.print_line("unreachable"))
    Ok(())
end t.main
