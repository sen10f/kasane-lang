fn t.deep(n: u64) -> u64 uses [] panics never stack 1000000
    if n == 0u64 {
        0u64
    } else {
        t.deep(n.wrapping_sub(1u64)).wrapping_add(1u64)
    }
end t.deep

fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console, thread] panics may
    std.io.print_line("start")
    let spawned = std.thread.spawn(
        std.alloc.SYSTEM,
        fn() -> u64 capture [] {
            t.deep(1000000000u64)
        },
    )
    let handle = match spawned {
        Ok(h) => h
        Err(_e) => core.panic.panic("spawn failed")
    }
    let n = handle.join()
    std.io.print_line("unreachable")
    core.check.eq(n, 0u64)
    Ok(())
end t.main
