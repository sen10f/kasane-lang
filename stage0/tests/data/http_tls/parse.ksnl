fn t.err(tag: &str, e: std.http.Error) -> Result<(), std.http.Error> uses [io.console] panics never
    let name = match e {
        std.http.Error.BadRequest => "BadRequest"
        std.http.Error.BodyTooLarge => "BodyTooLarge"
        std.http.Error.HeadTooLarge => "HeadTooLarge"
        std.http.Error.Truncated => "Truncated"
        std.http.Error.Unsupported => "Unsupported"
        std.http.Error.Io(_x) => "Io"
        std.http.Error.Alloc(_a) => "Alloc"
    }
    std.io.print_line(tag)?
    std.io.print_line(name)?
    Ok(())
end t.err

fn t.main() -> Result<(), std.http.Error> uses [alloc, io.console] panics never
    t.one("plain", b"GET /a HTTP/1.1\r\nHost: x\r\n\r\n", 8192usize, 1024usize)?
    t.one("close", b"GET /a HTTP/1.1\r\nConnection: close\r\n\r\n", 8192usize, 1024usize)?
    t.one("v10", b"GET /a HTTP/1.0\r\n\r\n", 8192usize, 1024usize)?
    t.one("v10ka", b"GET /a HTTP/1.0\r\nConnection: keep-alive\r\n\r\n", 8192usize, 1024usize)?
    t.one("body", b"POST /s HTTP/1.1\r\nContent-Length: 3\r\n\r\nabc", 8192usize, 1024usize)?
    t.one("chunked", b"POST /c HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nWiki\r\n5;ext=1\r\npedia\r\n0\r\nX-T: 1\r\n\r\n", 8192usize, 1024usize)?
    t.one("partial", b"POST /s HTTP/1.1\r\nContent-Length: 5\r\n\r\nab", 8192usize, 1024usize)?
    t.one("badreq", b"GET x HTTP/1.1\r\n\r\n", 8192usize, 1024usize)?
    t.one("http2", b"GET /x HTTP/2\r\n\r\n", 8192usize, 1024usize)?
    t.one("badhdr", b"GET /x HTTP/1.1\r\nbroken\r\n\r\n", 8192usize, 1024usize)?
    t.one("clte", b"POST /x HTTP/1.1\r\nContent-Length: 1\r\nTransfer-Encoding: chunked\r\n\r\n", 8192usize, 1024usize)?
    t.one("gzip", b"POST /x HTTP/1.1\r\nTransfer-Encoding: gzip\r\n\r\n", 8192usize, 1024usize)?
    t.one("clbig", b"POST /x HTTP/1.1\r\nContent-Length: 2000\r\n\r\n", 8192usize, 1024usize)?
    t.one("clnan", b"POST /x HTTP/1.1\r\nContent-Length: 1x\r\n\r\n", 8192usize, 1024usize)?
    t.one("hexbad", b"POST /x HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n", 8192usize, 1024usize)?
    t.one("chunkbig", b"POST /x HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n800\r\n", 8192usize, 100usize)?
    t.one("headbig", b"GET /x HTTP/1.1\r\nX: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\r\n", 16usize, 1024usize)?
    t.one("headok", b"GET / HTTP/1.1\r\n\r\n", 18usize, 1024usize)?
    t.one("crlfbad", b"GET /x HTTP/1.1\r\nA: 1\r\n\r\nPOSTX", 8192usize, 1024usize)?
    let mut d = std.http.Decoder.new(8192usize, 1024usize)
    d.feed(b"GET /1 HTTP/1.1\r\n\r\nGET /2 HTTP/1.1\r\nConnection: close\r\n\r\n")?
    if let Some(r1) = d.next()? {
        t.show("pipe1", &r1)?
    }
    if let Some(r2) = d.next()? {
        t.show("pipe2", &r2)?
    }
    if d.next()?.is_none() {
        std.io.print_line("pipe3 none")?
    }
    let mut split = std.http.Decoder.new(8192usize, 1024usize)
    split.feed(b"POST /c HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nWi")?
    if split.next()?.is_none() {
        std.io.print_line("split1 none")?
    }
    split.feed(b"ki\r\n0\r\n\r\n")?
    if let Some(r3) = split.next()? {
        t.show("split2", &r3)?
    }
    Ok(())
end t.main

fn t.one(tag: &str, bytes: &[u8], max_head: usize, max_body: usize) -> Result<(), std.http.Error> uses [alloc, io.console] panics never
    let mut d = std.http.Decoder.new(max_head, max_body)
    d.feed(bytes)?
    match d.next() {
        Ok(Some(r)) => t.show(tag, &r)
        Ok(None) => {
            std.io.print_line(tag)?
            Ok(())
        }
        Err(e) => {
            t.err(tag, e)
        }
    }
end t.one

fn t.show(tag: &str, r: &std.http.Request) -> Result<(), std.http.Error> uses [alloc, io.console] panics never
    let mut line = alloc.string.String.new(std.alloc.SYSTEM)
    line.push_str(tag)?
    line.push_str(" ")?
    line.push_str(r.method.as_str())?
    line.push_str(" ")?
    line.push_str(r.path.as_str())?
    line.push_str(" body=")?
    line.push_u64(u64.from_usize(r.body.len()))?
    line.push_str(" keep=")?
    if r.keep_alive() {
        line.push_str("1")?
    } else {
        line.push_str("0")?
    }
    std.io.print_line(line.as_str())?
    Ok(())
end t.show
