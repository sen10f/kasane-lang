end t.set

fn t.show(x: u64) -> () uses [alloc, io.console] panics never
    let mut s = std.string.String.new()
    core.mem.drop(s.push_u64(x))
    core.mem.drop(std.io.print_line(s.as_str()))
end t.show

fn t.work(n: u64) -> u64 uses [] panics never
    let mut x = 1u64
    let mut acc = 0u64
    for i in core.iter.range(0u64, n) {
        x = i.wrapping_add(10u64)
        acc = acc.wrapping_add(t.get((&x, 1u8)))
        x = i.wrapping_add(20u64)
        acc = acc.wrapping_add(t.get((&x, 1u8)))
    }
    acc
end t.work

fn t.work2(k: u64) -> u64 uses [] panics never
    let mut y = 5u64
    t.set((&mut y, 1u8), k)
    let y1 = y
    t.set((&mut y, 1u8), k.wrapping_add(1u64))
    y1 ^ y
end t.work2
