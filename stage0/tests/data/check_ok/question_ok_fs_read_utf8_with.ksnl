// expect-accept
// with の外で buf を宣言し、with の中で open → read_to_end → from_utf8 → 使用、
// with を抜けた後 buf.push で再利用（NLL、std.fs 読み込み結果を借りる形）。
enum t.Error derive [Debug, Clone, Copy, PartialEq, Eq, From] pub
    Io(std.io.Error)
    Alloc(alloc.alloc.AllocError)
    Utf8(core.str.Utf8Error)
end t.Error

fn t.main() -> Result<(), t.Error> uses [alloc, io.console, io.fs] panics may
    // まずファイルを作成して中身を書く
    with mut f = std.fs.create("/tmp/opencode/ksn_a111_fs3.dat")? close core.mem.drop(f.close()) {
        core.mem.drop(f.write(core.str.as_bytes("hello"))?)
    }
    let mut buf: alloc.vec.Vec<u8, std.alloc.System> = alloc.vec.Vec.new(std.alloc.SYSTEM)
    // with の中で open → read_to_end → from_utf8 → 使用
    with mut f = std.fs.open("/tmp/opencode/ksn_a111_fs3.dat")? close core.mem.drop(f.close()) {
        core.mem.drop(std.fs.read_to_end(&mut f, &mut buf)?)
        match core.str.from_utf8(buf.as_slice()) {
            Ok(s) => {
                core.check.eq(s, "hello")
            }
            Err(e) => {
                return Err(t.Error.Utf8(e))
            }
        }
    }
    // with を抜けた後 buf を再利用（read_to_end / from_utf8 の borrow は終了）
    core.mem.drop(buf.push(33u8)?)
    core.check.eq(buf.len(), 6usize)
    match std.io.print_line("fs read utf8 with ok") {
        Ok(_done) => {
        }
        Err(error) => {
            return Err(t.Error.Io(error))
        }
    }
    core.mem.drop(buf)
    Ok(())
end t.main
