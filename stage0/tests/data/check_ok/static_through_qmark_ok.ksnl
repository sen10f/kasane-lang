enum t.E derive [Debug, Clone, Copy] pub
    Bad
end t.E

fn t.main() -> Result<(), t.E> uses [] panics never
    core.mem.drop(t.take(t.pick(0usize)?))
    Ok(())
end t.main

fn t.pick(k: usize) -> Result<&'static str, t.E> uses [] panics never
    let names = ["A", "B"]
    if let Some(row) = names.get(k) {
        return Ok(*row)
    }
    Ok("")
end t.pick

fn t.take(s: &'static str) -> usize uses [] panics never
    s.len()
end t.take
