fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console] panics never
    let s = t.mk("hello, this is a long heap string")
    let mut owned: Option<std.string.String> = None
    let f = fn(sl: &mut Option<std.string.String>) -> () capture [&s] {
        *sl = Some(s.clone())
    }
    f(&mut owned)
    let mut slot: Option<&str> = Some("static text")
    let g = fn(p: &mut Option<&str>) -> () capture [] {
        let cur = *p
        *p = cur
    }
    g(&mut slot)
    let mut local: Option<&str> = None
    let h = fn() -> () capture [&mut local, &s] {
        *local = Some(s.as_str())
    }
    h()
    if let Some(r) = local {
        std.io.print_line(r)?
    }
    let k = fn() -> usize capture [&s] {
        s.as_str().len()
    }
    std.io.print_line(t.mk("ok").as_str())?
    core.mem.drop(k())
    core.mem.drop(owned)
    Ok(())
end t.main

fn t.mk(text: &str) -> std.string.String uses [alloc] panics never
    let mut s = std.string.String.new()
    core.mem.drop(s.push_str(text))
    s
end t.mk
