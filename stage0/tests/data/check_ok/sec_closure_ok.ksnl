fn t.fill(out: &mut std.vec.Vec<usize>) -> () uses [alloc] panics never
    let f = fn(x: &str) -> () capture [&mut out] {
        core.mem.drop(out.push(x.len()))
    }
    f("abc")
end t.fill

fn t.owned() -> fn() -> usize uses [] panics never uses [] panics never
    let s = std.string.String.new()
    fn() -> usize capture [move s] {
        s.len()
    }
end t.owned

fn t.within() -> usize uses [] panics never
    let s = std.string.String.new()
    let mut g = fn() -> usize capture [] {
        0usize
    }
    g = fn() -> usize capture [&s] {
        s.len()
    }
    g()
end t.within
