fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.ok() -> u32 uses [] panics never
    let mut x = 1u32
    let r = &mut x
    let r2 = &mut *r
    *r2 = 2u32
    *r = 3u32
    let s = &x
    let n = *s
    x.wrapping_add(n)
end t.ok

fn t.pass(x: &mut u32) -> &mut u32 uses [] panics never
    &mut *x
end t.pass
