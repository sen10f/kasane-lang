fn t.main() -> () uses [] panics never
    let v = [(1u32, 2u32), (3u32, 4u32)]
    for (a, b) in v {
        core.mem.drop(a.wrapping_add(b))
    }
    let o = Some((1u32, 2u32))
    if let Some((c, _d)) = o {
        core.mem.drop(c)
    }
    let p = (1u32, 2u32)
    match p {
        (e, f) => core.mem.drop(e.wrapping_add(f))
    }
    let g = fn(x: u32) -> u32 capture [] {
        x
    }
    core.mem.drop(g(7u32))
    let mut z = 1u32
    z = z.wrapping_add(1u32)
    core.mem.drop(z)
    ()
end t.main
