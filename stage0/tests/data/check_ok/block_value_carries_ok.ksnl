fn t.main() -> () uses [] panics never
    let mut x = 1u32
    let mut y = 2u32
    let r = &mut x
    let r2 = {
        r
    }
    *r2 = 3u32
    let ra = &mut y
    t.two({
        core.mem.drop(1u32)
        &mut x
    }, ra)
    core.mem.drop(*ra)
end t.main

fn t.two(a: &mut u32, b: &mut u32) -> () uses [] panics never
    *a = 1u32
    *b = 2u32
end t.two
