static t.M: std.sync.Mutex<u32> = std.sync.Mutex.new(0u32)

fn t.gs[F: core.ops.Fn<(), (), E, P>, E: uses, P: panics](f: F) -> () uses [thread, E] panics P
    let g = t.M.lock()
    core.mem.drop(*g.get())
    core.mem.drop(g)
    f()
end t.gs

fn t.main() -> () uses [suspend, thread] panics may
    std.task.block_on(fn() -> () capture [] {
        t.gs(fn() -> () capture [] {
            t.susp()
        })
    })
end t.main

fn t.susp() -> () uses [suspend] panics never
    std.task.yield_now()
end t.susp
