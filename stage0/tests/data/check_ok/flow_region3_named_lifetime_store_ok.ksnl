fn t.main() -> () uses [] panics never
    let mut buf = [&0u32, &0u32]
    let x = 9u32
    t.store3(&mut buf, &x)
end t.main

fn t.store3['a](v: &'a mut [&'a u32], x: &'a u32) -> () uses [] panics never
    match v.get_mut(0usize) {
        Some(p) => {
            *p = x
        }
        None => {
            core.mem.drop(0u8)
        }
    }
end t.store3
