type t.Named
    name: std.string.String
end t.Named

fn t.Named.pick(self: &t.Named, other: &str) -> &str uses [] panics never
    if other.is_empty() {
        return self.name.as_str()
    }
    let o = self.name.as_str()
    o
end t.Named.pick

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
