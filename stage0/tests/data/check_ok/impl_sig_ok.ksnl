trait t.C[T]
    fn get(self: &Self, x: T) -> T uses [] panics never
    fn me(self: &Self) -> &Self uses [] panics never
    fn own(self: Self, n: u32) -> Option<T> uses [] panics never
end t.C

type t.X
    v: u32
end t.X

impl t.C<u32> for t.X
fn t.X.get(self: &t.X, x: u32) -> u32 uses [] panics never impls t.C<u32>
    x.wrapping_add(self.v)
end t.X.get
fn t.X.me(self: &t.X) -> &t.X uses [] panics never impls t.C<u32>
    self
end t.X.me
fn t.X.own(self: t.X, n: u32) -> Option<u32> uses [] panics never impls t.C<u32>
    Some(n.wrapping_add(self.v))
end t.X.own
