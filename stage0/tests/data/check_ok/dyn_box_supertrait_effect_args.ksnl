trait t.Base[E: uses, P: panics]
    fn base(self: &Self) -> u32 uses [E] panics P
end t.Base

trait t.Sub[E: uses, P: panics] requires t.Base<E, P>
    fn sub(self: &Self) -> u32 uses [E] panics P
end t.Sub

type t.X
    v: u32
end t.X

impl t.Base<[], never> for t.X
fn t.X.base(self: &t.X) -> u32 uses [] panics never impls t.Base<[], never>
    self.v
end t.X.base

impl t.Sub<[], never> for t.X
fn t.X.sub(self: &t.X) -> u32 uses [] panics never impls t.Sub<[], never>
    self.v
end t.X.sub

fn t.good(h: &std.boxed.Box<dyn t.Sub<[], never> + 'static>) -> u32 uses [] panics never
    h.base()
end t.good

fn t.main() -> Result<(), std.io.Error> uses [alloc] panics may
    let b = t.make()
    core.mem.drop(t.good(&b))
    core.mem.drop(b)
    Ok(())
end t.main

fn t.make() -> std.boxed.Box<dyn t.Sub<[], never> + 'static> uses [alloc] panics may
    let x = t.X {
        v: 7u32
    }
    match std.boxed.Box.new(x) {
        Ok(b) => b.into_dyn()
        Err(e) => {
            core.mem.drop(e)
            core.panic.panic("oom")
        }
    }
end t.make
