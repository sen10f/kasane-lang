static t.FLAG: std.sync.Mutex<u64> = std.sync.Mutex.new(0u64) pub

fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console, suspend, thread, time] panics may
    let r = std.task.block_on_threads(
        std.alloc.SYSTEM,
        4usize,
        fn() -> u64 capture [] {
            let a = std.task.spawn(fn() -> u64 capture [] {
                loop {
                    let g = t.FLAG.lock()
                    let v = *g.get()
                    core.mem.drop(g)
                    if v == 1u64 {
                        return 7u64
                    }
                    std.thread.sleep(1u64)
                }
            })
            let b = std.task.spawn(fn() -> u64 capture [] {
                std.thread.sleep(50u64)
                let mut g = t.FLAG.lock()
                *g.get_mut() = 1u64
                core.mem.drop(g)
                1u64
            })
            a.join_task().wrapping_add(b.join_task())
        },
    )
    t.show(r)
    Ok(())
end t.main

fn t.show(x: u64) -> () uses [alloc, io.console] panics never
    let mut s = std.string.String.new()
    core.mem.drop(s.push_u64(x))
    core.mem.drop(std.io.print_line(s.as_str()))
end t.show
