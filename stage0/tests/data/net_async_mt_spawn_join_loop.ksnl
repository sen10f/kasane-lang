fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console, suspend, thread] panics may
    let r = std.task.block_on_threads(
        std.alloc.SYSTEM,
        4usize,
        fn() -> u64 capture [] {
            let mut i = 0u64
            let mut acc = 0u64
            while i < 500u64 {
                let a = std.task.spawn(fn() -> u64 capture [move i] {
                    i
                })
                acc = acc.wrapping_add(a.join_task())
                i = i + 1u64
            }
            acc
        },
    )
    t.show(r)
    Ok(())
end t.main

fn t.show(x: u64) -> () uses [alloc, io.console] panics never
    let mut s = std.string.String.new()
    core.mem.drop(s.push_u64(x))
    core.mem.drop(std.io.print_line(s.as_str()))
end t.show
