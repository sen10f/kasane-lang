extern t.run_once(f: fn() -> () uses [] panics never) -> () link "LIB:run_once"

fn t.deep(n: u64) -> u64 uses [] panics never stack 1000000
    if n == 0u64 {
        0u64
    } else {
        t.deep(n.wrapping_sub(1u64)).wrapping_add(1u64)
    }
end t.deep

fn t.main() -> Result<(), std.io.Error> uses [io.console] panics may
    std.io.print_line("start")
    unsafe "ffi" "callback that overflows the stack" {
        t.run_once(t.recurse)
    }
    std.io.print_line("unreachable")
    Ok(())
end t.main

fn t.recurse() -> () uses [] panics never
    core.mem.drop(t.deep(1000000000u64))
end t.recurse
