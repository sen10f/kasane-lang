fn t.main() -> Result<(), std.io.Error> uses [alloc] panics may
    let mut v = std.vec.Vec.new()
    let s = match alloc.string.String.from_str(std.alloc.SYSTEM, "a") {
        Ok(x) => x
        Err(_e) => std.string.String.new()
    }
    core.mem.drop(v.push(s))
    let a = v[0usize]
    let b = v[0usize]
    core.mem.drop(a)
    core.mem.drop(b)
    Ok(())
end t.main
