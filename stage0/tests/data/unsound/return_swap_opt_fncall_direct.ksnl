fn t.f['a, 'b](x: &'a u32, y: &'b u32) -> Option<(&'a u32, &'b u32)> uses [] panics never
    t.mk_opt(y, x)
end t.f

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.mk_opt['a, 'b](a: &'a u32, b: &'b u32) -> Option<(&'a u32, &'b u32)> uses [] panics never
    Some((a, b))
end t.mk_opt
