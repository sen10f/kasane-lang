type t.P
    v: i32
end t.P

impl core.ops.Drop for t.P
fn t.P.drop(self: &mut t.P) -> () uses [] panics never impls core.ops.Drop
    ()
end t.P.drop

fn t.main() -> () uses [] panics never
    core.mem.drop(1u8)
end t.main

fn t.take(p: (t.P, i32)) -> i32 uses [] panics never
    let (t.P {
        v: v
    }, n) = p
    core.mem.drop(n)
    v
end t.take
