type t.S
    name: alloc.string.String
    other: alloc.string.String
end t.S

fn t.consume(s: alloc.string.String) -> () uses [] panics never
    core.mem.drop(s)
end t.consume

fn t.f(x: &t.S) -> () uses [] panics never
    let t.S { name: n, other: o } = x
    t.consume(n)
    t.consume(o)
end t.f

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    let a = std.string.String.new()
    let b = std.string.String.new()
    let x = t.S { name: a, other: b }
    t.f(&x)
    Ok(())
end t.main
