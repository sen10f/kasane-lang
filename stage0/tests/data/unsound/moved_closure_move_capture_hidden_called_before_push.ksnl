type t.RefCell['a]
    p: &'a mut u32
end t.RefCell

fn t.bad() -> u32 uses [alloc] panics never
    let mut v = std.vec.Vec.new()
    core.mem.drop(v.push(1u32))
    let s = v.as_mut_slice()
    let r = s.get_mut(0usize)
    let x = match r {
        Some(x) => x
        None => return 0u32
    }
    let cell = t.RefCell { p: x }
    let c = fn() -> u32 capture [move cell] {
        *cell.p
    }
    core.mem.drop(c())
    core.mem.drop(v.push(2u32))
    0u32
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [alloc] panics never
    core.mem.drop(t.bad())
    Ok(())
end t.main
