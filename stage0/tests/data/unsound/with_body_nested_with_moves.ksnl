// expect: E3040
type t.Res linear
    id: u32
end t.Res

fn t.Res.get(self: &t.Res) -> u32 uses [] panics never
    self.id
end t.Res.get

fn t.Res.shut(self: t.Res) -> () uses [] panics never
    let t.Res { id: id } = self
    core.mem.drop(id)
end t.Res.shut

fn t.f() -> () uses [] panics never
    with a = t.Res { id: 1u32 } close a.shut() {
        with b = a close b.shut() {
        }
    }
end t.f

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.take(r: t.Res) -> () uses [] panics never
    r.shut()
end t.take
