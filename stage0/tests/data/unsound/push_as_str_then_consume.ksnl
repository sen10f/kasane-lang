fn t.bad() -> usize uses [alloc] panics never
    let mut v = std.vec.Vec.new()
    let s = t.mk()
    match v.push(s.as_str()) {
        Ok(_u) => 0u32
        Err(_e) => 1u32
    }
    t.consume(s)
    v.len()
end t.bad

fn t.consume(s: alloc.string.String) -> () uses [] panics never
    core.mem.drop(s)
end t.consume

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.mk() -> alloc.string.String uses [] panics never
    std.string.String.new()
end t.mk
