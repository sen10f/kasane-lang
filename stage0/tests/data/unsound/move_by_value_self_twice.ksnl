type t.Wrap
    v: std.vec.Vec<u32>
end t.Wrap

fn t.Wrap.into_len(self: t.Wrap) -> usize uses [] panics never
    self.v.len()
end t.Wrap.into_len

fn t.bad() -> usize uses [] panics never
    let w = t.Wrap { v: std.vec.Vec.new() }
    let a = w.into_len()
    a.wrapping_add(w.into_len())
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
