trait t.Tr[E: uses, P: panics] pub
    fn get_ref(self: &Self, x: &u32) -> &u32 uses [E] panics P
end t.Tr

type t.X pub
    mark: u32
end t.X

impl t.Tr<[], never> for t.X
fn t.X.get_ref(self: &t.X, x: &u32) -> &u32 uses [] panics never impls t.Tr<[], never>
    x
end t.X.get_ref

fn t.bad() -> u32 uses [] panics never
    let mut x = 1u32
    let obj = t.X {
        mark: 0u32
    }
    let mut d: &dyn t.Tr<[], never> = &obj
    let r = d.get_ref(&x)
    x = 2u32
    *r
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
