fn t.bad(l: &std.net.TcpListener) -> Result<(), std.net.Error> uses [alloc, io.net] panics never
    let s = l.accept()?
    let mut v = std.vec.Vec.new()
    match v.push(s) {
        Ok(_) => Ok(())
        Err(_) => Ok(())
    }
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
