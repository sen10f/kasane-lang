type t.W
    n: u32
end t.W

fn t.W.dup(self: &t.W) -> alloc.string.String uses [] panics never
    t.mk()
end t.W.dup

fn t.bad() -> usize uses [] panics never
    let w = t.W { n: 1u32 }
    let r = w.dup().as_str()
    let z = t.mk()
    core.mem.drop(z)
    r.len()
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.mk() -> alloc.string.String uses [] panics never
    alloc.string.String.new(std.alloc.SYSTEM)
end t.mk
