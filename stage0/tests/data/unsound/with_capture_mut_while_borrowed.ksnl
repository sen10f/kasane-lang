fn t.go() -> () uses [] panics never
    with mut s = std.string.String.new() close core.mem.drop(s) {
        let r = s.as_str()
        let f = fn() -> () capture [&mut s] {
            s.clear()
        }
        f()
        core.mem.drop(r.len())
    }
end t.go

fn t.main() -> () uses [] panics never
    t.go()
end t.main
