type t.Outer['a, 'b]
    inner: t.Pair<'a, 'b>
end t.Outer

type t.Pair['a, 'b]
    fst: &'a u32
    snd: &'b u32
end t.Pair

fn t.Outer.get_fst['a, 'b](self: &t.Outer<'a, 'b>, _y: &t.Outer<'a, 'b>) -> &'a u32 uses [] panics never
    self.inner.fst
end t.Outer.get_fst

fn t.Outer.get_snd['a, 'b](self: &t.Outer<'a, 'b>, _y: &t.Outer<'a, 'b>) -> &'b u32 uses [] panics never
    self.inner.snd
end t.Outer.get_snd

fn t.Pair.pick['a, 'b](self: &t.Pair<'a, 'b>, _y: &t.Pair<'a, 'b>, _fb: &'a u32) -> &'a u32 uses [] panics never
    match *self {
        t.Pair { fst: f, snd: _ } => f
    }
end t.Pair.pick

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    let a = 1u32
    let b = 2u32
    let o = t.Outer { inner: t.Pair { fst: &a, snd: &b } }
    core.mem.drop(*o.get_fst(&o))
    core.mem.drop(*o.get_snd(&o))
    Ok(())
end t.main
