type t.Boxed
    x: u32
end t.Boxed

trait t.Tr[E: uses, P: panics]
    fn m(self: &Self) -> () uses [E] panics P
end t.Tr

impl t.Tr<[], may> for t.Boxed
fn t.Boxed.m(self: &Self) -> () uses [] panics may impls t.Tr<[], may>
    core.panic.panic("x")
end t.Boxed.m

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    let b = t.Boxed { x: 1u32 }
    core.mem.drop(t.take(&b))
    Ok(())
end t.main

fn t.take[P: panics](h: &dyn t.Tr<[], P>) -> () uses [] panics never
    h.m()
end t.take
