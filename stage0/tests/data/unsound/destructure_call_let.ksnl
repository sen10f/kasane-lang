// expect: E3010
fn t.bad() -> u32 uses [] panics never
    let mut x = 1u32
    let (a, _n) = t.pair(&x)
    x = 2u32
    *a
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.pair(r: &u32) -> (&u32, u32) uses [] panics never
    (r, 1u32)
end t.pair
