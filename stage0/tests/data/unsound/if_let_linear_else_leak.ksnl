type t.L linear pub
    v: u32
end t.L

fn t.eat(l: t.L) -> () uses [] panics never
    let t.L { v: v } = l
    core.mem.drop(v)
end t.eat

fn t.main() -> () uses [] panics never
    let o = Some(t.L { v: 1u32 })
    if let Some(l) = o {
        t.eat(l)
    } else {
        core.mem.drop(0u8)
    }
end t.main
