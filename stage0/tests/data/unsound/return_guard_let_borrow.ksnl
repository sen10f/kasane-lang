fn t.borrow(m: &std.sync.Mutex<u32>) -> &u32 uses [thread] panics never
    let g = m.lock()
    g.get()
end t.borrow

fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console, thread] panics never
    let m = std.sync.Mutex.new(10u32)
    let r = t.borrow(&m)
    let mut out = std.string.String.new()
    match alloc.fmt.write(&mut out, r) {
        Ok(_) => ()
        Err(e) => core.mem.drop(e)
    }
    match out.push_str("\n") {
        Ok(_) => ()
        Err(e) => core.mem.drop(e)
    }
    match std.io.print_line(out.as_str()) {
        Ok(_) => ()
        Err(e) => core.mem.drop(e)
    }
    Ok(())
end t.main
