// expect: E3002
fn t.bad(v: &alloc.vec.Vec<Option<alloc.string.String>, std.alloc.System>) -> () uses [] panics may
    match v[0usize] {
        Some(x) => t.consume(x)
        None => core.mem.drop(0u8)
    }
end t.bad

fn t.consume(s: alloc.string.String) -> () uses [] panics never
    core.mem.drop(s)
end t.consume

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.mk() -> alloc.string.String uses [] panics never
    alloc.string.String.new(std.alloc.SYSTEM)
end t.mk
