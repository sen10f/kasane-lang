type t.S
    name: alloc.string.String
end t.S

fn t.S.a(self: t.S) -> () uses [] panics never
    t.consume(self.name)
    t.consume(self.name)
end t.S.a

fn t.consume(s: alloc.string.String) -> () uses [] panics never
    core.mem.drop(s)
end t.consume

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
