type t.W['a]
    r: &'a mut u32
end t.W

fn t.a_wrap['a](r: &'a mut u32) -> t.W<'a> uses [] panics never
    t.W { r: r }
end t.a_wrap

fn t.bad() -> u32 uses [] panics never
    let mut x = 1u32
    let w = t.a_wrap(&mut x)
    x = 2u32
    *w.r
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
