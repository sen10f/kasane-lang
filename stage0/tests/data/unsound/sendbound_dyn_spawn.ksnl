type t.Shared
    p: *const u8
end t.Shared

trait t.Tr
    fn go(self: &Self) -> () uses [] panics never
end t.Tr

impl t.Tr for t.Shared
fn t.Shared.go(self: &t.Shared) -> () uses [] panics never impls t.Tr
    core.mem.drop(self.p)
end t.Shared.go

fn t.main() -> i32 uses [alloc, thread] panics may
    let b = std.boxed.Box.new(t.mk()).unwrap()
    let d: std.boxed.Box<dyn t.Tr + 'static> = b.into_dyn()
    let h = std.thread.spawn(
        std.alloc.SYSTEM,
        fn() -> () capture [move d] {
            d.go()
        },
    ).unwrap()
    let _r = h.join()
    0i32
end t.main

fn t.mk() -> t.Shared uses [] panics never
    t.Shared {
        p: core.ptr.as_const(core.ptr.null_mut())
    }
end t.mk
