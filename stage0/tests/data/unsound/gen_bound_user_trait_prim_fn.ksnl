trait t.Handler[E: uses, P: panics] pub
    fn handle(self: &mut Self, event: &str) -> u32 uses [E] panics P
end t.Handler

fn t.main() -> () uses [] panics never
    t.reg(42u32)
end t.main

fn t.reg[H: t.Handler<[io.console], never>](handler: H) -> () uses [] panics never
    core.mem.drop(handler)
end t.reg
