// expect: E3002
fn t.bad() -> () uses [] panics never
    let mut s = t.mk()
    while t.eat(s) {
        s = t.mk()
    }
    t.consume(s)
end t.bad

fn t.consume(s: alloc.string.String) -> () uses [] panics never
    core.mem.drop(s)
end t.consume

fn t.eat(s: alloc.string.String) -> bool uses [] panics never
    core.mem.drop(s)
    false
end t.eat

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.mk() -> alloc.string.String uses [] panics never
    alloc.string.String.new(std.alloc.SYSTEM)
end t.mk

fn t.peek(s: &alloc.string.String) -> usize uses [] panics never
    s.len()
end t.peek
