fn t.bad(_p: &u32) -> Option<&u32> uses [] panics never
    let (a, _b) = (&7u32, 1u8)
    t.wrap(a)
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    let z = 0u32
    let o = t.bad(&z)
    core.mem.drop(o)
    Ok(())
end t.main

fn t.wrap(x: &u32) -> Option<&u32> uses [] panics never
    Some(x)
end t.wrap
