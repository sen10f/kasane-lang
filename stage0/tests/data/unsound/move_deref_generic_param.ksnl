fn t.consume(s: alloc.string.String) -> () uses [] panics never
    core.mem.drop(s)
end t.consume

fn t.main() -> Result<(), std.io.Error> uses [alloc] panics never
    let s = std.string.String.new()
    core.mem.drop(s.push_str("hello"))
    t.consume(t.steal(&s))
    t.consume(s)
    Ok(())
end t.main

fn t.steal[T](r: &T) -> T uses [] panics never
    *r
end t.steal
