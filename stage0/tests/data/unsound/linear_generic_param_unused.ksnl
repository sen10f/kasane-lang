type t.Res linear
    id: u32
end t.Res

fn t.bad() -> () uses [] panics never
    t.forget(t.open(1u32))
end t.bad

fn t.close(r: t.Res) -> u32 uses [] panics never
    let t.Res {
        id: id
    } = r
    id
end t.close

fn t.forget[T: linear](_x: T) -> () uses [] panics never
    core.mem.drop(1u8)
end t.forget

fn t.main() -> () uses [] panics never
    core.mem.drop(1u8)
end t.main

fn t.open(n: u32) -> t.Res uses [] panics never
    t.Res {
        id: n
    }
end t.open
