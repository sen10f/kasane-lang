fn t.go() -> Result<(), std.io.Error> uses [alloc, io.console] panics never
    let mut s = t.mk("hello, this is a long heap string")
    let mut slot: Option<&str> = None
    let f = fn() -> () capture [&mut s, &mut slot] {
        *slot = Some(s.as_str())
    }
    f()
    s.clear()
    core.mem.drop(s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"))
    if let Some(r) = slot {
        std.io.print_line(r)?
    }
    Ok(())
end t.go

fn t.main() -> () uses [alloc, io.console] panics never
    core.mem.drop(t.go())
end t.main

fn t.mk(text: &str) -> std.string.String uses [alloc] panics never
    let mut s = std.string.String.new()
    core.mem.drop(s.push_str(text))
    s
end t.mk
