// expect: E3060
fn t.bad() -> u32 uses [alloc] panics never
    let mut x = 1u32
    let mut m = alloc.collections.HashMap.new(std.alloc.SYSTEM)
    let c = fn() -> u32 capture [&mut x] {
        x
    }
    core.mem.drop(m.insert(1u32, c))
    let y = x
    core.mem.drop(m.len())
    y
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [alloc] panics never
    core.mem.drop(t.bad())
    Ok(())
end t.main
