type t.A
    n: u32
end t.A

type t.B
    n: u32
end t.B

fn t.A.pick['a](self: &t.A, x: &'a str) -> &'a str uses [] panics never
    if self.n == 0u32 {
        return x
    }
    x
end t.A.pick

fn t.B.pick(self: &t.B) -> u32 uses [] panics never
    self.n
end t.B.pick

fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console] panics never
    let a = t.A { n: 1u32 }
    let s = t.mk()
    let r = a.pick(s.as_str())
    core.mem.drop(s)
    core.mem.drop(std.io.print_line(r))
    Ok(())
end t.main

fn t.mk() -> alloc.string.String uses [alloc] panics never
    let mut s = alloc.string.String.new(std.alloc.SYSTEM)
    core.mem.drop(s.push_str("hello world, this is heap memory"))
    s
end t.mk
