// expect: E3060
type t.W['a]
    r: &'a u32
end t.W

fn t.a_mk['a](r: &'a u32) -> t.W<'a> uses [] panics never
    t.W { r: r }
end t.a_mk

fn t.bad() -> u32 uses [] panics never
    let mut x = 1u32
    let w = t.a_mk(&x)
    let r = w.r
    x = 2u32
    *r
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
