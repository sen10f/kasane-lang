type t.H['a]
    r: &'a str
end t.H

trait t.Show
    fn show(self: &Self) -> usize uses [] panics never
end t.Show

impl t.Show for t.H
fn t.H.show(self: &t.H) -> usize uses [] panics never impls t.Show
    self.r.len()
end t.H.show

fn t.go[T: core.marker.Send + t.Show](x: T) -> std.thread.JoinHandle<usize, std.alloc.System> uses [alloc, thread] panics may
    let spawned = std.thread.spawn(
        std.alloc.SYSTEM,
        fn() -> usize capture [move x] {
            x.show()
        },
    )
    match spawned {
        Ok(h) => h
        Err(_e) => core.panic.panic("spawn failed")
    }
end t.go

fn t.mk() -> alloc.string.String uses [] panics never
    std.string.String.new()
end t.mk

fn t.start() -> std.thread.JoinHandle<usize, std.alloc.System> uses [alloc, thread] panics may
    let s = t.mk()
    t.go(t.H {
        r: s.as_str()
    })
end t.start
