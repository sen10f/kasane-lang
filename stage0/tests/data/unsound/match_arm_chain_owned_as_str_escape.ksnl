fn t.dangling(s: &str) -> &str uses [alloc] panics never
    let x = match alloc.string.String.from_str(std.alloc.SYSTEM, s) {
        Ok(v) => v.as_str().trim()
        Err(_e) => ""
    }
    x
end t.dangling

fn t.main() -> Result<(), std.io.Error> uses [io.console] panics never
    std.io.print_line("main")
end t.main
