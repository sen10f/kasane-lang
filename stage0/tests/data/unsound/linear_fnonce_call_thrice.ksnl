type t.Res linear
    id: u32
end t.Res

fn t.Res.shut(self: t.Res) -> () uses [] panics never
    let t.Res {
        id: id
    } = self
    core.mem.drop(id)
end t.Res.shut

fn t.bad() -> () uses [] panics never
    let r = t.open()
    let f = fn() -> () capture [move r] {
        r.shut()
    }
    f()
    f()
end t.bad

fn t.main() -> () uses [] panics never
    t.bad()
end t.main

fn t.open() -> t.Res uses [] panics never
    t.Res {
        id: 1u32
    }
end t.open
