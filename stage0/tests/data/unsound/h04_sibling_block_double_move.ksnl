fn t.eat(s: alloc.string.String) -> () uses [] panics never
    core.mem.drop(s)
end t.eat

fn t.main(c: bool) -> Result<(), std.io.Error> uses [alloc] panics never
    if c {
        let b = t.mk()
        t.eat(b)
    } else {
        let b = t.mk()
        t.eat(b)
        t.eat(b)
    }
    Ok(())
end t.main

fn t.mk() -> alloc.string.String uses [alloc] panics never
    let mut s = alloc.string.String.new(std.alloc.SYSTEM)
    core.mem.drop(s.push_str("x"))
    s
end t.mk
