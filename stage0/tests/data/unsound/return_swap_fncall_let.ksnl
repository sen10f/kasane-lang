// expect: E3010
fn t.f['a, 'b](x: &'a u32, y: &'b u32) -> (&'a u32, &'b u32) uses [] panics never
    let z = t.mk(y, x)
    z
end t.f

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.mk['a, 'b](a: &'a u32, b: &'b u32) -> (&'a u32, &'b u32) uses [] panics never
    (a, b)
end t.mk
