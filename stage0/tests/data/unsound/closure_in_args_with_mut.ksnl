fn t.apply[F: core.ops.FnOnce<(), u32, [], never>](f: F, _a: &mut u32) -> u32 uses [] panics never
    f()
end t.apply

fn t.bad() -> u32 uses [] panics never
    let mut x = 1u32
    t.apply(fn() -> u32 capture [&x] {
        x
    }, &mut x)
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
