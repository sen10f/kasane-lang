fn t.main() -> () uses [alloc, io.console] panics may
    let mut m = alloc.collections.HashMap.new(std.alloc.SYSTEM)
    let s = alloc.string.String.new(std.alloc.SYSTEM)
    match m.insert(s.as_str(), 1u32) {
        Ok(_r) => {
        }
        Err(_e) => {
            core.panic.panic("insert")
        }
    }
end t.main
