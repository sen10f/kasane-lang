// expect: E3010
fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console, thread] panics never
    match std.sync.channel(std.alloc.SYSTEM, 2usize) {
        Ok((tx, rx)) => {
            let s = alloc.string.String.new(std.alloc.SYSTEM)
            let sent = tx.send(&s)
            core.mem.drop(sent)
            let moved = s
            core.mem.drop(moved)
            core.mem.drop(rx.recv())
        }
        Err(_e) => std.io.print_line("alloc")?
    }
    Ok(())
end t.main
