// expect: E????
fn t.bad() -> u32 uses [] panics never
    let mut x = 1u32
    let c = fn() -> u32 capture [&mut x] {
        *x
    }
    let a = c()
    core.mem.drop(a)
    x = 5u32
    x
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    core.mem.drop(t.bad())
    Ok(())
end t.main
