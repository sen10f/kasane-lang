type t.P['a, 'b]
    x: &'a u64
    y: Option<&'b u64>
end t.P

type t.Q['a, 'b]
    p: t.P<'a, 'b>
end t.Q

fn t.f5['a, 'b](q: &mut t.Q<'a, 'b>) -> () uses [] panics never
    let inner = &q.p
    let inner2 = inner
    let w = inner2.y
    match w {
        Some(v) => {
            q.p.x = v
        }
        None => ()
    }
end t.f5

fn t.main() -> () uses [] panics never
end t.main
