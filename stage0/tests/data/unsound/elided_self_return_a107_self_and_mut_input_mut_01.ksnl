type t.S
    v: u32
end t.S

fn t.S.m(self: &t.S, x: &mut u32) -> &mut u32 uses [] panics never
    x
end t.S.m

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    let s = t.S { v: 1u32 }
    let mut a = 2u32
    let r = s.m(&mut a)
    *r = 7u32
    a = 5u32
    core.mem.drop(*r)
    Ok(())
end t.main
