enum t.E derive [Clone, Copy]
    Num(u64, u64)
    Text(&'static str)
end t.E

fn t.confuse(a: &mut t.E, b: &mut t.E) -> Result<(), std.io.Error> uses [io.console] panics never
    match a {
        t.E.Text(s) => {
            *b = t.E.Num(1_094_795_585u64, 4096u64)
            std.io.print_line(*s)?
        }
        t.E.Num(_x, _y) => ()
    }
    Ok(())
end t.confuse

fn t.main() -> Result<(), std.io.Error> uses [io.console] panics never
    let mut e = t.E.Text("hello")
    let o = Some(&mut e)
    let c = o.clone()
    match o {
        Some(a) => match c {
            Some(b) => t.confuse(a, b)?
            None => ()
        }
        None => ()
    }
    Ok(())
end t.main
