static t.M: std.sync.Mutex<u64> = std.sync.Mutex.new(0u64)

static t.RW: std.sync.RwLock<u64> = std.sync.RwLock.new(0u64)

fn t.bump() -> () uses [thread] panics never
    let mut g = t.M.lock()
    *g.get_mut() = 77u64
    core.mem.drop(g)
end t.bump

fn t.gr(g: &std.sync.MutexGuard<'static, u64>) -> &u64 uses [] panics never
    g.get()
end t.gr

fn t.main() -> () uses [alloc, io.console, thread] panics may
    t.see(t.gr(&t.M.lock()))
end t.main

fn t.pr(x: u64) -> () uses [alloc, io.console] panics may
    let mut s = std.string.String.new()
    s.push_u64(x).unwrap()
    std.io.print_line(s.as_str()).unwrap()
end t.pr

fn t.see(x: &u64) -> () uses [alloc, io.console, thread] panics may
    t.pr(*x)
    t.bump()
    t.pr(*x)
end t.see

fn t.two(a: &mut u64, b: &mut u64) -> u64 uses [] panics never
    *a = 1u64
    *b = 2u64
    *a
end t.two
