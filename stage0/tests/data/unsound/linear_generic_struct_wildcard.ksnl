type t.Holder[T: linear]
    v: T
end t.Holder

type t.Res linear
    id: u32
end t.Res

fn t.close(r: t.Res) -> u32 uses [] panics never
    let t.Res { id: id } = r
    id
end t.close

fn t.forget[T: linear](h: t.Holder<T>) -> u8 uses [] panics never
    let t.Holder { v: _ } = h
    1u8
end t.forget

fn t.main() -> () uses [] panics never
    core.mem.drop(1u8)
end t.main

fn t.open(n: u32) -> t.Res uses [] panics never
    t.Res { id: n }
end t.open
