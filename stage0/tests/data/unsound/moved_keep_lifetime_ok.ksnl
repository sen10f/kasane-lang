fn t.keep['a](v: &mut std.vec.Vec<&'a alloc.string.String>, s: &'a alloc.string.String) -> &'a alloc.string.String uses [alloc] panics never
    core.mem.drop(v.push(s))
    s
end t.keep

fn t.main() -> Result<(), std.io.Error> uses [alloc] panics never
    let mut v = std.vec.Vec.new()
    let s = std.string.String.new()
    core.mem.drop(t.keep(&mut v, &s))
    Ok(())
end t.main
