type t.Pair['a, 'b] derive [Clone, Copy]
    fst: &'a u32
    snd: &'b u32
end t.Pair

fn t.Pair.snd_as_fst['a, 'b](self: &t.Pair<'a, 'b>, _y: &t.Pair<'a, 'b>) -> &'a u32 uses [] panics never
    match *self {
        t.Pair {
            fst: _
            snd: s
        } => s
    }
end t.Pair.snd_as_fst

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    let a = 1u32
    let b = 2u32
    let p = t.Pair {
        fst: &a
        snd: &b
    }
    core.mem.drop(*p.snd_as_fst(&p))
    Ok(())
end t.main
