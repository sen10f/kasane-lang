type t.W['a]
    r: &'a u32
end t.W

fn t.bad() -> u32 uses [] panics never
    let mut x = 1u32
    let w = t.id(t.W {
        r: &x
    })
    x = 2u32
    *w.r
end t.bad

fn t.id[T](v: T) -> T uses [] panics never
    v
end t.id

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
