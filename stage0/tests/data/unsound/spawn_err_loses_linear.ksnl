type t.L linear pub
    n: u64
end t.L

fn t.L.close(self: t.L) -> u64 uses [] panics never
    let t.L {
        n: n
    } = self
    n
end t.L.close

fn t.main() -> () uses [alloc, thread] panics never
    let l = t.mk(1u64)
    let h = std.thread.spawn(
        std.alloc.SYSTEM,
        fn() -> u64 capture [move l] {
            l.close()
        },
    )
    match h {
        Ok(j) => core.mem.drop(j.join())
        Err(_) => core.mem.drop(0u8)
    }
end t.main

fn t.mk(n: u64) -> t.L uses [] panics never
    t.L {
        n: n
    }
end t.mk
