fn t.bad() -> usize uses [alloc] panics never
    let mut v: std.vec.Vec<&mut u32> = std.vec.Vec.new()
    {
        let mut x = 7u32
        core.mem.drop(v.push(&mut *&mut x))
    }
    let n = v.len()
    core.mem.drop(v)
    n
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
