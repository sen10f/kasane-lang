fn t.bad() -> u32 uses [] panics never
    let mut x = 1u32
    let c = fn() -> u32 capture [&x] {
        x
    }
    let w = t.wrap(c)
    x = 2u32
    match w {
        Some(cf) => cf()
        None => 0u32
    }
end t.bad

fn t.main() -> () uses [] panics never
end t.main

fn t.wrap[F: core.ops.Fn<(), u32, [], never>](f: F) -> Option<F> uses [] panics never
    Some(f)
end t.wrap
