// expect: E2023
fn t.main() -> Result<(), std.io.Error> uses [] panics never
    core.mem.drop(t.sink(("hi", 7u32)))
    Ok(())
end t.main

fn t.sink(p: (&alloc.string.String<std.alloc.System>, u32)) -> () uses [] panics never
    match p {
        (s, n) => {
            core.mem.drop(s)
            core.mem.drop(n)
        }
    }
end t.sink
