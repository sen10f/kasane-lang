// expect: E3060
// 穴候補: HashMap::get_mut の &mut を構造体欄に隠して move でクロージャへ取り込み、insert で再ハッシュさせてから呼ぶ
type t.RefCell['a]
    p: &'a mut u32
end t.RefCell

fn t.bad() -> u32 uses [alloc] panics never
    let mut m = alloc.collections.HashMap.new(std.alloc.SYSTEM)
    core.mem.drop(m.insert(1u32, 10u32))
    let r = m.get_mut(&1u32)
    let x = match r {
        Some(x) => x
        None => return 0u32
    }
    let cell = t.RefCell { p: x }
    let c = fn() -> u32 capture [move cell] {
        *cell.p
    }
    core.mem.drop(m.insert(2u32, 20u32))
    core.mem.drop(c())
    0u32
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [alloc] panics never
    core.mem.drop(t.bad())
    Ok(())
end t.main
