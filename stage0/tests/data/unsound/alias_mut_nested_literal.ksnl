type t.Pair
    a: Option<&'static mut u32>
    b: Option<&'static mut u32>
end t.Pair

fn t.bad() -> u32 uses [] panics never
    let mut x = 1u32
    let _p = t.Pair {
        a: Some(&mut x)
        b: Some(&mut x)
    }
    x
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
