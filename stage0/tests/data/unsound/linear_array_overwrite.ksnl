// expect: E3003
type t.Res linear
    id: u32
end t.Res

fn t.bad() -> u32 uses [] panics may
    let mut a = [t.open(1u32)]
    a[0usize] = t.open(2u32)
    for r in a {
        core.mem.drop(t.close(r))
    }
    0u32
end t.bad

fn t.close(r: t.Res) -> u32 uses [] panics never
    let t.Res { id: id } = r
    id
end t.close

fn t.main() -> () uses [] panics never
    core.mem.drop(1u8)
end t.main

fn t.open(n: u32) -> t.Res uses [] panics never
    t.Res { id: n }
end t.open
