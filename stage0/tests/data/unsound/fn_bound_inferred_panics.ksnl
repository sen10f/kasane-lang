fn t.bad() -> u32 uses [] panics never
    t.strict(fn() -> u32 capture [] {
        t.boom()
    })
end t.bad

fn t.boom() -> u32 uses [] panics may
    core.panic.panic("p")
end t.boom

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.strict[F: core.ops.Fn<(), u32, [], never>](f: F) -> u32 uses [] panics never
    f.call(())
end t.strict
