type t.Res linear
    id: u32
    data: std.vec.Vec<u64>
end t.Res

fn t.Res.shut(self: t.Res) -> () uses [] panics never
    let t.Res { id: id, data: data } = self
    core.mem.drop(id)
    core.mem.drop(data)
end t.Res.shut

fn t.bad() -> () uses [] panics never
    with r = t.Res { id: 1u32, data: std.vec.Vec.new() } close r.shut() {
        if let t.Res { id: id, data: data } = r {
            core.mem.drop(data)
        }
    }
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
