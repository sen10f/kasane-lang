type t.H['a]
    r: &'a u64
end t.H

fn t.bad() -> u64 uses [] panics never
    let mut a = 5u64
    let mut o = Some(t.H { r: &a })
    let p = o.take()
    a = 6u64
    match p {
        Some(h) => *h.r
        None => 0u64
    }
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
