type t.Pair
    a: t.Res
    b: t.Res
end t.Pair

type t.Res linear
    id: u32
end t.Res

fn t.bad(r: t.Res) -> u32 uses [] panics never
    t.peek(&t.Pair {
        a: r
        b: t.open(1u32)
    })
end t.bad

fn t.close(r: t.Res) -> u32 uses [] panics never
    let t.Res {
        id: id
    } = r
    id
end t.close

fn t.main() -> () uses [] panics never
    core.mem.drop(1u8)
end t.main

fn t.open(n: u32) -> t.Res uses [] panics never
    t.Res {
        id: n
    }
end t.open

fn t.peek(p: &t.Pair) -> u32 uses [] panics never
    p.a.id
end t.peek
