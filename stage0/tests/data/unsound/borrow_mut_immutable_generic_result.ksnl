// expect: E3031
type t.S derive [Clone, Copy] pub
    n: u32
end t.S

fn t.bad(s: t.S) -> () uses [] panics never
    let a = t.id(s.n)
    t.bump(&mut a)
end t.bad

fn t.bump(x: &mut u32) -> () uses [] panics never
    *x = 1u32
end t.bump

fn t.id[T](x: T) -> T uses [] panics never
    x
end t.id

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
