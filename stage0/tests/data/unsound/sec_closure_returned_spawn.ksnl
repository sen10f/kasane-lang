fn t.main() -> Result<(), std.io.Error> uses [alloc, thread] panics never
    let g = t.mkf()
    let other = t.mk("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")
    let spawned = std.thread.spawn(
        std.alloc.SYSTEM,
        fn() -> usize capture [move g] {
            g().len()
        },
    )
    match spawned {
        Ok(handle) => core.mem.drop(handle.join())
        Err(_e) => ()
    }
    core.mem.drop(other)
    Ok(())
end t.main

fn t.mk(text: &str) -> alloc.string.String uses [alloc] panics never
    let mut s = alloc.string.String.new(std.alloc.SYSTEM)
    core.mem.drop(s.push_str(text))
    s
end t.mk

fn t.mkf() -> fn() -> &'static str uses [] panics never uses [alloc] panics never
    let s = t.mk("hello, this is a long heap string")
    fn() -> &'static str capture [&s] {
        s.as_str()
    }
end t.mkf
