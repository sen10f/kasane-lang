static t.M: std.sync.Mutex<u64> = std.sync.Mutex.new(0u64)

static t.RW: std.sync.RwLock<u64> = std.sync.RwLock.new(0u64)

fn t.gm(g: &mut std.sync.RwLockWriteGuard<'static, u64>) -> &mut u64 uses [] panics never
    g.get_mut()
end t.gm

fn t.gr(g: &std.sync.RwLockReadGuard<'static, u64>) -> &u64 uses [] panics never
    g.get()
end t.gr

fn t.main() -> () uses [alloc, io.console, thread] panics may
    t.pr(t.rw(t.gr(&t.RW.read()), t.gm(&mut t.RW.write())))
end t.main

fn t.pr(x: u64) -> () uses [alloc, io.console] panics may
    let mut s = std.string.String.new()
    s.push_u64(x).unwrap()
    std.io.print_line(s.as_str()).unwrap()
end t.pr

fn t.rw(a: &u64, b: &mut u64) -> u64 uses [] panics never
    let x = *a
    *b = x.wrapping_add(5u64)
    a.wrapping_sub(x)
end t.rw

fn t.two(a: &mut u64, b: &mut u64) -> u64 uses [] panics never
    *a = 1u64
    *b = 2u64
    *a
end t.two
