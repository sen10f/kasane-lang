type t.Shared
    p: *const u8
end t.Shared

fn t.main() -> i32 uses [] panics never
    let f = t.w
    f(t.mk())
    0i32
end t.main

fn t.mk() -> t.Shared uses [] panics never
    t.Shared {
        p: core.ptr.as_const(core.ptr.null_mut())
    }
end t.mk

fn t.w[T: core.marker.Send](x: T) -> () uses [] panics never
    let _y = x
end t.w
