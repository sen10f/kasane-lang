fn t.main() -> () uses [] panics may
    core.mem.drop(core.iter.fold(
        core.iter.map(
            core.iter.range(0u64, 2u64),
            fn(x: u64) -> u64 capture [] {
                core.panic.panic("todo")
                x
            },
        ),
        0u64,
        fn(acc: u64, x: u64) -> u64 capture [] {
            acc.wrapping_add(x)
        },
    ))
end t.main
