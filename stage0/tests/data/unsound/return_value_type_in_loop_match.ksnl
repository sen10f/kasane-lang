fn t.f(o: Option<u32>) -> u8 uses [] panics never
    loop {
        match o {
            Some(v) => {
                return v
            }
            None => {
                return 0u8
            }
        }
    }
end t.f

fn t.main() -> () uses [] panics never
    core.mem.drop(t.f(Some(1u32)))
end t.main
