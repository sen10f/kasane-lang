type t.S pub
    v: u32
    s: alloc.string.String<std.alloc.System>
end t.S

fn t.bad(n: u32) -> u32 uses [] panics never
    let k = n
    core.mem.drop(*k)
    *n
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.make() -> t.S uses [] panics never
    t.S { v: 7u32, s: alloc.string.String.new() }
end t.make
