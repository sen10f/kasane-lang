fn t.bad() -> () uses [] panics never
    let s: alloc.string.String = std.string.String.new()
    let f = fn() -> () capture [move s] {
        core.mem.drop(s)
    }
    let mut i = 0u32
    while i < 2u32 {
        f()
        i = i.wrapping_add(1u32)
    }
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
