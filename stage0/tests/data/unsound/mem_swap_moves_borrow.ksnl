type t.H
    r: &'static u32
end t.H

fn t.bad() -> u32 uses [] panics never
    let mut x = 1u32
    let y = 2u32
    let mut a = t.H {
        r: &x
    }
    let mut b = t.H {
        r: &y
    }
    core.mem.swap(&mut a, &mut b)
    x = 3u32
    *b.r
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
