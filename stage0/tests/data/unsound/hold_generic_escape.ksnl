type t.Hold[T]
    v: T
end t.Hold

fn t.Hold.get(self: t.Hold<&u32>) -> &u32 uses [] panics never
    match self {
        t.Hold { v: r } => r
    }
end t.Hold.get

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    let keep = 1u32
    let mut k1 = t.make(&keep)
    let mut k2 = t.make(&keep)
    let mut k3 = &keep
    {
        let a = 10u32
        k1 = t.make(&a)
        k2 = if true {
            t.make(&a)
        } else {
            t.make(&a)
        }
        k3 = t.Hold { v: &a }.get()
    }
    core.mem.drop(*k1.v)
    core.mem.drop(*k2.v)
    core.mem.drop(*k3)
    Ok(())
end t.main

fn t.make(r: &u32) -> t.Hold<&u32> uses [] panics never
    t.Hold { v: r }
end t.make
