fn t.b() -> usize uses [alloc] panics never
    let mut src = std.vec.Vec.new()
    match src.push(1u32) {
        Ok(_) => ()
        Err(_) => ()
    }
    let mut dst = std.vec.Vec.new()
    match src.get(0usize) {
        Some(r) => match dst.push(r) {
            Ok(_) => ()
            Err(_) => ()
        }
        None => ()
    }
    match src.push(2u32) {
        Ok(_) => ()
        Err(_) => ()
    }
    let n = dst.len()
    core.mem.drop(dst)
    core.mem.drop(src)
    n
end t.b

fn t.main() -> Result<(), std.io.Error> uses [alloc] panics never
    core.mem.drop(t.b())
    Ok(())
end t.main
