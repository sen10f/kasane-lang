type t.S pub
    v: u32
end t.S

fn t.eat(s: t.S) -> u32 uses [] panics never
    s.v
end t.eat

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    let s = t.S {
        v: 1u32
    }
    for i in core.iter.range(0u8, 2u8) {
        core.mem.drop(t.eat(s))
        core.mem.drop(i)
    }
    Ok(())
end t.main
