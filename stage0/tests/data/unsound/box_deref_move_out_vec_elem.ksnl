// expect: E3002
// Vec<Box<T>> の要素 v[0] から * で Box<T> を move-out し、その Box を drop した後、
// Vec を drop すると Vec の drop が要素の Box<T> の drop を実行し、T のリソース
// (String バッファ) が二回解放される。
fn t.bad() -> () uses [alloc] panics may
    let mut v = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let s = match alloc.string.String.from_str(std.alloc.SYSTEM, "hi") {
        Ok(s) => s
        Err(_e) => core.panic.panic("oom")
    }
    let b = match alloc.boxed.Box.new(std.alloc.SYSTEM, s) {
        Ok(b) => b
        Err(_e) => core.panic.panic("oom")
    }
    core.mem.drop(v.push(b))
    let x = *v[0usize]
    core.mem.drop(x)
    core.mem.drop(v)
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [alloc] panics may
    t.bad()
    Ok(())
end t.main
