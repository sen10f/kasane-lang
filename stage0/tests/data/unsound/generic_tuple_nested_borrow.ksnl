fn t.bad() -> usize uses [alloc] panics never
    let mut v = alloc.vec.Vec.new(std.alloc.SYSTEM)
    core.mem.drop(v.push(alloc.string.String.new(std.alloc.SYSTEM)))
    let r = t.pick(((v.get(0usize), 1u32), 2u32))
    core.mem.drop(v.push(alloc.string.String.new(std.alloc.SYSTEM)))
    match r {
        Some(x) => x.len()
        None => 7usize
    }
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [alloc] panics never
    Ok(())
end t.main

fn t.pick[A, B](p: ((A, B), u32)) -> A uses [] panics never
    let ((a, b), _n) = p
    core.mem.drop(b)
    a
end t.pick
