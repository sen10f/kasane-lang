fn t.bad() -> usize uses [alloc] panics never
    let mut v = std.vec.Vec.new()
    core.mem.drop(v.push(std.string.String.new()))
    let r = t.pick(((v.get(0usize), 1u32), 2u32))
    core.mem.drop(v.push(std.string.String.new()))
    match r {
        Some(x) => x.len()
        None => 7usize
    }
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.pick[A, B](p: ((A, B), u32)) -> A uses [] panics never
    let ((a, b), _n) = p
    core.mem.drop(b)
    a
end t.pick
