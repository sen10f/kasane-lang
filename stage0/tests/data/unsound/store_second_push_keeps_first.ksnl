fn t.bad() -> usize uses [alloc] panics never
    let mut v = std.vec.Vec.new()
    let mut x = 1u32
    let y = 2u32
    match v.push(&x) {
        Ok(_) => 0u32
        Err(_) => 1u32
    }
    match v.push(&y) {
        Ok(_) => 0u32
        Err(_) => 1u32
    }
    x = 3u32
    v.len()
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
