type t.Box[T] derive [ToJson]
    x: T
end t.Box

type t.NoJson
    a: u8
end t.NoJson

fn t.main() -> Result<(), std.io.Error> uses [alloc] panics never
    let b = t.Box {
        x: t.NoJson {
            a: 1u8
        }
    }
    let r = std.json.to_string(&b)
    core.mem.drop(r)
    Ok(())
end t.main
