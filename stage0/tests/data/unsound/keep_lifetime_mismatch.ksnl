fn t.keep(v: &mut std.vec.Vec<&alloc.string.String>, s: &alloc.string.String) -> () uses [alloc] panics never
    core.mem.drop(v.push(s))
end t.keep

fn t.main() -> Result<(), std.io.Error> uses [alloc] panics never
    let mut v = std.vec.Vec.new()
    let s = std.string.String.new()
    t.keep(&mut v, &s)
    Ok(())
end t.main
