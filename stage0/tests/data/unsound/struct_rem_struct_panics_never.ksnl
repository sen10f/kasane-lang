type t.P
    x: i32
end t.P

fn t.main() -> Result<(), std.io.Error> uses [io.console] panics never
    let a = t.P {
        x: 1i32
    }
    let b = t.P {
        x: 2i32
    }
    let p = t.r(a, b)
    std.io.print_line("ok")
end t.main

fn t.r(a: t.P, b: t.P) -> t.P uses [] panics never
    a % b
end t.r
