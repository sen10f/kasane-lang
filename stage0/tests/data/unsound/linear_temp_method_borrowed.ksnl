// expect: E3003
type t.Res linear
    id: u32
end t.Res

fn t.Res.peek(self: &t.Res) -> u32 uses [] panics never
    self.id
end t.Res.peek

fn t.bad() -> u32 uses [] panics never
    t.open(1u32).peek()
end t.bad

fn t.main() -> () uses [] panics never
    core.mem.drop(1u8)
end t.main

fn t.open(n: u32) -> t.Res uses [] panics never
    t.Res { id: n }
end t.open
