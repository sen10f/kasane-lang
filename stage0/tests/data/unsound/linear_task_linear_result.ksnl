fn t.main() -> () uses [io.net, suspend] panics may
    let conn = t.open()
    std.task.block_on(fn() -> () capture [move conn] {
        let a = std.task.spawn_local(fn() -> std.net.TcpStream capture [move conn] {
            conn
        })
        core.mem.drop(a.join_task())
    })
end t.main

fn t.open() -> std.net.TcpStream uses [io.net] panics may
    match std.net.connect("127.0.0.1:1") {
        Ok(s) => s
        Err(_e) => core.panic.panic("connect")
    }
end t.open
