trait t.Handler[E: uses, P: panics]
    fn handle(self: &Self) -> () uses [E] panics P
end t.Handler

fn t.bad(h: &alloc.boxed.Box<dyn t.Handler<[io.console], never> + 'static, std.alloc.System>) -> () uses [] panics never
    h.handle()
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
