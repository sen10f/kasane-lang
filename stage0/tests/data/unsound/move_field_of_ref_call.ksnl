// expect: E3002
type t.S
    name: alloc.string.String
end t.S

fn t.bad(s: &t.S) -> () uses [] panics never
    t.consume(t.id(s).name)
end t.bad

fn t.consume(s: alloc.string.String) -> () uses [] panics never
    core.mem.drop(s)
end t.consume

fn t.id(s: &t.S) -> &t.S uses [] panics never
    s
end t.id

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.mk() -> alloc.string.String uses [] panics never
    alloc.string.String.new(std.alloc.SYSTEM)
end t.mk
