fn t.bad() -> usize uses [alloc] panics never
    let mut m = std.collections.HashMap.new()
    let mut k = std.string.String.new()
    core.mem.drop(k.push_str("abc"))
    core.mem.drop(m.insert(1u32, k.as_str()))
    core.mem.drop(k.push_str("x"))
    m.len()
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
