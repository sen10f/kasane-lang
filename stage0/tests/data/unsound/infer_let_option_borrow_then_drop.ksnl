fn t.main() -> Result<(), alloc.alloc.AllocError> uses [] panics never
    let opt = Some(std.string.String.new())
    let r = if true {
        opt.as_ref()
    } else {
        opt.as_ref()
    }
    core.mem.drop(opt)
    match r {
        Some(s) => {
            let n = s.as_str().len()
            core.mem.drop(n)
        }
        None => ()
    }
    Ok(())
end t.main
