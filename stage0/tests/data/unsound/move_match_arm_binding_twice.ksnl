fn t.bad(v: &mut alloc.vec.Vec<alloc.string.String, std.alloc.System>) -> () uses [] panics never
    match v.pop() {
        Some(s) => {
            t.consume(s)
            t.consume(s)
        }
        None => core.mem.drop(0u8)
    }
end t.bad

fn t.consume(s: alloc.string.String) -> () uses [] panics never
    core.mem.drop(s)
end t.consume

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
