type t.L linear pub
    v: u32
end t.L

fn t.eat(l: t.L) -> () uses [] panics never
    let t.L { v: v } = l
    core.mem.drop(v)
end t.eat

fn t.main() -> () uses [] panics never
    let l = t.L { v: 1u32 }
    let f = fn() -> () capture [move l] {
        t.eat(l)
    }
    core.mem.drop(f)
end t.main
