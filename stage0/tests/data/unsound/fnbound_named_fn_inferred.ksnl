fn t.apply[F: core.ops.Fn<(u32,), u32, [], never>](f: F) -> u32 uses [] panics never
    f(2u32)
end t.apply

fn t.divides(x: u32) -> u32
    x / 0u32
end t.divides

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.zpure() -> u32 uses [] panics never
    t.apply(t.divides)
end t.zpure
