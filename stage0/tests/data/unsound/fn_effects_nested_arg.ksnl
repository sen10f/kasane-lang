fn t.ap(q: fn() -> u32 uses [] panics never) -> u32 uses [] panics never
    q()
end t.ap

fn t.hi(p: fn(fn() -> u32 uses [io.console] panics may) -> u32 uses [] panics never) -> u32 uses [] panics never
    p(t.loud)
end t.hi

fn t.loud() -> u32 uses [io.console] panics may
    core.mem.drop(std.io.print_line("LOUD"))
    core.panic.panic("PANIC")
end t.loud

fn t.main() -> () uses [] panics never
    core.mem.drop(t.hi(t.ap))
end t.main

fn t.quiet() -> u32 uses [] panics never
    1u32
end t.quiet
