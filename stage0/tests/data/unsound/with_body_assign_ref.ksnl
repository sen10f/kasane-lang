type t.Res linear
    id: u32
    inner: Option<std.vec.Vec<u64>>
end t.Res

fn t.Res.shut(self: t.Res) -> () uses [] panics never
    let t.Res {
        id: id
        inner: inner
    } = self
    core.mem.drop(id)
    core.mem.drop(inner)
end t.Res.shut

fn t.bad() -> u32 uses [] panics never
    let holder = t.mk()
    let mut p = &holder
    with r = t.mk() close r.shut() {
        p = &r
    }
    let n = p.id
    holder.shut()
    n
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.mk() -> t.Res uses [] panics never
    t.Res {
        id: 1u32
        inner: None
    }
end t.mk

fn t.wrap(x: &t.Res) -> &t.Res uses [] panics never
    x
end t.wrap
