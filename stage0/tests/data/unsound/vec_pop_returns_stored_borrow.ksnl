fn t.bad() -> u32 uses [alloc] panics never
    let mut v = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let mut x = 1u32
    match v.push(&x) {
        Ok(_) => 0u32
        Err(_) => 1u32
    }
    match v.pop() {
        Some(r) => {
            x = 2u32
            *r
        }
        None => 0u32
    }
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
