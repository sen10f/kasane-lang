// expect: E4001
fn t.g[F: core.ops.Fn<(), ()>](f: F) -> ()
    f()
end t.g

fn t.loud() -> () uses [io.console] panics never
    core.mem.drop(std.io.print_line("y"))
end t.loud

fn t.main() -> () uses [] panics never
    t.pub_caller()
end t.main

fn t.pub_caller() -> () uses [] panics never pub
    t.g(t.loud)
end t.pub_caller
