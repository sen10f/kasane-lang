import alloc.boxed

trait t.Handler pub
    fn handle(self: &mut Self) -> u32 uses [] panics never
end t.Handler

type t.Slot
    handler: alloc.boxed.Box<dyn t.Handler + 'static, std.alloc.System>
end t.Slot

fn t.main() -> () uses [] panics never
end t.main

fn t.wrap[H](handler: H) -> Result<t.Slot, alloc.alloc.AllocError> uses [alloc] panics never
    let b = boxed.Box.new(std.alloc.SYSTEM, handler)?
    Ok(t.Slot { handler: boxed.Box.into_dyn(b) })
end t.wrap
