fn t.loud(a: i32) -> i32 uses [io.console] panics never
    core.mem.drop(std.io.print_line("x"))
    a
end t.loud

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    let m = core.iter.map(core.iter.range(0i32, 3i32), t.loud)
    let f = core.iter.filter(m, fn(a: &i32) -> bool capture [] {
        true
    })
    for x in f {
        core.mem.drop(x)
    }
    Ok(())
end t.main
