type t.Wrap
    v: std.vec.Vec<u32>
end t.Wrap

fn t.bad() -> usize uses [] panics never
    let v = std.vec.Vec.new()
    let mut n = 0usize
    while n < 3usize {
        let w = t.Wrap { v: v }
        n = n.wrapping_add(w.v.len()).wrapping_add(1usize)
    }
    n
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
