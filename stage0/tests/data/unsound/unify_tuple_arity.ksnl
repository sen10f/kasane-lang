// expect: E2023
fn t.bad() -> u64 uses [] panics never
    let q = (1u64, 2u64)
    t.third(q)
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

// expect: E2023
fn t.third(p: (u64, u64, u64)) -> u64 uses [] panics never
    let (_a, _b, c) = p
    c
end t.third
