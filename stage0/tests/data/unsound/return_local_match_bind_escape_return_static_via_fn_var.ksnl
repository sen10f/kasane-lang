// expect: E3030
// 言い換え穴: `t.id(&x)` は E3030（ローカル `x` への参照を `&'static u32` として返す）だが、
// `match &x { r => t.id(r) }` と match の腕で変数を 1 段束縛すると E3030 をすり抜ける。
// 戻り値 &'static u32 は実際にはローカル `x` へのダングル参照。main で *r を読むとダングル参照を読む。
fn t.bad() -> &'static u32 uses [] panics never
    let x = 7u32
    match &x {
        r => t.id(r)
    }
end t.bad

fn t.id(x: &u32) -> &u32 uses [] panics never
    x
end t.id

fn t.main() -> Result<(), std.io.Error> uses [io.console] panics never
    Ok(())
end t.main
