// expect: E3006
type t.Res linear
    id: u32
end t.Res

fn t.bad(rx: std.sync.Receiver<t.Res>) -> u32 uses [alloc] panics may
    let mut all = alloc.vec.Vec.new(std.alloc.SYSTEM)
    match all.push(rx) {
        Ok(_u) => 0u32
        Err(_e) => core.panic.panic("oom")
    }
    0u32
end t.bad

fn t.close(r: t.Res) -> u32 uses [] panics never
    match r {
        t.Res { id: id } => id
    }
end t.close

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.open() -> t.Res uses [] panics never
    t.Res { id: 1u32 }
end t.open
