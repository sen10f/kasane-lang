fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console] panics never
    let mut a = std.vec.Vec.new()
    let mut b = std.vec.Vec.new()
    {
        let s = t.mk()
        core.mem.drop(b.push(s.as_str()))
        core.mem.drop(a.append(&mut b))
    }
    match a.get(0usize) {
        Some(r) => core.mem.drop(std.io.print_line(*r))
        None => core.mem.drop(std.io.print_line("none"))
    }
    Ok(())
end t.main

fn t.mk() -> alloc.string.String uses [alloc] panics never
    let mut s = std.string.String.new()
    core.mem.drop(s.push_str("hello world, this is heap memory"))
    s
end t.mk
