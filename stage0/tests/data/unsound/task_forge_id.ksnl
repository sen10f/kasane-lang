fn t.forge(id: usize) -> std.task.Task<std.vec.Vec<u8>> uses [] panics never
    std.task.Task {
        id: id
    }
end t.forge

fn t.main() -> () uses [alloc, suspend] panics may
    std.task.block_on(fn() -> () capture [] {
        let b = std.task.spawn_local(
            fn() -> std.vec.Vec<u8> capture [] {
                let mut v: std.vec.Vec<u8> = std.vec.Vec.new()
                match v.push(7u8) {
                    Ok(u) => u
                    Err(_) => ()
                }
                v
            },
        )
        let forged = t.forge(1usize)
        let v1 = b.join_task()
        let v2 = forged.join_task()
        core.mem.drop(v1)
        core.mem.drop(v2)
    })
end t.main
