fn t.main() -> () uses [alloc] panics never
    let mut v = std.vec.Vec.new()
    core.mem.drop(v.push(1u32))
    core.mem.drop(v.push(2u32))
    let s = v.as_mut_slice()
    let left = s.sub_mut(0usize, 2usize)
    let right = s.sub_mut(1usize, 2usize)
    core.mem.drop(left)
    core.mem.drop(right)
end t.main
