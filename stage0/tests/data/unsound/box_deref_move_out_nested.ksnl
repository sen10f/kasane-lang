fn t.bad() -> () uses [alloc] panics may
    let s = match alloc.string.String.from_str(std.alloc.SYSTEM, "hi") {
        Ok(s) => s
        Err(_e) => core.panic.panic("oom")
    }
    let inner = match alloc.boxed.Box.new(std.alloc.SYSTEM, s) {
        Ok(b) => b
        Err(_e) => core.panic.panic("oom")
    }
    let outer = match alloc.boxed.Box.new(std.alloc.SYSTEM, inner) {
        Ok(b) => b
        Err(_e) => core.panic.panic("oom")
    }
    let x = *outer
    core.mem.drop(x)
    core.mem.drop(outer)
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [alloc] panics may
    t.bad()
    Ok(())
end t.main
