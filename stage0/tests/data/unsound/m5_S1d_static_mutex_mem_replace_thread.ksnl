static t.M: std.sync.Mutex<&'static u64> = std.sync.Mutex.new(&7u64)

fn t.main() -> () uses [alloc, io.console, thread] panics may
    let mut v = std.vec.Vec.new()
    v.push(42u64).unwrap()
    t.stash(&v[0usize])
    core.mem.drop(v)
    let mut w = std.vec.Vec.new()
    w.push(99u64).unwrap()
    let h = std.thread.spawn(std.alloc.SYSTEM, fn() -> u64 capture [] {
        let g = t.M.lock()
        let n = **g.get()
        core.mem.drop(g)
        n
    }).unwrap()
    t.pr(h.join())
end t.main

fn t.pr(x: u64) -> () uses [alloc, io.console] panics may
    let mut s = std.string.String.new()
    s.push_u64(x).unwrap()
    std.io.print_line(s.as_str()).unwrap()
end t.pr

fn t.stash(x: &u64) -> () uses [thread] panics never
    let mut g = t.M.lock()
    core.mem.drop(core.mem.replace(g.get_mut(), x))
    core.mem.drop(g)
end t.stash

fn t.two(a: &mut u64, b: &mut u64) -> u64 uses [] panics never
    *a = 1u64
    *b = 2u64
    *a
end t.two
