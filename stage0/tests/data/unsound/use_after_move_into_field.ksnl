type t.Wrap
    v: std.vec.Vec<u32>
end t.Wrap

fn t.bad() -> usize uses [] panics never
    let v = std.vec.Vec.new()
    let w = t.Wrap {
        v: v
    }
    let n = v.len()
    core.mem.drop(w)
    n
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
