fn t.a_pick(x: &u32) -> Option<&u32> uses [] panics never
    Some(x)
end t.a_pick

fn t.bad() -> u32 uses [] panics never
    let mut x = 1u32
    let o = t.a_pick(&x)
    x = 2u32
    match o {
        Some(r) => *r
        None => 0u32
    }
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
