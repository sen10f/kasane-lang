// expect: E????
fn t.bad() -> u32 uses [] panics never
    let mut x = 1u32
    let c = fn() -> u32 capture [&mut x] {
        x = x.wrapping_add(1u32)
        *x
    }
    let cr = &c
    let a = cr()
    core.mem.drop(a)
    x
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    core.mem.drop(t.bad())
    Ok(())
end t.main
