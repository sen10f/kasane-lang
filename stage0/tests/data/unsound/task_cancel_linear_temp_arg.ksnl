type t.L linear pub
    v: u32
end t.L

fn t.eat(l: t.L, u: ()) -> () uses [alloc, io.console] panics may
    let t.L {
        v: v
    } = l
    core.mem.drop(u)
    t.say(u64.from_u32(v))
end t.eat

fn t.main() -> () uses [alloc, io.console, suspend] panics may
    std.task.block_on(fn() -> () capture [] {
        let a = std.task.spawn_local(fn() -> () capture [] {
            t.eat(t.L {
                v: 42u32
            }, std.task.yield_now())
        })
        std.task.yield_now()
        a.cancel()
        t.say(0u64)
    })
end t.main

fn t.mk() -> t.L uses [] panics never
    t.L {
        v: 42u32
    }
end t.mk

fn t.say(n: u64) -> () uses [alloc, io.console] panics may
    let mut s = std.string.String.new()
    match s.push_u64(n) {
        Ok(_) => ()
        Err(_e) => core.panic.panic("oom")
    }
    core.mem.drop(std.io.print_line(s.as_str()))
end t.say
