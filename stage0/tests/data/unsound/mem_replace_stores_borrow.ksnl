type t.H
    r: &'static u32
end t.H

fn t.bad() -> u32 uses [] panics never
    let a = 1u32
    let mut x = 2u32
    let mut h = t.H { r: &a }
    let _old = core.mem.replace(&mut h.r, &x)
    x = 3u32
    *h.r
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
