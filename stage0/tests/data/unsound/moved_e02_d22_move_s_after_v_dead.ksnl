// expect: E3060
fn t.consume(s: alloc.string.String) -> () uses [io.console] panics never
    core.mem.drop(std.io.print_line(s.as_str()))
    core.mem.drop(s)
end t.consume

// `s` を `v` (と `v` に入れた `s` への借用) の最後の使用の後に move する正しい形。
fn t.keep['a](v: &mut alloc.vec.Vec<&'a alloc.string.String, std.alloc.System>, s: &'a alloc.string.String) -> &'a alloc.string.String uses [alloc] panics never
    core.mem.drop(v.push(s))
    s
end t.keep

fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console] panics may
    let mut v = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let s = t.mk()
    core.mem.drop(t.keep(&mut v, &s))
    core.mem.drop(t.peek(v[0usize]))
    t.consume(s)
    Ok(())
end t.main

fn t.mk() -> alloc.string.String uses [alloc] panics never
    let mut s = alloc.string.String.new(std.alloc.SYSTEM)
    core.mem.drop(s.push_str("hello, this is a long heap string"))
    s
end t.mk

fn t.peek(s: &alloc.string.String) -> usize uses [io.console] panics never
    core.mem.drop(std.io.print_line(s.as_str()))
    s.len()
end t.peek
