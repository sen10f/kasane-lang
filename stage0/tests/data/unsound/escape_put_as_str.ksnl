fn t.bad() -> usize uses [alloc] panics never
    let mut r = "d"
    {
        let mut x = alloc.string.String.new(std.alloc.SYSTEM)
        core.mem.drop(x.push_str("hello"))
        t.put(&mut r, x.as_str())
    }
    r.len()
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.put['a](o: &mut &'a str, r: &'a str) -> () uses [] panics never
    *o = r
end t.put
