// expect: E3010
fn t.bad() -> u32 uses [] panics never
    let mut x = 1u32
    let r = &mut x
    let c = fn() -> u32 capture [move r] {
        *r
    }
    let x2 = x
    core.mem.drop(x2)
    let a = c()
    core.mem.drop(a)
    x
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    core.mem.drop(t.bad())
    Ok(())
end t.main
