type t.Sq
    side: u64
end t.Sq

trait t.Tag pub
    fn tag(self: &Self) -> &u64 uses [] panics never
end t.Tag

impl t.Tag for t.Sq
fn t.Sq.tag(self: &t.Sq) -> &u64 uses [] panics never impls t.Tag
    &self.side
end t.Sq.tag

fn t.main() -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never
    let mut r: Option<&u64> = None
    {
        let b = alloc.boxed.Box.new(std.alloc.SYSTEM, t.Sq { side: 3u64 })?
        let d: alloc.boxed.Box<dyn t.Tag + 'static, std.alloc.System> = alloc.boxed.Box.into_dyn(b)
        let q = alloc.boxed.Box.as_ref(&d)
        r = Some(q.tag())
    }
    let v = match r {
        Some(x) => *x
        None => 0u64
    }
    core.mem.drop(v)
    Ok(())
end t.main
