type t.Hold[T]
    v: T
end t.Hold

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    let a = 10u32
    let tag = true
    let h = match tag {
        true => t.make(&a)
        false => t.make(&a)
    }
    match h {
        t.Hold {
            v: r
        } => core.mem.drop(*r)
    }
    Ok(())
end t.main

fn t.make(r: &u32) -> t.Hold<&u32> uses [] panics never
    t.Hold {
        v: r
    }
end t.make
