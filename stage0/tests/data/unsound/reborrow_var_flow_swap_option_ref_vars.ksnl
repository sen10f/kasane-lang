fn t.bad() -> u32 uses [] panics never
    let mut x = 1u32
    let mut y = 2u32
    let mut rx: Option<&mut u32> = Some(&mut x)
    let mut ry: Option<&mut u32> = Some(&mut y)
    let rpd = &mut ry
    core.mem.swap(&mut rx, rpd)
    x = 3u32
    match ry {
        Some(r) => *r
        None => 0u32
    }
end t.bad

fn t.main() -> () uses [] panics never
end t.main
