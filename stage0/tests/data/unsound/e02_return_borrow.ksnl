// expect: E3060
type t.H['a]
    r: &'a alloc.string.String
end t.H

fn t.consume(s: alloc.string.String) -> () uses [] panics never
    core.mem.drop(s)
end t.consume

fn t.main() -> Result<(), std.io.Error> uses [alloc] panics never
    let s = alloc.string.String.new(std.alloc.SYSTEM)
    let h = t.wrap(&s)
    t.consume(s)
    let n = h.r.len()
    core.mem.drop(n)
    Ok(())
end t.main

fn t.wrap(s: &alloc.string.String) -> t.H uses [alloc] panics never
    t.H { r: s }
end t.wrap
