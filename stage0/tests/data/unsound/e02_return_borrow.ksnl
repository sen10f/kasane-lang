type t.H['a]
    r: &'a alloc.string.String
end t.H

fn t.consume(s: alloc.string.String) -> () uses [] panics never
    core.mem.drop(s)
end t.consume

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    let s = std.string.String.new()
    let h = t.wrap(&s)
    t.consume(s)
    let n = h.r.len()
    core.mem.drop(n)
    Ok(())
end t.main

fn t.wrap(s: &alloc.string.String) -> t.H uses [] panics never
    t.H {
        r: s
    }
end t.wrap
