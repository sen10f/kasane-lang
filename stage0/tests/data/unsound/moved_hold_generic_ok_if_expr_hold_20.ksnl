// expect: E3060
type t.Hold[T]
    v: T
end t.Hold

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    let a = 10u32
    let h = if true {
        t.Hold { v: &a }
    } else {
        t.Hold { v: &a }
    }
    match h {
        t.Hold { v: r } => core.mem.drop(*r)
    }
    Ok(())
end t.main
