fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console] panics never
    let mut r = "x"
    let o = Some(t.mk())
    match o {
        Some(s) => {
            r = s.as_str()
        }
        None => {
            r = "none"
        }
    }
    core.mem.drop(std.io.print_line(r))
    Ok(())
end t.main

fn t.mk() -> alloc.string.String uses [alloc] panics never
    let mut s = alloc.string.String.new(std.alloc.SYSTEM)
    core.mem.drop(s.push_str("hello world, this is heap memory"))
    s
end t.mk
