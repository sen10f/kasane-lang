type t.Res linear
    id: u32
end t.Res

fn t.bad(c: Option<u32>) -> () uses [] panics never
    match c {
        Some(_) => t.open()
        None => t.open()
    }
    core.mem.drop(1u32)
end t.bad

fn t.close(r: t.Res) -> u32 uses [] panics never
    match r {
        t.Res { id: id } => id
    }
end t.close

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.open() -> t.Res uses [] panics never
    t.Res { id: 1u32 }
end t.open
