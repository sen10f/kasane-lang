type t.Named
    name: std.string.String
end t.Named

fn t.Named.pick(self: &t.Named, other: &str) -> &str uses [] panics never
    if self.name.is_empty() {
        return other
    }
    self.name.as_str()
end t.Named.pick

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
