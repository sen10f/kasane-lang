fn t.dangling(s: &str) -> &str uses [alloc] panics never
    let x = match alloc.string.String.from_str(std.alloc.SYSTEM, s) {
        Ok(v) => v.as_str()
        Err(_e) => ""
    }
    x
end t.dangling

fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console] panics never
    let r = t.dangling("hello world, this is heap memory")
    let mut o = alloc.string.String.new(std.alloc.SYSTEM)
    core.mem.drop(o.push_str("OVERWRITTEN BY ANOTHER ALLOCATION"))
    std.io.print_line(r)
end t.main
