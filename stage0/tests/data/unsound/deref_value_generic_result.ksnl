// expect: E2020
type t.S derive [Clone, Copy] pub
    n: u32
end t.S

fn t.bad(s: t.S) -> u32 uses [] panics never
    let a = t.id(s.n)
    *t.id(a)
end t.bad

fn t.id[T](x: T) -> T uses [] panics never
    x
end t.id

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
