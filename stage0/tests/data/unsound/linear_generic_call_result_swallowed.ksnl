type t.Res linear
    id: u32
end t.Res

fn t.close(r: t.Res) -> u32 uses [] panics never
    match r {
        t.Res { id: id } => id
    }
end t.close

fn t.id[T: linear](x: T) -> T uses [] panics never
    x
end t.id

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.open() -> t.Res uses [] panics never
    t.Res { id: 1u32 }
end t.open

fn t.swallow[T: linear](x: T) -> u32 uses [] panics never
    let y = t.id(x)
    core.mem.drop(&y)
    1u32
end t.swallow
