type t.Raw pub
    p: *const u8
end t.Raw

fn t.mk() -> t.Raw uses [] panics never
    let mut x = 10u8
    t.Raw {
        p: core.ptr.from_mut(&mut x)
    }
end t.mk

fn t.work() -> u32 uses [suspend] panics never
    let r = t.mk()
    std.task.yield_now()
    core.mem.drop(r)
    1u32
end t.work

fn t.main() -> () uses [alloc, suspend, thread] panics may
    let v = std.task.block_on_threads(
        std.alloc.SYSTEM,
        2usize,
        fn() -> u32 capture [] {
            let h = std.task.spawn(
                fn() -> u32 capture [] {
                    t.work()
                },
            )
            h.join_task()
        },
    )
    core.check.eq(v, 1u32)
end t.main
