// expect: E2023
fn t.bad() -> usize uses [] panics never
    let a = [1u32, 2u32, 3u32]
    t.count(&a)
end t.bad

fn t.count(v: &alloc.vec.Vec<u32, std.alloc.System>) -> usize uses [] panics never
    v.len()
end t.count

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
