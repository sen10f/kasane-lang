fn t.main() -> Result<(), std.io.Error> uses [alloc] panics never
    let mut v = alloc.vec.Vec.new(std.alloc.SYSTEM)
    match v.push(1u32) {
        Ok(()) => {
        }
        Err(_) => {
        }
    }
    t.push_hold(&mut v)
    core.mem.drop(v)
    Ok(())
end t.main

fn t.push_hold(v: &mut alloc.vec.Vec<u32, std.alloc.System>) -> () uses [alloc] panics never
    let r = &v.get(0usize)
    match v.push(99u32) {
        Ok(()) => {
        }
        Err(_) => {
        }
    }
    core.mem.drop(*r)
end t.push_hold
