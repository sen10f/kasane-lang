type t.Pair
    a: t.Res
    b: t.Res
end t.Pair

// expect: E3002
type t.Res linear
    id: u32
end t.Res

fn t.bad() -> u32 uses [] panics never
    let r = t.open(1u32)
    let f = fn() -> u32 capture [&r] {
        t.close(*r)
    }
    core.mem.drop(f())
    t.close(r)
end t.bad

fn t.close(r: t.Res) -> u32 uses [] panics never
    let t.Res { id: id } = r
    id
end t.close

fn t.main() -> () uses [] panics never
    core.mem.drop(1u8)
end t.main

fn t.open(n: u32) -> t.Res uses [] panics never
    t.Res { id: n }
end t.open
