// expect: E3010
fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console] panics may
    let mut v = alloc.vec.Vec.new(std.alloc.SYSTEM)
    core.mem.drop(v.push("x"))
    {
        let s = t.mk()
        let p = &mut v
        core.mem.drop(p.push(s.as_str()))
    }
    match v.get(0usize) {
        Some(r) => core.mem.drop(std.io.print_line(*r))
        None => core.mem.drop(std.io.print_line("none"))
    }
    Ok(())
end t.main

fn t.mk() -> alloc.string.String uses [alloc] panics never
    let mut s = alloc.string.String.new(std.alloc.SYSTEM)
    core.mem.drop(s.push_str("hello world, this is heap memory"))
    s
end t.mk
