fn t.bad(v: std.vec.Vec<alloc.string.String>) -> () uses [] panics never
    for s in v {
        t.consume(s)
        t.consume(s)
    }
end t.bad

fn t.consume(s: alloc.string.String) -> () uses [] panics never
    core.mem.drop(s)
end t.consume

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
