// expect: E3010
type t.Pair['a, 'b]
    fst: &'a u32
    snd: &'b u32
end t.Pair

fn t.f['a, 'b](x: &t.Pair<'a, 'b>, _y: &t.Pair<'a, 'b>) -> &'a u32 uses [] panics never
    x.snd
end t.f

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    let a = 1u32
    let b = 2u32
    let p = t.Pair { fst: &a, snd: &b }
    core.mem.drop(*t.f(&p, &p))
    Ok(())
end t.main
