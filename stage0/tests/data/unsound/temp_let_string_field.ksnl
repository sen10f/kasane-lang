type t.S pub
    v: u32
    s: std.string.String
end t.S

fn t.bad() -> usize uses [] panics never
    let r = &t.make().s
    r.as_str().len()
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.make() -> t.S uses [] panics never
    t.S { v: 7u32, s: alloc.string.String.new() }
end t.make
