fn t.id(x: &mut u64) -> &mut u64 uses [] panics never
    x
end t.id

fn t.main() -> () uses [alloc, io.console] panics may
    let mut x = 5u64
    let a = t.wid(t.id, &mut x)
    let b = t.wid(t.id, &mut x)
    t.pr(t.two(a, b))
end t.main

fn t.pr(x: u64) -> () uses [alloc, io.console] panics may
    let mut s = std.string.String.new()
    s.push_u64(x).unwrap()
    std.io.print_line(s.as_str()).unwrap()
end t.pr

fn t.two(a: &mut u64, b: &mut u64) -> u64 uses [] panics never
    *a = 1u64
    *b = 2u64
    *a
end t.two

fn t.wid(f: fn(&mut u64) -> &'static mut u64 uses [] panics never, x: &mut u64) -> &'static mut u64 uses [] panics never
    f(x)
end t.wid
