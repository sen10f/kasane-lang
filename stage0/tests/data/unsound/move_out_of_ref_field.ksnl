// expect: E3002
type t.S
    name: alloc.string.String
end t.S

fn t.consume(s: alloc.string.String) -> () uses [] panics never
    core.mem.drop(s)
end t.consume

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.steal(s: &mut t.S) -> () uses [] panics never
    t.consume(s.name)
end t.steal
