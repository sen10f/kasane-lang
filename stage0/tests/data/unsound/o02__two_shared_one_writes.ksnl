fn t.f(q: &u64, r: &[&mut u64; 1]) -> u64 uses [] panics may
    let x = *q
    *r[0usize] = 5u64
    x.wrapping_add(*q)
end t.f

fn t.main() -> () uses [alloc, io.console] panics may
    let mut a = 1u64
    let arr = [&mut a]
    let q: &u64 = &*arr[0usize]
    t.pr(t.f(q, &arr))
end t.main

fn t.pr(x: u64) -> () uses [alloc, io.console] panics may
    let mut s = std.string.String.new()
    s.push_u64(x).unwrap()
    std.io.print_line(s.as_str()).unwrap()
end t.pr
