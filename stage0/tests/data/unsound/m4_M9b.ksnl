fn t.main() -> () uses [alloc, io.console] panics may
    let mut v = std.vec.Vec.new()
    v.push(5u64).unwrap()
    let k = 1u64
    let mut f = fn(_d: &u64) -> &u64 capture [&mut v] {
        for _i in core.iter.range(0u64, 1000u64) {
            v.push(9u64).unwrap()
        }
        &v[0usize]
    }
    let a = f(&k)
    let b = f(&k)
    t.pr(*a)
    t.pr(*b)
end t.main

fn t.pr(x: u64) -> () uses [alloc, io.console] panics may
    let mut s = std.string.String.new()
    s.push_u64(x).unwrap()
    std.io.print_line(s.as_str()).unwrap()
end t.pr
