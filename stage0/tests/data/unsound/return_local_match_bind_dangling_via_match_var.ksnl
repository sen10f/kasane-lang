// expect: E3030
// 言い換え穴: `match v.get(0) { Some => r, None => r }` は E3030（ローカル tmp への参照 r を返す）だが、
// `match &tmp { rr => match v.get(0) { Some(_q) => rr, None => rr } }` で変数を 1 段束縛するとすり抜ける。
// 戻り値 &u32 は実際にはローカル `tmp` へのダングル参照。main で *r を読むとダングル参照を読む。
fn t.bad(v: &[u32]) -> &u32 uses [] panics never
    let tmp = 3u32
    match &tmp {
        rr => match v.get(0usize) {
            Some(_q) => rr
            None => rr
        }
    }
end t.bad

fn t.main() -> Result<(), std.io.Error> uses [io.console] panics never
    Ok(())
end t.main
