// expect: E2023
fn t.first(v: &alloc.vec.Vec<alloc.string.String, std.alloc.System>) -> () uses [] panics may
    match v.get(0usize) {
        Some(s) => core.mem.drop(s.len())
        None => ()
    }
end t.first

fn t.main() -> () uses [alloc] panics may
    let mut v: alloc.vec.Vec<u64, std.alloc.System> = alloc.vec.Vec.new(std.alloc.SYSTEM)
    core.mem.drop(v.push(4096u64))
    t.first(&v)
end t.main
