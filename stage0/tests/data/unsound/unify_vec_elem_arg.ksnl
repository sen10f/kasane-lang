fn t.first(v: &std.vec.Vec<alloc.string.String>) -> () uses [] panics never
    match v.get(0usize) {
        Some(s) => core.mem.drop(s.len())
        None => ()
    }
end t.first

fn t.main() -> () uses [alloc] panics never
    let mut v: std.vec.Vec<u64> = std.vec.Vec.new()
    core.mem.drop(v.push(4096u64))
    t.first(&v)
end t.main
