// expect: E4001
fn t.loud() -> u32 uses [io.console] panics may
    core.mem.drop(std.io.print_line("LOUD"))
    core.panic.panic("PANIC")
end t.loud

fn t.main() -> () uses [] panics never
    core.mem.drop(t.pick(false))
end t.main

fn t.pick(c: bool) -> u32 uses [] panics never
    let p: fn() -> u32 uses [] panics never = if c {
        t.quiet
    } else {
        t.loud
    }
    p()
end t.pick

fn t.quiet() -> u32 uses [] panics never
    1u32
end t.quiet
