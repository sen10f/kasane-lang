fn t.consume(s: alloc.string.String) -> () uses [] panics never
    core.mem.drop(s)
end t.consume

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

test t.main.test_twice
    let s: alloc.string.String = std.string.String.new()
    t.consume(s)
    t.consume(s)
end t.main.test_twice
