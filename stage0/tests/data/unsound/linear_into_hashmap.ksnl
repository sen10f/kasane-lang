type t.Res linear
    id: u32
end t.Res

fn t.bad() -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never
    let mut m = alloc.collections.HashMap.new(std.alloc.SYSTEM)
    match m.insert(1u32, t.open()) {
        Ok(_) => Ok(())
        Err(e) => Err(e)
    }
end t.bad

fn t.check(n: u32) -> Result<u32, std.net.Error> uses [] panics never
    Ok(n)
end t.check

fn t.close(r: t.Res) -> u32 uses [] panics never
    match r {
        t.Res { id: id } => id
    }
end t.close

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.open() -> t.Res uses [] panics never
    t.Res { id: 1u32 }
end t.open
