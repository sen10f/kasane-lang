// expect: E3003
type t.Res linear
    id: u32
end t.Res

fn t.bad() -> u32 uses [] panics never
    let r = t.open()
    let f = fn () -> u32 capture [move r] {
        1u32
    }
    f()
end t.bad

fn t.close(r: t.Res) -> u32 uses [] panics never
    match r {
        t.Res { id: id } => id
    }
end t.close

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.open() -> t.Res uses [] panics never
    t.Res { id: 1u32 }
end t.open
