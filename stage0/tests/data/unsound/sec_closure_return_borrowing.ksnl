fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console] panics never
    let g = t.mkf()
    let other = t.mk2()
    std.io.print_line(g())?
    core.mem.drop(other)
    Ok(())
end t.main

fn t.mk() -> alloc.string.String uses [alloc] panics never
    let mut s = alloc.string.String.new(std.alloc.SYSTEM)
    core.mem.drop(s.push_str("hello, this is a long heap string"))
    s
end t.mk

fn t.mk2() -> alloc.string.String uses [alloc] panics never
    let mut s = alloc.string.String.new(std.alloc.SYSTEM)
    core.mem.drop(s.push_str("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"))
    s
end t.mk2

fn t.mkf() -> fn() -> &'static str uses [] panics never uses [alloc] panics never
    let s = t.mk()
    fn() -> &'static str capture [&s] {
        s.as_str()
    }
end t.mkf
