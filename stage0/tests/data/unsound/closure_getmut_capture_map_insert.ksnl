fn t.bad() -> u32 uses [alloc] panics never
    let mut m = std.collections.HashMap.new()
    core.mem.drop(m.insert(1u32, std.string.String.new()))
    let r = m.get_mut(&1u32)
    if let Some(v) = r {
        let c = fn() -> usize capture [&mut v] {
            0usize
        }
        core.mem.drop(m.insert(2u32, std.string.String.new()))
        core.mem.drop(c())
    }
    0u32
end t.bad
