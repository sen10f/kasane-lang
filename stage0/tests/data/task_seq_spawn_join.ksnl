fn t.main() -> () uses [alloc, io.console, suspend] panics may
    let s = std.task.block_on(fn() -> u64 capture [] {
        let mut i = 0u64
        let mut acc = 0u64
        while i < 200_000u64 {
            let a = std.task.spawn_local(fn() -> u64 capture [move i] {
                i
            })
            acc = acc.wrapping_add(a.join_task())
            i = i + 1u64
        }
        acc
    })
    t.show(s)
end t.main

fn t.show(x: u64) -> () uses [alloc, io.console] panics never
    let mut s = std.string.String.new()
    core.mem.drop(s.push_u64(x))
    core.mem.drop(std.io.print_line(s.as_str()))
end t.show
