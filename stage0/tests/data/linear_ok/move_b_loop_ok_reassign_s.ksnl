type t.S pub
    v: u32
end t.S

fn t.eat(s: t.S) -> u32 uses [] panics never
    s.v
end t.eat

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    let mut s = t.S { v: 1u32 }
    let mut i = 0u8
    while i < 2u8 {
        core.mem.drop(t.eat(s))
        s = t.S { v: 1u32 }
        i = i.wrapping_add(1u8)
    }
    core.mem.drop(t.eat(s))
    Ok(())
end t.main
