fn t.consume(s: alloc.string.String) -> () uses [] panics never
    core.mem.drop(s)
end t.consume

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    let mut s = alloc.string.String.new(std.alloc.SYSTEM)
    for _ in core.iter.range(0u8, 2u8) {
        core.mem.drop(t.consume(s))
        s = alloc.string.String.new(std.alloc.SYSTEM)
    }
    core.mem.drop(t.consume(s))
    Ok(())
end t.main
