fn t.consume(s: std.string.String) -> () uses [] panics never
    core.mem.drop(s)
end t.consume

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    let mut s = std.string.String.new()
    for _ in core.iter.range(0u8, 2u8) {
        core.mem.drop(t.consume(s))
        s = std.string.String.new()
    }
    core.mem.drop(t.consume(s))
    Ok(())
end t.main
