fn t.consume(s: alloc.string.String) -> () uses [alloc] panics never
    core.mem.drop(s)
end t.consume

fn t.main() -> Result<(), std.io.Error> uses [alloc] panics may
    let s = alloc.string.String.new(std.alloc.SYSTEM)
    let mut i = 0u8
    loop {
        i = i.wrapping_add(1u8)
        if i > 2u8 {
            core.mem.drop(t.consume(s))
            break
        }
    }
    Ok(())
end t.main
