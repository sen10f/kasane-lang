type t.Res linear
    id: u32
end t.Res

fn t.check(n: u32) -> Result<u32, std.net.Error> uses [] panics never
    Ok(n)
end t.check

fn t.close(r: t.Res) -> u32 uses [] panics never
    match r {
        t.Res {
            id: id
        } => id
    }
end t.close

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.ok(n: u32) -> u32 uses [] panics never
    let mut r = t.open()
    for _ in core.iter.range(0u32, n) {
        r = t.step(r)
    }
    t.close(r)
end t.ok

fn t.open() -> t.Res uses [] panics never
    t.Res {
        id: 1u32
    }
end t.open

fn t.step(r: t.Res) -> t.Res uses [] panics never
    r
end t.step
