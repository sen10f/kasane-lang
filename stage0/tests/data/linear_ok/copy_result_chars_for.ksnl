fn t.c(s: &str) -> usize uses [alloc] panics never
    let mut v: std.vec.Vec<char> = std.vec.Vec.new()
    for c in s.chars() {
        match v.push(c) {
            Ok(_u) => ()
            Err(_e) => ()
        }
    }
    let n = v.len()
    core.mem.drop(v)
    n
end t.c

fn t.main() -> Result<(), std.io.Error> uses [alloc] panics never
    core.mem.drop(t.c("abc"))
    Ok(())
end t.main
