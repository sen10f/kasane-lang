fn t.f(c: bool, o: Option<u32>) -> u8 uses [] panics never
    if c {
        return 1u8
    }
    match o {
        Some(v) => {
            if v > 3u32 {
                return 2u8
            }
            3u8
        }
        None => 0u8
    }
end t.f

fn t.g(n: u32) -> u8 uses [] panics never
    let h = fn(k: u32) -> u8 capture [] {
        if k == 0u32 {
            return 9u8
        }
        7u8
    }
    loop {
        if n > 0u32 {
            return h(n)
        }
        return 5u8
    }
end t.g

fn t.main() -> () uses [] panics never
    core.mem.drop(t.f(true, Some(1u32)))
    core.mem.drop(t.g(2u32))
end t.main
