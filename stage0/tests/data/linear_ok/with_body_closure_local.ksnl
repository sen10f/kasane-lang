// expect-accept
type t.Res linear
    id: u32
end t.Res

fn t.Res.get(self: &t.Res) -> u32 uses [] panics never
    self.id
end t.Res.get

fn t.Res.shut(self: t.Res) -> () uses [] panics never
    let t.Res { id: id } = self
    core.mem.drop(id)
end t.Res.shut

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.ok() -> u32 uses [] panics never
    with r = t.Res { id: 1u32 } close r.shut() {
        let c = fn() -> u32 capture [&r] {
            r.get()
        }
        c()
    }
end t.ok
