fn t.main() -> Result<(), std.io.Error> uses [alloc] panics never
    let tmp = t.mk()
    let r = t.same(&tmp)
    let z = t.mk()
    core.mem.drop(t.peek(r))
    core.mem.drop(tmp)
    core.mem.drop(z)
    Ok(())
end t.main

fn t.mk() -> std.string.String uses [alloc] panics never
    let mut s = std.string.String.new()
    core.mem.drop(s.push_str("x"))
    s
end t.mk

fn t.peek(s: &std.string.String) -> usize uses [] panics never
    s.len()
end t.peek

fn t.same(s: &std.string.String) -> &std.string.String uses [] panics never
    s
end t.same
