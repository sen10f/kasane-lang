// expect-accept
// String.as_bytes() で &[u8] を得て from_utf8 で &str を得、Ok 腕で使用、Err 腕で return。
// その後 s.push_str が可のはず（NLL: borrow は s の使用終了とともに終わる）。
// Vec 版 (found/fp_regress_from_utf8_borrow) とは別の形（String + as_bytes + 使用後）。
enum t.Error derive [Debug, Clone, Copy, PartialEq, Eq, From] pub
    Utf8(core.str.Utf8Error)
    Io(std.io.Error)
    Alloc(alloc.alloc.AllocError)
end t.Error

fn t.main() -> Result<(), t.Error> uses [alloc, io.console] panics may
    let mut s = alloc.string.String.from_str(std.alloc.SYSTEM, "hello")?
    match core.str.from_utf8(s.as_bytes()) {
        Ok(text) => {
            core.check.eq(text, "hello")
        }
        Err(error) => {
            return Err(t.Error.Utf8(error))
        }
    }
    // s への borrow は from_utf8 の使用とともに終わるので push_str が可（NLL）
    core.mem.drop(s.push_str(" world")?)
    match std.io.print_line("string from_utf8 nll ok") {
        Ok(_done) => {
        }
        Err(error) => {
            return Err(t.Error.Io(error))
        }
    }
    core.mem.drop(s)
    Ok(())
end t.main
