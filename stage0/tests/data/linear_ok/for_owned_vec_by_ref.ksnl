fn t.count(v: &std.vec.Vec<u8>) -> usize uses [] panics never
    v.len()
end t.count

fn t.main() -> () uses [] panics never
    core.mem.drop(1u8)
end t.main

fn t.run() -> usize uses [] panics never
    let v: std.vec.Vec<u8> = std.vec.Vec.new()
    let mut n = 0usize
    for _x in v.iter() {
        n = n.wrapping_add(1usize)
    }
    n.wrapping_add(t.count(&v))
end t.run
