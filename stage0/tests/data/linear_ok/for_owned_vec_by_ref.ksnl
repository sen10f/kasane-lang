fn t.count(v: &alloc.vec.Vec<u8, std.alloc.System>) -> usize uses [] panics never
    v.len()
end t.count

fn t.main() -> () uses [] panics never
    core.mem.drop(1u8)
end t.main

fn t.run() -> usize uses [] panics never
    let v: alloc.vec.Vec<u8, std.alloc.System> = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let mut n = 0usize
    for _x in v.iter() {
        n = n.wrapping_add(1usize)
    }
    n.wrapping_add(t.count(&v))
end t.run
