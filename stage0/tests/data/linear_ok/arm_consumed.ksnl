type t.L linear pub
    v: u32
end t.L

fn t.eat(l: t.L) -> () uses [] panics never
    let t.L {
        v: v
    } = l
    core.mem.drop(v)
end t.eat

fn t.main() -> () uses [] panics never
    core.mem.drop(t.run(Some(t.L {
        v: 1u32
    })))
end t.main

fn t.run(o: Option<t.L>) -> u8 uses [] panics never
    match o {
        Some(l) => {
            t.eat(l)
            1u8
        }
        None => 0u8
    }
end t.run
