fn t.f(v: &mut alloc.vec.Vec<u8, std.alloc.System>, o: Option<u32>) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never
    v.push(1u8)?
    core.mem.drop(v.pop())
    core.mem.drop(match o {
        Some(x) => x
        None => 5u32
    })
    if let Some(_) = o {
        ()
    }
    Ok(())
end t.f

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
