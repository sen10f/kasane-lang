// Pair を分解して両方の線形な欄を消費すれば、一時値の欄漏れにはならない。
type t.Pair
    a: t.Res
    b: t.Res
end t.Pair

type t.Res linear
    id: u32
end t.Res

fn t.close(r: t.Res) -> u32 uses [] panics never
    let t.Res { id: id } = r
    id
end t.close

fn t.good() -> u32 uses [] panics never
    let t.Pair { a: a, b: b } = t.mkpair()
    core.mem.drop(t.close(a))
    core.mem.drop(t.close(b))
    0u32
end t.good

fn t.main() -> () uses [] panics never
    core.mem.drop(1u8)
end t.main

fn t.mkpair() -> t.Pair uses [] panics never
    t.Pair { a: t.open(1u32), b: t.open(2u32) }
end t.mkpair

fn t.open(n: u32) -> t.Res uses [] panics never
    t.Res { id: n }
end t.open
