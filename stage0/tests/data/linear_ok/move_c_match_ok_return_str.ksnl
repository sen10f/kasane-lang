fn t.consume(s: alloc.string.String) -> () uses [] panics never
    core.mem.drop(s)
end t.consume

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    let s = alloc.string.String.new(std.alloc.SYSTEM)
    let o: Option<u8> = Some(1u8)
    match o {
        Some(_) => {
            core.mem.drop(t.consume(s))
            return Ok(())
        }
        None => core.mem.drop(0u8)
    }
    core.mem.drop(s.len())
    Ok(())
end t.main
