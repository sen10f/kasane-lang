fn t.eat(s: std.string.String) -> () uses [] panics never
    core.mem.drop(s)
end t.eat

fn t.main() -> Result<(), std.io.Error> uses [alloc] panics may
    {
        let b = t.mk()
        core.check.eq(t.peek(&b), 1usize)
    }
    {
        let b = t.mk()
        t.eat(b)
    }
    Ok(())
end t.main

fn t.mk() -> std.string.String uses [alloc] panics never
    let mut s = std.string.String.new()
    core.mem.drop(s.push_str("x"))
    s
end t.mk

fn t.peek(s: &std.string.String) -> usize uses [] panics never
    s.len()
end t.peek
