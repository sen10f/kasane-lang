fn t.main() -> Result<(), core.str.Utf8Error> uses [] panics never
    let mut buf = std.vec.Vec.new()
    let text = core.str.from_utf8(buf.as_slice())?
    core.mem.drop(text.len())
    core.mem.drop(t.read(&buf)?)
    core.mem.drop(t.read_match(&buf)?)
    Ok(())
end t.main

fn t.read(buf: &std.vec.Vec<u8>) -> Result<usize, core.str.Utf8Error> uses [] panics never
    let text = core.str.from_utf8(buf.as_slice())?
    Ok(text.len())
end t.read

fn t.read_match(buf: &std.vec.Vec<u8>) -> Result<usize, core.str.Utf8Error> uses [] panics never
    let text = match core.str.from_utf8(buf.as_slice()) {
        Ok(s) => s
        Err(e) => return Err(e)
    }
    Ok(text.len())
end t.read_match
