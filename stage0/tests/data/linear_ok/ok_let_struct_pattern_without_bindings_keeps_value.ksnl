// expect-accept
// `let` の分解で束縛しない欄 (`_`) だけなら、値は move されず、線形な値は分解で消費されるので、
// 同じ形の `match` と `if let` と同じく `r` は分解のあとでも残る (E3002 にならない)。
type t.Res linear
    id: u32
end t.Res

fn t.Res.shut(self: t.Res) -> () uses [] panics never
    let t.Res { id: id } = self
    core.mem.drop(id)
end t.Res.shut

fn t.a() -> () uses [] panics never
    let r = t.Res { id: 1u32 }
    let t.Res { id: _ } = r
    r.shut()
end t.a

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
