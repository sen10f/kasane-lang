type t.W
    n: u32
end t.W

fn t.W.dup(self: &t.W) -> alloc.string.String uses [] panics never
    t.mk()
end t.W.dup

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.mk() -> alloc.string.String uses [] panics never
    std.string.String.new()
end t.mk

fn t.ok() -> usize uses [] panics never
    let w = t.W { n: 1u32 }
    let n = w.dup().as_str().len()
    n
end t.ok
