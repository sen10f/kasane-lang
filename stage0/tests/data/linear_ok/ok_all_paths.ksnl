type t.Res linear
    id: u32
end t.Res

fn t.check(n: u32) -> Result<u32, std.net.Error> uses [] panics never
    Ok(n)
end t.check

fn t.close(r: t.Res) -> u32 uses [] panics never
    match r {
        t.Res {
            id: id
        } => id
    }
end t.close

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.ok(flag: bool) -> u32 uses [] panics never
    let r = t.open()
    if flag {
        t.close(r)
    } else {
        let n = t.close(r)
        n.wrapping_add(1u32)
    }
end t.ok

fn t.open() -> t.Res uses [] panics never
    t.Res {
        id: 1u32
    }
end t.open
