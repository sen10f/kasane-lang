type t.S
    name: alloc.string.String
    n: u32
end t.S

fn t.borrow_only(s: &t.S) -> usize uses [] panics never
    t.peek(&(*s).name).wrapping_add(t.peek(&s.name))
end t.borrow_only

fn t.consume(s: alloc.string.String) -> () uses [] panics never
    core.mem.drop(s)
end t.consume

fn t.copy_out(r: &u32, s: &t.S) -> u32 uses [] panics never
    let a = *r
    let b = (*s).n
    a.wrapping_add(b).wrapping_add(*r)
end t.copy_out

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.mk() -> alloc.string.String uses [] panics never
    std.string.String.new()
end t.mk

fn t.peek(s: &alloc.string.String) -> usize uses [] panics never
    s.len()
end t.peek
