fn t.get(x: &u64) -> u64 uses [] panics never
    *x
end t.get

fn t.main() -> () uses [] panics may
    t.run(t.get)
end t.main

fn t.run(f: fn(&u64) -> u64 uses [] panics never) -> () uses [] panics may
    let mut y = 5u64
    let q = f(&y)
    y = 7u64
    core.check.eq(q, 5u64)
    core.check.eq(y, 7u64)
end t.run
