fn t.f_ok(xs: &mut std.vec.Vec<u32>) -> u32 uses [] panics never
    let k = *xs.as_slice().get(0usize).unwrap_or(&0u32)
    xs.clear()
    k
end t.f_ok

fn t.g_ok(xs: &mut std.vec.Vec<u32>) -> u32 uses [] panics never
    let k = xs.as_slice().get(0usize)
    core.mem.drop(*k.unwrap_or(&0u32))
    if let Some(p) = xs.as_mut_slice().get_mut(0usize) {
        *p = 7u32
    }
    0u32
end t.g_ok

fn t.main() -> Result<(), std.io.Error> uses [alloc] panics never
    let mut v = std.vec.Vec.new()
    core.mem.drop(v.push(1u32))
    core.mem.drop(t.f_ok(&mut v))
    core.mem.drop(t.g_ok(&mut v))
    Ok(())
end t.main
