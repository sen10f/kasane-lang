fn t.f_ok(xs: &mut alloc.vec.Vec<u32, std.alloc.System>) -> u32 uses [] panics never
    let k = *xs.as_slice().get(0usize).unwrap_or(&0u32)
    xs.clear()
    k
end t.f_ok

fn t.g_ok(xs: &mut alloc.vec.Vec<u32, std.alloc.System>) -> u32 uses [] panics never
    let k = xs.as_slice().get(0usize)
    core.mem.drop(*k.unwrap_or(&0u32))
    match xs.as_mut_slice().get_mut(0usize) {
        Some(p) => {
            *p = 7u32
        }
        None => ()
    }
    0u32
end t.g_ok

fn t.main() -> Result<(), std.io.Error> uses [alloc] panics never
    let mut v = alloc.vec.Vec.new(std.alloc.SYSTEM)
    core.mem.drop(v.push(1u32))
    core.mem.drop(t.f_ok(&mut v))
    core.mem.drop(t.g_ok(&mut v))
    Ok(())
end t.main
