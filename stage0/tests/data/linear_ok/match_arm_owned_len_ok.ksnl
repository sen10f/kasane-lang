fn t.count(s: &str) -> usize uses [alloc] panics never
    let n = match std.string.String.from_str(s) {
        Ok(v) => v.as_str().len()
        Err(_) => 0usize
    }
    n
end t.count

fn t.main() -> Result<(), std.io.Error> uses [io.console] panics never
    std.io.print_line("main")
end t.main
