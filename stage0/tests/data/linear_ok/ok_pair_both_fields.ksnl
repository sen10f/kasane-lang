type t.Pair
    a: t.Res
    b: t.Res
end t.Pair

type t.Res linear
    id: u32
end t.Res

fn t.both(p: t.Pair) -> u32 uses [] panics never
    let x = t.close(p.a)
    let y = t.close(p.b)
    x.wrapping_add(y)
end t.both

fn t.close(r: t.Res) -> u32 uses [] panics never
    let t.Res { id: id } = r
    id
end t.close

fn t.main() -> () uses [] panics never
    core.mem.drop(1u8)
end t.main
