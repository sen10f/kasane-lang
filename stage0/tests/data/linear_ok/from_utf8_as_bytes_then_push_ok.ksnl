// expect-accept
// core.str.as_bytes(s) で &[u8] を借り、最後の使用後 s.push_str が可（NLL）。
// from_utf8 を介さない as_bytes 単独の形。
enum t.Error derive [Debug, Clone, Copy, PartialEq, Eq, From] pub
    Io(std.io.Error)
    Alloc(alloc.alloc.AllocError)
    Utf8(core.str.Utf8Error)
end t.Error

fn t.main() -> Result<(), t.Error> uses [alloc, io.console] panics may
    let mut s = alloc.string.String.from_str(std.alloc.SYSTEM, "hello")?
    let b = core.str.as_bytes(s.as_str())
    core.check.eq(core.str.len(core.str.from_utf8(b)?), 5usize)
    // b (&s) の最後の使用とともに s への borrow が終わるので push_str が可（NLL）
    core.mem.drop(s.push_str(" world")?)
    core.check.eq(s.as_str(), "hello world")
    match std.io.print_line("as_bytes mut ok") {
        Ok(_done) => {
        }
        Err(error) => {
            return Err(t.Error.Io(error))
        }
    }
    core.mem.drop(s)
    Ok(())
end t.main
