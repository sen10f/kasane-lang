type t.Res linear
    id: u32
end t.Res

fn t.Res.finish(self: t.Res) -> u32 uses [] panics never
    let t.Res { id: id } = self
    id
end t.Res.finish

fn t.main() -> () uses [] panics never
    core.mem.drop(t.run())
end t.main

fn t.open(n: u32) -> t.Res uses [] panics never
    t.Res { id: n }
end t.open

fn t.run() -> u32 uses [] panics never
    t.open(1u32).finish()
end t.run
