// (1)+(2) 組み合わせ: f64 subnormal を HashMap の値に入れて iter 表示、ネイティブ SEGV の再現
// expect-accept
fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console] panics never
    let mut out = alloc.string.String.new(std.alloc.SYSTEM)
    let mut m = alloc.collections.HashMap.new(std.alloc.SYSTEM)
    let s = core.num.f64.from_bits(0x0000000000000001u64)
    match m.insert("k", s) {
        Ok(_o) => ()
        Err(e) => core.mem.drop(e)
    }
    let mut it = m.iter()
    loop {
        match it.next() {
            Some(pair) => {
                let (_kk, vv) = pair
                match alloc.fmt.write(&mut out, vv) {
                    Ok(_u) => ()
                    Err(e) => core.mem.drop(e)
                }
            }
            None => break
        }
    }
    match out.push_str("\n") {
        Ok(_u) => ()
        Err(e) => core.mem.drop(e)
    }
    std.io.print_line(out.as_str())?
    Ok(())
end t.main
