type t.L linear pub
    v: u32
end t.L

fn t.eat(l: t.L) -> () uses [] panics never
    let t.L {
        v: v
    } = l
    core.mem.drop(v)
end t.eat

fn t.main() -> () uses [] panics never
    let b = t.pick(Some(t.L {
        v: 1u32
    }))
    t.eat(b)
end t.main

fn t.pick(o: Option<t.L>) -> t.L uses [] panics never
    match o {
        Some(l) => l
        None => t.L {
            v: 0u32
        }
    }
end t.pick
