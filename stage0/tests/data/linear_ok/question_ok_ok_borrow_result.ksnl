enum t.Error derive [Debug, Clone, Copy, PartialEq, Eq, From] pub
    Alloc(alloc.alloc.AllocError)
end t.Error

fn t.get_str(s: &std.string.String) -> Result<&str, t.Error> uses [] panics never
    Ok(s.as_str())
end t.get_str

fn t.main() -> Result<(), t.Error> uses [] panics never
    let s = std.string.String.new()
    let r = t.get_str(&s)?
    core.mem.drop(r)
    core.mem.drop(s)
    Ok(())
end t.main
