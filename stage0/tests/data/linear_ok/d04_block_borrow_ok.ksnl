fn t.main() -> Result<(), std.io.Error> uses [alloc] panics may
    let b = t.mk()
    let r = &b
    core.mem.drop(t.peek(r))
    core.mem.drop(b)
    Ok(())
end t.main

fn t.mk() -> alloc.string.String uses [alloc] panics never
    let mut s = alloc.string.String.new(std.alloc.SYSTEM)
    core.mem.drop(s.push_str("x"))
    s
end t.mk

fn t.peek(s: &alloc.string.String) -> usize uses [] panics never
    s.len()
end t.peek
