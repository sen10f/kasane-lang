fn t.f(p: &[u8], c: bool) -> Option<&u8> uses [] panics never
    let v: [u8; 2] = [1, 2]
    if c {
        let x = v.first()
        core.mem.drop(x)
    } else {
        let x = p.first()
        return x
    }
    p.first()
end t.f

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
