fn t.forward[F: core.ops.Fn<(), u32, E, P>, E: uses, P: panics](f: F, g: F) -> u32 uses [E] panics P
    core.mem.drop(t.id(g))
    f.call(())
end t.forward

fn t.id[F: core.ops.Fn<(), u32, E, P>, E: uses, P: panics](f: F) -> u32 uses [E] panics P
    f.call(())
end t.id

fn t.main() -> u32 uses [] panics never
    core.mem.drop(t.forward(t.quiet, t.quiet))
    0u32
end t.main

fn t.quiet() -> u32 uses [] panics never
    1u32
end t.quiet
