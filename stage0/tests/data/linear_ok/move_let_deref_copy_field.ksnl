fn t.f(x: &(std.string.String, usize)) -> usize uses [] panics never
    let (n, k) = x
    t.peek(n).wrapping_add(*k)
end t.f

fn t.main() -> () uses [] panics never
    let x = (std.string.String.new(), 1usize)
    let r = t.f(&x)
    core.mem.drop(r)
end t.main

fn t.peek(s: &std.string.String) -> usize uses [] panics never
    s.len()
end t.peek
