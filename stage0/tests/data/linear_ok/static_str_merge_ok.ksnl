fn t.main() -> Result<(), std.io.Error> uses [alloc, env, thread] panics may
    let a = match std.env.arg(0usize) {
        Some(t) => t
        None => "none"
    }
    core.mem.drop(t.work(a))
    let b = if a == "x" {
        "p"
    } else {
        "q"
    }
    core.mem.drop(t.work(b))
    let c: &'static str = std.env.arg(1usize).unwrap_or("x")
    core.mem.drop(t.work(c))
    let d = {
        match std.env.arg(2usize) {
            Some(r) => r
            None => "z"
        }
    }
    let spawned = std.thread.spawn(
        std.alloc.SYSTEM,
        fn() -> usize capture [move d] {
            t.work(d)
        },
    )
    match spawned {
        Ok(handle) => core.mem.drop(handle.join())
        Err(_e) => core.panic.panic("spawn failed")
    }
    Ok(())
end t.main

fn t.work(token: &'static str) -> usize uses [] panics never
    token.len()
end t.work
