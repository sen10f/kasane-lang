type t.Res linear
    id: u32
end t.Res

fn t.good(flag: Option<u32>) -> u32 uses [] panics never
    with r = t.open(1u32) close match flag {
        Some(_) => t.shut(r)
        None => t.shut(r)
    } {
        core.mem.drop(0u8)
    }
    0u32
end t.good

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.open(n: u32) -> t.Res uses [] panics never
    t.Res {
        id: n
    }
end t.open

fn t.shut(r: t.Res) -> () uses [] panics never
    let t.Res {
        id: id
    } = r
    core.mem.drop(id)
end t.shut
