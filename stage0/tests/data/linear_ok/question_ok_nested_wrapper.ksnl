enum t.Error derive [Debug, Clone, PartialEq, From] pub
    Alloc(alloc.alloc.AllocError)
end t.Error

fn t.inner(s: &std.string.String) -> Result<&str, t.Error> uses [] panics never
    Ok(s.as_str())
end t.inner

fn t.main() -> Result<(), t.Error> uses [alloc] panics never
    let s = std.string.String.from_str("hello")?
    let r = t.outer(&s)?
    core.mem.drop(r)
    core.mem.drop(s)
    Ok(())
end t.main

fn t.outer(s: &std.string.String) -> Result<&str, t.Error> uses [] panics never
    t.inner(s)
end t.outer
