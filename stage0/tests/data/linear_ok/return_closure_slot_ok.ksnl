// ok: 位置どおりに返す閉包
fn t.f['a, 'b](x: &'a u32, y: &'b u32) -> (&'a u32, &'b u32) uses [] panics never
    let c = fn() -> (&'a u32, &'b u32) capture [move x, move y] {
        (x, y)
    }
    t.id(c())
end t.f

fn t.id[T](x: T) -> T uses [] panics never
    x
end t.id

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
