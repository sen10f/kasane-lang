fn t.bad() -> u32 uses [] panics never
    let mut x = 1u32
    let (_a, n) = t.pair(&x)
    let r = &x
    let rr = &r
    let k = **rr
    let c = fn() -> u32 capture [&x] {
        x
    }
    let m = c()
    let i = t.id(7u32)
    x = 2u32
    n.wrapping_add(k).wrapping_add(m).wrapping_add(i)
end t.bad

fn t.id[T](v: T) -> T uses [] panics never
    v
end t.id

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main

fn t.pair(r: &u32) -> (&u32, u32) uses [] panics never
    (r, 1u32)
end t.pair
