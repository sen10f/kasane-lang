fn t.main() -> Result<(), std.io.Error> uses [] panics may
    let mut m = alloc.collections.HashMap.new(std.alloc.SYSTEM)
    let mut x = 1u8
    let mut y = 2u8
    match m.insert(1u8, &x) {
        Ok(_u) => 0u8
        Err(_e) => 1u8
    }
    let r = match m.get(1u8) {
        Some(rr) => rr
        None => &y
    }
    x = 2u8
    core.check.eq(*r, 1u8)
    Ok(())
end t.main
