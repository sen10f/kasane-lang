trait t.Shape
    fn area(self: &Self) -> i64 uses [] panics never
end t.Shape

type t.Sq
    side: i64
end t.Sq

impl t.Shape for t.Sq
fn t.Sq.area(self: &t.Sq) -> i64 uses [] panics never impls t.Shape
    self.side
end t.Sq.area

fn t.f(b: &alloc.boxed.Box<dyn t.Shape, std.alloc.System>) -> i64 uses [] panics never
    b.area()
end t.f

fn t.main() -> Result<(), std.io.Error> uses [io.console] panics may
    std.io.print_line("x")
end t.main
