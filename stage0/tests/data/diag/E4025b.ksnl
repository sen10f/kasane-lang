trait t.Act
    fn act(self: &Self) -> u8 uses [io.console] panics never
end t.Act

type t.Ui
    n: u8
end t.Ui

impl t.Act for t.Ui
fn t.Ui.act(self: &t.Ui) -> u8 uses [] panics never impls t.Act
    self.n
end t.Ui.act

fn t.main() -> Result<(), std.io.Error> uses [] panics never
    Ok(())
end t.main
