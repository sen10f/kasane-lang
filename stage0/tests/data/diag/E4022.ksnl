fn t.body() -> () uses [suspend] panics may
    let a = std.task.spawn_local(
        fn() -> u32 capture [] {
            t.wait_one()
        },
    )
    a.cancel()
end t.body

fn t.main() -> () uses [suspend] panics may
    std.task.block_on(fn() -> () capture [] {
        t.body()
    })
end t.main

fn t.wait_one() -> u32 uses [suspend] panics never
    std.task.yield_now()
    1u32
end t.wait_one
