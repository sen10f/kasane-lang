type t.Rf
    r: &'static i64
end t.Rf

trait t.Shape
    fn area(self: &Self) -> i64 uses [] panics never
end t.Shape

type t.Sq
    side: i64
end t.Sq

impl t.Shape for t.Rf
fn t.Rf.area(self: &t.Rf) -> i64 uses [] panics never impls t.Shape
    0i64
end t.Rf.area

impl t.Shape for t.Sq
fn t.Sq.area(self: &t.Sq) -> i64 uses [] panics never impls t.Shape
    self.side
end t.Sq.area

fn t.main() -> Result<(), std.io.Error> uses [io.console] panics never
    std.io.print_line("x")
end t.main

fn t.mk(x: t.Rf) -> Result<alloc.boxed.Box<dyn t.Shape + 'static, std.alloc.System>, alloc.alloc.AllocError> uses [alloc] panics never
    let b = alloc.boxed.Box.new(std.alloc.SYSTEM, x)?
    Ok(alloc.boxed.Box.into_dyn(b))
end t.mk
