trait t.Shape
    fn area(self: &Self) -> i64 uses [] panics never
end t.Shape

type t.Sq
    side: i64
end t.Sq

type t.Tok linear
    n: i64
end t.Tok

impl t.Shape for t.Sq
fn t.Sq.area(self: &t.Sq) -> i64 uses [] panics never impls t.Shape
    self.side
end t.Sq.area

fn t.main() -> Result<(), std.io.Error> uses [io.console] panics never
    std.io.print_line("x")
end t.main

fn t.mk(k: t.Tok) -> Result<std.boxed.Box<t.Tok>, alloc.alloc.AllocError> uses [alloc] panics never
    alloc.boxed.Box.new(std.alloc.SYSTEM, k)
end t.mk
