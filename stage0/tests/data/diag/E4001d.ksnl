trait t.Handler[E: uses, P: panics]
    fn handle(self: &Self) -> () uses [E] panics P
end t.Handler

fn t.main() -> Result<(), std.io.Error> uses [io.console] panics never
    std.io.print_line("x")
end t.main

fn t.run(h: &dyn t.Handler<[io.console], never> + 'static) -> () uses [] panics never
    h.handle()
end t.run
