extern t.qsort(base: *mut i32, n: usize, size: usize, cmp: fn(*const i32, *const i32) -> i32 uses [] panics never) -> () link "qsort"

fn t.c0(a: *const i32, b: *const i32) -> i32 uses [] panics never
    let x = unsafe "cmp" "read" {
        core.ptr.read(a)
    }
    let y = unsafe "cmp" "read" {
        core.ptr.read(b)
    }
    if x < y {
        -1i32
    } else if x > y {
        1i32
    } else {
        0i32
    }
end t.c0

