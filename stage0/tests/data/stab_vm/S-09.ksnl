fn t.main() -> () uses [alloc, io.console] panics may
    match char.try_from_u32(127u32) {
        Some(ch) => {
            let mut s = std.string.String.new()
            s.push_str("U+007F ").unwrap()
            alloc.fmt.debug(&mut s, &ch).unwrap()
            std.io.print_line(s.as_str()).unwrap()
        }
        None => std.io.print_line("none").unwrap()
    }
