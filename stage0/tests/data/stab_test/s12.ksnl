fn t.grab(n: usize, fail: bool) -> usize uses [alloc] panics may
    let mut v: std.vec.Vec<u8> = std.vec.Vec.with_capacity(n).unwrap()
    v.push(1u8).unwrap()
    if fail {
        core.panic.panic("leave it")
    }
    v.len()
end t.grab

fn t.main() -> () uses [] panics never
end t.main

test t.grab.test_a00
    core.check.eq(t.grab(1_000_000_000usize, true), 1usize)
end t.grab.test_a00

