fn t.f() -> u32 uses [] panics never
    1u32
end t.f

fn t.main() -> () uses [] panics never
end t.main

test t.f.test_try_twice
    std.io.print_line("test body started").unwrap()
    if std.fs.exists("marker") {
        std.io.print_line("marker exists: second run passes").unwrap()
        core.check.eq(t.f(), 1u32)
    } else {
        std.fs.write_atomic("marker", b"x").unwrap()
        let n = u32.parse("zz")?
        core.check.eq(n, 1u32)
    }
end t.f.test_try_twice
