fn t.dangle() -> &'static std.vec.Vec<u64> uses [alloc] panics may
    let v: std.vec.Vec<u64> = std.vec.Vec.new()
    let b = std.boxed.Box.new(v).unwrap()
    let r = t.launder(t.id, b.as_ref())
    core.mem.drop(b)
    r
end t.dangle

fn t.id(x: &std.vec.Vec<u64>) -> &std.vec.Vec<u64> uses [] panics never
    x
end t.id

fn t.launder(f: fn(&std.vec.Vec<u64>) -> &'static std.vec.Vec<u64> uses [] panics never, x: &std.vec.Vec<u64>) -> &'static std.vec.Vec<u64> uses [] panics never
    f(x)
end t.launder

fn t.main() -> () uses [alloc, io.console] panics may
    let r = t.dangle()
    let tri = (4_702_111_234_474_983_745u64, 16u64, 16u64)
    let fake = std.boxed.Box.new(tri).unwrap()
    t.pr(u64.from_usize(r.len()))
    t.pr(r[0usize])
    core.mem.drop(fake)
end t.main

fn t.pr(x: u64) -> () uses [alloc, io.console] panics may
    let mut s = std.string.String.new()
    s.push_u64(x).unwrap()
    std.io.print_line(s.as_str()).unwrap()
end t.pr
