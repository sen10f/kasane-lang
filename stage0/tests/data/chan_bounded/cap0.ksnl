fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console, thread] panics may
    let made = std.sync.channel::<u32, std.alloc.System>(std.alloc.SYSTEM, 0usize)
    let (tx, rx) = made.map_err(t.oom)?
    core.mem.drop(tx.send(5u32))
    match rx.recv() {
        Ok(n) => core.check.eq(n, 5u32)
        Err(_e) => core.panic.panic("recv failed")
    }
    std.io.print_line("cap0 ok")
end t.main

fn t.oom(_e: alloc.alloc.AllocError) -> std.io.Error uses [] panics never
    std.io.Error {
        kind: std.io.ErrorKind.OutOfMemory
        code: 0i32
    }
end t.oom
