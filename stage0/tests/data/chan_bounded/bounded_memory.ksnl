static t.SENT: std.sync.Mutex<u64> = std.sync.Mutex.new(0u64) pub

fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console, thread] panics may
    let made = std.sync.channel::<u64, std.alloc.System>(std.alloc.SYSTEM, 4usize)
    let (tx, rx) = made.map_err(t.oom)?
    let spawned = std.thread.spawn(
        std.alloc.SYSTEM,
        fn() -> () capture [move tx] {
            let mut i = 0u64
            while i < 20000u64 {
                core.mem.drop(match tx.send(i) {
                    Ok(_) => 0u32
                    Err(_e) => core.panic.panic("send failed")
                })
                let mut g = t.SENT.lock()
                let r = g.get_mut()
                *r = *r + 1u64
                core.mem.drop(g)
                i = i + 1u64
            }
        },
    )
    let producer = match spawned {
        Ok(h) => h
        Err(_e) => core.panic.panic("spawn failed")
    }
    let mut got = 0u64
    let mut worst = 0u64
    loop {
        match rx.recv() {
            Ok(_n) => {
                got = got + 1u64
                let g = t.SENT.lock()
                let sent = *g.get()
                core.mem.drop(g)
                if sent > got && sent - got > worst {
                    worst = sent - got
                }
            }
            Err(_) => break
        }
    }
    producer.join()
    core.check.eq(got, 20000u64)
    core.check.is_true(worst <= 5u64)
    std.io.print_line("bounded ok")
end t.main

fn t.oom(_e: alloc.alloc.AllocError) -> std.io.Error uses [] panics never
    std.io.Error {
        kind: std.io.ErrorKind.OutOfMemory
        code: 0i32
    }
end t.oom
