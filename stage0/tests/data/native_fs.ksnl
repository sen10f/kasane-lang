fn t.flag(label: &str, b: bool) -> () uses [alloc, io.console] panics never
    if b {
        t.show(label, 1i64)
    } else {
        t.show(label, 0i64)
    }
end t.flag

fn t.kind_num(k: std.io.ErrorKind) -> i64 uses [] panics never
    match k {
        std.io.ErrorKind.NotFound => 1i64
        std.io.ErrorKind.PermissionDenied => 2i64
        std.io.ErrorKind.AlreadyExists => 3i64
        std.io.ErrorKind.InvalidInput => 4i64
        std.io.ErrorKind.UnexpectedEof => 5i64
        std.io.ErrorKind.BrokenPipe => 6i64
        std.io.ErrorKind.Interrupted => 7i64
        std.io.ErrorKind.OutOfMemory => 8i64
        std.io.ErrorKind.TimedOut => 10i64
        std.io.ErrorKind.Other => 9i64
    }
end t.kind_num

fn t.main() -> Result<(), std.io.Error> uses [alloc, io.console, io.fs] panics may
    t.ok_unit(t.round_trip())
    t.ok_unit(t.many())
    std.io.print_line("fs ok")
end t.main

fn t.many() -> Result<(), std.io.Error> uses [alloc, io.console, io.fs] panics may
    let mut i = 0usize
    let mut total = 0usize
    while i < 3000usize {
        let mut f = t.ok_file(std.fs.create("ksn_native_fs_many.txt"))
        total = total + t.ok_size(f.write(b"abc"))
        t.ok_unit(f.close())
        let mut g = t.ok_file(std.fs.open("ksn_native_fs_many.txt"))
        let mut rest = alloc.vec.Vec.new(std.alloc.SYSTEM)
        total = total + t.ok_size(std.fs.read_to_end(&mut g, &mut rest))
        t.ok_unit(g.close())
        i = i + 1usize
    }
    t.ok_unit(std.fs.remove_file("ksn_native_fs_many.txt"))
    t.show("bytes moved in the loop", t.num(total))
    Ok(())
end t.many

fn t.num(n: usize) -> i64 uses [] panics never
    match i64.try_from_usize(n) {
        Ok(v) => v
        Err(_e) => -1i64
    }
end t.num

fn t.ok_file(r: Result<std.fs.File, std.io.Error>) -> std.fs.File uses [] panics may
    match r {
        Ok(v) => v
        Err(_e) => core.panic.panic("unexpected I/O error")
    }
end t.ok_file

fn t.ok_size(r: Result<usize, std.io.Error>) -> usize uses [] panics may
    match r {
        Ok(v) => v
        Err(_e) => core.panic.panic("unexpected I/O error")
    }
end t.ok_size

fn t.ok_unit(r: Result<(), std.io.Error>) -> () uses [] panics may
    match r {
        Ok(_u) => {
        }
        Err(_e) => core.panic.panic("unexpected I/O error")
    }
end t.ok_unit

fn t.round_trip() -> Result<(), std.io.Error> uses [alloc, io.console, io.fs] panics may
    let mut f = t.ok_file(std.fs.create("ksn_native_fs.txt"))
    let n = t.ok_size(f.write(b"hello, file"))
    t.show("written", t.num(n))
    t.ok_unit(f.flush())
    let mut probe = [0u8; 4]
    match f.read(&mut probe) {
        Ok(k) => t.show("read from a write-only file", t.num(k))
        Err(e) => t.show_err("read from a write-only file", e)
    }
    t.ok_unit(f.close())
    t.flag("exists", std.fs.exists("ksn_native_fs.txt"))
    let mut g = t.ok_file(std.fs.open("ksn_native_fs.txt"))
    let mut chunk = [0u8; 4]
    let first = t.ok_size(g.read(&mut chunk))
    t.show("first chunk", t.num(first))
    match chunk.get(0usize) {
        Some(b) => t.show("first byte", i64.from_u8(*b))
        None => t.show("first byte", 0i64)
    }
    match g.write(b"x") {
        Ok(k) => t.show("write to a read-only file", t.num(k))
        Err(e) => t.show_err("write to a read-only file", e)
    }
    let mut rest = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let m = t.ok_size(std.fs.read_to_end(&mut g, &mut rest))
    t.show("rest", t.num(m))
    t.show("rest length", t.num(rest.len()))
    let eof = t.ok_size(g.read(&mut chunk))
    t.show("at end of file", t.num(eof))
    let again = t.ok_size(std.fs.read_to_end(&mut g, &mut rest))
    t.show("read_to_end at end", t.num(again))
    t.ok_unit(g.close())
    t.ok_unit(std.fs.remove_file("ksn_native_fs.txt"))
    t.flag("exists after remove", std.fs.exists("ksn_native_fs.txt"))
    match std.fs.remove_file("ksn_native_fs.txt") {
        Ok(_u) => t.show("second remove", 0i64)
        Err(e) => t.show_err("second remove", e)
    }
    match std.fs.open("ksn_native_fs_missing.txt") {
        Ok(h) => {
            core.mem.drop(h.close())
            t.show("open missing", 0i64)
        }
        Err(e) => {
            t.show_err("open missing", e)
            core.check.eq(e.kind, std.io.ErrorKind.NotFound)
        }
    }
    match std.fs.open("") {
        Ok(h) => {
            core.mem.drop(h.close())
            t.show("open empty path", 0i64)
        }
        Err(e) => t.show_err("open empty path", e)
    }
    match std.fs.create("ksn_native_no_dir/inner.txt") {
        Ok(h) => {
            core.mem.drop(h.close())
            t.show("create in a missing directory", 0i64)
        }
        Err(e) => t.show_err("create in a missing directory", e)
    }
    Ok(())
end t.round_trip

fn t.show(label: &str, n: i64) -> () uses [alloc, io.console] panics never
    let mut s = alloc.string.String.new(std.alloc.SYSTEM)
    core.mem.drop(s.push_str(label))
    core.mem.drop(s.push_str(": "))
    core.mem.drop(s.push_i64(n))
    core.mem.drop(std.io.print_line(s.as_str()))
end t.show

fn t.show_err(label: &str, e: std.io.Error) -> () uses [alloc, io.console] panics never
    let mut s = alloc.string.String.new(std.alloc.SYSTEM)
    core.mem.drop(s.push_str(label))
    core.mem.drop(s.push_str(": kind "))
    core.mem.drop(s.push_i64(t.kind_num(e.kind)))
    core.mem.drop(s.push_str(" code "))
    core.mem.drop(s.push_i64(i64.from_i32(e.code)))
    core.mem.drop(std.io.print_line(s.as_str()))
end t.show_err
