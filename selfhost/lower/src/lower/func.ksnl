fn lower.func.body_text(c: &lower.cx.Cx) -> Result<alloc.string.String<std.alloc.System>, resolve.Failure> uses [alloc] panics may pub
    let mut out = alloc.string.String.new(std.alloc.SYSTEM)
    let mut b = 0usize
    while b < c.v.hdr.len() {
        match c.v.hdr.as_slice().get(b) {
            Some(h) => out.push_str(h.as_str())?
            None => core.mem.drop(0u8)
        }
        if b == 0usize {
            for l in c.v.lines.as_slice().iter() {
                if l.as_str().ends_with(" = frame.bytes 24") || l.as_str().ends_with(" = frame.bytes 1") {
                    out.push_str("    ")?
                    out.push_str(l.as_str())?
                    out.push('\n')?
                }
            }
            for l in c.v.lines.as_slice().iter() {
                if l.as_str().ends_with(" = alloca") {
                    out.push_str("    ")?
                    out.push_str(l.as_str())?
                    out.push('\n')?
                }
            }
        }
        let mut i = 0usize
        while i < c.v.lines.len() {
            let mine = match c.v.lblk.as_slice().get(i) {
                Some(x) => *x == b
                None => false
            }
            if mine {
                match c.v.lines.as_slice().get(i) {
                    Some(l) => if !(l.as_str().ends_with(" = alloca") || l.as_str().ends_with(" = frame.bytes 24") || l.as_str().ends_with(" = frame.bytes 1")) {
                        out.push_str("    ")?
                        out.push_str(l.as_str())?
                        out.push('\n')?
                    }
                    None => core.mem.drop(0u8)
                }
            }
            i = i + 1usize
        }
        b = b + 1usize
    }
    Ok(out)
end lower.func.body_text

fn lower.func.lower_item(env: &types.env.Env, c: &mut lower.cx.Cx, item: usize, key: &str, subs: &alloc.vec.Vec<usize, std.alloc.System>, ret0: usize) -> Result<(), resolve.Failure> uses [alloc] panics may pub
    lower.cx.reset(c)?
    let fqn_s = lower.tyk.item_fqn(env, item)
    let fqn = fqn_s.as_str()
    let mut sb = alloc.vec.Vec.new(std.alloc.SYSTEM)
    for x in subs.as_slice().iter() {
        sb.push(*x)?
    }
    c.v.subst = sb
    let file = types.infer.item_file(env, item)
    let node = types.infer.item_node(env, item)
    c.s.file = file
    let p = match types.env.unit(env, file) {
        Some(q) => q
        None => return lower.func.record(c, "", "ファイルがない")
    }
    let src_r = match env.srcs.as_slice().get(file) {
        Some(s) => s
        None => return lower.func.record(c, "", "ソースがない")
    }
    let src = src_r.text.as_slice()
    let n = parse.ast.get(&p.ast, node)
    if n.d == 0usize {
        return lower.func.record(c, "", "本体のない宣言")
    }
    let sg = parse.ast.get(&p.ast, n.c)
    let at = parse.ast.get(&p.ast, sg.d)
    let mark = lower.cx.depth(c)
    let mut bl = alloc.vec.Vec.new(std.alloc.SYSTEM)
    lower.expr.scan(env, c, p, src, n.d, &mut bl, true)?
    c.v.sl.bor = bl
    let mut ps = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let np = resolve.ast.count(p, sg.b)
    for j in core.iter.range(0usize, np) {
        let pnode = resolve.ast.item(p, sg.b, j)
        let prm = parse.ast.get(&p.ast, pnode)
        let pt = lower.expr.tyof(c, pnode)?
        let kt = lower.tyk.text(env, c, pt)?
        let v = lower.cx.newval(c, kt.as_str())?
        ps.push(v)?
        let nm = resolve.ast.tok_text(p, src, prm.a)
        let pk = lower.opt.bind(env, c, nm, v, false, pt)?
        lower.own.declare(env, c, pk, pt)?
    }
    let pstop = lower.cx.depth(c)
    let ret = if ret0 != 0usize {
        ret0
    } else if sg.c == 0usize {
        types.ty.UNIT
    } else {
        let rr = types.lower.ty(env, &mut c.ar, &c.tc, p, src, file, sg.c)?
        lower.inst.subst(c, rr)?
    }
    c.s.ret_t = ret
    let rt = lower.tyk.text(env, c, ret)?
    let _b0 = lower.cx.blk(c, &ps)?
    lower.cx.goto(c, 0usize)
    let r = lower.expr.expr(env, c, p, src, n.d, ret)?
    if !c.s.term {
        lower.vec.exit_drops(env, c, p, src, pstop, mark)?
        if rt.as_str() == "unit" {
            let bt = lower.tyk.text(env, c, r.t)?
            let mut u = r.v
            if bt.as_str() != "unit" {
                u = lower.expr.unit(c)?
            }
            lower.cx.finish(c, lower.cx.cat2("ret ", lower.cx.vs(u)?.as_str())?)?
        } else {
            lower.cx.finish(c, lower.cx.cat2("ret ", lower.cx.vs(r.v)?.as_str())?)?
        }
    }
    lower.expr.trunc(c, mark)
    let mut out = alloc.string.String.new(std.alloc.SYSTEM)
    out.push_str("fn ")?
    out.push_str(fqn)?
    out.push_str(" key=")?
    out.push_str(key)?
    out.push_str(" uses=[")?
    let mut first = true
    for j in core.iter.range(0usize, resolve.ast.count(p, at.a)) {
        if !first {
            out.push_str(",")?
        }
        first = false
        let en = parse.ast.get(&p.ast, resolve.ast.item(p, at.a, j))
        out.push_str(resolve.ast.text(src, en.a, en.b))?
    }
    out.push_str("] panics=")?
    if at.b == 1usize {
        out.push_str("never")?
    } else if at.b == 2usize {
        out.push_str("may")?
    } else {
        return lower.func.record(c, "", "panics の値 (未対応)")
    }
    if at.d == 0usize {
        out.push_str(" stack=-")?
    } else {
        let stk = parse.cur.peek_at(p, at.d - 1usize)
        out.push_str(" stack=")?
        out.push_str(resolve.ast.text(src, stk.start, stk.stop))?
    }
    out.push_str(" ret=")?
    out.push_str(rt.as_str())?
    out.push('\n')?
    out.push_str(lower.func.body_text(c)?.as_str())?
    out.push_str("end ")?
    out.push_str(fqn)?
    out.push('\n')?
    if !c.s.unsup.is_empty() {
        let why = lower.cx.cat2(c.s.unsup.as_str(), "")?
        return lower.func.record(c, "", why.as_str())
    }
    lower.func.record(c, out.as_str(), "")
end lower.func.lower_item

fn lower.func.record(c: &mut lower.cx.Cx, text: &str, why: &str) -> Result<(), resolve.Failure> uses [alloc] panics never pub
    if !why.is_empty() {
        c.g.oks.push(false)?
        c.g.tx.push(lower.cx.cat2(why, "")?)?
        return Ok(())
    }
    c.g.oks.push(true)?
    c.g.tx.push(lower.cx.cat2(text, "")?)?
    Ok(())
end lower.func.record
