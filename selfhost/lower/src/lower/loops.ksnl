fn lower.loops.args(c: &lower.cx.Cx, ks: &std.vec.Vec<usize>, extra: &std.vec.Vec<usize>) -> Result<std.vec.Vec<usize>, resolve.Failure> uses [alloc] panics never pub
    let mut out = std.vec.Vec.new()
    for v in extra.as_slice().iter() {
        out.push(*v)?
    }
    let cv = lower.cx.cur_vals(c, ks)?
    for v in cv.as_slice().iter() {
        out.push(*v)?
    }
    Ok(out)
end lower.loops.args

fn lower.loops.bin(c: &mut lower.cx.Cx, ty: &str, op: &str, a: usize, b: usize) -> Result<usize, resolve.Failure> uses [alloc] panics never pub
    let mut s = lower.cx.cat2(op, " ")?
    s.push_str(lower.expr.two(a, b)?.as_str())?
    lower.cx.def(c, ty, s.as_str())
end lower.loops.bin

fn lower.loops.blk2(c: &mut lower.cx.Cx, ld: &std.vec.Vec<usize>, sv: &std.vec.Vec<usize>) -> Result<usize, resolve.Failure> uses [alloc] panics never pub
    let mut all = std.vec.Vec.new()
    for v in ld.as_slice().iter() {
        all.push(*v)?
    }
    for v in sv.as_slice().iter() {
        all.push(*v)?
    }
    lower.cx.blk(c, &all)
end lower.loops.blk2

fn lower.loops.br(c: &mut lower.cx.Cx, b: usize, a: &std.vec.Vec<usize>) -> Result<(), resolve.Failure> uses [alloc] panics never pub
    lower.cx.finish(c, lower.cx.cat2("br ", lower.cx.target(b, a)?.as_str())?)
end lower.loops.br

fn lower.loops.brif(c: &mut lower.cx.Cx, cond: usize, b1: usize, a1: &std.vec.Vec<usize>, b2: usize, a2: &std.vec.Vec<usize>) -> Result<(), resolve.Failure> uses [alloc] panics never pub
    let mut s = lower.cx.cat2("br_if ", lower.cx.vs(cond)?.as_str())?
    s.push_str(", ")?
    s.push_str(lower.cx.target(b1, a1)?.as_str())?
    s.push_str(", ")?
    s.push_str(lower.cx.target(b2, a2)?.as_str())?
    lower.cx.finish(c, s)
end lower.loops.brif

fn lower.loops.fld(c: &mut lower.cx.Cx, ty: &str, v: usize, off: &str) -> Result<usize, resolve.Failure> uses [alloc] panics never pub
    let mut s = lower.cx.cat2("field ", lower.cx.vs(v)?.as_str())?
    s.push_str(", ")?
    s.push_str(off)?
    lower.cx.def(c, ty, s.as_str())
end lower.loops.fld

fn lower.loops.forsplit(env: &types.env.Env, c: &mut lower.cx.Cx, p: &parse.cur.P, src: &[u8], n: parse.ast.Node, t: usize, loc: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let it = parse.ast.get(&p.ast, n.b)
    let pn = parse.ast.get(&p.ast, n.a)
    if pn.kind != parse.ast.Kind.PBind {
        lower.cx.fail(c, "for の束縛 (名前だけ対応)")?
        return lower.expr.dummy(c, t)
    }
    let lt = lower.cx.tyof_t(c, loc)
    let lk = types.ty.node(&c.ar, types.ty.strip(&c.ar, lt)).k
    if lk != types.ty.K.Str {
        lower.cx.fail(c, "for s.split(..) の s は &str だけ (未対応)")?
        return lower.expr.dummy(c, t)
    }
    let sv = lower.opt.local_val(env, c, loc, lt)?
    let sv2 = lower.std_calls.val_of(env, c, sv, lt)?
    let sep = lower.expr.expr(env, c, p, src, resolve.ast.item(p, it.b, 0usize), types.ty.UNKNOWN)?
    let base = lower.cx.depth(c)
    let mut nms = std.vec.Vec.new()
    lower.expr.scan(env, c, p, src, n.c, &mut nms, false)?
    let ks = lower.cx.mlist_in(c, base, &nms)?
    let s_ptr = lower.loops.fld(c, "ptr", sv2, "+0")?
    let s_len = lower.loops.fld(c, "usize", sv2, "+8")?
    let sp_ptr = lower.loops.fld(c, "ptr", sep.v, "+0")?
    let sp_len = lower.loops.fld(c, "usize", sep.v, "+8")?
    let zero = lower.vec.usize_c(c, 0usize)?
    let one = lower.vec.usize_c(c, 1usize)?
    let (l0, xs) = lower.loops.mk(c, 0usize, &ks)?
    let xb = lower.loops.blk2(c, &l0, &xs)?
    let (l1, hs) = lower.loops.mk(c, 1usize, &ks)?
    let hb = lower.loops.blk2(c, &l1, &hs)?
    let (l2, fs) = lower.loops.mk(c, 2usize, &ks)?
    let fb = lower.loops.blk2(c, &l2, &fs)?
    let (l3, cs) = lower.loops.mk(c, 3usize, &ks)?
    let cb = lower.loops.blk2(c, &l3, &cs)?
    let (l4, ts) = lower.loops.mk(c, 3usize, &ks)?
    let tb = lower.loops.blk2(c, &l4, &ts)?
    let (l5, bs) = lower.loops.mk(c, 2usize, &ks)?
    let bb = lower.loops.blk2(c, &l5, &bs)?
    let (l6, ats) = lower.loops.mk(c, 1usize, &ks)?
    let ab = lower.loops.blk2(c, &l6, &ats)?
    let ea = lower.loops.args(c, &ks, &lower.loops.vv(1usize, zero, 0usize, 0usize)?)?
    lower.loops.br(c, hb, &ea)?
    lower.cx.goto(c, hb)
    lower.cx.bind_vals(c, &ks, &hs)?
    let from = lower.tyk.at(l1.as_slice(), 0usize)
    let e1 = lower.loops.bin(c, "bool", "icmp.eq.usize", sp_len, zero)?
    let e2 = lower.loops.bin(c, "bool", "icmp.eq.usize", s_len, zero)?
    let triv = lower.loops.bin(c, "bool", "or.bool", e1, e2)?
    let a1 = lower.loops.args(c, &ks, &lower.loops.vv(2usize, from, s_len, 0usize)?)?
    let a2 = lower.loops.args(c, &ks, &lower.loops.vv(2usize, from, from, 0usize)?)?
    lower.loops.brif(c, triv, bb, &a1, fb, &a2)?
    lower.cx.goto(c, fb)
    lower.cx.bind_vals(c, &ks, &fs)?
    let ffrom = lower.tyk.at(l2.as_slice(), 0usize)
    let fi = lower.tyk.at(l2.as_slice(), 1usize)
    let fend = lower.loops.bin(c, "usize", "add.usize.wrap", fi, sp_len)?
    let past = lower.loops.bin(c, "bool", "icmp.gt.usize", fend, s_len)?
    let b1 = lower.loops.args(c, &ks, &lower.loops.vv(2usize, ffrom, s_len, 0usize)?)?
    let b2 = lower.loops.args(c, &ks, &lower.loops.vv(3usize, ffrom, zero, fi)?)?
    lower.loops.brif(c, past, bb, &b1, cb, &b2)?
    lower.cx.goto(c, cb)
    lower.cx.bind_vals(c, &ks, &cs)?
    let cfrom = lower.tyk.at(l3.as_slice(), 0usize)
    let ck = lower.tyk.at(l3.as_slice(), 1usize)
    let ci = lower.tyk.at(l3.as_slice(), 2usize)
    let keq = lower.loops.bin(c, "bool", "icmp.eq.usize", ck, sp_len)?
    let c1 = lower.loops.args(c, &ks, &lower.loops.vv(2usize, cfrom, ci, 0usize)?)?
    let c2 = lower.loops.args(c, &ks, &lower.loops.vv(3usize, cfrom, ck, ci)?)?
    lower.loops.brif(c, keq, bb, &c1, tb, &c2)?
    lower.cx.goto(c, tb)
    lower.cx.bind_vals(c, &ks, &cs)?
    let sum = lower.loops.bin(c, "usize", "add.usize.wrap", ci, ck)?
    let spa = lower.loops.bin(c, "ptr", "ptr.add", s_ptr, sum)?
    let sb = lower.loops.ld8(c, spa)?
    let cpa = lower.loops.bin(c, "ptr", "ptr.add", sp_ptr, ck)?
    let cbv = lower.loops.ld8(c, cpa)?
    let diff = lower.loops.bin(c, "bool", "icmp.ne.u8", sb, cbv)?
    let ni = lower.loops.bin(c, "usize", "add.usize.wrap", ci, one)?
    let k1 = lower.loops.bin(c, "usize", "add.usize.wrap", ck, one)?
    let d1 = lower.loops.args(c, &ks, &lower.loops.vv(2usize, cfrom, ni, 0usize)?)?
    let d2 = lower.loops.args(c, &ks, &lower.loops.vv(3usize, cfrom, k1, ci)?)?
    lower.loops.brif(c, diff, fb, &d1, cb, &d2)?
    lower.cx.goto(c, bb)
    lower.cx.bind_vals(c, &ks, &bs)?
    let bfrom = lower.tyk.at(l5.as_slice(), 0usize)
    let bend = lower.tyk.at(l5.as_slice(), 1usize)
    let pptr = lower.loops.bin(c, "ptr", "ptr.add", s_ptr, bfrom)?
    let plen = lower.loops.bin(c, "usize", "sub.usize.wrap", bend, bfrom)?
    let strt = types.ty.push(&mut c.ar, types.ty.mk(types.ty.K.Str, 0usize, 0usize, 0usize, false))?
    let ety = strt
    let ftx = lower.tyk.text(env, c, ety)?
    let mk0 = lower.cx.cat2("make(", lower.expr.two(pptr, plen)?.as_str())?
    let piece = lower.cx.def(c, ftx.as_str(), lower.cx.cat2(mk0.as_str(), ")")?.as_str())?
    let mark = lower.cx.depth(c)
    let ptk = parse.cur.peek_at(p, pn.a)
    let pname = resolve.ast.text(src, ptk.start, ptk.stop)
    core.mem.drop(lower.cx.push_local(c, pname, piece + 1usize, false, ety, false)?)
    let saved_head = c.lp.head
    let saved_exit = c.lp.exit
    let saved_base = c.lp.base
    let saved_ks = lower.cx.copy_u(&c.lp.ks)?
    let saved_brk = c.lp.brk
    c.lp.head = ab
    c.lp.exit = xb
    c.lp.base = base
    c.lp.ks = lower.cx.copy_u(&ks)?
    c.lp.brk = 0usize
    core.mem.drop(lower.expr.expr(env, c, p, src, n.c, types.ty.UNKNOWN)?)
    if !c.s.term {
        let g1 = lower.loops.args(c, &ks, &lower.loops.vv(1usize, bend, 0usize, 0usize)?)?
        lower.loops.br(c, ab, &g1)?
    }
    c.lp.head = saved_head
    c.lp.exit = saved_exit
    c.lp.base = saved_base
    c.lp.ks = saved_ks
    c.lp.brk = saved_brk
    lower.expr.trunc(c, mark)
    lower.cx.goto(c, ab)
    lower.cx.bind_vals(c, &ks, &ats)?
    let aend = lower.tyk.at(l6.as_slice(), 0usize)
    let done = lower.loops.bin(c, "bool", "icmp.eq.usize", aend, s_len)?
    let nxt = lower.loops.bin(c, "usize", "add.usize.wrap", aend, sp_len)?
    let h1 = lower.loops.args(c, &ks, &lower.loops.vv(0usize, 0usize, 0usize, 0usize)?)?
    let h2 = lower.loops.args(c, &ks, &lower.loops.vv(1usize, nxt, 0usize, 0usize)?)?
    lower.loops.brif(c, done, xb, &h1, hb, &h2)?
    lower.cx.goto(c, xb)
    lower.cx.bind_vals(c, &ks, &xs)?
    let u = lower.expr.unit(c)?
    Ok(lower.cx.R { v: u, t: t })
end lower.loops.forsplit

fn lower.loops.forvec(env: &types.env.Env, c: &mut lower.cx.Cx, p: &parse.cur.P, src: &[u8], n: parse.ast.Node, t: usize, by_ref: bool, hv: usize, hbt: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let (inner, _th, _mu) = lower.opt.deref_ty(c, hbt)
    let elem = lower.vec.elem(c, inner)
    let (sz, _al) = lower.tyk.size_of(env, c, elem)?
    let et = lower.tyk.text(env, c, elem)?
    let base = lower.cx.depth(c)
    let mut nms = std.vec.Vec.new()
    lower.expr.scan(env, c, p, src, n.c, &mut nms, false)?
    let ks = lower.cx.mlist_in(c, base, &nms)?
    let len0 = lower.vec.load_usize(c, hv, 8usize)?
    let p1 = lower.vec.load_ptr(c, hv)?
    let zero = lower.vec.usize_c(c, 0usize)?
    let iv = lower.cx.newval(c, "usize")?
    let mut hps = std.vec.Vec.new()
    hps.push(iv)?
    let mvh = lower.cx.fresh_vals(c, &ks)?
    for v in mvh.as_slice().iter() {
        hps.push(*v)?
    }
    let eps = lower.cx.fresh_vals(c, &ks)?
    let exitb = lower.cx.blk(c, &eps)?
    let cps = lower.cx.fresh_vals(c, &ks)?
    let contb = lower.cx.blk(c, &cps)?
    let head = lower.cx.blk(c, &hps)?
    let mut a0 = std.vec.Vec.new()
    a0.push(zero)?
    let cur = lower.cx.cur_vals(c, &ks)?
    for v in cur.as_slice().iter() {
        a0.push(*v)?
    }
    lower.cx.finish(c, lower.cx.cat2("br ", lower.cx.target(head, &a0)?.as_str())?)?
    lower.cx.goto(c, head)
    lower.cx.bind_vals(c, &ks, &mvh)?
    let cmp_s = lower.cx.cat2("icmp.lt.usize ", lower.expr.two(iv, len0)?.as_str())?
    let cmp = lower.cx.def(c, "bool", cmp_s.as_str())?
    let empty = std.vec.Vec.new()
    let bodyb = lower.cx.blk(c, &empty)?
    let cv = lower.cx.cur_vals(c, &ks)?
    let mut s1 = lower.cx.cat2("br_if ", lower.cx.vs(cmp)?.as_str())?
    s1.push_str(", ")?
    s1.push_str(lower.cx.target(bodyb, &empty)?.as_str())?
    s1.push_str(", ")?
    s1.push_str(lower.cx.target(exitb, &cv)?.as_str())?
    lower.cx.finish(c, s1)?
    lower.cx.goto(c, bodyb)
    let mark = lower.cx.depth(c)
    let mut addr = 0usize
    if sz == 1usize {
        addr = lower.vec.padd(c, p1, iv)?
    } else {
        let szc = lower.vec.usize_c(c, sz)?
        let off = lower.vec.arith(c, "mul", iv, szc)?
        addr = lower.vec.padd(c, p1, off)?
    }
    let pn = parse.ast.get(&p.ast, n.a)
    if pn.kind != parse.ast.Kind.PBind {
        lower.cx.fail(c, "for の束縛 (名前だけ対応)")?
        return lower.expr.dummy(c, t)
    }
    let ptk = parse.cur.peek_at(p, pn.a)
    let pname = resolve.ast.text(src, ptk.start, ptk.stop)
    let saved_head = c.lp.head
    let saved_exit = c.lp.exit
    let saved_base = c.lp.base
    let saved_ks = lower.cx.copy_u(&c.lp.ks)?
    let saved_brk = c.lp.brk
    let mut ety = elem
    let ek = types.ty.node(&c.ar, types.ty.find(&c.ar, elem)).k
    let sc1 = ek == types.ty.K.Int || ek == types.ty.K.Bool || ek == types.ty.K.Float
    let scalar_el = sc1 || ek == types.ty.K.Char
    let ebind = if by_ref && !scalar_el {
        ety = types.ty.push(&mut c.ar, types.ty.mk(types.ty.K.Ref, elem, 0usize, 0usize, false))?
        addr
    } else {
        let ls = lower.cx.cat2("mem.load.", et.as_str())?
        let ls2 = lower.cx.cat2(ls.as_str(), " ")?
        let ls3 = lower.cx.cat2(ls2.as_str(), lower.cx.vs(addr)?.as_str())?
        lower.cx.def(c, et.as_str(), lower.cx.cat2(ls3.as_str(), " +0")?.as_str())?
    }
    core.mem.drop(lower.cx.push_local(c, pname, ebind + 1usize, false, ety, false)?)
    c.lp.head = contb
    c.lp.exit = exitb
    c.lp.base = base
    c.lp.ks = lower.cx.copy_u(&ks)?
    c.lp.brk = 0usize
    core.mem.drop(lower.expr.expr(env, c, p, src, n.c, types.ty.UNKNOWN)?)
    if !c.s.term {
        let a1 = lower.cx.cur_vals(c, &ks)?
        lower.cx.finish(c, lower.cx.cat2("br ", lower.cx.target(contb, &a1)?.as_str())?)?
    }
    c.lp.head = saved_head
    c.lp.exit = saved_exit
    c.lp.base = saved_base
    c.lp.ks = saved_ks
    c.lp.brk = saved_brk
    lower.expr.trunc(c, mark)
    lower.cx.goto(c, contb)
    lower.cx.bind_vals(c, &ks, &cps)?
    let one = lower.vec.usize_c(c, 1usize)?
    let inc = lower.vec.arith(c, "add", iv, one)?
    let mut a2 = std.vec.Vec.new()
    a2.push(inc)?
    let cur2 = lower.cx.cur_vals(c, &ks)?
    for v in cur2.as_slice().iter() {
        a2.push(*v)?
    }
    lower.cx.finish(c, lower.cx.cat2("br ", lower.cx.target(head, &a2)?.as_str())?)?
    lower.cx.goto(c, exitb)
    lower.cx.bind_vals(c, &ks, &eps)?
    let u = lower.expr.unit(c)?
    Ok(lower.cx.R { v: u, t: t })
end lower.loops.forvec

fn lower.loops.forvec_path(env: &types.env.Env, c: &mut lower.cx.Cx, p: &parse.cur.P, src: &[u8], n: parse.ast.Node, t: usize, bname: &str) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    if lower.expr.seg_count(bname) < 2usize {
        let loc = lower.cx.find(c, bname)
        if loc != 0usize {
            let lt = lower.cx.tyof_t(c, loc - 1usize)
            let hv = lower.cx.get_val(c, loc - 1usize).wrapping_sub(1usize)
            return lower.loops.forvec(env, c, p, src, n, t, true, hv, lt)
        }
    } else {
        let (hp, vt, ok) = lower.expr.hdr_of(env, c, bname)?
        if ok {
            return lower.loops.forvec(env, c, p, src, n, t, true, hp, vt)
        }
    }
    lower.cx.fail(c, "for NAME.as_slice().iter() (NAME が Vec でない)")?
    lower.expr.dummy(c, t)
end lower.loops.forvec_path

fn lower.loops.forx(env: &types.env.Env, c: &mut lower.cx.Cx, p: &parse.cur.P, src: &[u8], n: parse.ast.Node, t: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let it = parse.ast.get(&p.ast, n.b)
    let mut is_range = false
    if it.kind == parse.ast.Kind.Call && resolve.ast.count(p, it.b) == 2usize {
        let ce = types.rec.callee_of(&c.tc.rec, c.s.file, n.b)
        if ce != 0usize {
            let fq = lower.tyk.item_fqn(env, ce - 1usize)
            is_range = fq.as_str() == "core.iter.range"
        }
    }
    if !is_range {
        if it.kind == parse.ast.Kind.Call && resolve.ast.count(p, it.b) == 1usize {
            let cn1 = parse.ast.get(&p.ast, it.a)
            if cn1.kind == parse.ast.Kind.Path {
                let (g1, g2) = lower.expr.split2(resolve.ast.text(src, cn1.a, cn1.b))
                if g1 != "" && g2 == "split" {
                    let loc1 = lower.cx.find(c, g1)
                    if loc1 != 0usize {
                        return lower.loops.forsplit(env, c, p, src, n, t, loc1 - 1usize)
                    }
                }
            }
        }
        let mut name = ""
        let mut by_ref = false
        if it.kind == parse.ast.Kind.Call && resolve.ast.count(p, it.b) == 0usize {
            let cn = parse.ast.get(&p.ast, it.a)
            if cn.kind == parse.ast.Kind.Path {
                let (f1, f2) = lower.expr.split2(resolve.ast.text(src, cn.a, cn.b))
                if f1 != "" && f2 == "iter" {
                    name = f1
                    by_ref = true
                }
            }
        } else if it.kind == parse.ast.Kind.Path {
            name = resolve.ast.text(src, it.a, it.b)
        }
        if it.kind == parse.ast.Kind.MCall && resolve.ast.tok_text(p, src, it.b) == "iter" {
            let rn = parse.ast.get(&p.ast, it.a)
            if rn.kind == parse.ast.Kind.Call && resolve.ast.count(p, rn.b) == 0usize {
                let cn2 = parse.ast.get(&p.ast, rn.a)
                if cn2.kind == parse.ast.Kind.Path {
                    let cname = resolve.ast.text(src, cn2.a, cn2.b)
                    if let Some(bname) = cname.strip_suffix(".as_slice") {
                        return lower.loops.forvec_path(env, c, p, src, n, t, bname)
                    }
                }
            }
        }
        if name != "" {
            let loc = lower.cx.find(c, name)
            if loc != 0usize {
                let lt = lower.cx.tyof_t(c, loc - 1usize)
                let (_di, is_thr, _dm) = lower.opt.deref_ty(c, lt)
                if lower.tyk.is_vec_ty(env, c, lt) || is_thr {
                    let hv = lower.cx.get_val(c, loc - 1usize).wrapping_sub(1usize)
                    return lower.loops.forvec(env, c, p, src, n, t, by_ref, hv, lt)
                }
            }
        }
        lower.cx.fail(c, "for (整数の範囲と Vec 以外は未対応)")?
        return lower.expr.dummy(c, t)
    }
    let lo = lower.expr.expr(env, c, p, src, resolve.ast.item(p, it.b, 0usize), types.ty.UNKNOWN)?
    let hi = lower.expr.expr(env, c, p, src, resolve.ast.item(p, it.b, 1usize), types.ty.UNKNOWN)?
    let ity = lower.tyk.text(env, c, lo.t)?
    let base = lower.cx.depth(c)
    let mut nms = std.vec.Vec.new()
    lower.expr.scan(env, c, p, src, n.c, &mut nms, false)?
    let ks = lower.cx.mlist_in(c, base, &nms)?
    let eps = lower.cx.fresh_vals(c, &ks)?
    let exitb = lower.cx.blk(c, &eps)?
    let cps = lower.cx.fresh_vals(c, &ks)?
    let contb = lower.cx.blk(c, &cps)?
    let iv = lower.cx.newval(c, ity.as_str())?
    let mut hps = std.vec.Vec.new()
    hps.push(iv)?
    let mvh = lower.cx.fresh_vals(c, &ks)?
    for v in mvh.as_slice().iter() {
        hps.push(*v)?
    }
    let head = lower.cx.blk(c, &hps)?
    let mut a0 = std.vec.Vec.new()
    a0.push(lo.v)?
    let cur = lower.cx.cur_vals(c, &ks)?
    for v in cur.as_slice().iter() {
        a0.push(*v)?
    }
    let s0 = lower.cx.cat2("br ", lower.cx.target(head, &a0)?.as_str())?
    lower.cx.finish(c, s0)?
    lower.cx.goto(c, head)
    lower.cx.bind_vals(c, &ks, &mvh)?
    let cmp_op = lower.expr.two(iv, hi.v)?
    let cmp_src = lower.cx.cat2("icmp.lt.", ity.as_str())?
    let cmp_s0 = lower.cx.cat2(" ", cmp_op.as_str())?
    let cmp_s = lower.cx.cat2(cmp_src.as_str(), cmp_s0.as_str())?
    let cmp = lower.cx.def(c, "bool", cmp_s.as_str())?
    let empty = std.vec.Vec.new()
    let bodyb = lower.cx.blk(c, &empty)?
    let cv = lower.cx.cur_vals(c, &ks)?
    let mut s1 = lower.cx.cat2("br_if ", lower.cx.vs(cmp)?.as_str())?
    s1.push_str(", ")?
    s1.push_str(lower.cx.target(bodyb, &empty)?.as_str())?
    s1.push_str(", ")?
    s1.push_str(lower.cx.target(exitb, &cv)?.as_str())?
    lower.cx.finish(c, s1)?
    lower.cx.goto(c, bodyb)
    let mark = lower.cx.depth(c)
    let pn = parse.ast.get(&p.ast, n.a)
    if pn.kind != parse.ast.Kind.PBind {
        lower.cx.fail(c, "for の束縛 (名前だけ対応)")?
        return lower.expr.dummy(c, t)
    }
    let ptk = parse.cur.peek_at(p, pn.a)
    let pname = resolve.ast.text(src, ptk.start, ptk.stop)
    core.mem.drop(lower.cx.push_local(c, pname, iv + 1usize, false, lo.t, false)?)
    let saved_head = c.lp.head
    let saved_exit = c.lp.exit
    let saved_base = c.lp.base
    let saved_ks = lower.cx.copy_u(&c.lp.ks)?
    let saved_brk = c.lp.brk
    c.lp.head = contb
    c.lp.exit = exitb
    c.lp.base = base
    c.lp.ks = lower.cx.copy_u(&ks)?
    c.lp.brk = 0usize
    core.mem.drop(lower.expr.expr(env, c, p, src, n.c, types.ty.UNKNOWN)?)
    if !c.s.term {
        let a1 = lower.cx.cur_vals(c, &ks)?
        let s2 = lower.cx.cat2("br ", lower.cx.target(contb, &a1)?.as_str())?
        lower.cx.finish(c, s2)?
    }
    c.lp.head = saved_head
    c.lp.exit = saved_exit
    c.lp.base = saved_base
    c.lp.ks = saved_ks
    c.lp.brk = saved_brk
    lower.expr.trunc(c, mark)
    lower.cx.goto(c, contb)
    lower.cx.bind_vals(c, &ks, &cps)?
    let one_s0 = lower.cx.cat2(ity.as_str(), " 1")?
    let one_s = lower.cx.cat2("const.", one_s0.as_str())?
    let one = lower.cx.def(c, ity.as_str(), one_s.as_str())?
    let inc_op = lower.expr.two(iv, one)?
    let inc_src = lower.cx.cat2("add.", ity.as_str())?
    let inc_s0 = lower.cx.cat2(".wrap ", inc_op.as_str())?
    let inc_s = lower.cx.cat2(inc_src.as_str(), inc_s0.as_str())?
    let inc = lower.cx.def(c, ity.as_str(), inc_s.as_str())?
    let mut a2 = std.vec.Vec.new()
    a2.push(inc)?
    let cur2 = lower.cx.cur_vals(c, &ks)?
    for v in cur2.as_slice().iter() {
        a2.push(*v)?
    }
    let s3 = lower.cx.cat2("br ", lower.cx.target(head, &a2)?.as_str())?
    lower.cx.finish(c, s3)?
    lower.cx.goto(c, exitb)
    lower.cx.bind_vals(c, &ks, &eps)?
    let u = lower.expr.unit(c)?
    Ok(lower.cx.R { v: u, t: t })
end lower.loops.forx

fn lower.loops.ld8(c: &mut lower.cx.Cx, a: usize) -> Result<usize, resolve.Failure> uses [alloc] panics never pub
    let s = lower.cx.cat2("mem.load.u8 ", lower.cx.vs(a)?.as_str())?
    lower.cx.def(c, "u8", lower.cx.cat2(s.as_str(), " +0")?.as_str())
end lower.loops.ld8

fn lower.loops.make2(c: &mut lower.cx.Cx, ty: &str, a: usize, b: usize) -> Result<usize, resolve.Failure> uses [alloc] panics never pub
    let s = lower.cx.cat2("make(", lower.expr.two(a, b)?.as_str())?
    lower.cx.def(c, ty, lower.cx.cat2(s.as_str(), ")")?.as_str())
end lower.loops.make2

fn lower.loops.mk(c: &mut lower.cx.Cx, lead: usize, ks: &std.vec.Vec<usize>) -> Result<(std.vec.Vec<usize>, std.vec.Vec<usize>), resolve.Failure> uses [alloc] panics never pub
    let mut ld = std.vec.Vec.new()
    for _i in core.iter.range(0usize, lead) {
        ld.push(lower.cx.newval(c, "usize")?)?
    }
    let sv = lower.cx.fresh_vals(c, ks)?
    Ok((ld, sv))
end lower.loops.mk

fn lower.loops.none_of(c: &mut lower.cx.Cx, rt: &str) -> Result<usize, resolve.Failure> uses [alloc] panics never pub
    let s = lower.cx.cat2("const.", rt)?
    lower.cx.def(c, rt, lower.cx.cat2(s.as_str(), " none")?.as_str())
end lower.loops.none_of

fn lower.loops.un(c: &mut lower.cx.Cx, ty: &str, op: &str, a: usize) -> Result<usize, resolve.Failure> uses [alloc] panics never pub
    let s = lower.cx.cat2(op, lower.cx.vs(a)?.as_str())?
    lower.cx.def(c, ty, s.as_str())
end lower.loops.un

fn lower.loops.vv(n: usize, a: usize, b: usize, d: usize) -> Result<std.vec.Vec<usize>, resolve.Failure> uses [alloc] panics never pub
    let mut out = std.vec.Vec.new()
    if n > 0usize {
        out.push(a)?
    }
    if n > 1usize {
        out.push(b)?
    }
    if n > 2usize {
        out.push(d)?
    }
    Ok(out)
end lower.loops.vv
