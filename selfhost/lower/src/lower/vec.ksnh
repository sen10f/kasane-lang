// `a * b` と `a + b` (wrap)。
fn lower.vec.arith(c: &mut lower.cx.Cx, op: &str, a: usize, b: usize) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let s = lower.cx.cat2(op, ".usize.wrap ")?
    let s2 = lower.cx.cat2(s.as_str(), lower.expr.two(a, b)?.as_str())?
    lower.cx.def(c, "usize", s2.as_str())
end lower.vec.arith

// `Vec` / `String` のメソッドの呼び出し (Rust 版と同じく、生成した小関数の呼び出し)。as_str だけは展開する。
// 受け手 vs[0] は枠の番地 (ptr)。rty は受け手の型 (参照でもよい)、t は呼び出しの結果の型。
fn lower.vec.call(env: &types.env.Env, c: &mut lower.cx.Cx, fqn: &str, rty: usize, vs: &alloc.vec.Vec<usize, std.alloc.System>, t: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let name = lower.expr.last_seg(fqn)
    let recv = lower.tyk.at(vs.as_slice(), 0usize)
    if name == "as_str" {
        return lower.str.as_str(env, c, recv, t)
    }
    let is_str = fqn.starts_with("alloc.string.String.")
    let ok = if is_str {
        name == "len" || name == "is_empty" || name == "push_str" || name == "push" || name == "push_u64" || name == "clear"
    } else {
        name == "len" || name == "is_empty" || name == "push" || name == "pop" || name == "as_slice" || name == "clear" || name == "truncate"
    }
    if !ok {
        lower.cx.fail(c, lower.cx.cat2("Vec / String のメソッド (未対応): ", name)?.as_str())?
        return lower.expr.dummy(c, t)
    }
    let f = types.ty.strip(&c.ar, rty)
    let n = types.ty.node(&c.ar, f)
    let mut key = lower.cx.cat2(fqn, "<")?
    let mut subs = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let want = if is_str {
        1usize
    } else {
        2usize
    }
    for k in core.iter.range(0usize, want) {
        if k > 0usize {
            key.push(',')?
        }
        if k < n.c {
            let a = types.ty.arg(&c.ar, n.b, k)
            key.push_str(lower.tyk.src(env, c, a)?.as_str())?
            subs.push(k)?
            subs.push(a)?
        } else {
            key.push_str("std.alloc.System")?
        }
    }
    key.push('>')?
    lower.expr.enqueue(c, key.as_str(), lower.chk.GEN, subs, t)?
    let rt = lower.tyk.text(env, c, t)?
    let co = lower.cx.cat2("call ", key.as_str())?
    let co2 = lower.cx.cat2(co.as_str(), "(")?
    let co3 = lower.cx.cat2(co2.as_str(), lower.cx.vlist(vs)?.as_str())?
    let co4 = lower.cx.cat2(co3.as_str(), ")")?
    let v = lower.cx.def(c, rt.as_str(), co4.as_str())?
    Ok(lower.cx.R { v: v, t: t })
end lower.vec.call

// `Vec` の型 (参照を外した後) の要素の型。
fn lower.vec.elem(c: &lower.cx.Cx, vt: usize) -> usize uses [] panics may pub
    let f = types.ty.strip(&c.ar, vt)
    let n = types.ty.node(&c.ar, f)
    types.ty.arg(&c.ar, n.b, 0usize)
end lower.vec.elem

// 枠の入った番地 `recv` (mutref / ref の vec) から要素 elem の番地 `base + i * size` を作る。
fn lower.vec.elem_addr(c: &mut lower.cx.Cx, p1: usize, idx: usize, szc: usize) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let off = lower.vec.arith(c, "mul", idx, szc)?
    lower.vec.padd(c, p1, off)
end lower.vec.elem_addr

// 出口 (本体の終わり・`return`・`?` の失敗) で、局所 [lo, hi) のうち所有する `Vec` / `String` の枠を逆順に解放し、`scope.end` を出す。
fn lower.vec.exit_drops(env: &types.env.Env, c: &mut lower.cx.Cx, p: &parse.cur.P, src: &[u8], hi: usize, lo: usize) -> Result<(), resolve.Failure> uses [alloc] panics may pub
    let mut k = hi
    while k > lo {
        k = k - 1usize
        lower.drop.exit(env, c, p, src, k)?
        if lower.cx.is_slot(c, k) && lower.vec.is_hdr(env, c, lower.cx.tyof_t(c, k)) {
            let sv = lower.cx.get_val(c, k).wrapping_sub(1usize)
            lower.vec.free_slot(env, c, sv, lower.cx.tyof_t(c, k))?
            core.mem.drop(lower.cx.def1(c, "unit", "scope.end ", sv)?)
        }
    }
    Ok(())
end lower.vec.exit_drops

// ループを抜ける (`break` / `continue`) とき、局所 [lo, hi) のスロットを逆順に片付ける
// (`Vec` / `String` は解放して、どれも `scope.end`)。
fn lower.vec.exit_scope(env: &types.env.Env, c: &mut lower.cx.Cx, p: &parse.cur.P, src: &[u8], hi: usize, lo: usize) -> Result<(), resolve.Failure> uses [alloc] panics may pub
    let mut k = hi
    while k > lo {
        k = k - 1usize
        lower.drop.exit(env, c, p, src, k)?
        if lower.cx.is_slot(c, k) && lower.fs.close_at(c, k) == 0usize {
            let sv = lower.cx.get_val(c, k).wrapping_sub(1usize)
            if lower.vec.is_hdr(env, c, lower.cx.tyof_t(c, k)) {
                lower.vec.free_slot(env, c, sv, lower.cx.tyof_t(c, k))?
            }
            core.mem.drop(lower.cx.def1(c, "unit", "scope.end ", sv)?)
        }
    }
    Ok(())
end lower.vec.exit_scope

// 枠の先頭の番地を解放する (`mem.load.ptr` と `heap.free`)。
fn lower.vec.free_hdr(c: &mut lower.cx.Cx, slot: usize) -> Result<(), resolve.Failure> uses [alloc] panics may pub
    let pv = lower.vec.load_ptr(c, slot)?
    core.mem.drop(lower.cx.def1(c, "unit", "heap.free ", pv)?)
    Ok(())
end lower.vec.free_hdr

// 枠 slot の `Vec` / `String` (型 t) を解放する。要素が所有物の `Vec` は、要素も 1 つずつ解放する。
fn lower.vec.free_slot(env: &types.env.Env, c: &mut lower.cx.Cx, slot: usize, t: usize) -> Result<(), resolve.Failure> uses [alloc] panics may pub
    if lower.vec.owns_elems(env, c, t)? {
        let hv = lower.vec.load_hdr(env, c, slot, types.ty.strip(&c.ar, t), false)?
        return lower.drop.value(env, c, hv, types.ty.strip(&c.ar, t))
    }
    lower.vec.free_hdr(c, slot)
end lower.vec.free_slot

// 生成した小関数の本体 (`key` は `alloc.vec.Vec.push<u32,std.alloc.System>` など)。subs は型引数の対 (番号, 型)、ret は結果の型。
fn lower.vec.gen(env: &types.env.Env, c: &mut lower.cx.Cx, key: &str, subs: &alloc.vec.Vec<usize, std.alloc.System>, ret: usize) -> Result<(), resolve.Failure> uses [alloc] panics may pub
    lower.cx.reset(c)?
    let mut fq = key
    for w in key.split("<") {
        fq = w
        break
    }
    let name = lower.expr.last_seg(fq)
    let is_str = fq.starts_with("alloc.string.String.")
    let elem = lower.tyk.at(subs.as_slice(), 1usize)
    let rt = lower.tyk.text(env, c, ret)?
    if is_str && name == "push" {
        let mut po = alloc.string.String.new(std.alloc.SYSTEM)
        lower.str.push_char_text(&mut po, fq, key, rt.as_str())?
        return lower.func.record(c, po.as_str(), "")
    }
    if is_str && name == "push_u64" {
        let mut uo = alloc.string.String.new(std.alloc.SYSTEM)
        lower.str.push_u64_text(&mut uo, fq, key, rt.as_str())?
        return lower.func.record(c, uo.as_str(), "")
    }
    let mut ps = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let recv = lower.cx.newval(c, "ptr")?
    ps.push(recv)?
    let mut value = 0usize
    let mut eff = "[]"
    if name == "truncate" {
        value = lower.cx.newval(c, "usize")?
        ps.push(value)?
    }
    if name == "push" {
        let et = lower.tyk.text(env, c, elem)?
        value = lower.cx.newval(c, et.as_str())?
        ps.push(value)?
        eff = "[alloc]"
    }
    if name == "push_str" {
        let ft = lower.chk.fat(c)?
        value = lower.cx.newval(c, ft.as_str())?
        ps.push(value)?
        eff = "[alloc]"
    }
    let _b0 = lower.cx.blk(c, &ps)?
    lower.cx.goto(c, 0usize)
    let mut r = lower.cx.R { v: 0usize, t: ret }
    if name == "len" {
        r = lower.vec.len(env, c, recv, false, ret)?
    } else if name == "is_empty" {
        r = lower.vec.len(env, c, recv, true, ret)?
    } else if name == "push" {
        r = lower.vec.push(env, c, recv, elem, value, ret)?
    } else if name == "pop" {
        r = lower.vec.pop(env, c, recv, elem, ret)?
    } else if name == "clear" {
        let z = lower.vec.usize_c(c, 0usize)?
        core.mem.drop(lower.vec.store_at(c, "usize", recv, 8usize, z)?)
        r = lower.cx.R { v: lower.expr.unit(c)?, t: ret }
    } else if name == "truncate" {
        // 長さを縮めるだけ (n < len のときだけ)。要素の解放はしない (所有物の要素は漏れる。README 29 章)。
        let len0 = lower.vec.load_usize(c, recv, 8usize)?
        let lts = lower.cx.cat2("icmp.lt.usize ", lower.expr.two(value, len0)?.as_str())?
        let lt = lower.cx.def(c, "bool", lts.as_str())?
        let empty = alloc.vec.Vec.new(std.alloc.SYSTEM)
        let setb = lower.cx.blk(c, &empty)?
        let jb = lower.cx.blk(c, &empty)?
        let mut brs = lower.cx.cat2("br_if ", lower.cx.vs(lt)?.as_str())?
        brs.push_str(", ")?
        brs.push_str(lower.cx.target(setb, &empty)?.as_str())?
        brs.push_str(", ")?
        brs.push_str(lower.cx.target(jb, &empty)?.as_str())?
        lower.cx.finish(c, brs)?
        lower.cx.goto(c, setb)
        core.mem.drop(lower.vec.store_at(c, "usize", recv, 8usize, value)?)
        lower.cx.finish(c, lower.cx.cat2("br ", lower.cx.target(jb, &empty)?.as_str())?)?
        lower.cx.goto(c, jb)
        r = lower.cx.R { v: lower.expr.unit(c)?, t: ret }
    } else if name == "as_slice" {
        let pv = lower.vec.load_ptr(c, recv)?
        let lv = lower.vec.load_usize(c, recv, 8usize)?
        let mk = lower.cx.cat2("make(", lower.expr.two(pv, lv)?.as_str())?
        let mv = lower.cx.def(c, rt.as_str(), lower.cx.cat2(mk.as_str(), ")")?.as_str())?
        r = lower.cx.R { v: mv, t: ret }
    } else if is_str {
        r = lower.str.push_str(env, c, recv, value, ret)?
    }
    lower.cx.finish(c, lower.cx.cat2("ret ", lower.cx.vs(r.v)?.as_str())?)?
    let mut out = alloc.string.String.new(std.alloc.SYSTEM)
    out.push_str("fn ")?
    out.push_str(fq)?
    out.push_str(" key=")?
    out.push_str(key)?
    out.push_str(" uses=")?
    out.push_str(eff)?
    out.push_str(" panics=never stack=- ret=")?
    out.push_str(rt.as_str())?
    out.push('\n')?
    out.push_str(lower.func.body_text(c)?.as_str())?
    out.push_str("end ")?
    out.push_str(fq)?
    out.push('\n')?
    lower.func.record(c, out.as_str(), "")
end lower.vec.gen

// `v[i]` (読み出し): 添字の検査 (index.check) の後で要素を読む。
fn lower.vec.index(env: &types.env.Env, c: &mut lower.cx.Cx, recv: usize, elem: usize, idx: usize, t: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let (sz, _al) = lower.tyk.size_of(env, c, elem)?
    let et = lower.tyk.text(env, c, elem)?
    let len0 = lower.vec.load_usize(c, recv, 8usize)?
    let ics = lower.cx.cat2("index.check ", lower.expr.two(idx, len0)?.as_str())?
    core.mem.drop(lower.cx.def(c, "unit", ics.as_str())?)
    let p1 = lower.vec.load_ptr(c, recv)?
    let szc = lower.vec.usize_c(c, sz)?
    let addr = lower.vec.elem_addr(c, p1, idx, szc)?
    let lds = lower.cx.cat2("mem.load.", et.as_str())?
    let lds2 = lower.cx.cat2(lds.as_str(), " ")?
    let lds3 = lower.cx.cat2(lds2.as_str(), lower.cx.vs(addr)?.as_str())?
    let v = lower.cx.def(c, et.as_str(), lower.cx.cat2(lds3.as_str(), " +0")?.as_str())?
    Ok(lower.cx.R { v: v, t: t })
end lower.vec.index

// `base[idx]` (読み出し)。基は参照 (値) か、スロットの局所。
fn lower.vec.index_expr(env: &types.env.Env, c: &mut lower.cx.Cx, p: &parse.cur.P, src: &[u8], n: parse.ast.Node, t: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let bt = lower.expr.tyof(c, n.a)?
    let (inner, through, _m) = lower.opt.deref_ty(c, bt)
    if !(lower.tyk.is_vec_ty(env, c, inner)) {
        lower.cx.fail(c, "添字 (Vec 以外は未対応)")?
        return lower.expr.dummy(c, t)
    }
    let elem = lower.vec.elem(c, inner)
    let bn = parse.ast.get(&p.ast, n.a)
    let mut recv = 0usize
    if through {
        recv = lower.expr.expr(env, c, p, src, n.a, types.ty.UNKNOWN)?.v
    } else if bn.kind == parse.ast.Kind.Path {
        let loc = lower.cx.find(c, resolve.ast.text(src, bn.a, bn.b))
        if loc == 0usize || !lower.cx.is_slot(c, loc - 1usize) {
            lower.cx.fail(c, "添字の基 (スロットでない局所は未対応)")?
            return lower.expr.dummy(c, t)
        }
        recv = lower.cx.get_val(c, loc - 1usize).wrapping_sub(1usize)
    } else {
        lower.cx.fail(c, "添字の基 (未対応)")?
        return lower.expr.dummy(c, t)
    }
    let idx = lower.expr.expr(env, c, p, src, n.b, types.ty.UNKNOWN)?
    lower.vec.index(env, c, recv, elem, idx.v, t)
end lower.vec.index_expr

// 型 t (参照を外さない) が `Vec` / `String` の値か。値は枠 (`frame.bytes 24`) の局所に置く。
fn lower.vec.is_hdr(env: &types.env.Env, c: &lower.cx.Cx, t: usize) -> bool uses [alloc] panics may pub
    let f = types.ty.find(&c.ar, t)
    let n = types.ty.node(&c.ar, f)
    n.k == types.ty.K.Adt && lower.tyk.is_vec(env, n.a)
end lower.vec.is_hdr

// `v.len()` と `v.is_empty()`.
fn lower.vec.len(env: &types.env.Env, c: &mut lower.cx.Cx, recv: usize, empty_q: bool, t: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let len0 = lower.vec.load_usize(c, recv, 8usize)?
    if !empty_q {
        return Ok(lower.cx.R { v: len0, t: t })
    }
    let zero = lower.vec.usize_c(c, 0usize)?
    let eqs = lower.cx.cat2("icmp.eq.usize ", lower.expr.two(len0, zero)?.as_str())?
    let v = lower.cx.def(c, "bool", eqs.as_str())?
    core.mem.drop(env.srcs.len())
    Ok(lower.cx.R { v: v, t: t })
end lower.vec.len

// 枠 slot の値を取り出す (移動): 3 つの欄を読み、先頭の番地を null にして、`vec` の値を作る。
// take が false なら null にしない (読むだけ)。
fn lower.vec.load_hdr(env: &types.env.Env, c: &mut lower.cx.Cx, slot: usize, t: usize, take: bool) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let pv = lower.vec.load_ptr(c, slot)?
    let lv = lower.vec.load_usize(c, slot, 8usize)?
    let cv = lower.vec.load_usize(c, slot, 16usize)?
    if take {
        let nul = lower.cx.def(c, "ptr", "const.ptr 0")?
        core.mem.drop(lower.vec.store_at(c, "ptr", slot, 0usize, nul)?)
        if lower.vec.owns_elems(env, c, t)? {
            // 要素が所有物の `Vec`: 長さも 0 にする (移した後に要素を解放しない)。
            let z = lower.vec.usize_c(c, 0usize)?
            core.mem.drop(lower.vec.store_at(c, "usize", slot, 8usize, z)?)
        }
    }
    let tt = lower.tyk.text(env, c, t)?
    let mut mk = alloc.string.String.new(std.alloc.SYSTEM)
    mk.push_str("make(")?
    mk.push_str(lower.cx.vs(pv)?.as_str())?
    mk.push_str(", ")?
    mk.push_str(lower.cx.vs(lv)?.as_str())?
    mk.push_str(", ")?
    mk.push_str(lower.cx.vs(cv)?.as_str())?
    mk.push(')')?
    lower.cx.def(c, tt.as_str(), mk.as_str())
end lower.vec.load_hdr

// `mem.load.ptr <p> +0` (枠の先頭の番地)。
fn lower.vec.load_ptr(c: &mut lower.cx.Cx, p: usize) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let s = lower.cx.cat2("mem.load.ptr ", lower.cx.vs(p)?.as_str())?
    let s2 = lower.cx.cat2(s.as_str(), " +0")?
    lower.cx.def(c, "ptr", s2.as_str())
end lower.vec.load_ptr

// `mem.load.usize <p> +off`.
fn lower.vec.load_usize(c: &mut lower.cx.Cx, p: usize, off: usize) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let s = lower.cx.cat2("mem.load.usize ", lower.cx.vs(p)?.as_str())?
    let s2 = lower.cx.cat2(s.as_str(), " +")?
    let s3 = lower.cx.cat2(s2.as_str(), lower.cx.dec(off)?.as_str())?
    lower.cx.def(c, "usize", s3.as_str())
end lower.vec.load_usize

// 利用者の呼び出しの前に、`Vec` のメソッドを直に下ろす (vs は受け手と引数の値)。
fn lower.vec.method(env: &types.env.Env, c: &mut lower.cx.Cx, fqn: &str, rty: usize, vs: &alloc.vec.Vec<usize, std.alloc.System>, t: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let name = lower.expr.last_seg(fqn)
    let elem = lower.vec.elem(c, rty)
    let recv = lower.tyk.at(vs.as_slice(), 0usize)
    if name == "push" {
        let value = lower.tyk.at(vs.as_slice(), 1usize)
        return lower.vec.push(env, c, recv, elem, value, t)
    }
    if name == "pop" {
        return lower.vec.pop(env, c, recv, elem, t)
    }
    if name == "len" {
        return lower.vec.len(env, c, recv, false, t)
    }
    if name == "is_empty" {
        return lower.vec.len(env, c, recv, true, t)
    }
    lower.cx.fail(c, lower.cx.cat2("Vec のメソッド (未対応): ", name)?.as_str())?
    lower.expr.dummy(c, t)
end lower.vec.method

// `Vec::new(alloc)`: 空の枠 {null, 0, 0}。
fn lower.vec.new(env: &types.env.Env, c: &mut lower.cx.Cx, t: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let nul = lower.cx.def(c, "ptr", "const.ptr 0")?
    let z = lower.vec.usize_c(c, 0usize)?
    let tt = lower.tyk.text(env, c, t)?
    let mk = lower.cx.cat2("make(", lower.cx.vs(nul)?.as_str())?
    let mk2 = lower.cx.cat2(mk.as_str(), ", ")?
    let mk3 = lower.cx.cat2(mk2.as_str(), lower.cx.vs(z)?.as_str())?
    let mk4 = lower.cx.cat2(mk3.as_str(), ", ")?
    let mk5 = lower.cx.cat2(mk4.as_str(), lower.cx.vs(z)?.as_str())?
    let mk6 = lower.cx.cat2(mk5.as_str(), ")")?
    let v = lower.cx.def(c, tt.as_str(), mk6.as_str())?
    Ok(lower.cx.R { v: v, t: t })
end lower.vec.new

// `Vec` の型 t (参照を外した後) の要素が所有物か。
fn lower.vec.owns_elems(env: &types.env.Env, c: &mut lower.cx.Cx, t: usize) -> Result<bool, resolve.Failure> uses [alloc] panics may pub
    let f = types.ty.strip(&c.ar, t)
    let n = types.ty.node(&c.ar, f)
    if n.k != types.ty.K.Adt || !lower.tyk.is_vec(env, n.a) {
        return Ok(false)
    }
    Ok(lower.tyk.vec_item(env, c, f)? != lower.tyk.VEC)
end lower.vec.owns_elems

// `ptr.add p, off` (p + off バイト)。
fn lower.vec.padd(c: &mut lower.cx.Cx, p: usize, off: usize) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let s = lower.cx.cat2("ptr.add ", lower.expr.two(p, off)?.as_str())?
    lower.cx.def(c, "ptr", s.as_str())
end lower.vec.padd

// `v.pop()`: 空なら None、そうでなければ末尾を取り出す。
fn lower.vec.pop(env: &types.env.Env, c: &mut lower.cx.Cx, recv: usize, elem: usize, t: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let (sz, _al) = lower.tyk.size_of(env, c, elem)?
    let et = lower.tyk.text(env, c, elem)?
    let szc = lower.vec.usize_c(c, sz)?
    let len0 = lower.vec.load_usize(c, recv, 8usize)?
    let zero = lower.vec.usize_c(c, 0usize)?
    let eqs = lower.cx.cat2("icmp.eq.usize ", lower.expr.two(len0, zero)?.as_str())?
    let isz = lower.cx.def(c, "bool", eqs.as_str())?
    let empty = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let emptyb = lower.cx.blk(c, &empty)?
    let popb = lower.cx.blk(c, &empty)?
    let rt = lower.tyk.text(env, c, t)?
    let mut jps = alloc.vec.Vec.new(std.alloc.SYSTEM)
    jps.push(lower.cx.newval(c, rt.as_str())?)?
    let jb = lower.cx.blk(c, &jps)?
    let mut brs = lower.cx.cat2("br_if ", lower.cx.vs(isz)?.as_str())?
    brs.push_str(", ")?
    brs.push_str(lower.cx.target(emptyb, &empty)?.as_str())?
    brs.push_str(", ")?
    brs.push_str(lower.cx.target(popb, &empty)?.as_str())?
    lower.cx.finish(c, brs)?
    lower.cx.goto(c, emptyb)
    let nn = lower.cx.def(c, rt.as_str(), lower.cx.cat2("const.", lower.cx.cat2(rt.as_str(), " none")?.as_str())?.as_str())?
    let mut a0 = alloc.vec.Vec.new(std.alloc.SYSTEM)
    a0.push(nn)?
    lower.cx.finish(c, lower.cx.cat2("br ", lower.cx.target(jb, &a0)?.as_str())?)?
    lower.cx.goto(c, popb)
    let one = lower.vec.usize_c(c, 1usize)?
    let nl = lower.vec.arith(c, "sub", len0, one)?
    core.mem.drop(lower.vec.store_at(c, "usize", recv, 8usize, nl)?)
    let p1 = lower.vec.load_ptr(c, recv)?
    let addr = lower.vec.elem_addr(c, p1, nl, szc)?
    let lds = lower.cx.cat2("mem.load.", et.as_str())?
    let lds2 = lower.cx.cat2(lds.as_str(), " ")?
    let lds3 = lower.cx.cat2(lds2.as_str(), lower.cx.vs(addr)?.as_str())?
    let v = lower.cx.def(c, et.as_str(), lower.cx.cat2(lds3.as_str(), " +0")?.as_str())?
    let sws = lower.cx.cat2("some ", lower.cx.vs(v)?.as_str())?
    let sv = lower.cx.def(c, rt.as_str(), sws.as_str())?
    let mut a1 = alloc.vec.Vec.new(std.alloc.SYSTEM)
    a1.push(sv)?
    lower.cx.finish(c, lower.cx.cat2("br ", lower.cx.target(jb, &a1)?.as_str())?)?
    lower.cx.goto(c, jb)
    Ok(lower.cx.R { v: lower.tyk.at(jps.as_slice(), 0usize), t: t })
end lower.vec.pop

// `v.push(x)`: 容量が足りなければ `cap * 2 + 4` に広げ (heap.realloc)、末尾へ書く。結果は Ok(())。
fn lower.vec.push(env: &types.env.Env, c: &mut lower.cx.Cx, recv: usize, elem: usize, value: usize, t: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let (sz, _al) = lower.tyk.size_of(env, c, elem)?
    let et = lower.tyk.text(env, c, elem)?
    let szc = lower.vec.usize_c(c, sz)?
    let len0 = lower.vec.load_usize(c, recv, 8usize)?
    let cap0 = lower.vec.load_usize(c, recv, 16usize)?
    let lts = lower.cx.cat2("icmp.lt.usize ", lower.expr.two(len0, cap0)?.as_str())?
    let lt = lower.cx.def(c, "bool", lts.as_str())?
    let empty = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let growb = lower.cx.blk(c, &empty)?
    let okb = lower.cx.blk(c, &empty)?
    let rt = lower.tyk.text(env, c, t)?
    let mut jps = alloc.vec.Vec.new(std.alloc.SYSTEM)
    jps.push(lower.cx.newval(c, rt.as_str())?)?
    let jb = lower.cx.blk(c, &jps)?
    let mut brs = lower.cx.cat2("br_if ", lower.cx.vs(lt)?.as_str())?
    brs.push_str(", ")?
    brs.push_str(lower.cx.target(okb, &empty)?.as_str())?
    brs.push_str(", ")?
    brs.push_str(lower.cx.target(growb, &empty)?.as_str())?
    lower.cx.finish(c, brs)?
    // 広げる。
    lower.cx.goto(c, growb)
    let two = lower.vec.usize_c(c, 2usize)?
    let four = lower.vec.usize_c(c, 4usize)?
    let c2 = lower.vec.arith(c, "mul", cap0, two)?
    let nc = lower.vec.arith(c, "add", c2, four)?
    let bytes = lower.vec.arith(c, "mul", nc, szc)?
    let p0 = lower.vec.load_ptr(c, recv)?
    let rls = lower.cx.cat2("heap.realloc ", lower.expr.two(p0, bytes)?.as_str())?
    let np = lower.cx.def(c, "ptr", rls.as_str())?
    core.mem.drop(lower.vec.store_at(c, "ptr", recv, 0usize, np)?)
    core.mem.drop(lower.vec.store_at(c, "usize", recv, 16usize, nc)?)
    lower.cx.finish(c, lower.cx.cat2("br ", lower.cx.target(okb, &empty)?.as_str())?)?
    // 書く。
    lower.cx.goto(c, okb)
    let p1 = lower.vec.load_ptr(c, recv)?
    let addr = lower.vec.elem_addr(c, p1, len0, szc)?
    core.mem.drop(lower.vec.store_at(c, et.as_str(), addr, 0usize, value)?)
    let one = lower.vec.usize_c(c, 1usize)?
    let nl = lower.vec.arith(c, "add", len0, one)?
    core.mem.drop(lower.vec.store_at(c, "usize", recv, 8usize, nl)?)
    let u = lower.expr.unit(c)?
    let oks = lower.cx.cat2("ok ", lower.cx.vs(u)?.as_str())?
    let okv = lower.cx.def(c, rt.as_str(), oks.as_str())?
    let mut a = alloc.vec.Vec.new(std.alloc.SYSTEM)
    a.push(okv)?
    lower.cx.finish(c, lower.cx.cat2("br ", lower.cx.target(jb, &a)?.as_str())?)?
    lower.cx.goto(c, jb)
    Ok(lower.cx.R { v: lower.tyk.at(jps.as_slice(), 0usize), t: t })
end lower.vec.push

// `store` の命令を書く (`mem.store.T <p> +off, v` の形)。
fn lower.vec.store_at(c: &mut lower.cx.Cx, ty: &str, p: usize, off: usize, v: usize) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let mut s = lower.cx.cat2("mem.store.", ty)?
    s.push(' ')?
    s.push_str(lower.cx.vs(p)?.as_str())?
    s.push_str(" +")?
    s.push_str(lower.cx.dec(off)?.as_str())?
    s.push_str(", ")?
    s.push_str(lower.cx.vs(v)?.as_str())?
    lower.cx.def(c, "unit", s.as_str())
end lower.vec.store_at

// 値 v (`vec` の集成体) の 3 つの欄を枠 slot へ書く (Rust 版 `store_hdr`)。
fn lower.vec.store_hdr(c: &mut lower.cx.Cx, slot: usize, v: usize) -> Result<(), resolve.Failure> uses [alloc] panics may pub
    let pv = lower.cx.def(c, "ptr", lower.expr.field_src(v, 0usize)?.as_str())?
    let lv = lower.cx.def(c, "usize", lower.expr.field_src(v, 8usize)?.as_str())?
    let cv = lower.cx.def(c, "usize", lower.expr.field_src(v, 16usize)?.as_str())?
    core.mem.drop(lower.vec.store_at(c, "ptr", slot, 0usize, pv)?)
    core.mem.drop(lower.vec.store_at(c, "usize", slot, 8usize, lv)?)
    core.mem.drop(lower.vec.store_at(c, "usize", slot, 16usize, cv)?)
    Ok(())
end lower.vec.store_hdr

// 整数の定数 `const.usize N` を作る。
fn lower.vec.usize_c(c: &mut lower.cx.Cx, n: usize) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let s = lower.cx.cat2("const.usize ", lower.cx.dec(n)?.as_str())?
    lower.cx.def(c, "usize", s.as_str())
end lower.vec.usize_c
