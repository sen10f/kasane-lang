fn lower.str.as_str(env: &types.env.Env, c: &mut lower.cx.Cx, h: usize, t: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let pv = lower.vec.load_ptr(c, h)?
    let lv = lower.vec.load_usize(c, h, 8usize)?
    let ft = lower.tyk.text(env, c, t)?
    let mk = lower.cx.cat2("make(", lower.expr.two(pv, lv)?.as_str())?
    let mk2 = lower.cx.cat2(mk.as_str(), ")")?
    let v = lower.cx.def(c, ft.as_str(), mk2.as_str())?
    Ok(lower.cx.R { v: v, t: t })
end lower.str.as_str

fn lower.str.bh(o: &mut std.string.String, b: usize, ps: &str) -> Result<(), resolve.Failure> uses [alloc] panics never pub
    o.push_str("  b")?
    o.push_str(lower.cx.dec(b)?.as_str())?
    o.push('(')?
    o.push_str(ps)?
    o.push_str("):\n")?
    Ok(())
end lower.str.bh

fn lower.str.enc(o: &mut std.string.String, k: &mut usize, base: usize, n: usize) -> Result<(), resolve.Failure> uses [alloc] panics may pub
    for j in core.iter.range(0usize, n) {
        let mut v = 1usize
        let shift = 6usize * (n - 1usize - j)
        if shift > 0usize {
            let sc = lower.str.row(o, k, "u32", lower.cx.cat2("const.u32 ", lower.cx.dec(shift)?.as_str())?.as_str())?
            v = lower.str.row(o, k, "u32", lower.str.op2("shr.u32.wrap ", 1usize, sc)?.as_str())?
        }
        if j > 0usize {
            let m = lower.str.row(o, k, "u32", "const.u32 63")?
            v = lower.str.row(o, k, "u32", lower.str.op2("and.u32 ", v, m)?.as_str())?
        }
        let mut lead = 128usize
        if j == 0usize && n == 2usize {
            lead = 192usize
        }
        if j == 0usize && n == 3usize {
            lead = 224usize
        }
        if j == 0usize && n == 4usize {
            lead = 240usize
        }
        if !(j == 0usize && n == 1usize) {
            let lc = lower.str.row(o, k, "u32", lower.cx.cat2("const.u32 ", lower.cx.dec(lead)?.as_str())?.as_str())?
            v = lower.str.row(o, k, "u32", lower.str.op2("or.u32 ", v, lc)?.as_str())?
        }
        let mut cs = lower.cx.cat2("conv.u8.u32 %", lower.cx.dec(v)?.as_str())?
        let b = lower.str.row(o, k, "u8", cs.as_str())?
        cs = lower.cx.cat2("mem.store.u8 %", lower.cx.dec(base)?.as_str())?
        cs.push_str(" +")?
        cs.push_str(lower.cx.dec(j)?.as_str())?
        cs.push_str(", %")?
        cs.push_str(lower.cx.dec(b)?.as_str())?
        let _q1 = lower.str.row(o, k, "unit", cs.as_str())?
    }
    let w = lower.str.row(o, k, "usize", lower.cx.cat2("const.usize ", lower.cx.dec(n)?.as_str())?.as_str())?
    o.push_str("    br b9(%")?
    o.push_str(lower.cx.dec(w)?.as_str())?
    o.push_str(")\n")?
    Ok(())
end lower.str.enc

fn lower.str.from_str(env: &types.env.Env, c: &mut lower.cx.Cx, p: &parse.cur.P, src: &[u8], n: parse.ast.Node, t: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let text = lower.expr.expr(env, c, p, src, resolve.ast.item(p, n.b, 1usize), types.ty.UNKNOWN)?
    let tf = types.ty.find(&c.ar, t)
    let tn = types.ty.node(&c.ar, tf)
    let st = types.ty.arg(&c.ar, tn.b, 0usize)
    let stxt = lower.tyk.text(env, c, st)?
    let ttxt = lower.tyk.text(env, c, t)?
    let bp = lower.cx.def(c, "ptr", lower.expr.field_src(text.v, 0usize)?.as_str())?
    let bn = lower.cx.def(c, "usize", lower.expr.field_src(text.v, 8usize)?.as_str())?
    let buf = lower.cx.def1(c, "ptr", "heap.alloc ", bn)?
    let zero = lower.vec.usize_c(c, 0usize)?
    let one = lower.vec.usize_c(c, 1usize)?
    let empty = std.vec.Vec.new()
    let mut hps = std.vec.Vec.new()
    hps.push(lower.cx.newval(c, "usize")?)?
    let hb = lower.cx.blk(c, &hps)?
    let bb = lower.cx.blk(c, &empty)?
    let eb = lower.cx.blk(c, &empty)?
    let mut a0 = std.vec.Vec.new()
    a0.push(zero)?
    lower.cx.finish(c, lower.cx.cat2("br ", lower.cx.target(hb, &a0)?.as_str())?)?
    lower.cx.goto(c, hb)
    let i = lower.tyk.at(hps.as_slice(), 0usize)
    let ge = lower.loops.bin(c, "bool", "icmp.ge.usize", i, bn)?
    let mut brs = lower.cx.cat2("br_if ", lower.cx.vs(ge)?.as_str())?
    brs.push_str(", ")?
    brs.push_str(lower.cx.target(eb, &empty)?.as_str())?
    brs.push_str(", ")?
    brs.push_str(lower.cx.target(bb, &empty)?.as_str())?
    lower.cx.finish(c, brs)?
    lower.cx.goto(c, bb)
    let sp = lower.loops.bin(c, "ptr", "ptr.add", bp, i)?
    let lds = lower.cx.cat2("mem.load.u8 ", lower.cx.vs(sp)?.as_str())?
    let ld = lower.cx.def(c, "u8", lower.cx.cat2(lds.as_str(), " +0")?.as_str())?
    let dp = lower.loops.bin(c, "ptr", "ptr.add", buf, i)?
    let sts = lower.cx.cat2("mem.store.u8 ", lower.cx.vs(dp)?.as_str())?
    let sts2 = lower.cx.cat2(sts.as_str(), " +0, ")?
    let sts3 = lower.cx.cat2(sts2.as_str(), lower.cx.vs(ld)?.as_str())?
    core.mem.drop(lower.cx.def(c, "unit", sts3.as_str())?)
    let ni = lower.vec.arith(c, "add", i, one)?
    let mut a1 = std.vec.Vec.new()
    a1.push(ni)?
    lower.cx.finish(c, lower.cx.cat2("br ", lower.cx.target(hb, &a1)?.as_str())?)?
    lower.cx.goto(c, eb)
    let np = lower.cx.def(c, "ptr", "const.ptr 0")?
    core.mem.drop(np)
    let mk = lower.cx.cat2("make(", lower.expr.two(buf, bn)?.as_str())?
    let mk2 = lower.cx.cat2(mk.as_str(), ", ")?
    let mk3 = lower.cx.cat2(mk2.as_str(), lower.cx.vs(bn)?.as_str())?
    let sv = lower.cx.def(c, stxt.as_str(), lower.cx.cat2(mk3.as_str(), ")")?.as_str())?
    let ov = lower.cx.def1(c, ttxt.as_str(), "ok ", sv)?
    Ok(lower.cx.R { v: ov, t: t })
end lower.str.from_str

fn lower.str.method(env: &types.env.Env, c: &mut lower.cx.Cx, fqn: &str, vs: &std.vec.Vec<usize>, t: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let name = lower.expr.last_seg(fqn)
    let recv = lower.tyk.at(vs.as_slice(), 0usize)
    if name == "len" {
        return lower.vec.len(env, c, recv, false, t)
    }
    if name == "as_str" {
        return lower.str.as_str(env, c, recv, t)
    }
    if name == "push_str" {
        let text = lower.tyk.at(vs.as_slice(), 1usize)
        return lower.str.push_str(env, c, recv, text, t)
    }
    lower.cx.fail(c, lower.cx.cat2("String のメソッド (未対応): ", name)?.as_str())?
    lower.expr.dummy(c, t)
end lower.str.method

fn lower.str.op2(op: &str, a: usize, b: usize) -> Result<std.string.String, resolve.Failure> uses [alloc] panics never pub
    let mut s = std.string.String.new()
    s.push_str(op)?
    lower.str.pv(&mut s, a)?
    s.push_str(", ")?
    lower.str.pv(&mut s, b)?
    Ok(s)
end lower.str.op2

fn lower.str.push_char_text(o: &mut std.string.String, fq: &str, key: &str, rt: &str) -> Result<(), resolve.Failure> uses [alloc] panics may pub
    o.push_str("fn ")?
    o.push_str(fq)?
    o.push_str(" key=")?
    o.push_str(key)?
    o.push_str(" uses=[alloc] panics=never stack=- ret=")?
    o.push_str(rt)?
    o.push('\n')?
    lower.str.bh(o, 0usize, "%0: ptr, %1: u32")?
    let mut k = 2usize
    let len0 = lower.str.row(o, &mut k, "usize", "mem.load.usize %0 +8")?
    let cap0 = lower.str.row(o, &mut k, "usize", "mem.load.usize %0 +16")?
    let four = lower.str.row(o, &mut k, "usize", "const.usize 4")?
    let need = lower.str.row(o, &mut k, "usize", lower.str.op2("add.usize.wrap ", len0, four)?.as_str())?
    let over = lower.str.row(o, &mut k, "bool", lower.str.op2("icmp.gt.usize ", need, cap0)?.as_str())?
    o.push_str("    br_if %")?
    o.push_str(lower.cx.dec(over)?.as_str())?
    o.push_str(", b1(), b2()\n")?
    lower.str.bh(o, 1usize, "")?
    let s1 = lower.str.row(o, &mut k, "usize", lower.str.op2("add.usize.wrap ", cap0, need)?.as_str())?
    let two = lower.str.row(o, &mut k, "usize", "const.usize 2")?
    let s2 = lower.str.row(o, &mut k, "usize", lower.str.op2("mul.usize.wrap ", s1, two)?.as_str())?
    let ncap = lower.str.row(o, &mut k, "usize", lower.str.op2("add.usize.wrap ", s2, four)?.as_str())?
    let p0 = lower.str.row(o, &mut k, "ptr", "mem.load.ptr %0 +0")?
    let np = lower.str.row(o, &mut k, "ptr", lower.str.op2("heap.realloc ", p0, ncap)?.as_str())?
    let _q2 = lower.str.row(o, &mut k, "unit", lower.cx.cat2("mem.store.ptr %0 +0, %", lower.cx.dec(np)?.as_str())?.as_str())?
    let _q3 = lower.str.row(o, &mut k, "unit", lower.cx.cat2("mem.store.usize %0 +16, %", lower.cx.dec(ncap)?.as_str())?.as_str())?
    o.push_str("    br b2()\n")?
    lower.str.bh(o, 2usize, "")?
    let p1 = lower.str.row(o, &mut k, "ptr", "mem.load.ptr %0 +0")?
    let base = lower.str.row(o, &mut k, "ptr", lower.str.op2("ptr.add ", p1, len0)?.as_str())?
    let c1 = lower.str.row(o, &mut k, "u32", "const.u32 128")?
    let l1 = lower.str.row(o, &mut k, "bool", lower.str.op2("icmp.lt.u32 ", 1usize, c1)?.as_str())?
    o.push_str("    br_if %")?
    o.push_str(lower.cx.dec(l1)?.as_str())?
    o.push_str(", b3(), b4()\n")?
    lower.str.bh(o, 3usize, "")?
    lower.str.enc(o, &mut k, base, 1usize)?
    lower.str.bh(o, 4usize, "")?
    let c2 = lower.str.row(o, &mut k, "u32", "const.u32 2048")?
    let l2 = lower.str.row(o, &mut k, "bool", lower.str.op2("icmp.lt.u32 ", 1usize, c2)?.as_str())?
    o.push_str("    br_if %")?
    o.push_str(lower.cx.dec(l2)?.as_str())?
    o.push_str(", b5(), b6()\n")?
    lower.str.bh(o, 5usize, "")?
    lower.str.enc(o, &mut k, base, 2usize)?
    lower.str.bh(o, 6usize, "")?
    let c3 = lower.str.row(o, &mut k, "u32", "const.u32 65536")?
    let l3 = lower.str.row(o, &mut k, "bool", lower.str.op2("icmp.lt.u32 ", 1usize, c3)?.as_str())?
    o.push_str("    br_if %")?
    o.push_str(lower.cx.dec(l3)?.as_str())?
    o.push_str(", b7(), b8()\n")?
    lower.str.bh(o, 7usize, "")?
    lower.str.enc(o, &mut k, base, 3usize)?
    lower.str.bh(o, 8usize, "")?
    lower.str.enc(o, &mut k, base, 4usize)?
    let wp = k
    k = k + 1usize
    let mut hd = std.string.String.new()
    hd.push('%')?
    hd.push_str(lower.cx.dec(wp)?.as_str())?
    hd.push_str(": usize")?
    lower.str.bh(o, 9usize, hd.as_str())?
    let nl = lower.str.row(o, &mut k, "usize", lower.str.op2("add.usize.wrap ", len0, wp)?.as_str())?
    let _q4 = lower.str.row(o, &mut k, "unit", lower.cx.cat2("mem.store.usize %0 +8, %", lower.cx.dec(nl)?.as_str())?.as_str())?
    let u = lower.str.row(o, &mut k, "unit", "const.unit ()")?
    let okv = lower.str.row(o, &mut k, rt, lower.cx.cat2("ok %", lower.cx.dec(u)?.as_str())?.as_str())?
    o.push_str("    ret %")?
    o.push_str(lower.cx.dec(okv)?.as_str())?
    o.push('\n')?
    o.push_str("end ")?
    o.push_str(fq)?
    o.push('\n')?
    Ok(())
end lower.str.push_char_text

fn lower.str.push_str(env: &types.env.Env, c: &mut lower.cx.Cx, h: usize, text: usize, t: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let src = lower.cx.def(c, "ptr", lower.expr.field_src(text, 0usize)?.as_str())?
    let tlen = lower.cx.def(c, "usize", lower.expr.field_src(text, 8usize)?.as_str())?
    let len0 = lower.vec.load_usize(c, h, 8usize)?
    let cap0 = lower.vec.load_usize(c, h, 16usize)?
    let need = lower.vec.arith(c, "add", len0, tlen)?
    let ogs = lower.cx.cat2("icmp.gt.usize ", lower.expr.two(need, cap0)?.as_str())?
    let over = lower.cx.def(c, "bool", ogs.as_str())?
    let empty = std.vec.Vec.new()
    let growb = lower.cx.blk(c, &empty)?
    let okb = lower.cx.blk(c, &empty)?
    let rt = lower.tyk.text(env, c, t)?
    let mut jps = std.vec.Vec.new()
    jps.push(lower.cx.newval(c, rt.as_str())?)?
    let jb = lower.cx.blk(c, &jps)?
    let mut brs = lower.cx.cat2("br_if ", lower.cx.vs(over)?.as_str())?
    brs.push_str(", ")?
    brs.push_str(lower.cx.target(growb, &empty)?.as_str())?
    brs.push_str(", ")?
    brs.push_str(lower.cx.target(okb, &empty)?.as_str())?
    lower.cx.finish(c, brs)?
    lower.cx.goto(c, growb)
    let s1 = lower.vec.arith(c, "add", cap0, need)?
    let two = lower.vec.usize_c(c, 2usize)?
    let s2 = lower.vec.arith(c, "mul", s1, two)?
    let four = lower.vec.usize_c(c, 4usize)?
    let ncap = lower.vec.arith(c, "add", s2, four)?
    let p0 = lower.vec.load_ptr(c, h)?
    let rls = lower.cx.cat2("heap.realloc ", lower.expr.two(p0, ncap)?.as_str())?
    let np = lower.cx.def(c, "ptr", rls.as_str())?
    core.mem.drop(lower.vec.store_at(c, "ptr", h, 0usize, np)?)
    core.mem.drop(lower.vec.store_at(c, "usize", h, 16usize, ncap)?)
    lower.cx.finish(c, lower.cx.cat2("br ", lower.cx.target(okb, &empty)?.as_str())?)?
    lower.cx.goto(c, okb)
    let p1 = lower.vec.load_ptr(c, h)?
    let dst = lower.vec.padd(c, p1, len0)?
    let ivs = lower.cx.newval(c, "usize")?
    let mut hps = std.vec.Vec.new()
    hps.push(ivs)?
    let hb = lower.cx.blk(c, &hps)?
    let bodyb = lower.cx.blk(c, &empty)?
    let exitb = lower.cx.blk(c, &empty)?
    let zero = lower.vec.usize_c(c, 0usize)?
    let mut a0 = std.vec.Vec.new()
    a0.push(zero)?
    lower.cx.finish(c, lower.cx.cat2("br ", lower.cx.target(hb, &a0)?.as_str())?)?
    lower.cx.goto(c, hb)
    let lcs = lower.cx.cat2("icmp.lt.usize ", lower.expr.two(ivs, tlen)?.as_str())?
    let lc = lower.cx.def(c, "bool", lcs.as_str())?
    let mut lb = lower.cx.cat2("br_if ", lower.cx.vs(lc)?.as_str())?
    lb.push_str(", ")?
    lb.push_str(lower.cx.target(bodyb, &empty)?.as_str())?
    lb.push_str(", ")?
    lb.push_str(lower.cx.target(exitb, &empty)?.as_str())?
    lower.cx.finish(c, lb)?
    lower.cx.goto(c, bodyb)
    let sa = lower.vec.padd(c, src, ivs)?
    let lds = lower.cx.cat2("mem.load.u8 ", lower.cx.vs(sa)?.as_str())?
    let lds2 = lower.cx.cat2(lds.as_str(), " +0")?
    let byte = lower.cx.def(c, "u8", lds2.as_str())?
    let da = lower.vec.padd(c, dst, ivs)?
    let sts = lower.cx.cat2("mem.store.u8 ", lower.cx.vs(da)?.as_str())?
    let sts2 = lower.cx.cat2(sts.as_str(), " +0, ")?
    let sts3 = lower.cx.cat2(sts2.as_str(), lower.cx.vs(byte)?.as_str())?
    core.mem.drop(lower.cx.def(c, "unit", sts3.as_str())?)
    let one = lower.vec.usize_c(c, 1usize)?
    let iv1 = lower.vec.arith(c, "add", ivs, one)?
    let mut a1 = std.vec.Vec.new()
    a1.push(iv1)?
    lower.cx.finish(c, lower.cx.cat2("br ", lower.cx.target(hb, &a1)?.as_str())?)?
    lower.cx.goto(c, exitb)
    core.mem.drop(lower.vec.store_at(c, "usize", h, 8usize, need)?)
    let u = lower.expr.unit(c)?
    let okv = lower.cx.def1(c, rt.as_str(), "ok ", u)?
    let mut a2 = std.vec.Vec.new()
    a2.push(okv)?
    lower.cx.finish(c, lower.cx.cat2("br ", lower.cx.target(jb, &a2)?.as_str())?)?
    lower.cx.goto(c, jb)
    Ok(lower.cx.R { v: lower.tyk.at(jps.as_slice(), 0usize), t: t })
end lower.str.push_str

fn lower.str.push_u64_text(o: &mut std.string.String, fq: &str, key: &str, rt: &str) -> Result<(), resolve.Failure> uses [alloc] panics may pub
    o.push_str("fn ")?
    o.push_str(fq)?
    o.push_str(" key=")?
    o.push_str(key)?
    o.push_str(" uses=[alloc] panics=never stack=- ret=")?
    o.push_str(rt)?
    o.push('\n')?
    lower.str.bh(o, 0usize, "%0: ptr, %1: u64")?
    let mut k = 2usize
    let len0 = lower.str.row(o, &mut k, "usize", "mem.load.usize %0 +8")?
    let cap0 = lower.str.row(o, &mut k, "usize", "mem.load.usize %0 +16")?
    let c20 = lower.str.row(o, &mut k, "usize", "const.usize 20")?
    let need = lower.str.row(o, &mut k, "usize", lower.str.op2("add.usize.wrap ", len0, c20)?.as_str())?
    let over = lower.str.row(o, &mut k, "bool", lower.str.op2("icmp.gt.usize ", need, cap0)?.as_str())?
    o.push_str("    br_if %")?
    o.push_str(lower.cx.dec(over)?.as_str())?
    o.push_str(", b1(), b2()\n")?
    lower.str.bh(o, 1usize, "")?
    let s1 = lower.str.row(o, &mut k, "usize", lower.str.op2("add.usize.wrap ", cap0, need)?.as_str())?
    let two = lower.str.row(o, &mut k, "usize", "const.usize 2")?
    let s2 = lower.str.row(o, &mut k, "usize", lower.str.op2("mul.usize.wrap ", s1, two)?.as_str())?
    let four = lower.str.row(o, &mut k, "usize", "const.usize 4")?
    let ncap = lower.str.row(o, &mut k, "usize", lower.str.op2("add.usize.wrap ", s2, four)?.as_str())?
    let p0 = lower.str.row(o, &mut k, "ptr", "mem.load.ptr %0 +0")?
    let np = lower.str.row(o, &mut k, "ptr", lower.str.op2("heap.realloc ", p0, ncap)?.as_str())?
    let _q2 = lower.str.row(o, &mut k, "unit", lower.cx.cat2("mem.store.ptr %0 +0, %", lower.cx.dec(np)?.as_str())?.as_str())?
    let _q3 = lower.str.row(o, &mut k, "unit", lower.cx.cat2("mem.store.usize %0 +16, %", lower.cx.dec(ncap)?.as_str())?.as_str())?
    o.push_str("    br b2()\n")?
    lower.str.bh(o, 2usize, "")?
    let p1 = lower.str.row(o, &mut k, "ptr", "mem.load.ptr %0 +0")?
    let base = lower.str.row(o, &mut k, "ptr", lower.str.op2("ptr.add ", p1, len0)?.as_str())?
    let one = lower.str.row(o, &mut k, "usize", "const.usize 1")?
    let zus = lower.str.row(o, &mut k, "usize", "const.usize 0")?
    let ten = lower.str.row(o, &mut k, "u64", "const.u64 10")?
    o.push_str("    br b3(%1, %")?
    o.push_str(lower.cx.dec(one)?.as_str())?
    o.push_str(")\n")?
    let n3 = k
    let d3 = k + 1usize
    k = k + 2usize
    let mut h3 = std.string.String.new()
    lower.str.pv(&mut h3, n3)?
    h3.push_str(": u64, ")?
    lower.str.pv(&mut h3, d3)?
    h3.push_str(": usize")?
    lower.str.bh(o, 3usize, h3.as_str())?
    let big = lower.str.row(o, &mut k, "bool", lower.str.op2("icmp.ge.u64 ", n3, ten)?.as_str())?
    o.push_str("    br_if %")?
    o.push_str(lower.cx.dec(big)?.as_str())?
    o.push_str(", b4(), b5()\n")?
    lower.str.bh(o, 4usize, "")?
    let n4 = lower.str.row(o, &mut k, "u64", lower.str.op2("div.u64.trap ", n3, ten)?.as_str())?
    let d4 = lower.str.row(o, &mut k, "usize", lower.str.op2("add.usize.wrap ", d3, one)?.as_str())?
    o.push_str("    br b3(%")?
    o.push_str(lower.cx.dec(n4)?.as_str())?
    o.push_str(", %")?
    o.push_str(lower.cx.dec(d4)?.as_str())?
    o.push_str(")\n")?
    lower.str.bh(o, 5usize, "")?
    o.push_str("    br b6(%1, %")?
    o.push_str(lower.cx.dec(d3)?.as_str())?
    o.push_str(")\n")?
    let x6 = k
    let i6 = k + 1usize
    k = k + 2usize
    let mut h6 = std.string.String.new()
    lower.str.pv(&mut h6, x6)?
    h6.push_str(": u64, ")?
    lower.str.pv(&mut h6, i6)?
    h6.push_str(": usize")?
    lower.str.bh(o, 6usize, h6.as_str())?
    let i1 = lower.str.row(o, &mut k, "usize", lower.str.op2("sub.usize.wrap ", i6, one)?.as_str())?
    let r6 = lower.str.row(o, &mut k, "u64", lower.str.op2("rem.u64.trap ", x6, ten)?.as_str())?
    let r8 = lower.str.row(o, &mut k, "u8", lower.cx.cat2("conv.u8.u64 %", lower.cx.dec(r6)?.as_str())?.as_str())?
    let c48 = lower.str.row(o, &mut k, "u8", "const.u8 48")?
    let ch = lower.str.row(o, &mut k, "u8", lower.str.op2("add.u8.wrap ", r8, c48)?.as_str())?
    let dst = lower.str.row(o, &mut k, "ptr", lower.str.op2("ptr.add ", base, i1)?.as_str())?
    let mut sw = lower.cx.cat2("mem.store.u8 %", lower.cx.dec(dst)?.as_str())?
    sw.push_str(" +0, %")?
    sw.push_str(lower.cx.dec(ch)?.as_str())?
    let _sw = lower.str.row(o, &mut k, "unit", sw.as_str())?
    let x2 = lower.str.row(o, &mut k, "u64", lower.str.op2("div.u64.trap ", x6, ten)?.as_str())?
    let dn = lower.str.row(o, &mut k, "bool", lower.str.op2("icmp.eq.usize ", i1, zus)?.as_str())?
    o.push_str("    br_if %")?
    o.push_str(lower.cx.dec(dn)?.as_str())?
    o.push_str(", b7(), b6(%")?
    o.push_str(lower.cx.dec(x2)?.as_str())?
    o.push_str(", %")?
    o.push_str(lower.cx.dec(i1)?.as_str())?
    o.push_str(")\n")?
    lower.str.bh(o, 7usize, "")?
    let nl = lower.str.row(o, &mut k, "usize", lower.str.op2("add.usize.wrap ", len0, d3)?.as_str())?
    let _q4 = lower.str.row(o, &mut k, "unit", lower.cx.cat2("mem.store.usize %0 +8, %", lower.cx.dec(nl)?.as_str())?.as_str())?
    let u = lower.str.row(o, &mut k, "unit", "const.unit ()")?
    let okv = lower.str.row(o, &mut k, rt, lower.cx.cat2("ok %", lower.cx.dec(u)?.as_str())?.as_str())?
    o.push_str("    ret %")?
    o.push_str(lower.cx.dec(okv)?.as_str())?
    o.push('\n')?
    o.push_str("end ")?
    o.push_str(fq)?
    o.push('\n')?
    Ok(())
end lower.str.push_u64_text

fn lower.str.pv(s: &mut std.string.String, k: usize) -> Result<(), resolve.Failure> uses [alloc] panics never pub
    s.push('%')?
    s.push_str(lower.cx.dec(k)?.as_str())?
    Ok(())
end lower.str.pv

fn lower.str.row(o: &mut std.string.String, k: &mut usize, ty: &str, op: &str) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let id = *k
    *k = id + 1usize
    o.push_str("    %")?
    o.push_str(lower.cx.dec(id)?.as_str())?
    o.push_str(": ")?
    o.push_str(ty)?
    o.push_str(" = ")?
    o.push_str(op)?
    o.push('\n')?
    Ok(id)
end lower.str.row
