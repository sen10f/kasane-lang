// 型の下ろし: types の型 id を KIR の型の文字列にし、集成体 (構造体・列挙型) の番号とレイアウトを決める。
// 集成体は見つけた順に agg#N を振る (ksn kir の番号とは一致しないことがある。比べるときは名前で正規化する)。
// 文字列の参照 (`&str`) の集成体 `fat` = {ptr, len}。項目の代わりに番号 FAT を使う。
// `Option<&T>` (T は構造体・列挙型) の中身: 要素の番地だけの集成体 `bref`。
const lower.tyk.BREF: usize = 1_999_999_999usize pub

const lower.tyk.FAT: usize = 4_294_967_295usize pub

// 総称の集成体 (ユーザーの総称の型の具体化) の項目の基点 (INS + 添字、添字は tps の添字)。
const lower.tyk.INS: usize = 2_500_000_000usize pub

// 組の集成体の項目の基点 (TUP + 添字)。
const lower.tyk.TUP: usize = 2_000_000_000usize pub

// `Vec<T>` の枠 `vec` = {ptr, len, cap} (24 バイト。要素の型は枠に入れない)。項目の代わりに番号 VEC を使う。
const lower.tyk.VEC: usize = 4_294_967_294usize pub

// 要素が所有物の `Vec` の枠 `vec<#E>` の項目の基点 (VECO + 要素の集成体の番号)。配置は `vec` と同じ。
const lower.tyk.VECO: usize = 1_000_000_000usize pub

// 集成体のレイアウト: 大きさ・そろえ・フィールドの末尾からのバイト位置。
// 列挙型は `offs` を変種の順に並べ (変種 j の i 番目は vlens の和 + i)、`vlens` に変種ごとの個数を入れる。
type lower.tyk.Lay pub
    size: usize pub
    align: usize pub
    offs: alloc.vec.Vec<usize, std.alloc.System> pub
    vlens: alloc.vec.Vec<usize, std.alloc.System> pub
end lower.tyk.Lay

// 集成体の行の本体 (総称の具体化は `agg_line` が代入を入れてから呼ぶ)。
fn lower.tyk.agg_body(env: &types.env.Env, c: &mut lower.cx.Cx, item: usize, id: usize) -> Result<alloc.string.String<std.alloc.System>, resolve.Failure> uses [alloc] panics may pub
    if item >= lower.tyk.TUP && item < lower.tyk.INS {
        return lower.tup.agg_line(env, c, item, id)
    }
    if item == lower.tyk.VEC {
        let mut vs = alloc.string.String.new(std.alloc.SYSTEM)
        vs.push_str("agg#")?
        vs.push_str(lower.cx.dec(id)?.as_str())?
        vs.push_str(" struct vec size=24 align=8 {ptr:ptr@0 len:usize@8 cap:usize@16}\n")?
        return Ok(vs)
    }
    if item >= lower.tyk.VECO && item < lower.tyk.BREF {
        let mut vo = alloc.string.String.new(std.alloc.SYSTEM)
        vo.push_str("agg#")?
        vo.push_str(lower.cx.dec(id)?.as_str())?
        vo.push_str(" struct vec<#")?
        vo.push_str(lower.cx.dec(item - lower.tyk.VECO)?.as_str())?
        vo.push_str("> size=24 align=8 {ptr:ptr@0 len:usize@8 cap:usize@16}\n")?
        return Ok(vo)
    }
    if item == lower.tyk.BREF {
        let mut bs = alloc.string.String.new(std.alloc.SYSTEM)
        bs.push_str("agg#")?
        bs.push_str(lower.cx.dec(id)?.as_str())?
        bs.push_str(" struct bref size=8 align=8 {ptr:ptr@0}\n")?
        return Ok(bs)
    }
    if item == lower.tyk.FAT {
        let mut fs = alloc.string.String.new(std.alloc.SYSTEM)
        fs.push_str("agg#")?
        fs.push_str(lower.cx.dec(id)?.as_str())?
        fs.push_str(" struct fat size=16 align=8 {ptr:ptr@0 len:usize@8}\n")?
        return Ok(fs)
    }
    let mut s = alloc.string.String.new(std.alloc.SYSTEM)
    let lay = lower.tyk.layout(env, c, item)?
    let real = lower.tyk.real_item(c, item)
    let kind = types.infer.item_kind(env, real)
    let file = types.infer.item_file(env, real)
    let node = types.infer.item_node(env, real)
    let fqn = if item >= lower.tyk.INS && item < lower.tyk.VEC {
        lower.tup.name(env, c, lower.tyk.at(c.g.tps.as_slice(), item - lower.tyk.INS))?
    } else {
        match env.tab.items.as_slice().get(item) {
            Some(it) => lower.cx.own(it.fqn.as_str())?
            None => alloc.string.String.new(std.alloc.SYSTEM)
        }
    }
    let p = match types.env.unit(env, file) {
        Some(q) => q
        None => return Ok(s)
    }
    let src_r = match env.srcs.as_slice().get(file) {
        Some(x) => x
        None => return Ok(s)
    }
    let src = src_r.text.as_slice()
    let nd = parse.ast.get(&p.ast, node)
    s.push_str("agg#")?
    s.push_str(lower.cx.dec(id)?.as_str())?
    if kind == parse.ast.Kind.TypeDef {
        s.push_str(" struct ")?
    } else {
        s.push_str(" enum ")?
    }
    s.push_str(fqn.as_str())?
    s.push_str(" size=")?
    s.push_str(lower.cx.dec(lay.size)?.as_str())?
    s.push_str(" align=")?
    s.push_str(lower.cx.dec(lay.align)?.as_str())?
    s.push_str(" {")?
    if kind == parse.ast.Kind.TypeDef {
        for j in core.iter.range(0usize, resolve.ast.count(p, nd.d)) {
            let fd = parse.ast.get(&p.ast, resolve.ast.item(p, nd.d, j))
            let ft = lower.tyk.fty(env, c, p, src, file, nd.c, fd.b)?
            let tt = lower.tyk.text(env, c, ft)?
            if j > 0usize {
                s.push(' ')?
            }
            s.push_str(resolve.ast.tok_text(p, src, fd.a))?
            s.push(':')?
            s.push_str(tt.as_str())?
            s.push('@')?
            let o = match lay.offs.as_slice().get(j) {
                Some(x) => *x
                None => 0usize
            }
            s.push_str(lower.cx.dec(o)?.as_str())?
        }
    } else {
        let mut base = 0usize
        for j in core.iter.range(0usize, resolve.ast.count(p, nd.d)) {
            let vn = parse.ast.get(&p.ast, resolve.ast.item(p, nd.d, j))
            if j > 0usize {
                s.push(' ')?
            }
            s.push_str(resolve.ast.tok_text(p, src, vn.a))?
            s.push('(')?
            let cnt = resolve.ast.count(p, vn.b)
            for i in core.iter.range(0usize, cnt) {
                let pn = resolve.ast.item(p, vn.b, i)
                let pt = lower.tyk.fty(env, c, p, src, file, nd.c, pn)?
                let tt = lower.tyk.text(env, c, pt)?
                if i > 0usize {
                    s.push(',')?
                }
                s.push_str(tt.as_str())?
                s.push('@')?
                let o = match lay.offs.as_slice().get(base + i) {
                    Some(x) => *x
                    None => 0usize
                }
                s.push_str(lower.cx.dec(o)?.as_str())?
            }
            base = base + cnt
            s.push(')')?
        }
    }
    s.push_str("}\n")?
    Ok(s)
end lower.tyk.agg_body

// 集成体の番号 (なければ登録する)。
fn lower.tyk.agg_id(c: &mut lower.cx.Cx, item: usize) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let mut k = 0usize
    for it in c.g.aggs.as_slice().iter() {
        if *it == item {
            return Ok(k)
        }
        k = k + 1usize
    }
    c.g.aggs.push(item)?
    Ok(c.g.aggs.len() - 1usize)
end lower.tyk.agg_id

fn lower.tyk.agg_line(env: &types.env.Env, c: &mut lower.cx.Cx, item: usize, id: usize) -> Result<alloc.string.String<std.alloc.System>, resolve.Failure> uses [alloc] panics may pub
    if item >= lower.tyk.INS && item < lower.tyk.VEC {
        let saved = lower.tyk.enter(c, item)?
        let r = lower.tyk.agg_body(env, c, item, id)
        lower.tyk.leave(c, saved)
        return r
    }
    lower.tyk.agg_body(env, c, item, id)
end lower.tyk.agg_line

// 集成体の定義の行 (`agg#N struct FQN size=S align=A {...}`) を、登録の順に全部作る。
fn lower.tyk.agg_lines(env: &types.env.Env, c: &mut lower.cx.Cx) -> Result<alloc.string.String<std.alloc.System>, resolve.Failure> uses [alloc] panics may pub
    let mut out = alloc.string.String.new(std.alloc.SYSTEM)
    let mut i = 0usize
    while i < c.g.aggs.len() {
        let item = lower.tyk.at(c.g.aggs.as_slice(), i)
        out.push_str(lower.tyk.agg_line(env, c, item, i)?.as_str())?
        i = i + 1usize
    }
    Ok(out)
end lower.tyk.agg_lines

// 並びの i 番目 (なければ 0)。
fn lower.tyk.at(xs: &[usize], i: usize) -> usize uses [] panics may pub
    match xs.get(i) {
        Some(x) => *x
        None => 0usize
    }
end lower.tyk.at

// `bref` の型の綴り (`agg#N`)。
fn lower.tyk.bref_text(c: &mut lower.cx.Cx) -> Result<alloc.string.String<std.alloc.System>, resolve.Failure> uses [alloc] panics may pub
    let id = lower.tyk.agg_id(c, lower.tyk.BREF)?
    lower.cx.cat2("agg#", lower.cx.dec(id)?.as_str())
end lower.tyk.bref_text

// 具体化の項目の引数を代入に入れる (元の値は返す)。
fn lower.tyk.enter(c: &mut lower.cx.Cx, item: usize) -> Result<alloc.vec.Vec<usize, std.alloc.System>, resolve.Failure> uses [alloc] panics may pub
    let saved = lower.cx.copy_u(&c.v.subst)?
    let ty = lower.tyk.at(c.g.tps.as_slice(), item - lower.tyk.INS)
    let f = types.ty.find(&c.ar, ty)
    let n = types.ty.node(&c.ar, f)
    let mut na = alloc.vec.Vec.new(std.alloc.SYSTEM)
    for k in core.iter.range(0usize, n.c) {
        // 代入は (総称の番号, 型) の組。総称の番号は定義の並び (0 から) と同じ。
        na.push(k)?
        na.push(types.ty.arg(&c.ar, n.b, k))?
    }
    c.v.subst = na
    Ok(saved)
end lower.tyk.enter

// 構造体のフィールドの添字 (見つからなければ 0。呼び出し側は未対応として扱う)。
fn lower.tyk.field_index(env: &types.env.Env, item: usize, name: &str) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let names = lower.tyk.field_names(env, item)?
    let mut k = 0usize
    while k < names.len() {
        let same = match names.as_slice().get(k) {
            Some(nm) => nm.as_str() == name
            None => false
        }
        if same {
            return Ok(k)
        }
        k = k + 1usize
    }
    Ok(0usize)
end lower.tyk.field_index

// 構造体の宣言の順のフィールド名 (0 から)。
fn lower.tyk.field_names(env: &types.env.Env, item: usize) -> Result<alloc.vec.Vec<alloc.string.String<std.alloc.System>, std.alloc.System>, resolve.Failure> uses [alloc] panics may pub
    let mut out = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let file = types.infer.item_file(env, item)
    let node = types.infer.item_node(env, item)
    let p = match types.env.unit(env, file) {
        Some(q) => q
        None => return Ok(out)
    }
    let src_r = match env.srcs.as_slice().get(file) {
        Some(s) => s
        None => return Ok(out)
    }
    let src = src_r.text.as_slice()
    let nd = parse.ast.get(&p.ast, node)
    for j in core.iter.range(0usize, resolve.ast.count(p, nd.d)) {
        let fd = parse.ast.get(&p.ast, resolve.ast.item(p, nd.d, j))
        out.push(lower.cx.own(resolve.ast.tok_text(p, src, fd.a))?)?
    }
    Ok(out)
end lower.tyk.field_names

// 構造体 item のフィールド name の型 (総称でない構造体向け。見つからなければ UNKNOWN)。
fn lower.tyk.field_ty(env: &types.env.Env, c: &mut lower.cx.Cx, item: usize, name: &str) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let file = types.infer.item_file(env, item)
    let node = types.infer.item_node(env, item)
    let p = match types.env.unit(env, file) {
        Some(q) => q
        None => return Ok(types.ty.UNKNOWN)
    }
    let src_r = match env.srcs.as_slice().get(file) {
        Some(s) => s
        None => return Ok(types.ty.UNKNOWN)
    }
    let src = src_r.text.as_slice()
    let nd = parse.ast.get(&p.ast, node)
    for j in core.iter.range(0usize, resolve.ast.count(p, nd.d)) {
        let fd = parse.ast.get(&p.ast, resolve.ast.item(p, nd.d, j))
        if resolve.ast.tok_text(p, src, fd.a) == name {
            return lower.tyk.fty(env, c, p, src, file, nd.c, fd.b)
        }
    }
    Ok(types.ty.UNKNOWN)
end lower.tyk.field_ty

// 欄の型 (宣言の型の節 tn を読み、具体化の代入を当てる)。総称の名前 (gl の並び) は Param (0 から) として見せる。
fn lower.tyk.fty(env: &types.env.Env, c: &mut lower.cx.Cx, p: &parse.cur.P, src: &[u8], file: usize, gl: usize, tn: usize) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let mark = c.tc.sc.len()
    let toks = types.lower.tparams(p, gl)?
    let mut k = 0usize
    for tk in toks.as_slice().iter() {
        let name = resolve.ast.tok_text(p, src, *tk)
        let pt = types.ty.param(&mut c.ar, k)?
        types.chk.push(&mut c.tc, name, pt, true)?
        k = k + 1usize
    }
    let t0 = types.lower.ty(env, &mut c.ar, &c.tc, p, src, file, tn)?
    types.chk.truncate(&mut c.tc, mark)
    lower.inst.subst(c, t0)
end lower.tyk.fty

fn lower.tyk.int_bytes(name: &str) -> usize uses [] panics may pub
    if name == "i8" || name == "u8" {
        return 1usize
    }
    if name == "i16" || name == "u16" {
        return 2usize
    }
    if name == "i32" || name == "u32" {
        return 4usize
    }
    if name == "i128" || name == "u128" {
        return 16usize
    }
    8usize
end lower.tyk.int_bytes

// 型 t が `&str` / `&[T]` (fat の値)。
fn lower.tyk.is_fat_ty(c: &lower.cx.Cx, t: usize) -> bool uses [alloc] panics may pub
    let n = types.ty.node(&c.ar, types.ty.find(&c.ar, t))
    if n.k == types.ty.K.Str {
        return true
    }
    n.k == types.ty.K.Ref && types.ty.node(&c.ar, types.ty.find(&c.ar, n.a)).k == types.ty.K.Slice
end lower.tyk.is_fat_ty

// 総称の型 (引数のある構造体・列挙型) か。Option と Result は別に扱う。
fn lower.tyk.is_generic_adt(env: &types.env.Env, c: &lower.cx.Cx, f: usize) -> bool uses [alloc] panics may pub
    let n = types.ty.node(&c.ar, f)
    if n.k != types.ty.K.Adt || n.c == 0usize {
        return false
    }
    // 型引数が未決め (Param) の具体化は下ろせない (展開が止まらない)。標準の型もここを通る。
    if lower.inst.has_param(c, f) {
        return false
    }
    let kind = types.infer.item_kind(env, n.a)
    kind == parse.ast.Kind.TypeDef || kind == parse.ast.Kind.EnumDef
end lower.tyk.is_generic_adt

// 型 t が `Option<整数・bool>` (値の Option)。
fn lower.tyk.is_opt_scalar(env: &types.env.Env, c: &lower.cx.Cx, t: usize) -> bool uses [alloc] panics may pub
    let n = types.ty.node(&c.ar, types.ty.find(&c.ar, t))
    if n.k != types.ty.K.Adt || n.c != 1usize || lower.opt.kind(env, n.a) != 1usize {
        return false
    }
    let mut a0 = types.ty.arg(&c.ar, n.b, 0usize)
    if lower.tyk.ref_scalar(c, a0) {
        a0 = types.ty.node(&c.ar, types.ty.find(&c.ar, a0)).a
    }
    let k = types.ty.node(&c.ar, types.ty.find(&c.ar, a0)).k
    k == types.ty.K.Int || k == types.ty.K.Bool
end lower.tyk.is_opt_scalar

// 項目が `alloc.vec.Vec` か。
fn lower.tyk.is_vec(env: &types.env.Env, item: usize) -> bool uses [alloc] panics may pub
    let fq = lower.tyk.item_fqn(env, item)
    fq.as_str() == "alloc.vec.Vec" || fq.as_str() == "alloc.string.String"
end lower.tyk.is_vec

// 型 (参照を外した後) が Vec か。
fn lower.tyk.is_vec_ty(env: &types.env.Env, c: &lower.cx.Cx, t: usize) -> bool uses [alloc] panics may pub
    let f = types.ty.strip(&c.ar, t)
    let n = types.ty.node(&c.ar, f)
    n.k == types.ty.K.Adt && lower.tyk.is_vec(env, n.a)
end lower.tyk.is_vec_ty

// 項目の FQN (なければ空)。
fn lower.tyk.item_fqn(env: &types.env.Env, item: usize) -> alloc.string.String<std.alloc.System> uses [alloc] panics may pub
    match env.tab.items.as_slice().get(item) {
        Some(it) => {
            match lower.cx.own(it.fqn.as_str()) {
                Ok(o) => {
                    o
                }
                Err(_e) => {
                    alloc.string.String.new(std.alloc.SYSTEM)
                }
            }
        }
        None => {
            alloc.string.String.new(std.alloc.SYSTEM)
        }
    }
end lower.tyk.item_fqn

// 構造体リテラルの型の集成体の番号の項目: 総称の具体化なら具体化の項目、それ以外は定義の項目。
fn lower.tyk.key_of(env: &types.env.Env, c: &mut lower.cx.Cx, t: usize, item: usize) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let f = types.ty.find(&c.ar, t)
    if lower.tyk.is_generic_adt(env, c, f) {
        return lower.tup.reg(env, c, f, lower.tyk.INS)
    }
    Ok(item)
end lower.tyk.key_of

// 型の種類の名前 (診断用)。
fn lower.tyk.kind_word(k: types.ty.K) -> &'static str uses [] panics may pub
    if k == types.ty.K.Ref {
        return "参照"
    }
    if k == types.ty.K.Tuple {
        return "組"
    }
    if k == types.ty.K.Str {
        return "str"
    }
    if k == types.ty.K.Array {
        return "配列"
    }
    if k == types.ty.K.Slice {
        return "スライス"
    }
    if k == types.ty.K.Param {
        return "型引数"
    }
    if k == types.ty.K.Fnty {
        return "関数の型"
    }
    if k == types.ty.K.Var {
        return "決まらない型"
    }
    if k == types.ty.K.Never {
        return "never"
    }
    if k == types.ty.K.Opaque {
        return "不透明"
    }
    "その他"
end lower.tyk.kind_word

// 項目 (構造体・列挙型) のレイアウト。
fn lower.tyk.layout(env: &types.env.Env, c: &mut lower.cx.Cx, item: usize) -> Result<lower.tyk.Lay, resolve.Failure> uses [alloc] panics may pub
    if item >= lower.tyk.INS && item < lower.tyk.VEC {
        // 代入の組が深すぎる = 総称の型が自分を含む (再帰)。未対応として空の大きさを返す。
        if c.v.subst.len() > 400usize {
            let nm = lower.tup.name(env, c, lower.tyk.at(c.g.tps.as_slice(), item - lower.tyk.INS))?
            let msg = lower.cx.cat2("総称の型の大きさ (再帰する型は未対応): ", nm.as_str())?
            lower.cx.fail(c, msg.as_str())?
            let e1 = alloc.vec.Vec.new(std.alloc.SYSTEM)
            let e2 = alloc.vec.Vec.new(std.alloc.SYSTEM)
            return Ok(lower.tyk.Lay { size: 0usize, align: 1usize, offs: e1, vlens: e2 })
        }
        let saved = lower.tyk.enter(c, item)?
        let r = lower.tyk.layout(env, c, lower.tyk.real_item(c, item))?
        lower.tyk.leave(c, saved)
        return Ok(r)
    }
    if item >= lower.tyk.TUP && item < lower.tyk.INS {
        let tt = lower.tyk.at(c.g.tps.as_slice(), item - lower.tyk.TUP)
        let f = types.ty.find(&c.ar, tt)
        let n = types.ty.node(&c.ar, f)
        let mut offs = alloc.vec.Vec.new(std.alloc.SYSTEM)
        let mut off = 0usize
        let mut al = 1usize
        for k in core.iter.range(0usize, n.c) {
            let et = types.ty.arg(&c.ar, n.b, k)
            let (sz, a) = lower.tyk.size_of(env, c, et)?
            off = lower.tyk.up(off, a)
            offs.push(off)?
            off = off + sz
            if a > al {
                al = a
            }
        }
        let size = lower.tyk.up(off, al)
        let vl = alloc.vec.Vec.new(std.alloc.SYSTEM)
        return Ok(lower.tyk.Lay { size: size, align: al, offs: offs, vlens: vl })
    }
    if item == lower.tyk.VEC || item >= lower.tyk.VECO && item < lower.tyk.BREF {
        let vo = alloc.vec.Vec.new(std.alloc.SYSTEM)
        let vl = alloc.vec.Vec.new(std.alloc.SYSTEM)
        return Ok(lower.tyk.Lay { size: 24usize, align: 8usize, offs: vo, vlens: vl })
    }
    if item == lower.tyk.FAT {
        let fo = alloc.vec.Vec.new(std.alloc.SYSTEM)
        let fl = alloc.vec.Vec.new(std.alloc.SYSTEM)
        return Ok(lower.tyk.Lay { size: 16usize, align: 8usize, offs: fo, vlens: fl })
    }
    let file = types.infer.item_file(env, item)
    let node = types.infer.item_node(env, item)
    let mut offs = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let mut vlens = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let kind = types.infer.item_kind(env, item)
    let p = match types.env.unit(env, file) {
        Some(q) => q
        None => return Ok(lower.tyk.Lay { size: 0usize, align: 1usize, offs: offs, vlens: vlens })
    }
    let src_r = match env.srcs.as_slice().get(file) {
        Some(s) => s
        None => return Ok(lower.tyk.Lay { size: 0usize, align: 1usize, offs: offs, vlens: vlens })
    }
    let src = src_r.text.as_slice()
    let nd = parse.ast.get(&p.ast, node)
    if kind == parse.ast.Kind.TypeDef {
        let mut off = 0usize
        let mut al = 1usize
        for j in core.iter.range(0usize, resolve.ast.count(p, nd.d)) {
            let fd = parse.ast.get(&p.ast, resolve.ast.item(p, nd.d, j))
            let ft = lower.tyk.fty(env, c, p, src, file, nd.c, fd.b)?
            let (sz, a) = lower.tyk.size_of(env, c, ft)?
            off = lower.tyk.up(off, a)
            offs.push(off)?
            off = off + sz
            if a > al {
                al = a
            }
        }
        let size = lower.tyk.up(off, al)
        return Ok(lower.tyk.Lay { size: size, align: al, offs: offs, vlens: vlens })
    }
    // 列挙型: 先頭に 4 バイトの i32 のタグ、変種のペイロードはその後ろ (列挙型全体のそろえの位置から)。
    let mut endp = 4usize
    let mut al = 4usize
    for j in core.iter.range(0usize, resolve.ast.count(p, nd.d)) {
        let vn0 = parse.ast.get(&p.ast, resolve.ast.item(p, nd.d, j))
        for i in core.iter.range(0usize, resolve.ast.count(p, vn0.b)) {
            let pn0 = resolve.ast.item(p, vn0.b, i)
            let pt0 = lower.tyk.fty(env, c, p, src, file, nd.c, pn0)?
            let (_sz0, a0) = lower.tyk.size_of(env, c, pt0)?
            if a0 > al {
                al = a0
            }
        }
    }
    let pbase = lower.tyk.up(4usize, al)
    for j in core.iter.range(0usize, resolve.ast.count(p, nd.d)) {
        let vn = parse.ast.get(&p.ast, resolve.ast.item(p, nd.d, j))
        let cnt = resolve.ast.count(p, vn.b)
        vlens.push(cnt)?
        let mut vend = pbase
        for i in core.iter.range(0usize, cnt) {
            let pn = resolve.ast.item(p, vn.b, i)
            let pt = lower.tyk.fty(env, c, p, src, file, nd.c, pn)?
            let (sz, a) = lower.tyk.size_of(env, c, pt)?
            let off = lower.tyk.up(vend, a)
            offs.push(off)?
            vend = off + sz
            if a > al {
                al = a
            }
        }
        if vend > endp {
            endp = vend
        }
    }
    let size = lower.tyk.up(endp, al)
    Ok(lower.tyk.Lay { size: size, align: al, offs: offs, vlens: vlens })
end lower.tyk.layout

fn lower.tyk.leave(c: &mut lower.cx.Cx, saved: alloc.vec.Vec<usize, std.alloc.System>) -> () uses [] panics may pub
    c.v.subst = saved
end lower.tyk.leave

// 列挙型の項目の変種の数。
fn lower.tyk.nvariants(env: &types.env.Env, item: usize) -> usize uses [alloc] panics may pub
    let file = types.infer.item_file(env, item)
    let node = types.infer.item_node(env, item)
    let p = match types.env.unit(env, file) {
        Some(q) => q
        None => return 0usize
    }
    let nd = parse.ast.get(&p.ast, node)
    resolve.ast.count(p, nd.d)
end lower.tyk.nvariants

// 型 t が、どの変種も値を持たない (欄のない) 利用者の列挙型か。
fn lower.tyk.plain_enum(env: &types.env.Env, c: &lower.cx.Cx, t: usize) -> bool uses [alloc] panics may pub
    let f = types.ty.find(&c.ar, t)
    let n = types.ty.node(&c.ar, f)
    if n.k != types.ty.K.Adt || n.c != 0usize {
        return false
    }
    if types.infer.item_kind(env, n.a) != parse.ast.Kind.EnumDef {
        return false
    }
    let file = types.infer.item_file(env, n.a)
    let node = types.infer.item_node(env, n.a)
    let p = match types.env.unit(env, file) {
        Some(q) => q
        None => return false
    }
    let nd = parse.ast.get(&p.ast, node)
    let cnt = resolve.ast.count(p, nd.d)
    for j in core.iter.range(0usize, cnt) {
        let vn = parse.ast.get(&p.ast, resolve.ast.item(p, nd.d, j))
        if resolve.ast.count(p, vn.b) != 0usize {
            return false
        }
    }
    cnt > 0usize
end lower.tyk.plain_enum

// 整数・bool・文字の大きさ (バイト) とそろえ。未知は 0。
fn lower.tyk.prim_size(t: usize) -> usize uses [] panics may pub
    let f = t
    if f == types.ty.BOOL {
        return 1usize
    }
    if f == types.ty.CHAR {
        return 4usize
    }
    0usize
end lower.tyk.prim_size

// 具体化の項目 (INS + 添字) から、元の定義の項目。それ以外はそのまま。
fn lower.tyk.real_item(c: &lower.cx.Cx, item: usize) -> usize uses [alloc] panics may pub
    if item >= lower.tyk.INS && item < lower.tyk.VEC {
        let ty = lower.tyk.at(c.g.tps.as_slice(), item - lower.tyk.INS)
        let f = types.ty.find(&c.ar, ty)
        return types.ty.node(&c.ar, f).a
    }
    item
end lower.tyk.real_item

// 型 t が、構造体・列挙型 (`Vec` / `String` でない) への参照か。`Option<&T>` の中身は `bref` で持つ。
fn lower.tyk.ref_agg(env: &types.env.Env, c: &lower.cx.Cx, t: usize) -> bool uses [alloc] panics may pub
    let n = types.ty.node(&c.ar, types.ty.find(&c.ar, t))
    if n.k != types.ty.K.Ref {
        return false
    }
    let inn = types.ty.node(&c.ar, types.ty.find(&c.ar, n.a))
    if inn.k != types.ty.K.Adt || inn.c != 0usize || lower.tyk.is_vec(env, inn.a) {
        return false
    }
    let kind = types.infer.item_kind(env, inn.a)
    kind == parse.ast.Kind.TypeDef || kind == parse.ast.Kind.EnumDef
end lower.tyk.ref_agg

// 型 t が、スカラー (整数・浮動小数・bool・char) への参照か。`Option<&スカラー>` は値の `Option<スカラー>` で持つ。
fn lower.tyk.ref_scalar(c: &lower.cx.Cx, t: usize) -> bool uses [alloc] panics may pub
    let n = types.ty.node(&c.ar, types.ty.find(&c.ar, t))
    if n.k != types.ty.K.Ref {
        return false
    }
    let k = types.ty.node(&c.ar, types.ty.find(&c.ar, n.a)).k
    k == types.ty.K.Int || k == types.ty.K.Float || k == types.ty.K.Bool || k == types.ty.K.Char
end lower.tyk.ref_scalar

// 型 (types の型 id) の大きさとそろえ。集成体はレイアウトから。
fn lower.tyk.size_of(env: &types.env.Env, c: &mut lower.cx.Cx, t: usize) -> Result<(usize, usize), resolve.Failure> uses [alloc] panics may pub
    let f = types.ty.find(&c.ar, t)
    let n = types.ty.node(&c.ar, f)
    if n.k == types.ty.K.Int {
        let b = lower.tyk.int_bytes(types.ty.int_name(n.a))
        return Ok((b, b))
    }
    if n.k == types.ty.K.Bool {
        return Ok((1usize, 1usize))
    }
    if n.k == types.ty.K.Char {
        return Ok((4usize, 4usize))
    }
    if n.k == types.ty.K.Str {
        return Ok((16usize, 8usize))
    }
    if n.k == types.ty.K.Tuple && n.c > 0usize {
        let ti = lower.tup.item(env, c, f)?
        let lay = lower.tyk.layout(env, c, ti)?
        return Ok((lay.size, lay.align))
    }
    if n.k == types.ty.K.Adt && lower.tyk.is_vec(env, n.a) {
        return Ok((24usize, 8usize))
    }
    if n.k == types.ty.K.Unit {
        return Ok((0usize, 1usize))
    }
    if n.k == types.ty.K.Ref {
        return Ok((8usize, 8usize))
    }
    if n.k == types.ty.K.Var {
        return Ok((4usize, 4usize))
    }
    if n.k == types.ty.K.Adt && n.c == 0usize {
        let lay = lower.tyk.layout(env, c, n.a)?
        return Ok((lay.size, lay.align))
    }
    if lower.tyk.is_generic_adt(env, c, f) {
        let key = lower.tup.reg(env, c, f, lower.tyk.INS)?
        let lay = lower.tyk.layout(env, c, key)?
        return Ok((lay.size, lay.align))
    }
    lower.cx.fail(c, "型の大きさが分からない")?
    Ok((0usize, 1usize))
end lower.tyk.size_of

// 型の源の綴り (総称の鍵に使う: `u32`・`&str`・`alloc.string.String<std.alloc.System>`)。
fn lower.tyk.src(env: &types.env.Env, c: &mut lower.cx.Cx, t: usize) -> Result<alloc.string.String<std.alloc.System>, resolve.Failure> uses [alloc] panics may pub
    let f = types.ty.find(&c.ar, t)
    let n = types.ty.node(&c.ar, f)
    if n.k == types.ty.K.Param {
        let r = lower.inst.lookup(c, n.a)
        if r != 0usize {
            return lower.tyk.src(env, c, r)
        }
    }
    if n.k == types.ty.K.Char {
        return lower.cx.own("char")
    }
    if n.k == types.ty.K.Unit {
        return lower.cx.own("()")
    }
    if n.k == types.ty.K.Str {
        return lower.cx.own("&str")
    }
    if n.k == types.ty.K.Ref {
        let inner = lower.tyk.src(env, c, n.a)?
        if n.m {
            return lower.cx.cat2("&mut ", inner.as_str())
        }
        return lower.cx.cat2("&", inner.as_str())
    }
    if n.k == types.ty.K.Adt {
        let mut s = lower.tyk.item_fqn(env, n.a)
        let mut na = n.c
        // 省いた割り当て器 (System) は補って書く。
        let fq = lower.tyk.item_fqn(env, n.a)
        let want = if fq.as_str() == "alloc.string.String" {
            1usize
        } else if fq.as_str() == "alloc.vec.Vec" {
            2usize
        } else {
            na
        }
        if want > 0usize {
            s.push('<')?
            for k in core.iter.range(0usize, want) {
                if k > 0usize {
                    s.push(',')?
                }
                if k < na {
                    s.push_str(lower.tyk.src(env, c, types.ty.arg(&c.ar, n.b, k))?.as_str())?
                } else {
                    s.push_str("std.alloc.System")?
                }
            }
            s.push('>')?
        }
        na = want
        core.mem.drop(na)
        return Ok(s)
    }
    lower.tyk.text(env, c, t)
end lower.tyk.src

// types の型 id → KIR の型の文字列。未対応の型は fail して "unit" を返す。
fn lower.tyk.text(env: &types.env.Env, c: &mut lower.cx.Cx, t: usize) -> Result<alloc.string.String<std.alloc.System>, resolve.Failure> uses [alloc] panics may pub
    let f = types.ty.find(&c.ar, t)
    let n = types.ty.node(&c.ar, f)
    let mut s = alloc.string.String.new(std.alloc.SYSTEM)
    if n.k == types.ty.K.Param {
        let r = lower.inst.lookup(c, n.a)
        if r != 0usize {
            return lower.tyk.text(env, c, r)
        }
    }
    if n.k == types.ty.K.Int {
        s.push_str(types.ty.int_name(n.a))?
        return Ok(s)
    }
    if n.k == types.ty.K.Float {
        if f == types.ty.F32 {
            s.push_str("f32")?
        } else {
            s.push_str("f64")?
        }
        return Ok(s)
    }
    if n.k == types.ty.K.Bool {
        s.push_str("bool")?
        return Ok(s)
    }
    if n.k == types.ty.K.Adt && lower.tyk.is_vec(env, n.a) {
        let vit = lower.tyk.vec_item(env, c, f)?
        let vid = lower.tyk.agg_id(c, vit)?
        s.push_str("agg#")?
        s.push_str(lower.cx.dec(vid)?.as_str())?
        return Ok(s)
    }
    if n.k == types.ty.K.Tuple && n.c > 0usize {
        let ti = lower.tup.item(env, c, f)?
        let tid = lower.tyk.agg_id(c, ti)?
        s.push_str("agg#")?
        s.push_str(lower.cx.dec(tid)?.as_str())?
        return Ok(s)
    }
    if n.k == types.ty.K.Str {
        let id = lower.tyk.agg_id(c, lower.tyk.FAT)?
        s.push_str("agg#")?
        s.push_str(lower.cx.dec(id)?.as_str())?
        return Ok(s)
    }
    if n.k == types.ty.K.Unit || n.k == types.ty.K.Never {
        s.push_str("unit")?
        return Ok(s)
    }
    if n.k == types.ty.K.Char {
        s.push_str("u32")?
        return Ok(s)
    }
    if n.k == types.ty.K.Var && n.c == 2usize {
        // 型の決まらない小数リテラル: 既定の f64。
        s.push_str("f64")?
        return Ok(s)
    }
    if n.k == types.ty.K.Var && n.c == 1usize {
        // 型の決まらない整数リテラル: 既定の i32 (検査器の既定と同じ)。
        s.push_str("i32")?
        return Ok(s)
    }
    let rin = types.ty.node(&c.ar, types.ty.find(&c.ar, n.a))
    if n.k == types.ty.K.Ref && rin.k == types.ty.K.Slice {
        // `&[T]` / `&mut [T]`: `&str` と同じ fat の値 {ptr, len}。
        let sid = lower.tyk.agg_id(c, lower.tyk.FAT)?
        s.push_str("agg#")?
        s.push_str(lower.cx.dec(sid)?.as_str())?
        return Ok(s)
    }
    if n.k == types.ty.K.Ref {
        if lower.vec.is_hdr(env, c, n.a) {
            // `&Vec` / `&String` は枠の番地 (ptr)。
            return lower.cx.own("ptr")
        }
        let inner = lower.tyk.text(env, c, n.a)?
        let rt = lower.opt.refty(n.m, inner.as_str())?
        return Ok(rt)
    }
    if n.k == types.ty.K.Adt && lower.opt.kind(env, n.a) == 1usize && n.c == 1usize {
        let mut a0 = types.ty.arg(&c.ar, n.b, 0usize)
        if lower.tyk.ref_scalar(c, a0) {
            a0 = types.ty.node(&c.ar, types.ty.find(&c.ar, a0)).a
        }
        let mut inner = lower.tyk.text(env, c, a0)?
        if lower.tyk.ref_agg(env, c, a0) {
            inner = lower.tyk.bref_text(c)?
        }
        let mut r = lower.cx.cat2("Option<", inner.as_str())?
        r.push('>')?
        return Ok(r)
    }
    if n.k == types.ty.K.Adt && lower.opt.kind(env, n.a) == 2usize && n.c == 2usize {
        let a0 = types.ty.arg(&c.ar, n.b, 0usize)
        let a1 = types.ty.arg(&c.ar, n.b, 1usize)
        let t0 = lower.tyk.text(env, c, a0)?
        let t1 = lower.tyk.text(env, c, a1)?
        let mut r = lower.cx.cat2("Result<", t0.as_str())?
        r.push(',')?
        r.push_str(t1.as_str())?
        r.push('>')?
        return Ok(r)
    }
    if lower.tyk.is_generic_adt(env, c, f) {
        let key = lower.tup.reg(env, c, f, lower.tyk.INS)?
        let id = lower.tyk.agg_id(c, key)?
        s.push_str("agg#")?
        s.push_str(lower.cx.dec(id)?.as_str())?
        return Ok(s)
    }
    if n.k == types.ty.K.Adt && n.c == 0usize {
        let kind = types.infer.item_kind(env, n.a)
        if kind == parse.ast.Kind.TypeDef || kind == parse.ast.Kind.EnumDef {
            let id = lower.tyk.agg_id(c, n.a)?
            s.push_str("agg#")?
            s.push_str(lower.cx.dec(id)?.as_str())?
            return Ok(s)
        }
    }
    let why = lower.tyk.why(env, c, f)?
    let msg = lower.cx.cat2("型の下ろし (未対応の型): ", why.as_str())?
    lower.cx.fail(c, msg.as_str())?
    s.push_str("unit")?
    Ok(s)
end lower.tyk.text

// そろえ `a` の倍数に切り上げる。
fn lower.tyk.up(x: usize, a: usize) -> usize uses [] panics may pub
    if a <= 1usize {
        return x
    }
    (x + a - 1usize) / a * a
end lower.tyk.up

// 列挙型の変種の添字 (宣言の順)。見つからなければ 0 (呼び出し側が形を確かめる)。
fn lower.tyk.variant_index(env: &types.env.Env, item: usize, name: &str) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let file = types.infer.item_file(env, item)
    let node = types.infer.item_node(env, item)
    let p = match types.env.unit(env, file) {
        Some(q) => q
        None => return Ok(0usize)
    }
    let src_r = match env.srcs.as_slice().get(file) {
        Some(s) => s
        None => return Ok(0usize)
    }
    let src = src_r.text.as_slice()
    let nd = parse.ast.get(&p.ast, node)
    let mut k = 0usize
    for j in core.iter.range(0usize, resolve.ast.count(p, nd.d)) {
        let vn = parse.ast.get(&p.ast, resolve.ast.item(p, nd.d, j))
        if resolve.ast.tok_text(p, src, vn.a) == name {
            return Ok(j)
        }
        k = k + 1usize
    }
    Ok(0usize)
end lower.tyk.variant_index

// `Vec` / `String` の枠の集成体の項目: 要素が所有物の `Vec` は `VECO + 要素の集成体の番号`、それ以外は `VEC`。
fn lower.tyk.vec_item(env: &types.env.Env, c: &mut lower.cx.Cx, f: usize) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let n = types.ty.node(&c.ar, f)
    if !lower.tyk.item_fqn(env, n.a).as_str().ends_with(".Vec") || n.c == 0usize {
        return Ok(lower.tyk.VEC)
    }
    let et = types.ty.arg(&c.ar, n.b, 0usize)
    if !lower.drop.owns(env, c, et)? {
        return Ok(lower.tyk.VEC)
    }
    let ets = lower.tyk.text(env, c, et)?
    let num = match ets.as_str().strip_prefix("agg#") {
        Some(d) => d
        None => return Ok(lower.tyk.VEC)
    }
    let mut v = 0usize
    for b in num.as_bytes().iter() {
        v = v * 10usize + usize.from_u8((*b).wrapping_sub(48u8))
    }
    Ok(lower.tyk.VECO + v)
end lower.tyk.vec_item

// 未対応の型の名前 (診断用)。
fn lower.tyk.why(env: &types.env.Env, c: &lower.cx.Cx, f: usize) -> Result<alloc.string.String<std.alloc.System>, resolve.Failure> uses [alloc] panics may pub
    let n = types.ty.node(&c.ar, f)
    let mut s = alloc.string.String.new(std.alloc.SYSTEM)
    if n.k == types.ty.K.Adt {
        let name = lower.tyk.item_fqn(env, n.a)
        s.push_str(name.as_str())?
        s.push_str(" (引数 ")?
        s.push_str(lower.cx.dec(n.c)?.as_str())?
        s.push(')')?
        return Ok(s)
    }
    let word = lower.tyk.kind_word(n.k)
    s.push_str(word)?
    Ok(s)
end lower.tyk.why
