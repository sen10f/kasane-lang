fn lower.io.print_line(env: &types.env.Env, c: &mut lower.cx.Cx, p: &parse.cur.P, src: &[u8], n: parse.ast.Node, t: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    if resolve.ast.count(p, n.b) != 1usize {
        lower.cx.fail(c, "std.io.print_line の引数の個数")?
        return lower.expr.dummy(c, t)
    }
    let s = lower.expr.expr(env, c, p, src, resolve.ast.item(p, n.b, 0usize), types.ty.UNKNOWN)?
    let res = lower.tyk.text(env, c, t)?
    let fd = lower.cx.def(c, "i32", "const.i32 1")?
    let w1 = lower.cx.cat2("write ", lower.expr.two(fd, s.v)?.as_str())?
    let r1 = lower.cx.def(c, res.as_str(), w1.as_str())?
    let ts = lower.cx.cat2("tag ", lower.cx.vs(r1)?.as_str())?
    let failed = lower.cx.def(c, "bool", ts.as_str())?
    let empty = std.vec.Vec.new()
    let nb = lower.cx.blk(c, &empty)?
    let mut jps = std.vec.Vec.new()
    jps.push(lower.cx.newval(c, res.as_str())?)?
    let jb = lower.cx.blk(c, &jps)?
    let mut a1 = std.vec.Vec.new()
    a1.push(r1)?
    let mut br = lower.cx.cat2("br_if ", lower.cx.vs(failed)?.as_str())?
    br.push_str(", ")?
    br.push_str(lower.cx.target(jb, &a1)?.as_str())?
    br.push_str(", ")?
    br.push_str(lower.cx.target(nb, &empty)?.as_str())?
    lower.cx.finish(c, br)?
    lower.cx.goto(c, nb)
    let data = lower.cx.def(c, "ptr", "static.bytes 0a")?
    let one = lower.cx.def(c, "usize", "const.usize 1")?
    let fid = lower.tyk.agg_id(c, lower.tyk.FAT)?
    let ft = lower.cx.cat2("agg#", lower.cx.dec(fid)?.as_str())?
    let mk = lower.cx.cat2("make(", lower.expr.two(data, one)?.as_str())?
    let mk2 = lower.cx.cat2(mk.as_str(), ")")?
    let nl = lower.cx.def(c, ft.as_str(), mk2.as_str())?
    let w2 = lower.cx.cat2("write ", lower.expr.two(fd, nl)?.as_str())?
    let r2 = lower.cx.def(c, res.as_str(), w2.as_str())?
    let mut a2 = std.vec.Vec.new()
    a2.push(r2)?
    let bj = lower.cx.cat2("br ", lower.cx.target(jb, &a2)?.as_str())?
    lower.cx.finish(c, bj)?
    lower.cx.goto(c, jb)
    let rv = lower.tyk.at(jps.as_slice(), 0usize)
    Ok(lower.cx.R { v: rv, t: t })
end lower.io.print_line
