// 局所の名前を束縛する。借用されるものはスロット (alloca + store) に置く。
fn lower.opt.bind(env: &types.env.Env, c: &mut lower.cx.Cx, name: &str, v: usize, m: bool, t: usize) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let tf = types.ty.find(&c.ar, t)
    let is_ref = types.ty.node(&c.ar, tf).k == types.ty.K.Ref
    if lower.vec.is_hdr(env, c, t) {
        // `Vec` / `String` の局所は枠 (frame.bytes 24) に置き、3 つの欄を書く。
        let slot = lower.cx.def(c, "ptr", "frame.bytes 24")?
        lower.vec.store_hdr(c, slot, v)?
        return lower.cx.push_local(c, name, slot + 1usize, m, t, true)
    }
    if lower.cx.is_bor(c, name) && !is_ref {
        let tt = lower.tyk.text(env, c, t)?
        let mt = lower.cx.cat2("mutref<", tt.as_str())?
        let mt2 = lower.cx.cat2(mt.as_str(), ">")?
        let slot = lower.cx.def(c, mt2.as_str(), "alloca")?
        let st = lower.opt.two_op("store ", slot, v)?
        lower.cx.def(c, "unit", st.as_str())?
        return lower.cx.push_local(c, name, slot + 1usize, m, t, true)
    }
    lower.cx.push_local(c, name, v + 1usize, m, t, false)
end lower.opt.bind

// 整数の定数 (`const N: T = 7u32`) の値を、その綴りの定数として置く。整数の綴り以外は VId 0 (未対応)。
fn lower.opt.const_value(env: &types.env.Env, c: &mut lower.cx.Cx, item: usize, t: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let file = types.infer.item_file(env, item)
    let node = types.infer.item_node(env, item)
    let p2 = match types.env.unit(env, file) {
        Some(q) => q
        None => return Ok(lower.cx.R { v: 0usize, t: t })
    }
    let src2 = match env.srcs.as_slice().get(file) {
        Some(x) => x.text.as_slice()
        None => return Ok(lower.cx.R { v: 0usize, t: t })
    }
    let cn = parse.ast.get(&p2.ast, node)
    if cn.d == 0usize {
        return Ok(lower.cx.R { v: 0usize, t: t })
    }
    let init = parse.ast.get(&p2.ast, cn.d)
    if (init.kind != parse.ast.Kind.Lit || init.a != 1usize) {
        // それ以外の定数: 初期化式を、定数の書かれたファイルの中で下ろす (型・名前はそのファイルで読む)。
        let saved = c.s.file
        c.s.file = file
        let r = lower.expr.expr(env, c, p2, src2, cn.d, t)?
        c.s.file = saved
        return Ok(r)
    }
    lower.expr.lit(env, c, p2, src2, init, t)
end lower.opt.const_value

// 列挙子の構築: Some / Ok / Err (Option・Result) と、利用者の列挙型の変種 (`make.vK(..)`)。
fn lower.opt.ctor(env: &types.env.Env, c: &mut lower.cx.Cx, p: &parse.cur.P, src: &[u8], n: parse.ast.Node, t: usize, item: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let owner = types.infer.item_owner(env, item).wrapping_sub(1usize)
    let k = lower.opt.kind(env, owner)
    let fq = lower.tyk.item_fqn(env, item)
    let vname = lower.expr.last_seg(fq.as_str())
    let nargs = resolve.ast.count(p, n.b)
    if k == 0usize {
        // 利用者の列挙型: 変種の番号 k と、フィールドの値を並べた make.vK。
        let vi = lower.tyk.variant_index(env, owner, vname)?
        let mut vs = alloc.vec.Vec.new(std.alloc.SYSTEM)
        for j in core.iter.range(0usize, nargs) {
            let a = lower.expr.expr(env, c, p, src, resolve.ast.item(p, n.b, j), types.ty.UNKNOWN)?
            vs.push(a.v)?
        }
        let agg = lower.tyk.agg_id(c, owner)?
        let ty = lower.cx.cat2("agg#", lower.cx.dec(agg)?.as_str())?
        let op = lower.cx.cat2("make.v", lower.cx.dec(vi)?.as_str())?
        let op2 = lower.cx.cat2(op.as_str(), "(")?
        let op3 = lower.cx.cat2(op2.as_str(), lower.cx.vlist(&vs)?.as_str())?
        let op4 = lower.cx.cat2(op3.as_str(), ")")?
        let v = lower.cx.def(c, ty.as_str(), op4.as_str())?
        return Ok(lower.cx.R { v: v, t: t })
    }
    if nargs != 1usize {
        lower.cx.fail(c, "列挙子の構築 (引数の個数)")?
        return lower.expr.dummy(c, t)
    }
    let a = lower.expr.expr(env, c, p, src, resolve.ast.item(p, n.b, 0usize), types.ty.UNKNOWN)?
    // 戻り値の型: 表が決まっていれば使い、決まらなければ引数から組み立てる (Option は引数、Result は残りを戻り値の型から)。
    let mut rty = t
    let tf = types.ty.find(&c.ar, t)
    let tn = types.ty.node(&c.ar, tf)
    let mut known = tn.k == types.ty.K.Adt && tn.c > 0usize
    if known {
        let a0 = types.ty.node(&c.ar, types.ty.find(&c.ar, types.ty.arg(&c.ar, tn.b, 0usize)))
        if a0.k == types.ty.K.Var || a0.k == types.ty.K.Unknown {
            known = false
        }
    }
    if !known {
        let mut ids = alloc.vec.Vec.new(std.alloc.SYSTEM)
        if lower.opt.owner_k(vname) == 1usize {
            ids.push(a.t)?
        } else {
            let rf = types.ty.find(&c.ar, c.s.ret_t)
            let rn = types.ty.node(&c.ar, rf)
            let mut other = a.t
            if rn.k == types.ty.K.Adt && rn.c == 2usize {
                let k2 = if vname == "Ok" {
                    1usize
                } else {
                    0usize
                }
                other = types.ty.arg(&c.ar, rn.b, k2)
            }
            if vname == "Ok" {
                ids.push(a.t)?
                ids.push(other)?
            } else {
                ids.push(other)?
                ids.push(a.t)?
            }
        }
        rty = types.ty.adt(&mut c.ar, owner, &ids)?
    }
    let tt = lower.tyk.text(env, c, rty)?
    let head = if (vname == "Some" || vname == "Ok") {
        if vname == "Some" {
            "some "
        } else {
            "ok "
        }
    } else {
        "err "
    }
    let op = lower.cx.cat2(head, lower.cx.vs(a.v)?.as_str())?
    let v = lower.cx.def(c, tt.as_str(), op.as_str())?
    Ok(lower.cx.R { v: v, t: rty })
end lower.opt.ctor

// 参照の型 (ref / mutref) の中身と可変かどうか。参照でなければ (e, false, false)。
fn lower.opt.deref_ty(c: &lower.cx.Cx, t: usize) -> (usize, bool, bool) uses [] panics may pub
    let f = types.ty.find(&c.ar, t)
    let n = types.ty.node(&c.ar, f)
    if (n.k == types.ty.K.Ref) {
        return (n.a, true, n.m)
    }
    (t, false, false)
end lower.opt.deref_ty

// 参照の値なら中身を読む (match の対象が `&e` のとき)。
fn lower.opt.deref_val(env: &types.env.Env, c: &mut lower.cx.Cx, r: lower.cx.R) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let (inner, through, _m) = lower.opt.deref_ty(c, r.t)
    if !through {
        return Ok(r)
    }
    let it = lower.tyk.text(env, c, inner)?
    let op = lower.cx.cat2("load ", lower.cx.vs(r.v)?.as_str())?
    let v = lower.cx.def(c, it.as_str(), op.as_str())?
    Ok(lower.cx.R { v: v, t: inner })
end lower.opt.deref_val

// `fieldaddr %v, +off` の文字列。
fn lower.opt.faddr_src(v: usize, off: usize) -> Result<alloc.string.String<std.alloc.System>, resolve.Failure> uses [alloc] panics may pub
    let mut s = alloc.string.String.new(std.alloc.SYSTEM)
    s.push_str("fieldaddr ")?
    s.push_str(lower.cx.vs(v)?.as_str())?
    s.push_str(", +")?
    s.push_str(lower.cx.dec(off)?.as_str())?
    Ok(s)
end lower.opt.faddr_src

// 構造体 (`bt` の中身) のフィールド name を、値 v から読む。参照越しなら fieldaddr + load。
fn lower.opt.field(env: &types.env.Env, c: &mut lower.cx.Cx, v: usize, bt: usize, name: &str, t: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let (inner, through, mutable) = lower.opt.deref_ty(c, bt)
    let rs = types.ty.strip(&c.ar, inner)
    let rn = types.ty.node(&c.ar, rs)
    let fty = lower.tyk.text(env, c, t)?
    let j = lower.tyk.field_index(env, rn.a, name)?
    let lay = lower.tyk.layout(env, c, rn.a)?
    let off = lower.tyk.at(lay.offs.as_slice(), j)
    if through {
        let rt = lower.opt.refty(mutable, fty.as_str())?
        let fa_src = lower.opt.faddr_src(v, off)?
        let fa = lower.cx.def(c, rt.as_str(), fa_src.as_str())?
        let ld = lower.cx.cat2("load ", lower.cx.vs(fa)?.as_str())?
        let fv = lower.cx.def(c, fty.as_str(), ld.as_str())?
        return Ok(lower.cx.R { v: fv, t: t })
    }
    let fv = lower.cx.def(c, fty.as_str(), lower.expr.field_src(v, off)?.as_str())?
    Ok(lower.cx.R { v: fv, t: t })
end lower.opt.field

// 構造体のフィールドの番地 (`fieldaddr`)。bv は参照 (ref / mutref) か、スロット (mutref<構造体>)。
// 結果の型は `mutref<F>` (F は fty の型)。
fn lower.opt.field_addr(env: &types.env.Env, c: &mut lower.cx.Cx, bv: usize, bt: usize, name: &str, fty: usize) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let (inner, _through, _m) = lower.opt.deref_ty(c, bt)
    let rs = types.ty.strip(&c.ar, inner)
    let rn = types.ty.node(&c.ar, rs)
    let j = lower.tyk.field_index(env, rn.a, name)?
    let lay = lower.tyk.layout(env, c, rn.a)?
    let off = lower.tyk.at(lay.offs.as_slice(), j)
    let ft = lower.tyk.text(env, c, fty)?
    let mt = lower.opt.refty(true, ft.as_str())?
    let fa = lower.opt.faddr_src(bv, off)?
    lower.cx.def(c, mt.as_str(), fa.as_str())
end lower.opt.field_addr

// 項目が Option (1) / Result (2) / それ以外 (0) か。
fn lower.opt.kind(env: &types.env.Env, item: usize) -> usize uses [alloc] panics may pub
    let f = lower.tyk.item_fqn(env, item)
    if f.as_str() == "core.option.Option" {
        return 1usize
    }
    if f.as_str() == "core.result.Result" {
        return 2usize
    }
    0usize
end lower.opt.kind

// 局所 k の値 (スロットなら読み出す)。t は局所の型。
fn lower.opt.local_val(env: &types.env.Env, c: &mut lower.cx.Cx, k: usize, t: usize) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let v = lower.cx.get_val(c, k).wrapping_sub(1usize)
    if lower.cx.is_slot(c, k) {
        if lower.vec.is_hdr(env, c, t) {
            return lower.vec.load_hdr(env, c, v, t, !c.s.peek)
        }
        let tt = lower.tyk.text(env, c, t)?
        let op = lower.cx.cat2("load ", lower.cx.vs(v)?.as_str())?
        return lower.cx.def(c, tt.as_str(), op.as_str())
    }
    Ok(v)
end lower.opt.local_val

// match の Option / Result: `tag` で分け、中身を `payload` で読む。Some / Ok / Err の腕は真の枝、None は偽。
fn lower.opt.optmatch(env: &types.env.Env, c: &mut lower.cx.Cx, p: &parse.cur.P, src: &[u8], n: parse.ast.Node, t: usize, sc0: lower.cx.R, sloc: usize, slin: bool) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let sc = lower.opt.deref_val(env, c, sc0)?
    let sv = sc.v
    let base = lower.cx.depth(c)
    let mut nms = alloc.vec.Vec.new(std.alloc.SYSTEM)
    lower.expr.scan_arms(p, src, n.b, &mut nms, false)?
    let ks = lower.cx.mlist_in(c, base, &nms)?
    let rty = lower.tyk.text(env, c, t)?
    let jps = lower.expr.join_params(c, rty.as_str(), &ks)?
    let jb = lower.cx.blk(c, &jps)?
    let nv = resolve.ast.count(p, n.b)
    let mut done = false
    let mut nextbs = 0usize
    for j in core.iter.range(0usize, nv) {
        if done {
            break
        }
        let arm = parse.ast.get(&p.ast, resolve.ast.item(p, n.b, j))
        let pat = parse.ast.get(&p.ast, arm.a)
        let mark = lower.cx.depth(c)
        if pat.kind == parse.ast.Kind.PWild {
            done = true
            let empty = alloc.vec.Vec.new(std.alloc.SYSTEM)
            let nb = lower.cx.blk(c, &empty)?
            lower.expr.br_to(c, nb)?
            lower.cx.goto(c, nb)
            lower.expr.arm_body(env, c, p, src, arm.b, t, rty.as_str(), &ks, jb, mark)?
        } else if (pat.kind == parse.ast.Kind.PVariant || pat.kind == parse.ast.Kind.PPath) {
            let name = resolve.ast.text(src, pat.a, pat.b)
            let last = lower.expr.last_seg(name)
            let positive = last == "Some" || last == "Err"
            // Rust 版の形: 腕ごとに tag を読み直し、部分パターン (`x` / `_`) があれば payload を読んで
            // `const.bool true` と `and.bool` で条件に結ぶ。最後の腕は無条件で飛ぶ (網羅は検査済み)。
            let tg = lower.cx.def1(c, "bool", "tag ", sv)?
            let mut cond = tg
            if !positive {
                cond = lower.cx.def1(c, "bool", "not.bool ", tg)?
            }
            let mut pv = 0usize
            let mut pt = types.ty.UNKNOWN
            let mut sub = 0usize
            let mut noncopy = false
            if pat.kind == parse.ast.Kind.PVariant && resolve.ast.count(p, pat.c) == 1usize {
                sub = resolve.ast.item(p, pat.c, 0usize)
                let sp = parse.ast.get(&p.ast, sub)
                if sp.kind == parse.ast.Kind.PBind || sp.kind == parse.ast.Kind.PWild {
                    pt = lower.expr.tyof(c, sub)?
                    if pt == types.ty.UNKNOWN {
                        let ss = types.ty.strip(&c.ar, sc.t)
                        let sn = types.ty.node(&c.ar, ss)
                        let mut ai = 0usize
                        if last == "Err" {
                            ai = 1usize
                        }
                        pt = types.ty.arg(&c.ar, sn.b, ai)
                    }
                    let pty = lower.tyk.text(env, c, pt)?
                    pv = lower.cx.def1(c, pty.as_str(), "payload ", sv)?
                    let tr = lower.cx.def(c, "bool", "const.bool true")?
                    let both = lower.expr.two(cond, tr)?
                    let andsrc = lower.cx.cat2("and.bool ", both.as_str())?
                    cond = lower.cx.def(c, "bool", andsrc.as_str())?
                } else {
                    lower.cx.fail(c, "match の腕 (入れ子の部分パターンは未対応)")?
                    return lower.expr.dummy(c, t)
                }
            }
            let empty = alloc.vec.Vec.new(std.alloc.SYSTEM)
            let armb = lower.cx.blk(c, &empty)?
            if j + 1usize == nv {
                lower.expr.br_to(c, armb)?
            } else {
                let nextb = lower.cx.blk(c, &empty)?
                lower.expr.br_if(c, cond, armb, nextb)?
                nextbs = nextb
            }
            lower.cx.goto(c, armb)
            if sub != 0usize {
                let sp = parse.ast.get(&p.ast, sub)
                if sp.kind == parse.ast.Kind.PBind {
                    let stk_tok = parse.cur.peek_at(p, sp.a)
                    let stk = resolve.ast.text(src, stk_tok.start, stk_tok.stop)
                    let pv2 = lower.opt.wrap_ref(env, c, pv, pt)?
                    let bv = lower.opt.bind(env, c, stk, pv2, false, pt)?
                    lower.own.declare(env, c, bv, pt)?
                    noncopy = !lower.own.is_copy(env, c, pt)
                }
            }
            lower.own.arm_consume(c, sloc, slin, noncopy, false)?
            lower.expr.arm_body(env, c, p, src, arm.b, t, rty.as_str(), &ks, jb, mark)?
            if j + 1usize != nv {
                lower.cx.goto(c, nextbs)
            }
        } else {
            lower.cx.fail(c, "match の腕 (Option と Result の形は未対応)")?
            return lower.expr.dummy(c, t)
        }
    }
    lower.cx.goto(c, jb)
    lower.expr.bind_join(c, rty.as_str(), &ks, &jps)?
    if rty.as_str() == "unit" {
        let u = lower.expr.unit(c)?
        return Ok(lower.cx.R { v: u, t: t })
    }
    let rv = lower.tyk.at(jps.as_slice(), 0usize)
    Ok(lower.cx.R { v: rv, t: t })
end lower.opt.optmatch

// 変種の名前から、組み立てる型の引数の数 (Option は 1、Result は 2) を決める。
fn lower.opt.owner_k(vname: &str) -> usize uses [] panics may pub
    if vname == "Some" {
        return 1usize
    }
    2usize
end lower.opt.owner_k

// 受け手の値を宣言の self に合わせる: 参照が要るのに値なら一時のスロット、参照でないのに参照なら読み出す。
fn lower.opt.recv_value(env: &types.env.Env, c: &mut lower.cx.Cx, r: lower.cx.R, want_ref: bool) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let (inner, through, m) = lower.opt.deref_ty(c, r.t)
    if want_ref == through {
        return Ok(r.v)
    }
    if through {
        let it = lower.tyk.text(env, c, inner)?
        let op = lower.cx.cat2("load ", lower.cx.vs(r.v)?.as_str())?
        return lower.cx.def(c, it.as_str(), op.as_str())
    }
    // 値を参照にしたい: 一時のスロットに置いて参照を作る。
    if lower.vec.is_hdr(env, c, r.t) {
        let tslot = lower.cx.def(c, "ptr", "frame.bytes 24")?
        lower.vec.store_hdr(c, tslot, r.v)?
        return Ok(tslot)
    }
    let st = lower.tyk.text(env, c, r.t)?
    let mt = lower.opt.refty(true, st.as_str())?
    let slot = lower.cx.def(c, mt.as_str(), "alloca")?
    let so = lower.opt.two_op("store ", slot, r.v)?
    lower.cx.def(c, "unit", so.as_str())?
    let rt = lower.opt.refty(m, st.as_str())?
    let sh = lower.cx.cat2("asshared ", lower.cx.vs(slot)?.as_str())?
    lower.cx.def(c, rt.as_str(), sh.as_str())
end lower.opt.recv_value

// 参照の型の文字列 (`ref<T>` / `mutref<T>`)。
fn lower.opt.refty(mutable: bool, t: &str) -> Result<alloc.string.String<std.alloc.System>, resolve.Failure> uses [alloc] panics may pub
    let head = if mutable {
        "mutref<"
    } else {
        "ref<"
    }
    let h = lower.cx.cat2(head, t)?
    lower.cx.cat2(h.as_str(), ">")
end lower.opt.refty

// `e?`: Result なら Err のとき戻り値の Err を返し、Option なら None を返す。それ以外は値の中身。
fn lower.opt.tryx(env: &types.env.Env, c: &mut lower.cx.Cx, p: &parse.cur.P, src: &[u8], n: parse.ast.Node, t: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let x = lower.expr.expr(env, c, p, src, n.a, types.ty.UNKNOWN)?
    let xf = types.ty.find(&c.ar, x.t)
    let xn = types.ty.node(&c.ar, xf)
    let k = if (xn.k == types.ty.K.Adt) {
        lower.opt.kind(env, xn.a)
    } else {
        0usize
    }
    if k == 0usize {
        lower.cx.fail(c, "`?` (Option と Result 以外は未対応)")?
        return lower.expr.dummy(c, t)
    }
    let tg = lower.cx.def1(c, "bool", "tag ", x.v)?
    let empty = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let okb = lower.cx.blk(c, &empty)?
    let errb = lower.cx.blk(c, &empty)?
    let mut br = alloc.string.String.new(std.alloc.SYSTEM)
    br.push_str("br_if ")?
    br.push_str(lower.cx.vs(tg)?.as_str())?
    br.push_str(", ")?
    if k == 2usize {
        br.push_str(lower.cx.target(errb, &empty)?.as_str())?
        br.push_str(", ")?
        br.push_str(lower.cx.target(okb, &empty)?.as_str())?
    } else {
        br.push_str(lower.cx.target(okb, &empty)?.as_str())?
        br.push_str(", ")?
        br.push_str(lower.cx.target(errb, &empty)?.as_str())?
    }
    lower.cx.finish(c, br)?
    // 失敗の枝: 戻り値の型で作り直して返す。
    lower.cx.goto(c, errb)
    let rt = lower.tyk.text(env, c, c.s.ret_t)?
    if k == 2usize {
        let a1 = types.ty.arg(&c.ar, xn.b, 1usize)
        let et = lower.tyk.text(env, c, a1)?
        let pv = lower.cx.def1(c, et.as_str(), "payload ", x.v)?
        let ev = lower.cx.def1(c, rt.as_str(), "err ", pv)?
        lower.vec.exit_drops(env, c, c.v.vals.len(), 0usize)?
        lower.cx.finish(c, lower.cx.cat2("ret ", lower.cx.vs(ev)?.as_str())?)?
    } else {
        let nv = lower.cx.def(c, rt.as_str(), lower.cx.cat2("const.", lower.cx.cat2(rt.as_str(), " none")?.as_str())?.as_str())?
        lower.vec.exit_drops(env, c, c.v.vals.len(), 0usize)?
        lower.cx.finish(c, lower.cx.cat2("ret ", lower.cx.vs(nv)?.as_str())?)?
    }
    // 成功の枝: 中身。
    lower.cx.goto(c, okb)
    let tt = lower.tyk.text(env, c, t)?
    let val = lower.cx.def1(c, tt.as_str(), "payload ", x.v)?
    Ok(lower.cx.R { v: val, t: t })
end lower.opt.tryx

// `op %a, %b` の文字列。
fn lower.opt.two_op(op: &str, a: usize, b: usize) -> Result<alloc.string.String<std.alloc.System>, resolve.Failure> uses [alloc] panics may pub
    let t = lower.expr.two(a, b)?
    lower.cx.cat2(op, t.as_str())
end lower.opt.two_op

// 変種の値 (値のない変種 `E.B`): `make.vK()`。Option / Result の変種は対象外 (None は path で扱う)。
fn lower.opt.unit_variant(env: &types.env.Env, c: &mut lower.cx.Cx, item: usize, t: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let owner = types.infer.item_owner(env, item).wrapping_sub(1usize)
    if lower.opt.kind(env, owner) != 0usize {
        lower.cx.fail(c, "Option / Result の変種の値 (未対応)")?
        return lower.expr.dummy(c, t)
    }
    let fq = lower.tyk.item_fqn(env, item)
    let vname = lower.expr.last_seg(fq.as_str())
    let vi = lower.tyk.variant_index(env, owner, vname)?
    let agg = lower.tyk.agg_id(c, owner)?
    let ty = lower.cx.cat2("agg#", lower.cx.dec(agg)?.as_str())?
    let op = lower.cx.cat2("make.v", lower.cx.dec(vi)?.as_str())?
    let op2 = lower.cx.cat2(op.as_str(), "()")?
    let v = lower.cx.def(c, ty.as_str(), op2.as_str())?
    Ok(lower.cx.R { v: v, t: t })
end lower.opt.unit_variant

// メソッドの呼び出し (利用者の関数): 受け手は宣言の `self` の型に合わせて参照する (自動参照・自動逆参照)。
// recv は受け手の式 (局所の名前なら loc の添字、それ以外は recv_node の式)。
fn lower.opt.user_method(env: &types.env.Env, c: &mut lower.cx.Cx, p: &parse.cur.P, src: &[u8], item: usize, recv_node: usize, loc: usize, args: usize, t: usize) -> Result<lower.cx.R, resolve.Failure> uses [alloc] panics may pub
    let sfq = lower.tyk.item_fqn(env, item)
    if lower.std_calls.has_method(sfq.as_str()) {
        return lower.std_calls.recv_call(env, c, p, src, sfq.as_str(), recv_node, loc, args, t)
    }
    let generic = lower.inst.is_generic(env, c, item)
    let mut subs = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let mut key = lower.tyk.item_fqn(env, item)
    if generic {
        let rt0 = if loc != 0usize {
            lower.cx.tyof_t(c, loc - 1usize)
        } else {
            lower.expr.tyof(c, recv_node)?
        }
        subs = lower.inst.method_args(env, c, p, item, rt0, args)?
        key = lower.inst.key(env, c, key.as_str(), &subs)?
    }
    let file = types.infer.item_file(env, item)
    let node = types.infer.item_node(env, item)
    let cp = match types.env.unit(env, file) {
        Some(q) => q
        None => return lower.expr.dummy(c, t)
    }
    let fd = parse.ast.get(&cp.ast, node)
    let sg = parse.ast.get(&cp.ast, fd.c)
    if resolve.ast.count(cp, sg.b) == 0usize {
        lower.cx.fail(c, "メソッドに self がない")?
        return lower.expr.dummy(c, t)
    }
    let self_node = resolve.ast.item(cp, sg.b, 0usize)
    let sdecl = types.rec.ty_of(&c.tc.rec, file, self_node)
    let sdn = types.ty.node(&c.ar, types.ty.find(&c.ar, sdecl))
    // `Vec` のメソッドの self は常に参照 (宣言が .sig にあり、型の表に記録がない)。
    let mut self_ref = sdn.k == types.ty.K.Ref
    if lower.tyk.item_fqn(env, item).as_str().starts_with("alloc.vec.Vec.") || lower.tyk.item_fqn(env, item).as_str().starts_with("alloc.string.String.") {
        self_ref = true
    }
    // 受け手の値。
    let mut recv = 0usize
    if loc != 0usize {
        let bt = lower.cx.tyof_t(c, loc - 1usize)
        // 借用の受け手は move 済みの値の読み (`use`)、値の受け手は move (`consume`)。
        let hdr_recv = lower.vec.is_hdr(env, c, bt)
        if self_ref && !hdr_recv {
            lower.own.emit(c, loc - 1usize, "own.use ")?
        }
        if lower.cx.is_slot(c, loc - 1usize) && self_ref && hdr_recv {
            // `Vec` / `String` の局所: 枠の番地をそのまま渡す。
            recv = lower.cx.get_val(c, loc - 1usize).wrapping_sub(1usize)
        } else if lower.cx.is_slot(c, loc - 1usize) && self_ref {
            let slot = lower.cx.get_val(c, loc - 1usize).wrapping_sub(1usize)
            let inner_t = types.ty.strip(&c.ar, bt)
            let st0 = lower.tyk.text(env, c, inner_t)?
            let st = lower.opt.refty(sdn.m, st0.as_str())?
            let fqn_m = lower.tyk.item_fqn(env, item)
            let mname = lower.expr.last_seg(fqn_m.as_str())
            let mut head = "asshared "
            if sdn.m || mname == "push" || mname == "pop" {
                head = "reborrow "
            }
            let so = lower.cx.cat2(head, lower.cx.vs(slot)?.as_str())?
            recv = lower.cx.def(c, st.as_str(), so.as_str())?
        } else {
            let rv = lower.opt.local_val(env, c, loc - 1usize, bt)?
            let rr = lower.cx.R { v: rv, t: bt }
            recv = lower.opt.recv_value(env, c, rr, self_ref)?
            if !self_ref {
                lower.own.emit(c, loc - 1usize, "own.consume ")?
            }
        }
    } else {
        let r = lower.expr.expr(env, c, p, src, recv_node, types.ty.UNKNOWN)?
        recv = lower.opt.recv_value(env, c, r, self_ref)?
    }
    let mut vs = alloc.vec.Vec.new(std.alloc.SYSTEM)
    vs.push(recv)?
    let na = resolve.ast.count(p, args)
    for j in core.iter.range(0usize, na) {
        let a = lower.expr.expr(env, c, p, src, resolve.ast.item(p, args, j), types.ty.UNKNOWN)?
        vs.push(a.v)?
    }
    let owner_fqn = lower.tyk.item_fqn(env, item)
    if owner_fqn.as_str().starts_with("alloc.string.String.") {
        let rty3 = if loc != 0usize {
            lower.cx.tyof_t(c, loc - 1usize)
        } else {
            lower.expr.tyof(c, recv_node)?
        }
        return lower.vec.call(env, c, owner_fqn.as_str(), rty3, &vs, t)
    }
    if owner_fqn.as_str().starts_with("alloc.vec.Vec.") {
        let rty2 = if loc != 0usize {
            lower.cx.tyof_t(c, loc - 1usize)
        } else {
            lower.expr.tyof(c, recv_node)?
        }
        return lower.vec.call(env, c, owner_fqn.as_str(), rty2, &vs, t)
    }
    lower.expr.enqueue(c, key.as_str(), item + 1usize, subs, t)?
    let rt = lower.tyk.text(env, c, t)?
    let co = lower.cx.cat2("call ", key.as_str())?
    let co2 = lower.cx.cat2(co.as_str(), "(")?
    let co3 = lower.cx.cat2(co2.as_str(), lower.cx.vlist(&vs)?.as_str())?
    let co4 = lower.cx.cat2(co3.as_str(), ")")?
    let v = lower.cx.def(c, rt.as_str(), co4.as_str())?
    Ok(lower.cx.R { v: v, t: t })
end lower.opt.user_method

// 束縛の型が参照で、値が参照でないとき (パターンの既定の束縛): 値をスロットに置いて参照にする。
fn lower.opt.wrap_ref(env: &types.env.Env, c: &mut lower.cx.Cx, v: usize, pt: usize) -> Result<usize, resolve.Failure> uses [alloc] panics may pub
    let f = types.ty.find(&c.ar, pt)
    let n = types.ty.node(&c.ar, f)
    if n.k != types.ty.K.Ref {
        return Ok(v)
    }
    let vt = lower.cx.tyof(c, v)
    if vt.as_str().starts_with("ref") || vt.as_str().starts_with("mutref") {
        return Ok(v)
    }
    let it = lower.tyk.text(env, c, n.a)?
    let mt = lower.opt.refty(true, it.as_str())?
    let slot = lower.cx.def(c, mt.as_str(), "alloca")?
    let so = lower.opt.two_op("store ", slot, v)?
    lower.cx.def(c, "unit", so.as_str())?
    let rt = lower.opt.refty(false, it.as_str())?
    let sh = lower.cx.cat2("asshared ", lower.cx.vs(slot)?.as_str())?
    lower.cx.def(c, rt.as_str(), sh.as_str())
end lower.opt.wrap_ref
