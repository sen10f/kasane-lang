type resolve.table.Def derive [Debug, Clone, Copy, PartialEq] pub
    kind: parse.ast.Kind pub
    file: usize pub
    line: usize pub
    public: bool pub
    sig: bool pub
end resolve.table.Def

type resolve.table.Map pub
    m: alloc.collections.HashMap<alloc.string.String<std.alloc.System>, usize, std.alloc.System> pub
end resolve.table.Map

type resolve.table.Table pub
    defs: resolve.table.Map pub
    variants: resolve.table.Map pub
    items: alloc.vec.Vec<resolve.table.Def, std.alloc.System> pub
end resolve.table.Table

fn resolve.table.add_file(t: &mut resolve.table.Table, p: &parse.cur.P, src: &[u8], file: usize, rep: &mut resolve.report.Report) -> Result<(), resolve.Failure> uses [alloc] panics never pub
    let sig = rep.sig
    for d in p.ast.defs.as_slice().iter() {
        let n = parse.ast.get(&p.ast, *d)
        if n.kind != parse.ast.Kind.Import && n.kind != parse.ast.Kind.ImplLine {
            let name = resolve.ast.text(src, n.a, n.b)
            let key = alloc.string.String.from_str(std.alloc.SYSTEM, name)?
            let line = resolve.ast.line_of(p, n.tok)
            let public = resolve.table.is_pub(&n)
            let def = resolve.table.mk(n.kind, file, line, public, sig)
            let st = resolve.table.state(t, &t.defs, &key, sig)
            if st == 2usize {
                resolve.report.diag(rep, "E1103", line, "duplicate definition", name)?
            } else if st == 0usize || !sig {
                resolve.table.put_def(t, key, def)?
            }
            if n.kind == parse.ast.Kind.EnumDef {
                resolve.table.add_variants(t, p, src, file, sig, name, n.d)?
            }
        }
    }
    Ok(())
end resolve.table.add_file

fn resolve.table.add_variants(t: &mut resolve.table.Table, p: &parse.cur.P, src: &[u8], file: usize, sig: bool, owner: &str, list: usize) -> Result<(), resolve.Failure> uses [alloc] panics never pub
    for k in core.iter.range(0usize, resolve.ast.count(p, list)) {
        let v = parse.ast.get(&p.ast, resolve.ast.item(p, list, k))
        let vname = resolve.ast.tok_text(p, src, v.a)
        let mut key = alloc.string.String.from_str(std.alloc.SYSTEM, owner)?
        key.push('.')?
        key.push_str(vname)?
        let line = resolve.ast.line_of(p, v.tok)
        let def = resolve.table.mk(v.kind, file, line, true, sig)
        if resolve.table.state(t, &t.variants, &key, sig) == 0usize {
            resolve.table.put_var(t, key, def)?
        }
    }
    Ok(())
end resolve.table.add_variants

fn resolve.table.at(t: &resolve.table.Table, ix: usize) -> resolve.table.Def uses [] panics never pub
    match t.items.as_slice().get(ix) {
        Some(d) => resolve.table.copy(d)
        None => resolve.table.mk(parse.ast.Kind.Nil, 0usize, 0usize, false, false)
    }
end resolve.table.at

fn resolve.table.copy(d: &resolve.table.Def) -> resolve.table.Def uses [] panics never pub
    resolve.table.Def { kind: d.kind, file: d.file, line: d.line, public: d.public, sig: d.sig }
end resolve.table.copy

fn resolve.table.is_pub(n: &parse.ast.Node) -> bool uses [] panics never pub
    let k = n.kind
    if k == parse.ast.Kind.FnDef || k == parse.ast.Kind.ConstDef || k == parse.ast.Kind.StaticDef {
        return n.e == 1usize
    }
    if k == parse.ast.Kind.TraitDef {
        return n.f == 1usize
    }
    if k == parse.ast.Kind.TypeDef || k == parse.ast.Kind.EnumDef {
        return (n.f & 1usize) == 1usize
    }
    k == parse.ast.Kind.ExternDef
end resolve.table.is_pub

fn resolve.table.mk(kind: parse.ast.Kind, file: usize, line: usize, public: bool, sig: bool) -> resolve.table.Def uses [] panics never pub
    resolve.table.Def { kind: kind, file: file, line: line, public: public, sig: sig }
end resolve.table.mk

fn resolve.table.new() -> Result<resolve.table.Table, alloc.alloc.AllocError> uses [alloc] panics never pub
    let dm = alloc.collections.HashMap.new(std.alloc.SYSTEM)
    let vm = alloc.collections.HashMap.new(std.alloc.SYSTEM)
    let items = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let defs = resolve.table.Map { m: dm }
    let variants = resolve.table.Map { m: vm }
    Ok(resolve.table.Table { defs: defs, variants: variants, items: items })
end resolve.table.new

fn resolve.table.put_def(t: &mut resolve.table.Table, key: alloc.string.String<std.alloc.System>, def: resolve.table.Def) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    let ix = t.items.len()
    t.items.push(def)?
    let mm = &mut t.defs.m
    core.mem.drop(mm.insert(key, ix)?)
    Ok(())
end resolve.table.put_def

fn resolve.table.put_var(t: &mut resolve.table.Table, key: alloc.string.String<std.alloc.System>, def: resolve.table.Def) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    let ix = t.items.len()
    t.items.push(def)?
    let mm = &mut t.variants.m
    core.mem.drop(mm.insert(key, ix)?)
    Ok(())
end resolve.table.put_var

fn resolve.table.state(t: &resolve.table.Table, m: &resolve.table.Map, key: &alloc.string.String<std.alloc.System>, sig: bool) -> usize uses [] panics never pub
    let mm = &m.m
    match mm.get(key) {
        Some(ix) => {
            let old = resolve.table.at(t, *ix)
            if old.sig != sig {
                return 1usize
            }
            2usize
        }
        None => 0usize
    }
end resolve.table.state
