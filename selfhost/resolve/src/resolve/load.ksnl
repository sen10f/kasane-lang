type resolve.load.Src pub
    path: std.string.String pub
    module: std.string.String pub
    sig: bool pub
    own: bool pub
    text: std.vec.Vec<u8> pub
end resolve.load.Src

fn resolve.load.base(name: &str) -> &str uses [] panics never pub
    match name.strip_suffix(".ksnl") {
        Some(b) => b
        None => match name.strip_suffix(".sig") {
            Some(b) => b
            None => name
        }
    }
end resolve.load.base

fn resolve.load.collect(dir: &str, pfx: &str, own: bool, out: &mut std.vec.Vec<resolve.load.Src>) -> Result<(), resolve.Failure> uses [alloc, io.fs] panics never stack 4096 pub
    let ents = std.fs.read_dir(dir)?
    for e in ents.as_slice().iter() {
        let name = e.name.as_str()
        let full = resolve.manifest.join(dir, name)?
        match e.kind {
            std.fs.FileKind.Dir => {
                let sub = resolve.load.module_of(pfx, name)?
                resolve.load.collect(full.as_str(), sub.as_str(), own, out)?
            }
            std.fs.FileKind.File => if name.ends_with(".ksnl") || name.ends_with(".sig") {
                let text = resolve.load.read_bytes(full.as_str())?
                let module = resolve.load.module_of(pfx, resolve.load.base(name))?
                let is_sig = name.ends_with(".sig")
                out.push(resolve.load.src(full, module, is_sig, own, text))?
            }
            std.fs.FileKind.Other => core.mem.drop(0u8)
        }
    }
    Ok(())
end resolve.load.collect

fn resolve.load.module_of(pfx: &str, base: &str) -> Result<std.string.String, alloc.alloc.AllocError> uses [alloc] panics never pub
    let mut m = std.string.String.new()
    if pfx != "" {
        m.push_str(pfx)?
        m.push('.')?
    }
    m.push_str(base)?
    Ok(m)
end resolve.load.module_of

fn resolve.load.read_bytes(path: &str) -> Result<std.vec.Vec<u8>, resolve.Failure> uses [alloc, io.fs] panics never pub
    let mut buf = std.vec.Vec.new()
    with mut file = std.fs.open(path)? close core.mem.drop(file.close()) {
        core.mem.drop(std.fs.read_to_end(&mut file, &mut buf)?)
    }
    Ok(buf)
end resolve.load.read_bytes

fn resolve.load.src(path: std.string.String, module: std.string.String, sig: bool, own: bool, text: std.vec.Vec<u8>) -> resolve.load.Src uses [] panics never pub
    resolve.load.Src {
        path: path
        module: module
        sig: sig
        own: own
        text: text
    }
end resolve.load.src
