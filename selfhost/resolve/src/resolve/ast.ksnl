const resolve.ast.BAD: &str = "?" pub

fn resolve.ast.count(p: &parse.cur.P, l: usize) -> usize uses [] panics never pub
    let n = parse.ast.get(&p.ast, l)
    if n.kind == parse.ast.Kind.List {
        return n.b
    }
    0usize
end resolve.ast.count

fn resolve.ast.item(p: &parse.cur.P, l: usize, k: usize) -> usize uses [] panics never pub
    let n = parse.ast.get(&p.ast, l)
    match p.ast.links.as_slice().get(n.a.wrapping_add(k)) {
        Some(x) => *x
        None => 0usize
    }
end resolve.ast.item

fn resolve.ast.last_part(s: &str) -> &str uses [] panics never pub
    let mut tail = s
    for c in s.split(".") {
        tail = c
    }
    tail
end resolve.ast.last_part

fn resolve.ast.line_of(p: &parse.cur.P, ti: usize) -> usize uses [] panics never pub
    parse.cur.peek_at(p, ti).line
end resolve.ast.line_of

fn resolve.ast.text(src: &[u8], a: usize, b: usize) -> &str uses [] panics never pub
    let bad = resolve.ast.BAD
    match src.sub(a, b) {
        Some(bytes) => match core.str.from_utf8(bytes) {
            Ok(t) => t
            Err(_) => bad
        }
        None => bad
    }
end resolve.ast.text

fn resolve.ast.tok_text['a](p: &parse.cur.P, src: &'a [u8], ti: usize) -> &'a str uses [] panics never pub
    let t = parse.cur.peek_at(p, ti)
    resolve.ast.text(src, t.start, t.stop)
end resolve.ast.tok_text
