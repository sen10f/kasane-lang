type resolve.report.Report pub
    text: alloc.string.String<std.alloc.System> pub
    path: alloc.string.String<std.alloc.System> pub
    errors: usize pub
    refs: usize pub
    sig: bool pub
end resolve.report.Report

fn resolve.report.def_name['a](p: &parse.cur.P, src: &'a [u8], n: parse.ast.Node) -> &'a str uses [] panics never pub
    if n.kind == parse.ast.Kind.ImplLine {
        return resolve.report.line_from(src, parse.cur.peek_at(p, n.tok).start)
    }
    resolve.ast.text(src, n.a, n.b)
end resolve.report.def_name

fn resolve.report.defs(rep: &mut resolve.report.Report, p: &parse.cur.P, src: &[u8]) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    rep.text.push_str("== ")?
    rep.text.push_str(rep.path.as_str())?
    rep.text.push('\n')?
    for d in p.ast.defs.as_slice().iter() {
        let n = parse.ast.get(&p.ast, *d)
        rep.text.push_str(resolve.report.kind_word(n.kind))?
        rep.text.push(' ')?
        rep.text.push_str(resolve.report.def_name(p, src, n))?
        rep.text.push(' ')?
        rep.text.push_u64(u64.from_usize(resolve.ast.line_of(p, n.tok)))?
        rep.text.push('\n')?
    }
    Ok(())
end resolve.report.defs

fn resolve.report.diag(rep: &mut resolve.report.Report, code: &str, line: usize, msg: &str, name: &str) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    rep.text.push_str("error ")?
    rep.text.push_str(code)?
    rep.text.push(' ')?
    rep.text.push_str(rep.path.as_str())?
    rep.text.push(':')?
    rep.text.push_u64(u64.from_usize(line))?
    rep.text.push_str(": ")?
    rep.text.push_str(msg)?
    if name != "" {
        rep.text.push(' ')?
        rep.text.push_str(name)?
    }
    rep.text.push('\n')?
    rep.errors = rep.errors.wrapping_add(1usize)
    Ok(())
end resolve.report.diag

fn resolve.report.kind_word(kind: parse.ast.Kind) -> &'static str uses [] panics never pub
    if kind == parse.ast.Kind.ConstDef {
        return "const"
    }
    if kind == parse.ast.Kind.EnumDef {
        return "enum"
    }
    if kind == parse.ast.Kind.ExternDef {
        return "extern"
    }
    if kind == parse.ast.Kind.FnDef {
        return "fn"
    }
    if kind == parse.ast.Kind.ImplLine {
        return "impl"
    }
    if kind == parse.ast.Kind.Import {
        return "import"
    }
    if kind == parse.ast.Kind.StaticDef {
        return "static"
    }
    if kind == parse.ast.Kind.TestDef {
        return "test"
    }
    if kind == parse.ast.Kind.TraitDef {
        return "trait"
    }
    if kind == parse.ast.Kind.TypeDef {
        return "type"
    }
    "?"
end resolve.report.kind_word

fn resolve.report.line_from(src: &[u8], start: usize) -> &str uses [] panics never pub
    let mut last = start
    let mut stop = false
    for k in core.iter.range(start, src.len()) {
        if !stop {
            match src.get(k) {
                Some(c) => if *c == 10u8 {
                    stop = true
                } else {
                    last = k.wrapping_add(1usize)
                }
                None => {
                    stop = true
                }
            }
        }
    }
    resolve.ast.text(src, start, last).trim_end()
end resolve.report.line_from

fn resolve.report.new() -> Result<resolve.report.Report, alloc.alloc.AllocError> uses [] panics never pub
    let text = alloc.string.String.new(std.alloc.SYSTEM)
    let path = alloc.string.String.new(std.alloc.SYSTEM)
    let nosig = false
    Ok(resolve.report.Report { text: text, path: path, errors: 0usize, refs: 0usize, sig: nosig })
end resolve.report.new

fn resolve.report.set_path(rep: &mut resolve.report.Report, path: &str) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    rep.path.clear()
    rep.path.push_str(path)?
    Ok(())
end resolve.report.set_path

fn resolve.report.syntax(rep: &mut resolve.report.Report, line: usize, code: u32, want: u32) -> Result<(), resolve.Failure> uses [alloc] panics never pub
    rep.text.push_str("error PARSE ")?
    rep.text.push_str(rep.path.as_str())?
    rep.text.push(':')?
    rep.text.push_u64(u64.from_usize(line))?
    rep.text.push_str(": ")?
    rep.text.push_str(parse.err.message(code))?
    if want > 0u32 {
        rep.text.push(' ')?
        parse.tok.push_code_name(&mut rep.text, want)?
    }
    rep.text.push('\n')?
    rep.errors = rep.errors.wrapping_add(1usize)
    Ok(())
end resolve.report.syntax
