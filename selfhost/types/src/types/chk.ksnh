type types.chk.Ctx pub
    file: usize pub
    sc: std.vec.Vec<types.chk.Ent> pub
    pend: types.chk.Pend pub
    ret: usize pub
    rep: types.chk.Rep pub
    unknown: usize pub
    rec: types.rec.Rec pub
end types.chk.Ctx

// 検査の状態: 名前の並び (局所と総称)・整数リテラルの変数・戻り値の型・診断の文。
type types.chk.Ent pub
    name: std.string.String pub
    ty: usize pub
    generic: bool pub
end types.chk.Ent

// 関数の終わりに決める項目: 整数リテラル (行つき) と、let の束縛の型 (行つき)。
type types.chk.Pend pub
    lits: std.vec.Vec<usize> pub
    lit_lines: std.vec.Vec<usize> pub
    lets: std.vec.Vec<usize> pub
    let_lines: std.vec.Vec<usize> pub
end types.chk.Pend

// 診断の文の出力。sigcall は直前に完了した関数呼び出しが .sig の宣言だったか (E2042 の判定用)。
type types.chk.Rep pub
    out: std.string.String pub
    path: std.string.String pub
    errors: usize pub
    sigcall: bool pub
end types.chk.Rep

// 診断 1 件: `error CODE 路径:行: 内容`。
fn types.chk.diag(cx: &mut types.chk.Ctx, code: &str, line: usize, msg: &str) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    cx.rep.out.push_str("error ")?
    cx.rep.out.push_str(code)?
    cx.rep.out.push(' ')?
    cx.rep.out.push_str(cx.rep.path.as_str())?
    cx.rep.out.push(':')?
    cx.rep.out.push_u64(u64.from_usize(line))?
    cx.rep.out.push_str(": ")?
    cx.rep.out.push_str(msg)?
    cx.rep.out.push('\n')?
    cx.rep.errors = cx.rep.errors.wrapping_add(1usize)
    Ok(())
end types.chk.diag

// 名前を最も内側から探す (添字 + 1、なければ 0)。
fn types.chk.find(cx: &types.chk.Ctx, name: &str, generic: bool) -> usize uses [] panics never pub
    let mut found = 0usize
    for k in core.iter.range(0usize, cx.sc.len()) {
        match cx.sc.as_slice().get(k) {
            Some(e) => if e.generic == generic && e.name.as_str() == name {
                found = k.wrapping_add(1usize)
            }
            None => core.mem.drop(0u8)
        }
    }
    found
end types.chk.find

fn types.chk.mark(cx: &types.chk.Ctx) -> usize uses [] panics never pub
    cx.sc.len()
end types.chk.mark

fn types.chk.new() -> Result<types.chk.Ctx, alloc.alloc.AllocError> uses [] panics never pub
    let sc = std.vec.Vec.new()
    let lits = std.vec.Vec.new()
    let lit_lines = std.vec.Vec.new()
    let lets = std.vec.Vec.new()
    let let_lines = std.vec.Vec.new()
    let out = std.string.String.new()
    let path = std.string.String.new()
    let rep = types.chk.Rep {
        out: out
        path: path
        errors: 0usize
        sigcall: false
    }
    let pend = types.chk.Pend {
        lits: lits
        lit_lines: lit_lines
        lets: lets
        let_lines: let_lines
    }
    let rec = types.rec.empty()?
    let z = 0usize
    Ok(types.chk.Ctx {
        file: z
        sc: sc
        pend: pend
        ret: z
        rep: rep
        unknown: z
        rec: rec
    })
end types.chk.new

fn types.chk.push(cx: &mut types.chk.Ctx, name: &str, ty: usize, generic: bool) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    let nm = std.string.String.from_str(name)?
    cx.sc.push(types.chk.Ent {
        name: nm
        ty: ty
        generic: generic
    })?
    Ok(())
end types.chk.push

fn types.chk.truncate(cx: &mut types.chk.Ctx, m: usize) -> () uses [] panics never pub
    cx.sc.truncate(m)
end types.chk.truncate

// 添字 k (find の結果 - 1) の型。
fn types.chk.ty_at(cx: &types.chk.Ctx, k: usize) -> usize uses [] panics never pub
    match cx.sc.as_slice().get(k) {
        Some(e) => e.ty
        None => 0usize
    }
end types.chk.ty_at
