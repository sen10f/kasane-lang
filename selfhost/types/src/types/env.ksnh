type types.env.Env pub
    srcs: std.vec.Vec<resolve.load.Src> pub
    units: std.vec.Vec<parse.cur.P> pub
    tab: types.env.Tab pub
end types.env.Env

type types.env.Imp pub
    file: usize pub
    tail: std.string.String pub
    full: std.string.String pub
end types.env.Imp

// プログラム全体の表: 読み込んだファイル (パース済み) と、定義 (FQN → 項目)・列挙子・import の表。
// 検索は「添字 + 1」を返す (0 = 見つからない)。
type types.env.Item pub
    kind: parse.ast.Kind pub
    file: usize pub
    node: usize pub
    fqn: std.string.String pub
    sig: bool pub
    owner: usize pub
end types.env.Item

type types.env.Map pub
    m: std.collections.HashMap<std.string.String, usize> pub
end types.env.Map

type types.env.Tab pub
    items: std.vec.Vec<types.env.Item> pub
    defs: types.env.Map pub
    vars: types.env.Map pub
    imps: std.vec.Vec<types.env.Imp> pub
end types.env.Tab

// 単位 file (解析済みの p、本文 src) の定義・列挙子・import を表に入れる。
fn types.env.add_file(tab: &mut types.env.Tab, file: usize, p: &parse.cur.P, src: &[u8], sig: bool) -> Result<(), resolve.Failure> uses [alloc] panics never pub
    for d in p.ast.defs.as_slice().iter() {
        let n = parse.ast.get(&p.ast, *d)
        if n.kind == parse.ast.Kind.Import {
            let full = resolve.ast.text(src, n.a, n.b)
            let tail = resolve.ast.last_part(full)
            let tail_s = alloc.string.String.from_str(std.alloc.SYSTEM, tail)?
            let full_s = alloc.string.String.from_str(std.alloc.SYSTEM, full)?
            tab.imps.push(types.env.Imp { file: file, tail: tail_s, full: full_s })?
        } else if n.kind != parse.ast.Kind.ImplLine {
            let name = resolve.ast.text(src, n.a, n.b)
            let key = alloc.string.String.from_str(std.alloc.SYSTEM, name)?
            types.env.put(tab, key, n.kind, file, *d, sig)?
            if n.kind == parse.ast.Kind.EnumDef {
                types.env.add_variants(tab, file, p, src, name, n.d, sig)?
            }
        }
    }
    Ok(())
end types.env.add_file

// 列挙子を `型.列挙子` で入れる (owner は列挙型の項目 id + 1)。
fn types.env.add_variants(tab: &mut types.env.Tab, file: usize, p: &parse.cur.P, src: &[u8], owner: &str, list: usize, sig: bool) -> Result<(), resolve.Failure> uses [alloc] panics never pub
    let ownid = types.env.get_def(tab, owner)
    for j in core.iter.range(0usize, resolve.ast.count(p, list)) {
        let node = resolve.ast.item(p, list, j)
        let vn = parse.ast.get(&p.ast, node)
        let vname = resolve.ast.tok_text(p, src, vn.a)
        let mut key = alloc.string.String.from_str(std.alloc.SYSTEM, owner)?
        key.push('.')?
        key.push_str(vname)?
        types.env.put_var(tab, key, file, node, sig, ownid)?
    }
    Ok(())
end types.env.add_variants

// 構文エラーのファイルは空の単位にする (その中の定義は表に入らない。報告は resolve が出す)。
fn types.env.empty() -> Result<parse.cur.P, resolve.Failure> uses [alloc] panics never pub
    match parse.cur.new(std.vec.Vec.new()) {
        Ok(q) => Ok(q)
        Err(parse.err.Error.Alloc(e)) => Err(resolve.Failure.Alloc(e))
        Err(parse.err.Error.Syntax(_, _, _, _)) => Err(resolve.Failure.Manifest)
    }
end types.env.empty

// FQN で定義を引く (添字 + 1、なければ 0)。
fn types.env.get_def(tab: &types.env.Tab, name: &str) -> usize uses [alloc] panics never pub
    let k = match alloc.string.String.from_str(std.alloc.SYSTEM, name) {
        Ok(s) => s
        Err(_) => return 0usize
    }
    let dm = &tab.defs.m
    match dm.get_str(k.as_str()) {
        Some(ix) => ix.wrapping_add(1usize)
        None => 0usize
    }
end types.env.get_def

fn types.env.get_var(tab: &types.env.Tab, name: &str) -> usize uses [alloc] panics never pub
    let k = match alloc.string.String.from_str(std.alloc.SYSTEM, name) {
        Ok(s) => s
        Err(_) => return 0usize
    }
    let vm = &tab.vars.m
    match vm.get_str(k.as_str()) {
        Some(ix) => ix.wrapping_add(1usize)
        None => 0usize
    }
end types.env.get_var

fn types.env.item_sig(tab: &types.env.Tab, ix: usize) -> bool uses [] panics never pub
    match tab.items.as_slice().get(ix) {
        Some(it) => it.sig
        None => false
    }
end types.env.item_sig

// 名前の FQN 形。先頭成分が import の末尾名なら、その完全名に読み替える。
fn types.env.key_of(env: &types.env.Env, file: usize, name: &str) -> Result<std.string.String, alloc.alloc.AllocError> uses [alloc] panics never pub
    let (first, rest) = match name.split_once(".") {
        Some((a, b)) => (a, b)
        None => (name, "")
    }
    let pre = types.env.prelude(first, rest)
    if pre != "" {
        return alloc.string.String.from_str(std.alloc.SYSTEM, pre)
    }
    // 基本型の関連関数 (`usize.parse`、`i32.MAX`) は core.num.<型>.<名前> (4.5)。
    if (first == "bool" || first == "char") && rest != "" {
        let mut ps = alloc.string.String.from_str(std.alloc.SYSTEM, "core.")?
        ps.push_str(first)?
        ps.push('.')?
        ps.push_str(first)?
        ps.push('.')?
        ps.push_str(rest)?
        return Ok(ps)
    }
    if rest != "" && types.ty.int_id(first) != types.ty.UNKNOWN {
        let mut num = alloc.string.String.from_str(std.alloc.SYSTEM, "core.num.")?
        num.push_str(first)?
        num.push('.')?
        num.push_str(rest)?
        return Ok(num)
    }
    let mut found = std.string.String.new()
    let mut hit = false
    for k_im in core.iter.range(0usize, env.tab.imps.len()) {
        match env.tab.imps.as_slice().get(k_im) {
            Some(im) => if !hit && im.file == file && im.tail.as_str() == first {
                found.push_str(im.full.as_str())?
                hit = true
            }
            None => core.mem.drop(0u8)
        }
    }
    if hit {
        if rest != "" {
            found.push('.')?
            found.push_str(rest)?
        }
        return Ok(found)
    }
    alloc.string.String.from_str(std.alloc.SYSTEM, name)
end types.env.key_of

// 読み込み: 自パッケージと直接の path 依存の src/、標準ライブラリを集め、全ファイルを解析して表を作る。
fn types.env.load(pkg: &str, std_dir: &str) -> Result<types.env.Env, resolve.Failure> uses [alloc, io.fs] panics never pub
    let man = resolve.manifest.read(pkg)?
    let mut srcs = std.vec.Vec.new()
    let own_src = resolve.manifest.join(pkg, "src")?
    resolve.load.collect(own_src.as_str(), "", true, &mut srcs)?
    let deps = man.deps
    for d in deps.as_slice().iter() {
        let dir = resolve.manifest.join(pkg, d.path.as_str())?
        let dsrc = resolve.manifest.join(dir.as_str(), "src")?
        resolve.load.collect(dsrc.as_str(), "", false, &mut srcs)?
    }
    resolve.load.collect(std_dir, "", false, &mut srcs)?
    let mut units = std.vec.Vec.new()
    let mut rep = resolve.report.new()?
    for s in srcs.as_slice().iter() {
        let p = match resolve.parse_file(s.text.as_slice(), s.path.as_str(), s.sig, &mut rep)? {
            Some(q) => q
            None => types.env.empty()?
        }
        units.push(p)?
    }
    let mut tab = types.env.tab_new()?
    let mut file = 0usize
    for p in units.as_slice().iter() {
        match srcs.as_slice().get(file) {
            Some(s) => types.env.add_file(&mut tab, file, p, s.text.as_slice(), s.sig)?
            None => core.mem.drop(0u8)
        }
        file = file.wrapping_add(1usize)
    }
    Ok(types.env.Env { srcs: srcs, units: units, tab: tab })
end types.env.load

// 名前 (FQN の形、または import の先頭成分を含む) を解決して項目 + 1。見つからなければ 0。
// プレリュード (Option / Some / None / Result / Ok / Err) は core の FQN に読み替える (4.2)。
fn types.env.lookup(env: &types.env.Env, file: usize, name: &str) -> Result<usize, alloc.alloc.AllocError> uses [alloc] panics never pub
    let key = types.env.key_of(env, file, name)?
    let direct = types.env.get_def(&env.tab, key.as_str())
    if direct != 0usize {
        return Ok(direct)
    }
    Ok(types.env.get_var(&env.tab, key.as_str()))
end types.env.lookup

// 項目の作成 (構造体リテラルは 1 行に収める)。
fn types.env.mk_item(kind: parse.ast.Kind, file: usize, node: usize, fqn: std.string.String, sig: bool, owner: usize) -> types.env.Item uses [] panics never pub
    types.env.Item { kind: kind, file: file, node: node, fqn: fqn, sig: sig, owner: owner }
end types.env.mk_item

// プレリュードの名前の FQN (単独の名前だけ)。該当しなければ空。
fn types.env.prelude(first: &str, rest: &str) -> &'static str uses [] panics never pub
    if rest != "" {
        return ""
    }
    if first == "Option" {
        return "core.option.Option"
    }
    if first == "Some" {
        return "core.option.Option.Some"
    }
    if first == "None" {
        return "core.option.Option.None"
    }
    if first == "Result" {
        return "core.result.Result"
    }
    if first == "Ok" {
        return "core.result.Result.Ok"
    }
    if first == "Err" {
        return "core.result.Result.Err"
    }
    ""
end types.env.prelude

// 定義 1 件を defs に入れる。同名の宣言 (sig) があり、今回が実装なら実装で置き換える。
fn types.env.put(tab: &mut types.env.Tab, key: std.string.String, kind: parse.ast.Kind, file: usize, node: usize, sig: bool) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    let old = types.env.get_def(tab, key.as_str())
    if old != 0usize {
        if !types.env.item_sig(tab, old.wrapping_sub(1usize)) || sig {
            return Ok(())
        }
    }
    let ix = tab.items.len()
    let k2 = alloc.string.String.from_str(std.alloc.SYSTEM, key.as_str())?
    tab.items.push(types.env.mk_item(kind, file, node, key, sig, 0usize))?
    let dm = &mut tab.defs.m
    core.mem.drop(dm.insert(k2, ix)?)
    Ok(())
end types.env.put

fn types.env.put_var(tab: &mut types.env.Tab, key: std.string.String, file: usize, node: usize, sig: bool, owner: usize) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    let ix = tab.items.len()
    let k2 = alloc.string.String.from_str(std.alloc.SYSTEM, key.as_str())?
    tab.items.push(types.env.mk_item(parse.ast.Kind.Variant, file, node, key, sig, owner))?
    let vm = &mut tab.vars.m
    core.mem.drop(vm.insert(k2, ix)?)
    Ok(())
end types.env.put_var

fn types.env.tab_new() -> Result<types.env.Tab, alloc.alloc.AllocError> uses [] panics never pub
    let items = std.vec.Vec.new()
    let dm = std.collections.HashMap.new()
    let vm = std.collections.HashMap.new()
    let imps = std.vec.Vec.new()
    let defs = types.env.Map { m: dm }
    let vars = types.env.Map { m: vm }
    Ok(types.env.Tab { items: items, defs: defs, vars: vars, imps: imps })
end types.env.tab_new

// 単位 file の p (範囲外は None)。
fn types.env.unit(env: &types.env.Env, file: usize) -> Option<&parse.cur.P> uses [] panics never pub
    env.units.as_slice().get(file)
end types.env.unit
