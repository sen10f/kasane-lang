type types.export.Out pub
    env: types.env.Env pub
    ar: types.ty.Arena pub
    cx: types.chk.Ctx pub
end types.export.Out

fn types.export.run(pkg: &str, std_dir: &str) -> Result<types.export.Out, resolve.Failure> uses [alloc, io.fs] panics never pub
    let env = types.env.load(pkg, std_dir)?
    let mut ar = types.ty.new()?
    let mut cx = types.chk.new()?
    types.check.all(&env, &mut ar, &mut cx)?
    Ok(types.export.Out {
        env: env
        ar: ar
        cx: cx
    })
end types.export.run

fn types.export.ty_of(out: &types.export.Out, file: usize, node: usize) -> usize uses [] panics never pub
    let t = types.rec.ty_of(&out.cx.rec, file, node)
    types.ty.find(&out.ar, t)
end types.export.ty_of
