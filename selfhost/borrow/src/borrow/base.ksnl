const borrow.base.COPY: usize = 1usize pub

const borrow.base.LIN: usize = 3usize pub

const borrow.base.MOVE: usize = 2usize pub

const borrow.base.MREF: usize = 5usize pub

const borrow.base.OP_REF_MUT: usize = 1000usize pub

const borrow.base.SREF: usize = 4usize pub

const borrow.base.UNK: usize = 0usize pub

type borrow.base.Tab pub
    tnames: std.vec.Vec<std.string.String> pub
    tcls: std.vec.Vec<usize> pub
    fnames: std.vec.Vec<std.string.String> pub
    fcls: std.vec.Vec<usize> pub
end borrow.base.Tab

fn borrow.base.block_end(p: &parse.cur.P, open: usize) -> usize uses [] panics never pub
    let n = p.toks.len()
    let mut depth = 0usize
    for k in core.iter.range(open, n) {
        if borrow.base.is_op_tok(p, k, 123u32) {
            depth = depth.wrapping_add(1usize)
        }
        if borrow.base.is_op_tok(p, k, 125u32) {
            depth = depth.wrapping_sub(1usize)
            if depth == 0usize {
                return k
            }
        }
    }
    n
end borrow.base.block_end

fn borrow.base.combine(a: usize, b: usize) -> usize uses [] panics never pub
    let x = borrow.base.norm(a)
    let y = borrow.base.norm(b)
    if x == borrow.base.UNK || y == borrow.base.UNK {
        return borrow.base.UNK
    }
    if x == borrow.base.LIN || y == borrow.base.LIN {
        return borrow.base.LIN
    }
    if x == borrow.base.MOVE || y == borrow.base.MOVE {
        return borrow.base.MOVE
    }
    borrow.base.COPY
end borrow.base.combine

fn borrow.base.first_seg(s: &str) -> &str uses [] panics never pub
    for c in s.split(".") {
        return c
    }
    s
end borrow.base.first_seg

fn borrow.base.flag(c: bool) -> usize uses [] panics never pub
    if c {
        return 1usize
    }
    0usize
end borrow.base.flag

fn borrow.base.fn_lookup(tab: &borrow.base.Tab, name: &str) -> usize uses [] panics never pub
    let n = tab.fnames.len()
    for k in core.iter.range(0usize, n) {
        let same = match tab.fnames.as_slice().get(k) {
            Some(s) => s.as_str() == name
            None => false
        }
        if same {
            return match tab.fcls.as_slice().get(k) {
                Some(c) => *c
                None => borrow.base.UNK
            }
        }
    }
    borrow.base.UNK
end borrow.base.fn_lookup

fn borrow.base.is_container(name: &str) -> bool uses [] panics never pub
    if name == "String" || name == "Vec" || name == "Box" || name == "HashMap" {
        return true
    }
    if name == "BtreeMap" || name == "HashSet" || name == "BtreeSet" || name == "VecDeque" {
        return true
    }
    name == "Rc" || name == "Arc"
end borrow.base.is_container

fn borrow.base.is_kw_tok(p: &parse.cur.P, ti: usize, code: u32) -> bool uses [] panics never pub
    let t = parse.cur.peek_at(p, ti)
    t.kind == parse.tok.Kind.Kw && t.code == code
end borrow.base.is_kw_tok

fn borrow.base.is_op_tok(p: &parse.cur.P, ti: usize, code: u32) -> bool uses [] panics never pub
    let t = parse.cur.peek_at(p, ti)
    t.kind == parse.tok.Kind.Op && t.code == code
end borrow.base.is_op_tok

fn borrow.base.is_str_tok(p: &parse.cur.P, ti: usize) -> bool uses [] panics never pub
    parse.cur.peek_at(p, ti).kind == parse.tok.Kind.Str
end borrow.base.is_str_tok

fn borrow.base.norm(c: usize) -> usize uses [] panics never pub
    if c == borrow.base.SREF {
        return borrow.base.COPY
    }
    if c == borrow.base.MREF {
        return borrow.base.MOVE
    }
    c
end borrow.base.norm

fn borrow.base.pick(c: bool, a: usize, b: usize) -> usize uses [] panics never pub
    if c {
        return a
    }
    b
end borrow.base.pick

fn borrow.base.put_fn(tab: &mut borrow.base.Tab, name: &str, cls: usize) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    let n = tab.fnames.len()
    for k in core.iter.range(0usize, n) {
        let same = match tab.fnames.as_slice().get(k) {
            Some(s) => s.as_str() == name
            None => false
        }
        if same {
            borrow.base.set_usize(&mut tab.fcls, k, borrow.base.UNK)
            return Ok(())
        }
    }
    tab.fnames.push(std.string.String.from_str(name)?)?
    tab.fcls.push(cls)?
    Ok(())
end borrow.base.put_fn

fn borrow.base.put_ty(tab: &mut borrow.base.Tab, name: &str, cls: usize) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    let n = tab.tnames.len()
    for k in core.iter.range(0usize, n) {
        let same = match tab.tnames.as_slice().get(k) {
            Some(s) => s.as_str() == name
            None => false
        }
        if same {
            borrow.base.set_usize(&mut tab.tcls, k, borrow.base.UNK)
            return Ok(())
        }
    }
    tab.tnames.push(std.string.String.from_str(name)?)?
    tab.tcls.push(cls)?
    Ok(())
end borrow.base.put_ty

fn borrow.base.set_usize(v: &mut std.vec.Vec<usize>, k: usize, val: usize) -> () uses [] panics never pub
    match v.as_mut_slice().get_mut(k) {
        Some(x) => {
            *x = val
        }
        None => core.mem.drop(0u8)
    }
end borrow.base.set_usize

fn borrow.base.tab_new() -> borrow.base.Tab uses [] panics never pub
    let tn = std.vec.Vec.new()
    let tc = std.vec.Vec.new()
    let fnm = std.vec.Vec.new()
    let fc = std.vec.Vec.new()
    borrow.base.Tab {
        tnames: tn
        tcls: tc
        fnames: fnm
        fcls: fc
    }
end borrow.base.tab_new

fn borrow.base.tok_range(p: &parse.cur.P, ti: usize) -> (usize, usize) uses [] panics never pub
    let t = parse.cur.peek_at(p, ti)
    (t.start, t.stop)
end borrow.base.tok_range

fn borrow.base.ty_cls(tab: &borrow.base.Tab, p: &parse.cur.P, src: &[u8], t: usize) -> usize uses [] panics never stack 8192 pub
    if t == 0usize {
        return borrow.base.UNK
    }
    let n = parse.ast.get(&p.ast, t)
    if n.kind == parse.ast.Kind.TPrim || n.kind == parse.ast.Kind.TPtr {
        return borrow.base.COPY
    }
    if n.kind == parse.ast.Kind.TNever || n.kind == parse.ast.Kind.TFn {
        return borrow.base.COPY
    }
    if n.kind == parse.ast.Kind.TRef {
        if n.b == 1usize {
            return borrow.base.MREF
        }
        return borrow.base.SREF
    }
    if n.kind == parse.ast.Kind.TArray {
        return borrow.base.norm(borrow.base.ty_cls(tab, p, src, n.a))
    }
    if n.kind == parse.ast.Kind.TTuple {
        let mut acc = borrow.base.COPY
        let cnt = resolve.ast.count(p, n.a)
        for k in core.iter.range(0usize, cnt) {
            let it = resolve.ast.item(p, n.a, k)
            let c = borrow.base.ty_cls(tab, p, src, it)
            acc = borrow.base.combine(acc, c)
        }
        return acc
    }
    if n.kind == parse.ast.Kind.TNamed {
        let name = resolve.ast.text(src, n.a, n.b)
        let last = resolve.ast.last_part(name)
        if borrow.base.is_container(last) {
            return borrow.base.MOVE
        }
        if last == "Option" || last == "Result" {
            let mut acc = borrow.base.COPY
            let cnt = resolve.ast.count(p, n.c)
            for k in core.iter.range(0usize, cnt) {
                let it = resolve.ast.item(p, n.c, k)
                if parse.ast.get(&p.ast, it).kind != parse.ast.Kind.TArgLife {
                    acc = borrow.base.combine(acc, borrow.base.ty_cls(tab, p, src, it))
                }
            }
            return acc
        }
        return borrow.base.ty_lookup(tab, last)
    }
    borrow.base.UNK
end borrow.base.ty_cls

fn borrow.base.ty_lookup(tab: &borrow.base.Tab, name: &str) -> usize uses [] panics never pub
    let n = tab.tnames.len()
    for k in core.iter.range(0usize, n) {
        let same = match tab.tnames.as_slice().get(k) {
            Some(s) => s.as_str() == name
            None => false
        }
        if same {
            return match tab.tcls.as_slice().get(k) {
                Some(c) => *c
                None => borrow.base.UNK
            }
        }
    }
    borrow.base.UNK
end borrow.base.ty_lookup
