fn borrow.tabfill.derives(p: &parse.cur.P, src: &[u8], l: usize, want: &str) -> bool uses [] panics never pub
    for k in core.iter.range(0usize, resolve.ast.count(p, l)) {
        let it = parse.ast.get(&p.ast, resolve.ast.item(p, l, k))
        if resolve.ast.tok_text(p, src, it.a) == want {
            return true
        }
    }
    false
end borrow.tabfill.derives

fn borrow.tabfill.fns(tab: &mut borrow.base.Tab, p: &parse.cur.P, src: &[u8]) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    for d in p.ast.defs.as_slice().iter() {
        let n = parse.ast.get(&p.ast, *d)
        if n.kind == parse.ast.Kind.FnDef {
            let name = resolve.ast.last_part(resolve.ast.text(src, n.a, n.b))
            let sg = parse.ast.get(&p.ast, n.c)
            let mut cls = borrow.base.COPY
            if sg.c != 0usize {
                cls = borrow.base.ty_cls(tab, p, src, sg.c)
            }
            borrow.base.put_fn(tab, name, cls)?
        }
    }
    Ok(())
end borrow.tabfill.fns

fn borrow.tabfill.types(tab: &mut borrow.base.Tab, p: &parse.cur.P, src: &[u8]) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    for d in p.ast.defs.as_slice().iter() {
        let n = parse.ast.get(&p.ast, *d)
        if n.kind == parse.ast.Kind.TypeDef || n.kind == parse.ast.Kind.EnumDef {
            let name = resolve.ast.last_part(resolve.ast.text(src, n.a, n.b))
            let f = n.f
            let lin = f == 2usize || f == 3usize || f == 6usize || f == 7usize
            let mut cls = borrow.base.MOVE
            if lin {
                cls = borrow.base.LIN
            } else {
                if borrow.tabfill.derives(p, src, n.e, "Copy") {
                    cls = borrow.base.COPY
                }
            }
            borrow.base.put_ty(tab, name, cls)?
        }
    }
    Ok(())
end borrow.tabfill.types
