const borrow.cx.K_BMUT: usize = 5usize pub

const borrow.cx.K_BSHR: usize = 6usize pub

const borrow.cx.K_MOVE: usize = 2usize pub

const borrow.cx.K_PART: usize = 4usize pub

const borrow.cx.K_READ: usize = 1usize pub

const borrow.cx.K_WRITE: usize = 3usize pub

const borrow.cx.ST_CONS: usize = 3usize pub

const borrow.cx.ST_LIVE: usize = 0usize pub

const borrow.cx.ST_MOVED: usize = 1usize pub

const borrow.cx.ST_UNDEC: usize = 2usize pub

type borrow.cx.Br derive [Clone, Copy] pub
    holder: usize pub
    target: usize pub
    mutb: usize pub
    ps: usize pub
    pe: usize pub
end borrow.cx.Br

type borrow.cx.Cx pub
    p: parse.cur.P pub
    src: std.vec.Vec<u8> pub
    dat: borrow.cx.Dat pub
    rep: borrow.cx.Rep pub
    fnr: borrow.cx.FnInfo pub
    tcls: std.vec.Vec<usize> pub
end borrow.cx.Cx

type borrow.cx.Dat pub
    locs: std.vec.Vec<borrow.cx.Loc> pub
    brs: std.vec.Vec<borrow.cx.Br> pub
    nexts: std.vec.Vec<usize> pub
    bends: std.vec.Vec<usize> pub
    depth: usize pub
end borrow.cx.Dat

type borrow.cx.FnInfo pub
    ret_ref: usize pub
    ret_life: usize pub
    elide: usize pub
end borrow.cx.FnInfo

type borrow.cx.Loc derive [Clone, Copy] pub
    a: usize pub
    b: usize pub
    cl: usize pub
    mu: usize pub
    rf: usize pub
    pa: usize pub
    li: usize pub
    ir: usize pub
    dp: usize pub
    fi: usize pub
    st: usize pub
end borrow.cx.Loc

type borrow.cx.Rep pub
    path: std.string.String pub
    out: std.string.String pub
    errors: usize pub
    undec: usize pub
end borrow.cx.Rep

fn borrow.cx.access(cx: &mut borrow.cx.Cx, idx: usize, kind: usize, tok: usize) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    borrow.cx.access_at(cx, idx, kind, tok, 0usize, 0usize)
end borrow.cx.access

fn borrow.cx.access_at(cx: &mut borrow.cx.Cx, idx: usize, kind: usize, tok: usize, ps: usize, pe: usize) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    let l = borrow.cx.loc(cx, idx)
    if kind != borrow.cx.K_WRITE {
        if l.st == borrow.cx.ST_MOVED {
            borrow.cx.diag(cx, "E3002", tok, "移動した後の値を使う")?
        }
        if l.st == borrow.cx.ST_CONS {
            borrow.cx.diag(cx, "E3003", tok, "消費した線形値を使う")?
        }
        if l.st == borrow.cx.ST_UNDEC {
            borrow.cx.undec(cx)
        }
    }
    let mut clash = false
    let nb = cx.dat.brs.len()
    for k in core.iter.range(0usize, nb) {
        if !clash {
            let br = match cx.dat.brs.as_slice().get(k) {
                Some(x) => *x
                None => borrow.cx.empty_br()
            }
            let writes0 = kind == borrow.cx.K_WRITE || kind == borrow.cx.K_PART
            let writes = writes0 || kind == borrow.cx.K_MOVE
            let conflict = br.mutb == 1usize || writes || kind == borrow.cx.K_BMUT
            let hit = br.target == idx && br.holder != idx && conflict
            let ov = hit && borrow.cx.paths_overlap(cx.src.as_slice(), br.ps, br.pe, ps, pe)
            if ov && borrow.cx.alive(cx, br.holder) {
                clash = true
                borrow.cx.diag(cx, "E3010", tok, "借用中の値を変更・移動・借用する")?
            }
        }
    }
    if kind == borrow.cx.K_MOVE {
        if l.cl == borrow.base.LIN {
            borrow.cx.set_st(cx, idx, borrow.cx.ST_CONS)
        } else {
            borrow.cx.set_st(cx, idx, borrow.cx.ST_MOVED)
        }
    }
    if kind == borrow.cx.K_WRITE {
        borrow.cx.set_st(cx, idx, borrow.cx.ST_LIVE)
    }
    Ok(())
end borrow.cx.access_at

fn borrow.cx.add_borrow(cx: &mut borrow.cx.Cx, k: usize, target: usize, mutb: usize, ps: usize, pe: usize) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    let mut l = borrow.cx.loc(cx, k)
    l.rf = target.wrapping_add(1usize)
    match cx.dat.locs.as_mut_slice().get_mut(k) {
        Some(x) => {
            *x = l
        }
        None => core.mem.drop(0u8)
    }
    cx.dat.brs.push(borrow.cx.Br {
        holder: k
        target: target
        mutb: mutb
        ps: ps
        pe: pe
    })?
    Ok(())
end borrow.cx.add_borrow

fn borrow.cx.alive(cx: &borrow.cx.Cx, h: usize) -> bool uses [] panics never pub
    let l = borrow.cx.loc(cx, h)
    let from = match cx.dat.nexts.as_slice().get(l.dp) {
        Some(x) => *x
        None => 0usize
    }
    let name = resolve.ast.text(cx.src.as_slice(), l.a, l.b)
    let mut k = from
    while k < l.fi {
        let t = parse.cur.peek_at(&cx.p, k)
        let same_text = resolve.ast.tok_text(&cx.p, cx.src.as_slice(), k) == name
        if t.kind == parse.tok.Kind.Ident && same_text {
            return true
        }
        if borrow.base.is_kw_tok(&cx.p, k, parse.tok.KW_LET) {
            let j = if borrow.base.is_kw_tok(&cx.p, k.wrapping_add(1usize), parse.tok.KW_MUT) {
                k.wrapping_add(2usize)
            } else {
                k.wrapping_add(1usize)
            }
            if resolve.ast.tok_text(&cx.p, cx.src.as_slice(), j) == name {
                return false
            }
        }
        k = k.wrapping_add(1usize)
    }
    false
end borrow.cx.alive

fn borrow.cx.declare(cx: &mut borrow.cx.Cx, a: usize, b: usize, cls: usize, mutb: usize, tok: usize) -> Result<usize, alloc.alloc.AllocError> uses [alloc] panics never pub
    let d = cx.dat.depth
    let fin = match cx.dat.bends.as_slice().get(d) {
        Some(x) => *x
        None => 0usize
    }
    let l = borrow.cx.mk_loc(a, b, cls, mutb, d, fin)
    let at = cx.dat.locs.len()
    cx.dat.locs.push(l)?
    core.mem.drop(tok)
    Ok(at)
end borrow.cx.declare

fn borrow.cx.declare_tok(cx: &mut borrow.cx.Cx, ti: usize, cls: usize, mutb: usize) -> Result<usize, alloc.alloc.AllocError> uses [alloc] panics never pub
    let (a, b) = borrow.base.tok_range(&cx.p, ti)
    borrow.cx.declare(cx, a, b, cls, mutb, ti)
end borrow.cx.declare_tok

fn borrow.cx.diag(cx: &mut borrow.cx.Cx, code: &str, tok: usize, msg: &str) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    let line = resolve.ast.line_of(&cx.p, tok)
    cx.rep.out.push_str("error ")?
    cx.rep.out.push_str(code)?
    cx.rep.out.push(' ')?
    cx.rep.out.push_str(cx.rep.path.as_str())?
    cx.rep.out.push(':')?
    cx.rep.out.push_u64(u64.from_usize(line))?
    cx.rep.out.push_str(": ")?
    cx.rep.out.push_str(msg)?
    cx.rep.out.push('\n')?
    cx.rep.errors = cx.rep.errors.wrapping_add(1usize)
    Ok(())
end borrow.cx.diag

fn borrow.cx.dot_join(bs: usize, be: usize, fs: usize, fe: usize) -> (usize, usize) uses [] panics never pub
    if bs == be {
        return (fs, fe)
    }
    (bs, fe)
end borrow.cx.dot_join

fn borrow.cx.empty_br() -> borrow.cx.Br uses [] panics never pub
    borrow.cx.Br {
        holder: 0usize
        target: 0usize
        mutb: 0usize
        ps: 0usize
        pe: 0usize
    }
end borrow.cx.empty_br

fn borrow.cx.empty_loc() -> borrow.cx.Loc uses [] panics never pub
    borrow.cx.mk_loc(0usize, 0usize, 0usize, 0usize, 0usize, 0usize)
end borrow.cx.empty_loc

fn borrow.cx.find(cx: &borrow.cx.Cx, a: usize, b: usize) -> usize uses [] panics never pub
    let s = resolve.ast.text(cx.src.as_slice(), a, b)
    borrow.cx.find_text(cx, s)
end borrow.cx.find

fn borrow.cx.find_text(cx: &borrow.cx.Cx, s: &str) -> usize uses [] panics never pub
    let n = cx.dat.locs.len()
    let mut k = n
    while k > 0usize {
        k = k.wrapping_sub(1usize)
        let l = borrow.cx.loc(cx, k)
        if resolve.ast.text(cx.src.as_slice(), l.a, l.b) == s {
            return k.wrapping_add(1usize)
        }
    }
    0usize
end borrow.cx.find_text

fn borrow.cx.has_index(cx: &borrow.cx.Cx, e: usize) -> bool uses [] panics never stack 8192 pub
    if e == 0usize {
        return false
    }
    let n = parse.ast.get(&cx.p.ast, e)
    if n.kind == parse.ast.Kind.Index {
        return true
    }
    if n.kind == parse.ast.Kind.Dot {
        return borrow.cx.has_index(cx, n.a)
    }
    false
end borrow.cx.has_index

fn borrow.cx.join_into(cx: &borrow.cx.Cx, acc: &mut std.vec.Vec<usize>, cur: &std.vec.Vec<usize>) -> () uses [] panics never pub
    for k in core.iter.range(0usize, acc.len()) {
        let a = match acc.as_slice().get(k) {
            Some(x) => *x
            None => borrow.cx.ST_UNDEC
        }
        let b = match cur.as_slice().get(k) {
            Some(x) => *x
            None => borrow.cx.ST_UNDEC
        }
        let cls = borrow.cx.loc(cx, k).cl
        borrow.base.set_usize(acc, k, borrow.cx.join_st(a, b, cls))
    }
end borrow.cx.join_into

fn borrow.cx.join_st(a: usize, b: usize, cls: usize) -> usize uses [] panics never pub
    if a == b {
        return a
    }
    if a == borrow.cx.ST_UNDEC || b == borrow.cx.ST_UNDEC {
        return borrow.cx.ST_UNDEC
    }
    if cls == borrow.base.LIN {
        return borrow.cx.ST_UNDEC
    }
    borrow.cx.ST_MOVED
end borrow.cx.join_st

fn borrow.cx.loc(cx: &borrow.cx.Cx, k: usize) -> borrow.cx.Loc uses [] panics never pub
    match cx.dat.locs.as_slice().get(k) {
        Some(l) => *l
        None => borrow.cx.empty_loc()
    }
end borrow.cx.loc

fn borrow.cx.mark_undec(cx: &mut borrow.cx.Cx, idx: usize) -> () uses [] panics never pub
    let l = borrow.cx.loc(cx, idx)
    if l.st == borrow.cx.ST_LIVE {
        borrow.cx.set_st(cx, idx, borrow.cx.ST_UNDEC)
    }
end borrow.cx.mark_undec

fn borrow.cx.mk_loc(a: usize, b: usize, cls: usize, mb: usize, dp: usize, fi: usize) -> borrow.cx.Loc uses [] panics never pub
    let z = 0usize
    borrow.cx.Loc {
        a: a
        b: b
        cl: cls
        mu: mb
        rf: z
        pa: z
        li: z
        ir: z
        dp: dp
        fi: fi
        st: z
    }
end borrow.cx.mk_loc

fn borrow.cx.new(p: parse.cur.P, src: std.vec.Vec<u8>, path: &str) -> Result<borrow.cx.Cx, alloc.alloc.AllocError> uses [alloc] panics never pub
    let mut nx = std.vec.Vec.new()
    nx.push(0usize)?
    let mut be = std.vec.Vec.new()
    be.push(0usize)?
    let vl = std.vec.Vec.new()
    let vb = std.vec.Vec.new()
    let dat = borrow.cx.Dat {
        locs: vl
        brs: vb
        nexts: nx
        bends: be
        depth: 0usize
    }
    let pth = std.string.String.from_str(path)?
    let ob = std.string.String.new()
    let rep = borrow.cx.Rep {
        path: pth
        out: ob
        errors: 0usize
        undec: 0usize
    }
    let fnr = borrow.cx.FnInfo {
        ret_ref: 0usize
        ret_life: 0usize
        elide: 0usize
    }
    let tcls = std.vec.Vec.new()
    Ok(borrow.cx.Cx {
        p: p
        src: src
        dat: dat
        rep: rep
        fnr: fnr
        tcls: tcls
    })
end borrow.cx.new

fn borrow.cx.path_fields(src: &[u8], a: usize, b: usize, ctx: usize) -> (usize, usize) uses [] panics never pub
    if ctx == borrow.walk.CALLNAME {
        let (ps, pe) = borrow.cx.tail_path(src, a, b)
        return borrow.cx.recv_path(src, ps, pe)
    }
    borrow.cx.tail_path(src, a, b)
end borrow.cx.path_fields

fn borrow.cx.paths_overlap(src: &[u8], ps: usize, pe: usize, qs: usize, qe: usize) -> bool uses [] panics never pub
    if pe == ps || qe == qs {
        return true
    }
    let lp = pe.wrapping_sub(ps)
    let lq = qe.wrapping_sub(qs)
    let n = borrow.base.pick(lp < lq, lp, lq)
    for k in core.iter.range(0usize, n) {
        let x = borrow.walk.byte_at(src, ps.wrapping_add(k))
        let y = borrow.walk.byte_at(src, qs.wrapping_add(k))
        if x != y {
            return false
        }
    }
    if lp == lq {
        return true
    }
    let at = borrow.base.pick(lp < lq, qs.wrapping_add(n), ps.wrapping_add(n))
    borrow.walk.byte_at(src, at) == 46u8
end borrow.cx.paths_overlap

fn borrow.cx.place_path(cx: &borrow.cx.Cx, e: usize) -> (usize, usize) uses [] panics never stack 8192 pub
    if e == 0usize {
        return (0usize, 0usize)
    }
    let n = parse.ast.get(&cx.p.ast, e)
    if n.kind == parse.ast.Kind.Path {
        return borrow.cx.tail_path(cx.src.as_slice(), n.a, n.b)
    }
    if n.kind == parse.ast.Kind.Index {
        return borrow.cx.place_path(cx, n.a)
    }
    if n.kind == parse.ast.Kind.Dot {
        if borrow.cx.has_index(cx, n.a) {
            return borrow.cx.place_path(cx, n.a)
        }
        let (bs, be) = borrow.cx.place_path(cx, n.a)
        let f = parse.cur.peek_at(&cx.p, n.b)
        return borrow.cx.dot_join(bs, be, f.start, f.stop)
    }
    (0usize, 0usize)
end borrow.cx.place_path

fn borrow.cx.place_root(cx: &borrow.cx.Cx, e: usize) -> usize uses [] panics never stack 8192 pub
    let n = parse.ast.get(&cx.p.ast, e)
    if n.kind == parse.ast.Kind.Path {
        let s = resolve.ast.text(cx.src.as_slice(), n.a, n.b)
        return borrow.cx.find_text(cx, borrow.base.first_seg(s))
    }
    if n.kind == parse.ast.Kind.Dot || n.kind == parse.ast.Kind.Index {
        return borrow.cx.place_root(cx, n.a)
    }
    0usize
end borrow.cx.place_root

fn borrow.cx.recv_path(src: &[u8], ps: usize, pe: usize) -> (usize, usize) uses [] panics never pub
    let mut k = pe
    while k > ps {
        k = k.wrapping_sub(1usize)
        if borrow.walk.is_dot_at(src, k) {
            return (ps, k)
        }
    }
    (0usize, 0usize)
end borrow.cx.recv_path

fn borrow.cx.restore(cx: &mut borrow.cx.Cx, s: &std.vec.Vec<usize>) -> () uses [] panics never pub
    for k in core.iter.range(0usize, s.len()) {
        let v = match s.as_slice().get(k) {
            Some(x) => *x
            None => borrow.cx.ST_UNDEC
        }
        borrow.cx.set_st(cx, k, v)
    }
end borrow.cx.restore

fn borrow.cx.scope_exit(cx: &mut borrow.cx.Cx, mark: usize, tok: usize) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    let n = cx.dat.locs.len()
    for k in core.iter.range(mark, n) {
        let l = borrow.cx.loc(cx, k)
        if l.cl == borrow.base.LIN && l.st == borrow.cx.ST_LIVE && l.pa == 0usize {
            borrow.cx.diag(cx, "E3003", tok, "線形値を消費せずにスコープを出る")?
        }
    }
    cx.dat.locs.truncate(mark)
    let mut keep = std.vec.Vec.new()
    for br in cx.dat.brs.as_slice().iter() {
        if br.holder < mark && br.target < mark {
            keep.push(*br)?
        }
    }
    cx.dat.brs = keep
    Ok(())
end borrow.cx.scope_exit

fn borrow.cx.set_ref_info(cx: &mut borrow.cx.Cx, k: usize, isref: usize, life: usize, param: usize) -> () uses [] panics never pub
    let mut l = borrow.cx.loc(cx, k)
    l.ir = isref
    l.li = life
    l.pa = param
    match cx.dat.locs.as_mut_slice().get_mut(k) {
        Some(x) => {
            *x = l
        }
        None => core.mem.drop(0u8)
    }
end borrow.cx.set_ref_info

fn borrow.cx.set_st(cx: &mut borrow.cx.Cx, k: usize, st: usize) -> () uses [] panics never pub
    match cx.dat.locs.as_mut_slice().get_mut(k) {
        Some(l) => {
            l.st = st
        }
        None => core.mem.drop(0u8)
    }
end borrow.cx.set_st

fn borrow.cx.snap(cx: &borrow.cx.Cx) -> Result<std.vec.Vec<usize>, alloc.alloc.AllocError> uses [alloc] panics never pub
    let mut out = std.vec.Vec.new()
    for k in core.iter.range(0usize, cx.dat.locs.len()) {
        out.push(borrow.cx.loc(cx, k).st)?
    }
    Ok(out)
end borrow.cx.snap

fn borrow.cx.tail_from(src: &[u8], b: usize, e1: usize) -> (usize, usize) uses [] panics never pub
    if e1 < b && borrow.walk.is_dot_at(src, e1) {
        return (e1.wrapping_add(1usize), b)
    }
    (0usize, 0usize)
end borrow.cx.tail_from

fn borrow.cx.tail_path(src: &[u8], a: usize, b: usize) -> (usize, usize) uses [] panics never pub
    borrow.cx.tail_from(src, b, borrow.walk.ident_end(src, a))
end borrow.cx.tail_path

fn borrow.cx.undec(cx: &mut borrow.cx.Cx) -> () uses [] panics never pub
    cx.rep.undec = cx.rep.undec.wrapping_add(1usize)
end borrow.cx.undec
