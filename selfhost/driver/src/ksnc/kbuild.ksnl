fn ksnc.kbuild.make(dir: &str, root: &str, std_dir: &str, release: bool, target: &str) -> Result<(), ksnc.Failure> uses [alloc, env, io.console, io.fs, process] panics may pub
    if target != "host" {
        ksnc.tool.say_err("ksnc: --stages=kasane は --target host だけ対応する\n")?
        return Err(ksnc.Failure.Tool)
    }
    let man = resolve.manifest.read(dir)?
    let entry = ksnc.tool.entry(dir)?
    let kir = ksnc.kir.lower(dir, std_dir, entry.as_str())?
    if kir.nbad != 0usize {
        ksnc.tool.say_err("ksnc: --stages=kasane: 下ろせない関数がある (Rust 版へは戻らない)\n")?
        ksnc.tool.say_err(kir.bad.as_str())?
        return Err(ksnc.Failure.Tool)
    }
    let mut g = emit.new_g()
    emit.module(&mut g, kir.text.as_str(), entry.as_str())
    let mut kind = "debug"
    if release {
        kind = "release"
    }
    let tdir = std.path.join(dir, "target/kasane")?
    let outdir = std.path.join(tdir.as_str(), kind)?
    let mut mk = std.process.Command.new("mkdir")
    mk.arg("-p")
    mk.arg(outdir.as_str())
    let mut mk_out = std.vec.Vec.new()
    let mut mk_err = std.vec.Vec.new()
    let mk_st = mk.output(&mut mk_out, &mut mk_err)?
    ksnc.tool.expect_ok("ksnc: target/kasane を作れない\n", mk_st.code, &mk_out, &mk_err)?
    let base = std.path.join(outdir.as_str(), man.name.as_str())?
    let mut ll_path = std.string.String.from_str(base.as_str())?
    ll_path.push_str(".ll")?
    let mut exe = std.string.String.from_str(base.as_str())?
    exe.push_str(".native")?
    std.fs.write_atomic(ll_path.as_str(), g.outs.out.as_bytes())?
    let ir = g.outs.out.as_str()
    let sys = ir.contains("@ksn_rt_sys_")
    let rt_a = ir.contains("@ksn_fmt_") || ir.contains("@ksn_utf8_") || sys
    let rt_b = ir.contains("@ksn_parse_int") || ir.contains("@ksn_ext_resolve")
    let rt = rt_a || rt_b
    let rt_path = std.path.join(root, "stage0/src/kir_rt.c")?
    let sys_path = std.path.join(root, "stage0/src/sysrt.c")?
    let clang = ksnc.tool.clang()?
    let mut opt = "-O1"
    if release {
        opt = "-O2"
    }
    let mut cc = std.process.Command.new(clang.as_str())
    cc.arg(opt)
    cc.arg("-Wno-override-module")
    cc.arg("-x")
    cc.arg("ir")
    cc.arg(ll_path.as_str())
    if rt {
        cc.arg("-x")
        cc.arg("c")
        cc.arg(rt_path.as_str())
    }
    if sys {
        cc.arg("-x")
        cc.arg("c")
        cc.arg(sys_path.as_str())
    }
    cc.arg("-o")
    cc.arg(exe.as_str())
    cc.arg("-lm")
    cc.arg("-pthread")
    let mut out = std.vec.Vec.new()
    let mut err = std.vec.Vec.new()
    let st = cc.output(&mut out, &mut err)?
    ksnc.tool.expect_ok("ksnc: clang の段が失敗した (--stages=kasane)\n", st.code, &out, &err)?
    std.io.print_line(exe.as_str())?
    Ok(())
end ksnc.kbuild.make
