type ksnc.kir.Kir pub
    text: std.string.String pub
    bad: std.string.String pub
    nbad: usize pub
end ksnc.kir.Kir

fn ksnc.kir.lower(dir: &str, std_dir: &str, entry: &str) -> Result<ksnc.kir.Kir, ksnc.Failure> uses [alloc, io.fs] panics may pub
    let tout = types.export.run(dir, std_dir)?
    let env = tout.env
    let mut c = lower.cx.new(tout.ar, tout.cx)?
    let none = std.vec.Vec.new()
    lower.expr.enqueue(&mut c, entry, types.env.get_def(&env.tab, entry), none, 0usize)?
    let mut i = 0usize
    while i < c.g.nms.len() {
        let key = lower.cx.name_of(&c, i)?
        let it = lower.cx.item_at(&c, i)
        let subs = lower.cx.subs_at(&c, i)?
        let ret = lower.cx.ret_at(&c, i)
        if it == 0usize {
            lower.func.record(&mut c, "", "定義がない")?
        } else if types.infer.item_kind(&env, it - 1usize) != parse.ast.Kind.FnDef {
            lower.func.record(&mut c, "", "関数でない")?
        } else {
            lower.func.lower_item(&env, &mut c, it - 1usize, key.as_str(), &subs, ret)?
        }
        i = i + 1usize
    }
    let mut out = std.string.String.new()
    out.push_str("kir 1\n\n")?
    let aggs = lower.tyk.agg_lines(&env, &mut c)?
    out.push_str(aggs.as_str())?
    if !c.g.aggs.is_empty() {
        out.push('\n')?
    }
    let mut used = std.vec.Vec.new()
    for _k in core.iter.range(0usize, c.g.nms.len()) {
        used.push(false)?
    }
    let mut firstf = true
    let mut bad = std.string.String.new()
    let mut nbad = 0usize
    loop {
        let mut pick = c.g.nms.len()
        for k in core.iter.range(0usize, c.g.nms.len()) {
            let taken = match used.as_slice().get(k) {
                Some(x) => *x
                None => true
            }
            if !taken {
                if pick == c.g.nms.len() {
                    pick = k
                } else {
                    let a = lower.cx.name_of(&c, k)?
                    let b = lower.cx.name_of(&c, pick)?
                    if lower.cx.lt(a.as_str(), b.as_str()) {
                        pick = k
                    }
                }
            }
        }
        if pick == c.g.nms.len() {
            break
        }
        let mut nused = std.vec.Vec.new()
        let mut q = 0usize
        for flag in used.as_slice().iter() {
            if q == pick {
                nused.push(true)?
            } else {
                nused.push(*flag)?
            }
            q = q + 1usize
        }
        used = nused
        let ok = match c.g.oks.as_slice().get(pick) {
            Some(b) => *b
            None => false
        }
        let text = match c.g.tx.as_slice().get(pick) {
            Some(s) => lower.cx.own(s.as_str())?
            None => std.string.String.new()
        }
        let nm = match c.g.nms.as_slice().get(pick) {
            Some(s) => lower.cx.own(s.as_str())?
            None => std.string.String.new()
        }
        if ok {
            if !firstf {
                out.push('\n')?
            }
            firstf = false
            out.push_str(text.as_str())?
        } else {
            bad.push_str("unsupported ")?
            bad.push_str(nm.as_str())?
            bad.push_str(": ")?
            bad.push_str(text.as_str())?
            bad.push('\n')?
            nbad = nbad.wrapping_add(1usize)
        }
    }
    Ok(ksnc.kir.Kir { text: out, bad: bad, nbad: nbad })
end ksnc.kir.lower
