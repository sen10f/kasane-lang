fn ksnc.build.check(ksn: &str, dir: &str) -> Result<(), ksnc.Failure> uses [alloc, io.console, process] panics never pub
    let mut cmd = std.process.Command.new(ksn)
    cmd.arg("check")
    cmd.current_dir(dir)
    let mut out = std.vec.Vec.new()
    let mut err = std.vec.Vec.new()
    let st = cmd.output(&mut out, &mut err)?
    ksnc.tool.expect_ok("ksnc: ksn check が失敗した\n", st.code, &out, &err)
end ksnc.build.check

fn ksnc.build.check_show(ksn: &str, dir: &str) -> Result<bool, ksnc.Failure> uses [alloc, io.console, process] panics never pub
    let mut cmd = std.process.Command.new(ksn)
    cmd.arg("check")
    cmd.current_dir(dir)
    let code = ksnc.tool.run_show(cmd, "")?
    Ok(code == 0i32)
end ksnc.build.check_show

fn ksnc.build.fmt(ksn: &str, dir: &str, check: bool) -> Result<bool, ksnc.Failure> uses [alloc, io.console, process] panics never pub
    let mut cmd = std.process.Command.new(ksn)
    cmd.arg("fmt")
    if check {
        cmd.arg("--check")
    }
    cmd.current_dir(dir)
    let code = ksnc.tool.run_show(cmd, "")?
    Ok(code == 0i32)
end ksnc.build.fmt

fn ksnc.build.make(ksn: &str, root: &str, dir: &str, release: bool, target: &str) -> Result<(), ksnc.Failure> uses [alloc, env, io.console, process] panics never pub
    let me = ksnc.tool.env_or("KSNC_SELF")
    let self_exe = if me == "" {
        std.path.join(root, "selfhost/driver/target/release/ksnc.native")?
    } else {
        std.string.String.from_str(me)?
    }
    let real = ksnc.tool.clang()?
    let cache = std.path.join(dir, "target/ksnc-cache")?
    let mut rm = std.process.Command.new("rm")
    rm.arg("-rf")
    rm.arg(cache.as_str())
    let mut rm_out = std.vec.Vec.new()
    let mut rm_err = std.vec.Vec.new()
    let rm_st = rm.output(&mut rm_out, &mut rm_err)?
    ksnc.tool.expect_ok("ksnc: ksnc-cache を消せない\n", rm_st.code, &rm_out, &rm_err)?
    let mut cmd = std.process.Command.new(ksn)
    cmd.arg("build")
    if release {
        cmd.arg("--release")
    }
    if target != "host" {
        cmd.arg("--target")
        cmd.arg(target)
    }
    cmd.current_dir(dir)
    cmd.env("KSNC_CLANG", real.as_str())
    cmd.env("KSN_CLANG", self_exe.as_str())
    cmd.env("KSNC_SHIM", "1")
    cmd.env("KSNC_ROOT", root)
    cmd.env("KSN_CACHE_DIR", cache.as_str())
    let mut out = std.vec.Vec.new()
    let mut err = std.vec.Vec.new()
    let st = cmd.output(&mut out, &mut err)?
    ksnc.tool.expect_ok("ksnc: ksn build が失敗した\n", st.code, &out, &err)?
    let text = match core.str.from_utf8(out.as_slice()) {
        Ok(s) => s
        Err(_) => return Err(ksnc.Failure.Tool)
    }
    std.io.print_line(text)?
    Ok(())
end ksnc.build.make
