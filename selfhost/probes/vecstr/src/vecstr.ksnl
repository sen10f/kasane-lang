fn vecstr.main() -> Result<(), std.io.Error> uses [alloc, io.console] panics never
    let mut v = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let s = alloc.string.String.from_str(std.alloc.SYSTEM, "hello")
    match s {
        Ok(t) => core.mem.drop(v.push(t))
        Err(_e) => return std.io.print_line("alloc")
    }
    match v.get(0usize) {
        Some(x) => std.io.print_line(x.as_str())
        None => std.io.print_line("none")
    }
end vecstr.main
