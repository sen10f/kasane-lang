fn parse.lex.at(src: &[u8], i: usize) -> u8 uses [] panics never pub
    match src.get(i) {
        Some(c) => *c
        None => 0u8
    }
end parse.lex.at

fn parse.lex.check_escape(src: &[u8], j: usize, line: usize) -> Result<(), parse.err.Error> uses [] panics never
    let c = parse.lex.at(src, j.wrapping_add(1usize))
    let escapes = parse.tok.ESCAPES
    if escapes.as_bytes().contains(&c) {
        return Ok(())
    }
    if c == 0u8 || c == b'\n' {
        return Err(parse.err.Error.Syntax(line, j, parse.err.E_STRING, 0u32))
    }
    Err(parse.err.Error.Syntax(line, j, parse.err.E_ESCAPE, 0u32))
end parse.lex.check_escape

fn parse.lex.emit(toks: &mut alloc.vec.Vec<parse.tok.Tok, std.alloc.System>, kind: parse.tok.Kind, code: u32, start: usize, stop: usize, line: usize) -> Result<(), parse.err.Error> uses [alloc] panics never
    toks.push(parse.tok.new(kind, code, start, stop, line))?
    Ok(())
end parse.lex.emit

fn parse.lex.is_digit(c: u8) -> bool uses [] panics never
    c >= b'0' && c <= b'9'
end parse.lex.is_digit

fn parse.lex.is_hex(c: u8) -> bool uses [] panics never
    c >= b'0' && c <= b'9' || c >= b'a' && c <= b'f' || c >= b'A' && c <= b'F'
end parse.lex.is_hex

fn parse.lex.is_lifetime_char(c: u8) -> bool uses [] panics never
    parse.lex.is_lower(c) || parse.lex.is_digit(c) || c == b'_'
end parse.lex.is_lifetime_char

fn parse.lex.is_lower(c: u8) -> bool uses [] panics never
    c >= b'a' && c <= b'z'
end parse.lex.is_lower

fn parse.lex.is_upper(c: u8) -> bool uses [] panics never
    c >= b'A' && c <= b'Z'
end parse.lex.is_upper

fn parse.lex.is_value_kw(code: u32) -> bool uses [] panics never
    code == parse.tok.KW_SELF || code == parse.tok.KW_TRUE || code == parse.tok.KW_FALSE
end parse.lex.is_value_kw

fn parse.lex.is_word(c: u8) -> bool uses [] panics never
    parse.lex.is_lower(c) || parse.lex.is_upper(c) || parse.lex.is_digit(c) || c == b'_'
end parse.lex.is_word

fn parse.lex.last(toks: &alloc.vec.Vec<parse.tok.Tok, std.alloc.System>) -> parse.tok.Tok uses [] panics never
    match toks.as_slice().last() {
        Some(t) => parse.tok.new(t.kind, t.code, t.start, t.stop, t.line)
        None => parse.tok.new(parse.tok.Kind.Nl, 0u32, 0usize, 0usize, 0usize)
    }
end parse.lex.last

fn parse.lex.lex(src: &[u8], toks: &mut alloc.vec.Vec<parse.tok.Tok, std.alloc.System>) -> Result<(), parse.err.Error> uses [alloc] panics never pub
    let n = src.len()
    let mut line = 1usize
    let mut ls = 0usize
    while ls < n {
        let le = parse.lex.line_end(src, ls)
        parse.lex.line(toks, src, ls, le, line)?
        ls = le.wrapping_add(1usize)
        line = line.wrapping_add(1usize)
    }
    parse.lex.emit(toks, parse.tok.Kind.Eof, 0u32, n, n, line)
end parse.lex.lex

fn parse.lex.line(toks: &mut alloc.vec.Vec<parse.tok.Tok, std.alloc.System>, src: &[u8], ls: usize, le: usize, line: usize) -> Result<(), parse.err.Error> uses [alloc] panics never
    let mut i = ls
    while i < le && parse.lex.at(src, i) == b' ' {
        i = i.wrapping_add(1usize)
    }
    if i >= le {
        return Ok(())
    }
    if parse.lex.at(src, i) == b'/' && parse.lex.at(src, i.wrapping_add(1usize)) == b'/' {
        return Ok(())
    }
    if parse.lex.at(src, i) == b'.' && parse.lex.at(src, i.wrapping_add(1usize)) != b'.' {
        if parse.lex.last(toks).kind == parse.tok.Kind.Nl {
            core.mem.drop(toks.pop())
        }
    }
    while i < le {
        let c = parse.lex.at(src, i)
        if c == b' ' {
            i = i.wrapping_add(1usize)
            continue
        }
        let nx = parse.lex.at(src, i.wrapping_add(1usize))
        let is_b = c == b'b' && (nx == b'"' || nx == b'\'')
        if c == b'"' || is_b && nx == b'"' {
            let open = if is_b {
                i.wrapping_add(1usize)
            } else {
                i
            }
            let fin = parse.lex.string(src, open, le, line)?
            if is_b {
                parse.lex.emit(toks, parse.tok.Kind.Bstr, 0u32, i, fin, line)?
            } else {
                parse.lex.emit(toks, parse.tok.Kind.Str, 0u32, i, fin, line)?
            }
            i = fin
            continue
        }
        if c == b'\'' || is_b && nx == b'\'' {
            let (kind, fin) = parse.lex.quote(src, i, le, line, is_b)?
            parse.lex.emit(toks, kind, 0u32, i, fin, line)?
            i = fin
            continue
        }
        let neg = c == b'-' && parse.lex.is_digit(nx) && parse.lex.lit_start_ok(toks)
        if parse.lex.is_digit(c) || neg {
            let (fin, is_float) = parse.lex.number(src, i, le, neg)
            if is_float {
                parse.lex.emit(toks, parse.tok.Kind.Float, 0u32, i, fin, line)?
            } else {
                parse.lex.emit(toks, parse.tok.Kind.Int, 0u32, i, fin, line)?
            }
            i = fin
            continue
        }
        if parse.lex.is_lower(c) || parse.lex.is_upper(c) || c == b'_' {
            i = parse.lex.word(toks, src, i, le, line)?
            continue
        }
        let two = parse.lex.op2(c, nx)
        if two > 0u32 {
            parse.lex.emit(toks, parse.tok.Kind.Op, two, i, i.wrapping_add(2usize), line)?
            i = i.wrapping_add(2usize)
            continue
        }
        let ops1 = parse.tok.OPS1
        if ops1.as_bytes().contains(&c) {
            let stop = i.wrapping_add(1usize)
            parse.lex.emit(toks, parse.tok.Kind.Op, u32.from_u8(c), i, stop, line)?
            i = stop
            continue
        }
        return Err(parse.err.Error.Syntax(line, i, parse.err.E_CHARACTER, 0u32))
    }
    let last = parse.lex.last(toks)
    let open = last.code == 40u32 || last.code == 91u32 || last.code == 44u32
    if last.kind == parse.tok.Kind.Op && last.line == line && open {
        return Ok(())
    }
    parse.lex.emit(toks, parse.tok.Kind.Nl, 0u32, le, le, line)
end parse.lex.line

fn parse.lex.line_end(src: &[u8], from: usize) -> usize uses [] panics never
    let mut i = from
    loop {
        match src.get(i) {
            Some(c) => {
                if *c == b'\n' {
                    break
                }
                i = i.wrapping_add(1usize)
            }
            None => break
        }
    }
    i
end parse.lex.line_end

fn parse.lex.lit_start_ok(toks: &alloc.vec.Vec<parse.tok.Tok, std.alloc.System>) -> bool uses [] panics never
    let t = parse.lex.last(toks)
    match t.kind {
        parse.tok.Kind.Ident => false
        parse.tok.Kind.Upper => false
        parse.tok.Kind.Int => false
        parse.tok.Kind.Float => false
        parse.tok.Kind.Str => false
        parse.tok.Kind.Char => false
        parse.tok.Kind.Prim => false
        parse.tok.Kind.Byte => false
        parse.tok.Kind.Bstr => false
        parse.tok.Kind.Kw => !parse.lex.is_value_kw(t.code)
        parse.tok.Kind.Op => t.code != 41u32 && t.code != 93u32 && t.code != 125u32
        parse.tok.Kind.Life => true
        parse.tok.Kind.Nl => true
        parse.tok.Kind.Eof => true
    }
end parse.lex.lit_start_ok

fn parse.lex.number(src: &[u8], i: usize, le: usize, neg: bool) -> (usize, bool) uses [] panics never
    let mut j = i
    if neg {
        j = j.wrapping_add(1usize)
    }
    let c0 = parse.lex.at(src, j)
    let c1 = parse.lex.at(src, j.wrapping_add(1usize))
    let mut is_float = false
    if c0 == b'0' && c1 == b'x' {
        j = parse.lex.skip_digits(src, j.wrapping_add(2usize), le, true)
    } else if c0 == b'0' && (c1 == b'b' || c1 == b'o') {
        j = parse.lex.skip_digits(src, j.wrapping_add(2usize), le, false)
    } else {
        j = parse.lex.skip_digits(src, j, le, false)
        let j1 = j.wrapping_add(1usize)
        if j1 < le && parse.lex.at(src, j) == b'.' && parse.lex.is_digit(parse.lex.at(src, j1)) {
            is_float = true
            j = parse.lex.skip_digits(src, j1, le, false)
        }
        if j < le && parse.lex.at(src, j) == b'e' {
            let mut k = j.wrapping_add(1usize)
            let sign = parse.lex.at(src, k)
            if sign == b'-' || sign == b'+' {
                k = k.wrapping_add(1usize)
            }
            if k < le && parse.lex.is_digit(parse.lex.at(src, k)) {
                is_float = true
                j = parse.lex.skip_digits(src, k, le, false)
            }
        }
    }
    let suffixes = parse.tok.SUFFIXES
    for s in suffixes.split(" ") {
        let sb = s.as_bytes()
        let e = j.wrapping_add(sb.len())
        match src.sub(j, e) {
            Some(got) => {
                if got == sb && !parse.lex.is_word(parse.lex.at(src, e)) {
                    return (e, is_float || sb.get(0usize) == Some(&b'f'))
                }
            }
            None => core.mem.drop(0u8)
        }
    }
    (j, is_float)
end parse.lex.number

fn parse.lex.op2(a: u8, b: u8) -> u32 uses [] panics never
    if a == b'=' && b == b'>' {
        return parse.tok.OP_FATARROW
    }
    if a == b'-' && b == b'>' {
        return parse.tok.OP_ARROW
    }
    if a == b'=' && b == b'=' {
        return parse.tok.OP_EQEQ
    }
    if a == b'!' && b == b'=' {
        return parse.tok.OP_NE
    }
    if a == b'<' && b == b'=' {
        return parse.tok.OP_LE
    }
    if a == b'>' && b == b'=' {
        return parse.tok.OP_GE
    }
    if a == b'&' && b == b'&' {
        return parse.tok.OP_ANDAND
    }
    if a == b'|' && b == b'|' {
        return parse.tok.OP_OROR
    }
    if a == b':' && b == b':' {
        return parse.tok.OP_COLONCOLON
    }
    0u32
end parse.lex.op2

fn parse.lex.quote(src: &[u8], i: usize, le: usize, line: usize, is_b: bool) -> Result<(parse.tok.Kind, usize), parse.err.Error> uses [] panics never
    let j = if is_b {
        i.wrapping_add(2usize)
    } else {
        i.wrapping_add(1usize)
    }
    let c = parse.lex.at(src, j)
    let esc = j < le && c == b'\\'
    if esc {
        parse.lex.check_escape(src, j, line)?
    }
    let mut k = j.wrapping_add(parse.lex.utf8_len(c))
    if esc {
        let e = parse.lex.at(src, j.wrapping_add(1usize))
        if e == b'x' {
            k = j.wrapping_add(4usize)
        } else if e == b'u' {
            k = le
            let mut m = j
            loop {
                if m >= le {
                    break
                }
                if parse.lex.at(src, m) == b'}' {
                    k = m.wrapping_add(1usize)
                    break
                }
                m = m.wrapping_add(1usize)
            }
        } else {
            k = j.wrapping_add(2usize)
        }
    }
    if k < le && parse.lex.at(src, k) == b'\'' && j < le {
        if is_b {
            return Ok((parse.tok.Kind.Byte, k.wrapping_add(1usize)))
        }
        return Ok((parse.tok.Kind.Char, k.wrapping_add(1usize)))
    }
    let mut m = i.wrapping_add(1usize)
    while m < le && parse.lex.is_lifetime_char(parse.lex.at(src, m)) {
        m = m.wrapping_add(1usize)
    }
    if m > i.wrapping_add(1usize) && parse.lex.is_lower(parse.lex.at(src, i.wrapping_add(1usize))) {
        return Ok((parse.tok.Kind.Life, m))
    }
    Err(parse.err.Error.Syntax(line, i, parse.err.E_CHAR, 0u32))
end parse.lex.quote

fn parse.lex.skip_digits(src: &[u8], from: usize, le: usize, hex: bool) -> usize uses [] panics never
    let mut j = from
    while j < le {
        let c = parse.lex.at(src, j)
        let ok = c == b'_' || hex && parse.lex.is_hex(c) || !hex && parse.lex.is_digit(c)
        if !ok {
            break
        }
        j = j.wrapping_add(1usize)
    }
    j
end parse.lex.skip_digits

fn parse.lex.string(src: &[u8], i: usize, le: usize, line: usize) -> Result<usize, parse.err.Error> uses [] panics never
    let mut j = i.wrapping_add(1usize)
    loop {
        if j >= le {
            return Err(parse.err.Error.Syntax(line, i, parse.err.E_STRING, 0u32))
        }
        let c = parse.lex.at(src, j)
        if c == b'"' {
            break
        }
        if c == b'\\' {
            parse.lex.check_escape(src, j, line)?
            j = j.wrapping_add(2usize)
        } else {
            j = j.wrapping_add(1usize)
        }
    }
    Ok(j.wrapping_add(1usize))
end parse.lex.string

fn parse.lex.utf8_len(c: u8) -> usize uses [] panics never
    if c < 128u8 {
        return 1usize
    }
    if c >= 240u8 {
        return 4usize
    }
    if c >= 224u8 {
        return 3usize
    }
    2usize
end parse.lex.utf8_len

fn parse.lex.word(toks: &mut alloc.vec.Vec<parse.tok.Tok, std.alloc.System>, src: &[u8], i: usize, le: usize, line: usize) -> Result<usize, parse.err.Error> uses [alloc] panics never
    let mut j = i
    while j < le && parse.lex.is_word(parse.lex.at(src, j)) {
        j = j.wrapping_add(1usize)
    }
    let w = match src.sub(i, j) {
        Some(b) => b
        None => return Ok(j)
    }
    let kw = parse.tok.word_code(parse.tok.KEYWORDS, w)
    if kw > 0u32 {
        parse.lex.emit(toks, parse.tok.Kind.Kw, kw, i, j, line)?
        return Ok(j)
    }
    let pr = parse.tok.word_code(parse.tok.PRIMS, w)
    if pr > 0u32 {
        parse.lex.emit(toks, parse.tok.Kind.Prim, pr, i, j, line)?
        return Ok(j)
    }
    if parse.lex.is_upper(parse.lex.at(src, i)) {
        parse.lex.emit(toks, parse.tok.Kind.Upper, 0u32, i, j, line)?
        return Ok(j)
    }
    let cx = parse.tok.word_code(parse.tok.CONTEXTUAL, w)
    let mut code = 0u32
    if cx > 0u32 {
        code = cx.wrapping_add(100u32)
    }
    if j == i.wrapping_add(1usize) && parse.lex.at(src, i) == b'_' {
        code = parse.tok.WILD
    }
    parse.lex.emit(toks, parse.tok.Kind.Ident, code, i, j, line)?
    Ok(j)
end parse.lex.word
