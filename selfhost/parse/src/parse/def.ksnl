fn parse.def.accept_pub(p: &mut parse.cur.P) -> usize uses [] panics never
    if parse.cur.accept_kw(p, parse.tok.KW_PUB) {
        return 1usize
    }
    0usize
end parse.def.accept_pub

fn parse.def.body(p: &mut parse.cur.P) -> Result<usize, parse.err.Error> uses [alloc] panics never
    let at = p.pos
    let mut stmts = std.vec.Vec.new()
    loop {
        parse.cur.skip_nl(p)
        if parse.cur.is_kw(p, parse.tok.KW_END) || parse.cur.at_eof(p) {
            break
        }
        stmts.push(parse.expr.stmt(p)?)?
        parse.cur.expect_nl(p)?
    }
    let l = parse.ast.list(&mut p.ast, &stmts, at)?
    parse.ast.add1(&mut p.ast, parse.ast.Kind.Block, at, l)
end parse.def.body

fn parse.def.constant(p: &mut parse.cur.P, kind: parse.ast.Kind) -> Result<usize, parse.err.Error> uses [alloc] panics never
    let at = p.pos
    parse.cur.advance(p)
    let (a, b) = parse.cur.fqn(p)?
    parse.cur.expect_ch(p, b':')?
    let t = parse.ty.ty(p)?
    parse.cur.expect_ch(p, b'=')?
    let init = parse.expr.expr(p, false)?
    let vis = parse.def.accept_pub(p)
    parse.cur.expect_nl(p)?
    parse.ast.add6(&mut p.ast, kind, at, a, b, t, init, vis, 0usize)
end parse.def.constant

fn parse.def.derive(p: &mut parse.cur.P) -> Result<usize, parse.err.Error> uses [alloc] panics never
    let at = p.pos
    parse.cur.advance(p)
    parse.cur.expect_ch(p, b'[')?
    let mut items = std.vec.Vec.new()
    loop {
        let name = parse.cur.name_tok(p)?
        items.push(parse.ast.add1(&mut p.ast, parse.ast.Kind.Effect, name, name)?)?
        if !parse.cur.accept_ch(p, b',') {
            break
        }
    }
    parse.cur.expect_ch(p, b']')?
    parse.ast.list(&mut p.ast, &items, at)
end parse.def.derive

fn parse.def.end_name(p: &mut parse.cur.P, src: &[u8], a: usize, b: usize) -> Result<(), parse.err.Error> uses [] panics never
    parse.cur.expect_kw(p, parse.tok.KW_END)?
    let at = parse.cur.tok(p)
    let (c, d) = parse.cur.fqn(p)?
    if !parse.def.same(src, a, b, c, d) {
        return Err(parse.err.Error.Syntax(at.line, at.start, parse.err.E_END_NAME, 0u32))
    }
    parse.cur.expect_nl(p)
end parse.def.end_name

fn parse.def.extern_def(p: &mut parse.cur.P) -> Result<usize, parse.err.Error> uses [alloc] panics never
    let at = p.pos
    parse.cur.advance(p)
    let (a, b) = parse.cur.fqn(p)?
    parse.cur.expect_ch(p, b'(')?
    let ps = parse.ty.params(p)?
    parse.cur.expect_ch(p, b')')?
    parse.cur.expect_op(p, parse.tok.OP_ARROW)?
    let ret = parse.ty.ty(p)?
    let mut link = 0usize
    if parse.cur.accept_kw(p, parse.tok.CX_LINK) {
        if parse.cur.kind(p) != parse.tok.Kind.Str {
            return Err(parse.cur.fail(p, parse.err.E_EXPECT, 0u32))
        }
        link = p.pos.wrapping_add(1usize)
        parse.cur.advance(p)
    }
    parse.cur.expect_nl(p)?
    parse.ast.add6(&mut p.ast, parse.ast.Kind.ExternDef, at, a, b, ps, ret, link, 0usize)
end parse.def.extern_def

fn parse.def.field(p: &mut parse.cur.P) -> Result<usize, parse.err.Error> uses [alloc] panics never
    let name = parse.cur.name_tok(p)?
    parse.cur.expect_ch(p, b':')?
    let t = parse.ty.ty(p)?
    let vis = parse.def.accept_pub(p)
    parse.ast.add3(&mut p.ast, parse.ast.Kind.FieldDecl, name, name, t, vis)
end parse.def.field

fn parse.def.file(p: &mut parse.cur.P, src: &[u8], sig: bool) -> Result<(), parse.err.Error> uses [alloc] panics never pub
    loop {
        parse.cur.skip_nl(p)
        if parse.cur.at_eof(p) {
            break
        }
        let d = parse.def.one(p, src, sig)?
        p.ast.defs.push(d)?
    }
    Ok(())
end parse.def.file

fn parse.def.fn_def(p: &mut parse.cur.P, src: &[u8], sig: bool) -> Result<usize, parse.err.Error> uses [alloc] panics never
    let at = p.pos
    parse.cur.advance(p)
    let (a, b) = parse.cur.fqn(p)?
    let generics = parse.ty.generics(p)?
    parse.cur.expect_ch(p, b'(')?
    let ps = parse.ty.params(p)?
    parse.cur.expect_ch(p, b')')?
    parse.cur.expect_op(p, parse.tok.OP_ARROW)?
    let ret = parse.ty.ty(p)?
    let attrs = parse.ty.attrs(p)?
    let vis = parse.def.accept_pub(p)
    parse.cur.expect_nl(p)?
    let sg = parse.ast.add4(&mut p.ast, parse.ast.Kind.FnSig, at, generics, ps, ret, attrs)?
    if sig {
        return parse.ast.add6(&mut p.ast, parse.ast.Kind.FnDef, at, a, b, sg, 0usize, vis, 0usize)
    }
    let body = parse.def.body(p)?
    parse.def.end_name(p, src, a, b)?
    parse.ast.add6(&mut p.ast, parse.ast.Kind.FnDef, at, a, b, sg, body, vis, 0usize)
end parse.def.fn_def

fn parse.def.impl_line(p: &mut parse.cur.P) -> Result<usize, parse.err.Error> uses [alloc] panics never
    let at = p.pos
    let start = parse.cur.start_byte(p)
    parse.cur.advance(p)
    let generics = parse.ty.generics(p)?
    let tr = parse.ty.trait_ref(p)?
    parse.cur.expect_kw(p, parse.tok.KW_FOR)?
    let t = parse.ty.ty(p)?
    let stop = parse.cur.prev_stop(p)
    parse.cur.expect_nl(p)?
    parse.ast.add6(&mut p.ast, parse.ast.Kind.ImplLine, at, start, stop, generics, tr, t, 0usize)
end parse.def.impl_line

fn parse.def.import_line(p: &mut parse.cur.P) -> Result<usize, parse.err.Error> uses [alloc] panics never
    let at = p.pos
    parse.cur.advance(p)
    let (a, b) = parse.cur.fqn(p)?
    parse.cur.expect_nl(p)?
    parse.ast.add2(&mut p.ast, parse.ast.Kind.Import, at, a, b)
end parse.def.import_line

fn parse.def.one(p: &mut parse.cur.P, src: &[u8], sig: bool) -> Result<usize, parse.err.Error> uses [alloc] panics never
    let t = parse.cur.tok(p)
    if t.kind != parse.tok.Kind.Kw {
        return Err(parse.cur.fail(p, parse.err.E_TOPLEVEL, 0u32))
    }
    let c = t.code
    if c == parse.tok.KW_IMPORT {
        return parse.def.import_line(p)
    }
    if c == parse.tok.KW_CONST {
        return parse.def.constant(p, parse.ast.Kind.ConstDef)
    }
    if c == parse.tok.KW_STATIC {
        return parse.def.constant(p, parse.ast.Kind.StaticDef)
    }
    if c == parse.tok.KW_EXTERN {
        return parse.def.extern_def(p)
    }
    if c == parse.tok.KW_TYPE {
        return parse.def.record(p, src, parse.ast.Kind.TypeDef, false)
    }
    if c == parse.tok.KW_ENUM {
        return parse.def.record(p, src, parse.ast.Kind.EnumDef, true)
    }
    if c == parse.tok.KW_TRAIT {
        return parse.def.trait_def(p, src)
    }
    if c == parse.tok.KW_IMPL {
        return parse.def.impl_line(p)
    }
    if c == parse.tok.KW_FN {
        return parse.def.fn_def(p, src, sig)
    }
    if c == parse.tok.KW_TEST {
        return parse.def.test_def(p, src)
    }
    if c == parse.tok.KW_END {
        return Err(parse.cur.fail(p, parse.err.E_UNEXPECTED_END, 0u32))
    }
    Err(parse.cur.fail(p, parse.err.E_TOPLEVEL, 0u32))
end parse.def.one

fn parse.def.record(p: &mut parse.cur.P, src: &[u8], kind: parse.ast.Kind, is_enum: bool) -> Result<usize, parse.err.Error> uses [alloc] panics never
    let at = p.pos
    parse.cur.advance(p)
    let (a, b) = parse.cur.fqn(p)?
    let generics = parse.ty.generics(p)?
    let (derive, flags) = parse.def.type_attrs(p)?
    parse.cur.expect_nl(p)?
    let mut items = std.vec.Vec.new()
    loop {
        parse.cur.skip_nl(p)
        if parse.cur.is_kw(p, parse.tok.KW_END) || parse.cur.at_eof(p) {
            break
        }
        if is_enum {
            items.push(parse.def.variant(p)?)?
        } else {
            items.push(parse.def.field(p)?)?
        }
        parse.cur.expect_nl(p)?
    }
    parse.def.end_name(p, src, a, b)?
    let l = parse.ast.list(&mut p.ast, &items, at)?
    parse.ast.add6(&mut p.ast, kind, at, a, b, generics, l, derive, flags)
end parse.def.record

fn parse.def.same(src: &[u8], a: usize, b: usize, c: usize, d: usize) -> bool uses [] panics never
    match src.sub(a, b) {
        Some(x) => match src.sub(c, d) {
            Some(y) => x == y
            None => false
        }
        None => false
    }
end parse.def.same

fn parse.def.test_def(p: &mut parse.cur.P, src: &[u8]) -> Result<usize, parse.err.Error> uses [alloc] panics never
    let at = p.pos
    parse.cur.advance(p)
    let (a, b) = parse.cur.fqn(p)?
    parse.cur.expect_nl(p)?
    let body = parse.def.body(p)?
    parse.def.end_name(p, src, a, b)?
    parse.ast.add4(&mut p.ast, parse.ast.Kind.TestDef, at, a, b, 0usize, body)
end parse.def.test_def

fn parse.def.trait_def(p: &mut parse.cur.P, src: &[u8]) -> Result<usize, parse.err.Error> uses [alloc] panics never
    let at = p.pos
    parse.cur.advance(p)
    let (a, b) = parse.cur.fqn(p)?
    let generics = parse.ty.generics(p)?
    let mut reqs = std.vec.Vec.new()
    if parse.cur.accept_kw(p, parse.tok.CX_REQUIRES) {
        reqs.push(parse.ty.trait_ref(p)?)?
        while parse.cur.accept_ch(p, b',') {
            reqs.push(parse.ty.trait_ref(p)?)?
        }
    }
    let vis = parse.def.accept_pub(p)
    parse.cur.expect_nl(p)?
    let mut fns = std.vec.Vec.new()
    loop {
        parse.cur.skip_nl(p)
        if parse.cur.is_kw(p, parse.tok.KW_END) || parse.cur.at_eof(p) {
            break
        }
        fns.push(parse.def.trait_fn(p)?)?
        parse.cur.expect_nl(p)?
    }
    parse.def.end_name(p, src, a, b)?
    let rl = parse.ast.list(&mut p.ast, &reqs, at)?
    let fl = parse.ast.list(&mut p.ast, &fns, at)?
    parse.ast.add6(&mut p.ast, parse.ast.Kind.TraitDef, at, a, b, generics, rl, fl, vis)
end parse.def.trait_def

fn parse.def.trait_fn(p: &mut parse.cur.P) -> Result<usize, parse.err.Error> uses [alloc] panics never
    parse.cur.expect_kw(p, parse.tok.KW_FN)?
    let name = parse.cur.name_tok(p)?
    let generics = parse.ty.generics(p)?
    parse.cur.expect_ch(p, b'(')?
    let ps = parse.ty.params(p)?
    parse.cur.expect_ch(p, b')')?
    parse.cur.expect_op(p, parse.tok.OP_ARROW)?
    let ret = parse.ty.ty(p)?
    let attrs = parse.ty.attrs(p)?
    parse.ast.add6(&mut p.ast, parse.ast.Kind.TraitFn, name, name, generics, ps, ret, attrs, 0usize)
end parse.def.trait_fn

fn parse.def.type_attrs(p: &mut parse.cur.P) -> Result<(usize, usize), parse.err.Error> uses [alloc] panics never
    let mut flags = 0usize
    let mut derive = 0usize
    if parse.cur.accept_kw(p, parse.tok.CX_LAYOUT) {
        core.mem.drop(parse.cur.name_tok(p)?)
        flags = 4usize
    }
    if parse.cur.is_kw(p, parse.tok.CX_DERIVE) {
        derive = parse.def.derive(p)?
    }
    if parse.cur.accept_kw(p, parse.tok.CX_LINEAR) {
        flags = flags.wrapping_add(2usize)
    }
    flags = flags.wrapping_add(parse.def.accept_pub(p))
    Ok((derive, flags))
end parse.def.type_attrs

fn parse.def.variant(p: &mut parse.cur.P) -> Result<usize, parse.err.Error> uses [alloc] panics never
    let name = parse.cur.name_tok(p)?
    let mut items = std.vec.Vec.new()
    if parse.cur.accept_ch(p, b'(') {
        items.push(parse.ty.ty(p)?)?
        while parse.cur.accept_ch(p, b',') {
            items.push(parse.ty.ty(p)?)?
        }
        parse.cur.expect_ch(p, b')')?
    }
    let l = parse.ast.list(&mut p.ast, &items, name)?
    parse.ast.add2(&mut p.ast, parse.ast.Kind.Variant, name, name, l)
end parse.def.variant
