const parse.ast.KIND_NAMES: &str = "Arm ArrayE ArrayRep Assign Attrs Bin Block Break Call Capture Closure ConstDef ConstInt ConstPath Continue Dot Effect EnumDef ExprStmt ExternDef FieldDecl FieldInit FnDef FnSig For GParam If ImplLine Import Index Let Linear List Lit Loop MCall Match Nil PBind PField PLit PPath PRef PStruct PTuple PVariant PWild Param Path Return StaticDef StructLit TArgConst TArgEffects TArgLife TArgPanic TArray TDyn TFn TNamed TNever TPrim TPtr TRef TSelf TSlice TTuple TestDef TraitDef TraitFn TraitRef Try TupleE TypeDef Unary Unsafe Variant While With" pub

type parse.ast.Ast pub
    defs: std.vec.Vec<usize> pub
    links: std.vec.Vec<usize> pub
    nodes: std.vec.Vec<parse.ast.Node> pub
end parse.ast.Ast

enum parse.ast.Kind derive [Debug, Clone, Copy, PartialEq] pub
    Arm
    ArrayE
    ArrayRep
    Assign
    Attrs
    Bin
    Block
    Break
    Call
    Capture
    Closure
    ConstDef
    ConstInt
    ConstPath
    Continue
    Dot
    Effect
    EnumDef
    ExprStmt
    ExternDef
    FieldDecl
    FieldInit
    FnDef
    FnSig
    For
    GParam
    If
    ImplLine
    Import
    Index
    Let
    Linear
    List
    Lit
    Loop
    MCall
    Match
    Nil
    PBind
    PField
    PLit
    PPath
    PRef
    PStruct
    PTuple
    PVariant
    PWild
    Param
    Path
    Return
    StaticDef
    StructLit
    TArgConst
    TArgEffects
    TArgLife
    TArgPanic
    TArray
    TDyn
    TFn
    TNamed
    TNever
    TPrim
    TPtr
    TRef
    TSelf
    TSlice
    TTuple
    TestDef
    TraitDef
    TraitFn
    TraitRef
    Try
    TupleE
    TypeDef
    Unary
    Unsafe
    Variant
    While
    With
end parse.ast.Kind

type parse.ast.Node derive [Debug, Clone, Copy, PartialEq] pub
    a: usize pub
    b: usize pub
    c: usize pub
    d: usize pub
    e: usize pub
    f: usize pub
    kind: parse.ast.Kind pub
    tok: usize pub
end parse.ast.Node

fn parse.ast.add0(ast: &mut parse.ast.Ast, kind: parse.ast.Kind, tok: usize) -> Result<usize, parse.err.Error> uses [alloc] panics never pub
    parse.ast.push(ast, parse.ast.mk(kind, tok, 0usize, 0usize, 0usize, 0usize))
end parse.ast.add0

fn parse.ast.add1(ast: &mut parse.ast.Ast, kind: parse.ast.Kind, tok: usize, a: usize) -> Result<usize, parse.err.Error> uses [alloc] panics never pub
    parse.ast.push(ast, parse.ast.mk(kind, tok, a, 0usize, 0usize, 0usize))
end parse.ast.add1

fn parse.ast.add2(ast: &mut parse.ast.Ast, kind: parse.ast.Kind, tok: usize, a: usize, b: usize) -> Result<usize, parse.err.Error> uses [alloc] panics never pub
    parse.ast.push(ast, parse.ast.mk(kind, tok, a, b, 0usize, 0usize))
end parse.ast.add2

fn parse.ast.add3(ast: &mut parse.ast.Ast, kind: parse.ast.Kind, tok: usize, a: usize, b: usize, c: usize) -> Result<usize, parse.err.Error> uses [alloc] panics never pub
    parse.ast.push(ast, parse.ast.mk(kind, tok, a, b, c, 0usize))
end parse.ast.add3

fn parse.ast.add4(ast: &mut parse.ast.Ast, kind: parse.ast.Kind, tok: usize, a: usize, b: usize, c: usize, d: usize) -> Result<usize, parse.err.Error> uses [alloc] panics never pub
    parse.ast.push(ast, parse.ast.mk(kind, tok, a, b, c, d))
end parse.ast.add4

fn parse.ast.add6(ast: &mut parse.ast.Ast, kind: parse.ast.Kind, tok: usize, a: usize, b: usize, c: usize, d: usize, e: usize, f: usize) -> Result<usize, parse.err.Error> uses [alloc] panics never pub
    let mut n = parse.ast.mk(kind, tok, a, b, c, d)
    n.e = e
    n.f = f
    parse.ast.push(ast, n)
end parse.ast.add6

fn parse.ast.copy(n: &parse.ast.Node) -> parse.ast.Node uses [] panics never
    parse.ast.Node { a: n.a, b: n.b, c: n.c, d: n.d, e: n.e, f: n.f, kind: n.kind, tok: n.tok }
end parse.ast.copy

fn parse.ast.get(ast: &parse.ast.Ast, at: usize) -> parse.ast.Node uses [] panics never pub
    match ast.nodes.as_slice().get(at) {
        Some(n) => parse.ast.copy(n)
        None => parse.ast.mk(parse.ast.Kind.Nil, 0usize, 0usize, 0usize, 0usize, 0usize)
    }
end parse.ast.get

