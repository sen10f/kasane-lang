fn parse.ast.list(ast: &mut parse.ast.Ast, items: &std.vec.Vec<usize>, tok: usize) -> Result<usize, parse.err.Error> uses [alloc] panics never pub
    let first = ast.links.len()
    for v in items.as_slice().iter() {
        ast.links.push(*v)?
    }
    parse.ast.add2(ast, parse.ast.Kind.List, tok, first, items.len())
end parse.ast.list

fn parse.ast.mk(kind: parse.ast.Kind, tok: usize, a: usize, b: usize, c: usize, d: usize) -> parse.ast.Node uses [] panics never pub
    parse.ast.Node { a: a, b: b, c: c, d: d, e: 0usize, f: 0usize, kind: kind, tok: tok }
end parse.ast.mk

fn parse.ast.new() -> Result<parse.ast.Ast, parse.err.Error> uses [alloc] panics never pub
    let defs = std.vec.Vec.new()
    let links = std.vec.Vec.new()
    let mut nodes = std.vec.Vec.new()
    nodes.push(parse.ast.mk(parse.ast.Kind.Nil, 0usize, 0usize, 0usize, 0usize, 0usize))?
    Ok(parse.ast.Ast { defs: defs, links: links, nodes: nodes })
end parse.ast.new

fn parse.ast.push(ast: &mut parse.ast.Ast, node: parse.ast.Node) -> Result<usize, parse.err.Error> uses [alloc] panics never pub
    let at = ast.nodes.len()
    ast.nodes.push(node)?
    Ok(at)
end parse.ast.push
