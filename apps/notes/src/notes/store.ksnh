import notes.error
import notes.note

const notes.store.TEST_DIR: &str = "/tmp/ksn-notes-test-data"

type notes.store.Store pub
    dir: std.string.String
    notes: std.vec.Vec<notes.note.Note>
end notes.store.Store

fn notes.store.Store.add(self: &mut notes.store.Store, memo: notes.note.Note) -> Result<i64, notes.error.Error> uses [alloc, io.fs] panics never pub
    let id = self.next_id()?
    let mut n = memo
    n.id = id
    self.save_note(&n)?
    core.mem.drop(self.notes.push(n)?)
    Ok(id)
end notes.store.Store.add

fn notes.store.Store.all_notes_len(self: &notes.store.Store) -> usize uses [] panics never pub
    self.notes.len()
end notes.store.Store.all_notes_len

fn notes.store.Store.get(self: &notes.store.Store, id: i64) -> Option<&notes.note.Note> uses [] panics never pub
    for memo in self.notes.iter() {
        if memo.id == id {
            return Some(memo)
        }
    }
    None
end notes.store.Store.get

fn notes.store.Store.get_at(self: &notes.store.Store, index: usize) -> Option<&notes.note.Note> uses [] panics never pub
    let all = self.notes.as_slice()
    match all.get(index) {
        Some(n) => Some(n)
        None => None
    }
end notes.store.Store.get_at

fn notes.store.Store.len(self: &notes.store.Store) -> usize uses [] panics never pub
    self.notes.len()
end notes.store.Store.len

fn notes.store.Store.load(dir: &str) -> Result<notes.store.Store, notes.error.Error> uses [alloc, io.fs] panics never pub
    match std.fs.create_dir_all(dir) {
        Ok(_u) => {
        }
        Err(e) => return Err(error.Error.Io(e))
    }
    let mut store = notes.store.Store.new(dir)?
    let entries = std.fs.read_dir(dir)?
    let all = entries.as_slice()
    let n = all.len()
    for i in core.iter.range(0usize, n) {
        match all.get(i) {
            Some(e) => if e.kind == std.fs.FileKind.File {
                let name = e.name.as_str()
                if name.len() > 5usize && name.ends_with(".json") {
                    let base = match name.split_at(name.len().wrapping_sub(5usize)) {
                        Some((b, _)) => b
                        None => name
                    }
                    match i64.parse(base) {
                        Ok(id) => {
                            let path = notes.store.note_path(store.dir.as_str(), id)?
                            match notes.store.read_text(path.as_str()) {
                                Ok(text) => match std.json.parse(text.as_str()) {
                                    Ok(doc) => match note.Note.from_json(&doc, doc.root()) {
                                        Ok(parsed) => core.mem.drop(store.notes.push(parsed)?)
                                        Err(_) => core.mem.drop(0u8)
                                    }
                                    Err(_) => core.mem.drop(0u8)
                                }
                                Err(_) => core.mem.drop(0u8)
                            }
                        }
                        Err(_) => core.mem.drop(0u8)
                    }
                }
            }
            None => return Err(error.Error.Corrupt)
        }
    }
    Ok(store)
end notes.store.Store.load

fn notes.store.Store.new(dir: &str) -> Result<notes.store.Store, notes.error.Error> uses [alloc] panics never pub
    let d = std.string.String.from_str(dir)?
    let ns = std.vec.Vec.new()
    let r = notes.store.Store {
        dir: d
        notes: ns
    }
    Ok(r)
end notes.store.Store.new

fn notes.store.Store.next_id(self: &notes.store.Store) -> Result<i64, notes.error.Error> uses [] panics never pub
    let mut max = 0i64
    for memo in self.notes.iter() {
        if memo.id > max {
            max = memo.id
        }
    }
    Ok(max.wrapping_add(1i64))
end notes.store.Store.next_id

fn notes.store.Store.path(self: &notes.store.Store) -> &str uses [] panics never pub
    self.dir.as_str()
end notes.store.Store.path

fn notes.store.Store.remove(self: &mut notes.store.Store, id: i64) -> Result<(), notes.error.Error> uses [alloc, io.fs] panics never pub
    let index = notes.store.index_of(self, id)?
    core.mem.drop(self.notes.remove(index))
    let path = notes.store.note_path(self.dir.as_str(), id)?
    std.fs.remove_file(path.as_str())?
    Ok(())
end notes.store.Store.remove

fn notes.store.Store.save_note(self: &notes.store.Store, n: &notes.note.Note) -> Result<(), notes.error.Error> uses [alloc, io.fs] panics never pub
    let path = notes.store.note_path(self.dir.as_str(), n.id)?
    let text = notes.store.note_to_json(n)?
    std.fs.write_atomic(path.as_str(), text.as_bytes())?
    Ok(())
end notes.store.Store.save_note

fn notes.store.Store.search_ids(self: &notes.store.Store, q: &str) -> Result<std.vec.Vec<i64>, notes.error.Error> uses [alloc] panics never pub
    let mut out = std.vec.Vec.new()
    let n = self.notes.len()
    for i in core.iter.range(0usize, n) {
        match self.get_at(i) {
            Some(memo) => {
                let mut matched = false
                if memo.title.as_str().contains(q) {
                    matched = true
                }
                if !matched && memo.body.as_str().contains(q) {
                    matched = true
                }
                if !matched {
                    let tg = memo.tags.as_slice()
                    let m = tg.len()
                    for j in core.iter.range(0usize, m) {
                        match tg.get(j) {
                            Some(tag) => if tag.as_str().contains(q) {
                                matched = true
                            }
                            None => core.mem.drop(0u8)
                        }
                    }
                }
                if matched {
                    core.mem.drop(out.push(memo.id)?)
                }
            }
            None => core.mem.drop(0u8)
        }
    }
    Ok(out)
end notes.store.Store.search_ids

fn notes.store.Store.set(self: &mut notes.store.Store, id: i64, u: notes.note.Note) -> Result<(), notes.error.Error> uses [alloc, io.fs] panics never pub
    let index = notes.store.index_of(self, id)?
    {
        let n = match self.get_at(index) {
            Some(n) => n
            None => return Err(error.Error.NotFound)
        }
        core.mem.drop(n)
    }
    let title = u.title
    let body = u.body
    let tags = u.tags
    let created_at = u.created_at
    let title_s = title.as_str()
    let body_s = body.as_str()
    let created_s = created_at.as_str()
    let mut replaced = note.Note.new(0i64, title_s, body_s, tags, created_s)?
    replaced.id = id
    self.save_note(&replaced)?
    core.mem.drop(self.notes.remove(index))
    core.mem.drop(self.notes.push(replaced)?)
    Ok(())
end notes.store.Store.set

fn notes.store.Store.tagged_ids(self: &notes.store.Store, tag: &str) -> Result<std.vec.Vec<i64>, notes.error.Error> uses [alloc] panics never pub
    let mut out = std.vec.Vec.new()
    let n = self.notes.len()
    for i in core.iter.range(0usize, n) {
        match self.get_at(i) {
            Some(memo) => {
                let tg = memo.tags.as_slice()
                let m = tg.len()
                for j in core.iter.range(0usize, m) {
                    match tg.get(j) {
                        Some(t) => if t.as_str() == tag {
                            core.mem.drop(out.push(memo.id)?)
                            break
                        }
                        None => core.mem.drop(0u8)
                    }
                }
            }
            None => core.mem.drop(0u8)
        }
    }
    Ok(out)
end notes.store.Store.tagged_ids

fn notes.store.Store.tags(self: &notes.store.Store) -> Result<std.vec.Vec<std.string.String>, alloc.alloc.AllocError> uses [alloc] panics never pub
    let mut out = std.vec.Vec.new()
    let n = self.notes.len()
    for i in core.iter.range(0usize, n) {
        match self.get_at(i) {
            Some(memo) => {
                let tg = memo.tags.as_slice()
                let m = tg.len()
                for j in core.iter.range(0usize, m) {
                    match tg.get(j) {
                        Some(g) => {
                            let mut found = false
                            let o = out.as_slice()
                            let o_len = o.len()
                            for k in core.iter.range(0usize, o_len) {
                                match o.get(k) {
                                    Some(existing) => if *existing == *g {
                                        found = true
                                    }
                                    None => core.mem.drop(0u8)
                                }
                            }
                            if !found {
                                let c = std.string.String.from_str(g.as_str())?
                                core.mem.drop(out.push(c)?)
                            }
                        }
                        None => core.mem.drop(0u8)
                    }
                }
            }
            None => core.mem.drop(0u8)
        }
    }
    Ok(out)
end notes.store.Store.tags

fn notes.store.index_of(store: &notes.store.Store, id: i64) -> Result<usize, notes.error.Error> uses [] panics never pub
    let n = store.notes.len()
    for i in core.iter.range(0usize, n) {
        match store.get_at(i) {
            Some(memo) => if memo.id == id {
                return Ok(i)
            }
            None => return Err(error.Error.Corrupt)
        }
    }
    Err(error.Error.NotFound)
end notes.store.index_of

fn notes.store.note_path(dir: &str, id: i64) -> Result<std.string.String, alloc.alloc.AllocError> uses [alloc] panics never
    let mut p = std.string.String.from_str(dir)?
    match p.push_str("/") {
        Ok(_u) => {
        }
        Err(e) => return Err(e)
    }
    match p.push_i64(id) {
        Ok(_u) => {
        }
        Err(e) => return Err(e)
    }
    match p.push_str(".json") {
        Ok(_u) => {
        }
        Err(e) => return Err(e)
    }
    Ok(p)
end notes.store.note_path

// 1 メモを JSON オブジェクトとしてシリアライズする（derive [ToJson] の to_json）。
fn notes.store.note_to_json(n: &notes.note.Note) -> Result<std.string.String, alloc.alloc.AllocError> uses [alloc] panics never pub
    let mut out = std.string.String.new()
    n.to_json(&mut out)?
    Ok(out)
end notes.store.note_to_json

fn notes.store.read_text(path: &str) -> Result<std.string.String, notes.error.Error> uses [alloc, io.fs] panics never
    let mut data = std.vec.Vec.new()
    with mut file = std.fs.open(path)? close core.mem.drop(file.close()) {
        core.mem.drop(std.fs.read_to_end(&mut file, &mut data)?)
    }
    let mut text = std.string.String.new()
    text.push_bytes(data.as_slice()).map_err(error.push_failed)?
    Ok(text)
end notes.store.read_text

fn notes.store.remove_dir_all(path: &str) -> Result<(), notes.error.Error> uses [alloc, io.fs] panics never stack 256
    if !std.fs.exists(path) {
        return Ok(())
    }
    let entries = std.fs.read_dir(path)?
    let n = entries.len()
    for i in core.iter.range(0usize, n) {
        match entries.as_slice().get(i) {
            Some(e) => {
                let mut p = std.string.String.from_str(path)?
                core.mem.drop(p.push_str("/"))
                core.mem.drop(p.push_str(e.name.as_str()))
                if e.kind == std.fs.FileKind.Dir {
                    core.mem.drop(notes.store.remove_dir_all(p.as_str()))
                } else {
                    core.mem.drop(std.fs.remove_file(p.as_str()))
                }
            }
            None => core.mem.drop(0u8)
        }
    }
    core.mem.drop(std.fs.remove_dir(path))
    Ok(())
end notes.store.remove_dir_all

fn notes.store.string_copy(s: &std.string.String) -> Result<std.string.String, alloc.alloc.AllocError> uses [alloc] panics never
    std.string.String.from_str(s.as_str())
end notes.store.string_copy

// ディレクトリ（存在すれば中身ごと）を削除する。
fn notes.store.test_reset_dir() -> Result<(), notes.error.Error> uses [alloc, io.fs] panics never
    notes.store.remove_dir_all(notes.store.TEST_DIR)?
    std.fs.create_dir_all(notes.store.TEST_DIR)?
    Ok(())
end notes.store.test_reset_dir

test notes.store.Store.new.test_reset_and_load
    notes.store.test_reset_dir()?
    let mut store = notes.store.Store.load(notes.store.TEST_DIR)?
    core.check.eq(store.len(), 0usize)
    let mut tags = std.vec.Vec.new()
    core.mem.drop(tags.push(std.string.String.from_str("仕事")?))
    let n = note.Note.new(0i64, "打ち合わせ", "プロジェクトの打ち合わせ", tags, "2026-11-15T09:00:00Z")?
    let id = store.add(n)?
    core.check.eq(id, 1i64)
    core.check.eq(store.len(), 1usize)
    let loaded = notes.store.Store.load(notes.store.TEST_DIR)?
    core.check.eq(loaded.len(), 1usize)
    let got = loaded.get(1i64)
    match got {
        Some(memo) => {
            core.check.eq(memo.title.as_str(), "打ち合わせ")
            core.check.eq(memo.tags.len(), 1usize)
        }
        None => core.panic.panic("note not found")
    }
end notes.store.Store.new.test_reset_and_load

test notes.store.Store.search_ids.test_search_and_tags
    notes.store.test_reset_dir()?
    let mut store = notes.store.Store.load(notes.store.TEST_DIR)?
    let mut tags1 = std.vec.Vec.new()
    core.mem.drop(tags1.push(std.string.String.from_str("仕事")?))
    core.mem.drop(tags1.push(std.string.String.from_str("緊急")?))
    let note1 = note.Note.new(0i64, "打ち合わせ", "プロジェクトの打ち合わせ", tags1, "2026-11-15T09:00:00Z")?
    core.mem.drop(store.add(note1)?)
    let mut tags2 = std.vec.Vec.new()
    core.mem.drop(tags2.push(std.string.String.from_str("買い物")?))
    let note2 = note.Note.new(0i64, "牛乳を買う", "午後3時に牛乳を買う", tags2, "2026-11-15T15:00:00Z")?
    core.mem.drop(store.add(note2)?)
    let found = store.search_ids("牛乳")?
    core.check.eq(found.len(), 1usize)
    let all_tags = store.tags()?
    core.check.eq(all_tags.len(), 3usize)
    let tagged = store.tagged_ids("仕事")?
    core.check.eq(tagged.len(), 1usize)
end notes.store.Store.search_ids.test_search_and_tags

test notes.store.Store.set.test_set_and_remove
    notes.store.test_reset_dir()?
    let mut store = notes.store.Store.load(notes.store.TEST_DIR)?
    let tags = std.vec.Vec.new()
    let memo = note.Note.new(0i64, "元", "本文", tags, "2026-11-15T09:00:00Z")?
    let id = store.add(memo)?
    let mut tags2 = std.vec.Vec.new()
    core.mem.drop(tags2.push(std.string.String.from_str("変更")?))
    let u = note.Note.new(0i64, "変更後", "新しい本文", tags2, "2026-11-16T09:00:00Z")?
    store.set(id, u)?
    let got = store.get(id)
    match got {
        Some(found) => {
            core.check.eq(found.title.as_str(), "変更後")
            core.check.eq(found.body.as_str(), "新しい本文")
        }
        None => core.panic.panic("note not found")
    }
    store.remove(id)?
    core.check.eq(store.len(), 0usize)
end notes.store.Store.set.test_set_and_remove
