type wiki.page.Page pub
    name: alloc.string.String<std.alloc.System>
    content: alloc.string.String<std.alloc.System>
    version: u64
end wiki.page.Page

fn wiki.page.Page.new(name: &str, content: &str, version: u64) -> Result<wiki.page.Page, wiki.error.Error> uses [alloc] panics never pub
    let n = alloc.string.String.from_str(std.alloc.SYSTEM, name)?
    let c = alloc.string.String.from_str(std.alloc.SYSTEM, content)?
    Ok(wiki.page.Page { name: n, content: c, version: version })
end wiki.page.Page.new

test wiki.page.Page.new.test_fields
    let p = wiki.page.Page.new("Hello", "# Hi\n", 1u64)?
    core.check.eq(p.name.as_str(), "Hello")
    core.check.eq(p.content.as_str(), "# Hi\n")
    core.check.eq(p.version, 1u64)
end wiki.page.Page.new.test_fields
