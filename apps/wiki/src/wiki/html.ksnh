    core.check.eq(s.as_str().contains("<h1>ページ一覧</h1>"), true)
    core.check.eq(s.as_str().contains("<ul></ul>"), true)
    core.check.eq(s.as_str().contains("/new"), true)
end wiki.html.list_view.test_empty

test wiki.html.list_view.test_renders_links
