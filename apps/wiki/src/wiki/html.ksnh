    core.mem.drop(v.push(alloc.string.String.from_str(std.alloc.SYSTEM, "Alpha")?)?)
    core.mem.drop(v.push(alloc.string.String.from_str(std.alloc.SYSTEM, "Beta")?)?)
    let s = wiki.html.list_view(v.as_slice())?
    core.check.eq(s.as_str().contains("/page/Alpha"), true)
    core.check.eq(s.as_str().contains("/page/Beta"), true)
end wiki.html.list_view.test_renders_links

