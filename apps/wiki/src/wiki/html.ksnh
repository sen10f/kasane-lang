    core.check.eq(s.as_str().contains("/page/B"), true)
    core.check.eq(s.as_str().contains("/page/C"), true)
end wiki.html.list_view.test_three_pages

test wiki.html.page_shell.test_nav_links
    let s = wiki.html.page_shell("T", "<p>b</p>")?
    core.check.eq(s.as_str().contains("/new"), true)
    core.check.eq(s.as_str().contains("検索"), true)
    core.check.eq(s.as_str().contains("/"), true)
end wiki.html.page_shell.test_nav_links

test wiki.html.page_shell.test_wraps
    let s = wiki.html.page_shell("T", "<p>body</p>")?
    core.check.eq(s.as_str().starts_with("<!DOCTYPE html>"), true)
    core.check.eq(s.as_str().contains("<title>T</title>"), true)
    core.check.eq(s.as_str().contains("<p>body</p>"), true)
end wiki.html.page_shell.test_wraps

test wiki.html.page_view.test_no_backlinks
    let mut versions = alloc.vec.Vec.new(std.alloc.SYSTEM)
    core.mem.drop(versions.push(1u64)?)
    let empty = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let s = wiki.html.page_view("Hello", "<p>body</p>", versions.as_slice(), empty.as_slice())?
    core.check.eq(s.as_str().contains("<h2>被リンク</h2>"), true)
end wiki.html.page_view.test_no_backlinks

test wiki.html.page_view.test_renders_content_and_links
    let mut versions = alloc.vec.Vec.new(std.alloc.SYSTEM)
    core.mem.drop(versions.push(1u64)?)
    core.mem.drop(versions.push(2u64)?)
    let mut backlinks = alloc.vec.Vec.new(std.alloc.SYSTEM)
    core.mem.drop(backlinks.push(alloc.string.String.from_str(std.alloc.SYSTEM, "Other")?)?)
    let s = wiki.html.page_view("Hello", "<p>body</p>", versions.as_slice(), backlinks.as_slice())?
    core.check.eq(s.as_str().contains("<h1>Hello</h1>"), true)
    core.check.eq(s.as_str().contains("<p>body</p>"), true)
    core.check.eq(s.as_str().contains("/page/Other"), true)
    core.check.eq(s.as_str().contains("版 1"), true)
    core.check.eq(s.as_str().contains("版 2"), true)
end wiki.html.page_view.test_renders_content_and_links

test wiki.html.search_view.test_empty_results
    let empty = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let s = wiki.html.search_view("nothing", empty.as_slice())?
    core.check.eq(s.as_str().contains("<h1>検索: nothing</h1>"), true)
    core.check.eq(s.as_str().contains("<ul></ul>"), true)
end wiki.html.search_view.test_empty_results

test wiki.html.search_view.test_results
    let mut results = alloc.vec.Vec.new(std.alloc.SYSTEM)
    core.mem.drop(results.push(alloc.string.String.from_str(std.alloc.SYSTEM, "Alpha")?)?)
    core.mem.drop(results.push(alloc.string.String.from_str(std.alloc.SYSTEM, "Beta")?)?)
    let s = wiki.html.search_view("query", results.as_slice())?
    core.check.eq(s.as_str().contains("<h1>検索: query</h1>"), true)
    core.check.eq(s.as_str().contains("/page/Alpha"), true)
    core.check.eq(s.as_str().contains("/page/Beta"), true)
end wiki.html.search_view.test_results
