test wiki.store.PageStore.sanitize_name.test_cases
    core.check.eq(wiki.store.PageStore.sanitize_name("Hello"), true)
    core.check.eq(wiki.store.PageStore.sanitize_name("Hello_World"), true)
    core.check.eq(wiki.store.PageStore.sanitize_name("hello-world"), true)
    core.check.eq(wiki.store.PageStore.sanitize_name(""), false)
    core.check.eq(wiki.store.PageStore.sanitize_name("."), false)
    core.check.eq(wiki.store.PageStore.sanitize_name(".."), false)
    core.check.eq(wiki.store.PageStore.sanitize_name("a/b"), false)
    core.check.eq(wiki.store.PageStore.sanitize_name("a\\b"), false)
end wiki.store.PageStore.sanitize_name.test_cases

test wiki.store.PageStore.sanitize_name.test_unicode_and_control
    core.check.eq(wiki.store.PageStore.sanitize_name("Hello_World"), true)
    core.check.eq(wiki.store.PageStore.sanitize_name("hello-world"), true)
    core.check.eq(wiki.store.PageStore.sanitize_name("a.b"), true)
    core.check.eq(wiki.store.PageStore.sanitize_name("a b"), true)
    core.check.eq(wiki.store.PageStore.sanitize_name(""), false)
    core.check.eq(wiki.store.PageStore.sanitize_name("."), false)
    core.check.eq(wiki.store.PageStore.sanitize_name(".."), false)
    core.check.eq(wiki.store.PageStore.sanitize_name("a/b"), false)
    core.check.eq(wiki.store.PageStore.sanitize_name("a\\b"), false)
    let mut ctrl = alloc.string.String.new(std.alloc.SYSTEM)
    core.mem.drop(ctrl.push('a')?)
    match char.try_from_u32(0u32) {
        Some(nul) => core.mem.drop(ctrl.push(nul)?)
        None => core.mem.drop(0u8)
    }
    core.mem.drop(ctrl.push('b')?)
    core.check.eq(wiki.store.PageStore.sanitize_name(ctrl.as_str()), false)
end wiki.store.PageStore.sanitize_name.test_unicode_and_control

test wiki.store.PageStore.save_version.test_hello_persist_router
    core.mem.drop(wiki.remove_dir_all("/tmp/wiki-test-router"))
    let mut ps = wiki.store.PageStore.new("/tmp/wiki-test-router")?
    core.mem.drop(ps.save_version("Hello", "Hello world\n", 1u64)?)
    let ex = ps.page_exists("Hello")
    core.check.eq(ex, true)
    let loaded = ps.load_latest("Hello")
    match loaded {
        Some(c) => core.check.eq(c.as_str(), "Hello world\n")
        None => core.panic.panic("load_latest returned None")
    }
end wiki.store.PageStore.save_version.test_hello_persist_router

test wiki.store.PageStore.save_version.test_round_trip
    let path = "/tmp/wiki-test-store-round-trip"
    core.mem.drop(wiki.remove_dir_all(path))
    let mut page_store = match wiki.store.PageStore.new(path) {
        Ok(s) => s
        Err(_e) => core.panic.panic("new failed")
    }
    let content_v1 = "# Title\n\nbody text\n"
    core.mem.drop(page_store.save_version("Hello", content_v1, 1u64)?)
    core.check.eq(page_store.page_exists("Hello"), true)
    let loaded = page_store.load_latest("Hello")
    match loaded {
        Some(c) => core.check.eq(c.as_str(), "# Title\n\nbody text\n")
        None => core.panic.panic("load_latest returned None")
    }
    let v1 = page_store.load_version("Hello", 1usize)
    match v1 {
        Some(c) => core.check.eq(c.as_str(), "# Title\n\nbody text\n")
        None => core.panic.panic("load_version returned None")
    }
    let content_v2 = "# Title v2\n\nbody v2\n"
    core.mem.drop(page_store.save_version("Hello", content_v2, 2u64)?)
    let versions = page_store.page_versions("Hello")?
    core.check.eq(versions.len(), 2usize)
    match versions.as_slice().get(0usize) {
        Some(v) => core.check.eq(*v, 1u64)
        None => core.panic.panic("missing v1")
    }
    match versions.as_slice().get(1usize) {
        Some(v) => core.check.eq(*v, 2u64)
        None => core.panic.panic("missing v2")
    }
    let next = page_store.next_version("Hello")?
    core.check.eq(next, 3u64)
end wiki.store.PageStore.save_version.test_round_trip
