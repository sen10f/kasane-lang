// CSRF 保護トークンの発行・検証。トークンを Vec に登録し、verify で使い捨て（削除）する。
type wiki.csrf.CsrfManager pub
    tokens: std.vec.Vec<std.string.String>
end wiki.csrf.CsrfManager

fn wiki.csrf.CsrfManager.generate_token(self: &mut wiki.csrf.CsrfManager) -> Result<std.string.String, wiki.error.Error> uses [alloc, rand] panics never pub
    let mut buf = std.vec.Vec.new()
    for _ in core.iter.range(0usize, 32usize) {
        buf.push(0u8)?
    }
    std.rand.fill_secure(buf.as_mut_slice())?
    let mut hex = std.string.String.new()
    let mut i = 0usize
    let n = buf.len()
    while i < n {
        match buf.as_slice().get(i) {
            Some(b) => {
                let hi = b.wrapping_shr(4u32)
                let lo = *b & 15u8
                hex.push(wiki.csrf.hex_digit(hi))?
                hex.push(wiki.csrf.hex_digit(lo))?
            }
            None => core.mem.drop(0u8)
        }
        i = i.saturating_add(1usize)
    }
    // Clone hex for the return value before moving it into tokens
    let mut hex_copy = std.string.String.new()
    core.mem.drop(hex_copy.push_str(hex.as_str())?)
    core.mem.drop(self.tokens.push(hex)?)
    Ok(hex_copy)
end wiki.csrf.CsrfManager.generate_token

fn wiki.csrf.CsrfManager.new() -> Result<wiki.csrf.CsrfManager, wiki.error.Error> uses [] panics never pub
    let vec = std.vec.Vec.new()
    Ok(wiki.csrf.CsrfManager {
        tokens: vec
    })
end wiki.csrf.CsrfManager.new

fn wiki.csrf.CsrfManager.verify_token(self: &mut wiki.csrf.CsrfManager, token: &str) -> bool uses [] panics never pub
    let mut i = 0usize
    let n = self.tokens.len()
    while i < n {
        match self.tokens.as_slice().get(i) {
            Some(s) => if s.as_str() == token {
                match self.tokens.remove(i) {
                    Some(_) => return true
                    None => core.mem.drop(0u8)
                }
            }
            None => core.mem.drop(0u8)
        }
        i = i.saturating_add(1usize)
    }
    false
end wiki.csrf.CsrfManager.verify_token

fn wiki.csrf.hex_digit(v: u8) -> char uses [] panics never pub
    if v < 10u8 {
        match char.try_from_u32(u32.from_u8(b'0'.wrapping_add(v))) {
            Some(c) => c
            None => '0'
        }
    } else {
        match char.try_from_u32(u32.from_u8(b'a'.wrapping_add(v.wrapping_sub(10u8)))) {
            Some(c) => c
            None => 'a'
        }
    }
end wiki.csrf.hex_digit

test wiki.csrf.CsrfManager.generate_token.test_distinct_tokens
    let mut tokens = wiki.csrf.CsrfManager.new()?
    let t1 = tokens.generate_token()?
    let t2 = tokens.generate_token()?
    core.check.eq(t1.as_str() == t2.as_str(), false)
end wiki.csrf.CsrfManager.generate_token.test_distinct_tokens

test wiki.csrf.CsrfManager.generate_token.test_generate_and_verify
    let mut tokens = wiki.csrf.CsrfManager.new()?
    let token = tokens.generate_token()?
    core.check.eq(tokens.verify_token(token.as_str()), true)
    // 使い捨て: 2 度目は false
    core.check.eq(tokens.verify_token(token.as_str()), false)
end wiki.csrf.CsrfManager.generate_token.test_generate_and_verify

test wiki.csrf.CsrfManager.generate_token.test_token_is_hex
    let mut tokens = wiki.csrf.CsrfManager.new()?
    let token = tokens.generate_token()?
    let s = token.as_str()
    let mut i = 0usize
    let n = s.len()
    let mut all_hex = true
    while i < n {
        let c = match s.as_bytes().get(i) {
            Some(b) => *b
            None => 0u8
        }
        let ok = c >= b'0' && c <= b'9' || c >= b'a' && c <= b'f'
        if !ok {
            all_hex = false
        }
        i = i.saturating_add(1usize)
    }
    core.check.eq(all_hex, true)
    core.check.eq(n, 64usize)
end wiki.csrf.CsrfManager.generate_token.test_token_is_hex

test wiki.csrf.CsrfManager.verify_token.test_case_sensitive
    let mut tokens = wiki.csrf.CsrfManager.new()?
    let token = tokens.generate_token()?
    // 末尾に 1 文字追加したものは一致しないはず
    let mut modified = std.string.String.new()
    core.mem.drop(modified.push_str(token.as_str())?)
    core.mem.drop(modified.push('x')?)
    core.check.eq(tokens.verify_token(modified.as_str()), false)
end wiki.csrf.CsrfManager.verify_token.test_case_sensitive

test wiki.csrf.CsrfManager.verify_token.test_reject_unknown
    let mut tokens = wiki.csrf.CsrfManager.new()?
    core.check.eq(tokens.verify_token("deadbeef"), false)
end wiki.csrf.CsrfManager.verify_token.test_reject_unknown

test wiki.csrf.CsrfManager.verify_token.test_token_removed_after_use
    let mut tokens = wiki.csrf.CsrfManager.new()?
    let token = tokens.generate_token()?
    core.check.eq(tokens.verify_token(token.as_str()), true)
    // 2 度目は false (使い捨て)
    core.check.eq(tokens.verify_token(token.as_str()), false)
    // 3 度目も false
    core.check.eq(tokens.verify_token(token.as_str()), false)
end wiki.csrf.CsrfManager.verify_token.test_token_removed_after_use

test wiki.csrf.hex_digit.test_boundary
    core.check.eq(wiki.csrf.hex_digit(0u8), '0')
    core.check.eq(wiki.csrf.hex_digit(1u8), '1')
    core.check.eq(wiki.csrf.hex_digit(9u8), '9')
    core.check.eq(wiki.csrf.hex_digit(10u8), 'a')
    core.check.eq(wiki.csrf.hex_digit(15u8), 'f')
end wiki.csrf.hex_digit.test_boundary

test wiki.csrf.hex_digit.test_cases
    core.check.eq(wiki.csrf.hex_digit(0u8), '0')
    core.check.eq(wiki.csrf.hex_digit(9u8), '9')
    core.check.eq(wiki.csrf.hex_digit(10u8), 'a')
    core.check.eq(wiki.csrf.hex_digit(15u8), 'f')
end wiki.csrf.hex_digit.test_cases
