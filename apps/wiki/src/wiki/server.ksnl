import wiki.router
import wiki.store

const wiki.server.MAX_BODY: usize = 65536usize

const wiki.server.MAX_HEAD: usize = 8192usize

fn wiki.server.answer(stream: &mut std.net.TcpStream, page_store: &mut wiki.store.PageStore, csrf_tokens: &mut alloc.vec.Vec<alloc.string.String<std.alloc.System>, std.alloc.System>, request: &std.http.Request) -> Result<bool, wiki.error.Error> uses [alloc, io.console, io.fs, io.net, rand, time] panics never
    let keep = request.keep_alive()
    let method = request.method.as_str()
    let path = request.path.as_str()
    let reply = match core.str.from_utf8(request.body.as_slice()) {
        Ok(text) => router.route(page_store, method, path, text, csrf_tokens)?
        Err(_e) => router.error_reply(400u16, "bad request")?
    }
    wiki.server.send(stream, &reply, keep)?
    wiki.server.log_request(method, path, reply.status, keep)?
    Ok(keep)
end wiki.server.answer

fn wiki.server.close_stream(stream: std.net.TcpStream) -> Result<(), wiki.error.Error> uses [io.net] panics never pub
    stream.close()?
    Ok(())
end wiki.server.close_stream

fn wiki.server.connection(conn: std.net.TcpStream, page_store: &mut wiki.store.PageStore, csrf_tokens: &mut alloc.vec.Vec<alloc.string.String<std.alloc.System>, std.alloc.System>) -> Result<usize, wiki.error.Error> uses [alloc, io.console, io.fs, io.net, rand, time] panics never pub
    let mut stream = conn
    let max_head = wiki.server.MAX_HEAD
    let max_body = wiki.server.MAX_BODY
    let mut decoder = std.http.Decoder.new(max_head, max_body)
    let outcome = wiki.server.serve_all(&mut stream, page_store, csrf_tokens, &mut decoder)
    let closed = wiki.server.close_stream(stream)
    let served = outcome?
    closed?
    Ok(served)
end wiki.server.connection

fn wiki.server.log_request(method: &str, path: &str, status: u16, keep: bool) -> Result<(), wiki.error.Error> uses [alloc, io.console, time] panics never
    let mut code = alloc.string.String.new(std.alloc.SYSTEM)
    code.push_u64(u64.from_u16(status))?
    let mut kept = "0"
    if keep {
        kept = "1"
    }
    let fields = [
        ("method", method),
        ("path", path),
        ("status", code.as_str()),
        ("keep_alive", kept),
    ]
    core.mem.drop(std.log.info("request", &fields))
    Ok(())
end wiki.server.log_request

fn wiki.server.refuse(stream: &mut std.net.TcpStream, failure: std.http.Error) -> Result<(), wiki.error.Error> uses [alloc, io.console, io.net, time] panics never
    let status = match failure {
        std.http.Error.BadRequest => 400u16
        std.http.Error.BodyTooLarge => 413u16
        std.http.Error.HeadTooLarge => 431u16
        std.http.Error.Unsupported => 501u16
        std.http.Error.Truncated => 0u16
        std.http.Error.Io(_x) => 0u16
        std.http.Error.Alloc(_a) => 500u16
    }
    if status == 0u16 {
        core.mem.drop(std.log.warn("connection ended early", &[("reason", "truncated")]))
        return Ok(())
    }
    let reply = router.error_reply(status, std.http.reason(status))?
    wiki.server.send(stream, &reply, false)?
    wiki.server.log_request("-", "-", status, false)?
    Ok(())
end wiki.server.refuse

fn wiki.server.send(stream: &mut std.net.TcpStream, reply: &wiki.router.Reply, keep: bool) -> Result<(), wiki.error.Error> uses [alloc, io.net] panics never
    let mut head = alloc.string.String.new(std.alloc.SYSTEM)
    head.push_str("Content-Type: text/html; charset=utf-8\r\n")?
    if !reply.location.is_empty() {
        head.push_str("Location: ")?
        head.push_str(reply.location.as_str())?
        head.push_str("\r\n")?
    }
    let bytes = std.http.render(reply.status, head.as_str(), reply.body.as_str().as_bytes(), keep)?
    std.http.write_all(stream, bytes.as_slice())?
    Ok(())
end wiki.server.send

fn wiki.server.serve(address: &str, data_dir: &str) -> Result<(), wiki.error.Error> uses [alloc, env, io.console, io.fs, io.net, rand, time] panics never pub
    with listener = std.net.listen(address)? close core.mem.drop(listener.close()) {
        let mut page_store = store.PageStore.new(data_dir)?
        let mut csrf_tokens = alloc.vec.Vec.new(std.alloc.SYSTEM)
        let port = listener.local_port()?
        let mut text = alloc.string.String.new(std.alloc.SYSTEM)
        text.push_u64(u64.from_u16(port))?
        core.mem.drop(std.log.info("listening", &[("port", text.as_str())]))
        let ps = &mut page_store
        let ct = &mut csrf_tokens
        let served = wiki.server.serve_listener(&listener, ps, ct, 0usize)?
        core.mem.drop(served)
    }
    Ok(())
end wiki.server.serve

fn wiki.server.serve_all(stream: &mut std.net.TcpStream, page_store: &mut wiki.store.PageStore, csrf_tokens: &mut alloc.vec.Vec<alloc.string.String<std.alloc.System>, std.alloc.System>, decoder: &mut std.http.Decoder) -> Result<usize, wiki.error.Error> uses [alloc, io.console, io.fs, io.net, rand, time] panics never
    let mut served = 0usize
    let mut more = true
    while more {
        let mut chunk = [0u8; 1024]
        let n = stream.read(&mut chunk)?
        if n > 0usize {
            std.http.Decoder.feed_part(decoder, &chunk, n)?
        }
        loop {
            match std.http.Decoder.next(decoder) {
                Ok(Some(request)) => {
                    served = served.saturating_add(1usize)
                    more = wiki.server.answer(stream, page_store, csrf_tokens, &request)?
                    if !more {
                        break
                    }
                }
                Ok(None) => {
                    break
                }
                Err(failure) => {
                    wiki.server.refuse(stream, failure)?
                    more = false
                    break
                }
            }
        }
        if n == 0usize {
            more = false
        }
    }
    Ok(served)
end wiki.server.serve_all

fn wiki.server.serve_listener(listener: &std.net.TcpListener, page_store: &mut wiki.store.PageStore, csrf_tokens: &mut alloc.vec.Vec<alloc.string.String<std.alloc.System>, std.alloc.System>, connections: usize) -> Result<usize, wiki.error.Error> uses [alloc, io.console, io.fs, io.net, rand, time] panics never pub
    let mut accepted = 0usize
    let mut served = 0usize
    while connections == 0usize || accepted < connections {
        let tcp = listener.accept()?
        accepted = accepted.saturating_add(1usize)
        served = served.saturating_add(wiki.server.connection(tcp, page_store, csrf_tokens)?)
    }
    Ok(served)
end wiki.server.serve_listener

test wiki.server.MAX_BODY.test_value
    core.check.eq(65536usize, 65536usize)
end wiki.server.MAX_BODY.test_value

test wiki.server.MAX_HEAD.test_value
    core.check.eq(8192usize, 8192usize)
end wiki.server.MAX_HEAD.test_value
