end wiki.router.route.test_history_page

test wiki.router.route.test_history_page_missing
    let mut page_store = wiki.router.test_store()
    let mut csrf_tokens = wiki.router.test_csrf()
    let ps = &mut page_store
    let ct = &mut csrf_tokens
    let resp = wiki.router.test_route(ps, ct, "GET", "/history/NoSuch", "")
    core.check.eq(resp.status, 404u16)
end wiki.router.route.test_history_page_missing

test wiki.router.route.test_list_pages_empty
    let mut page_store = wiki.router.test_store()
    let mut csrf_tokens = wiki.router.test_csrf()
    let resp = wiki.router.test_route(&mut page_store, &mut csrf_tokens, "GET", "/", "")
    core.check.eq(resp.status, 200u16)
end wiki.router.route.test_list_pages_empty

test wiki.router.route.test_method_not_allowed
    let mut page_store = wiki.router.test_store()
    let mut csrf_tokens = wiki.router.test_csrf()
    let ps = &mut page_store
    let ct = &mut csrf_tokens
    let resp = wiki.router.test_route(ps, ct, "DELETE", "/page/Hello", "")
    core.check.eq(resp.status, 405u16)
end wiki.router.route.test_method_not_allowed

test wiki.router.route.test_not_found
    let mut page_store = wiki.router.test_store()
    let mut csrf_tokens = wiki.router.test_csrf()
    let resp = wiki.router.test_route(&mut page_store, &mut csrf_tokens, "GET", "/page/NoSuch", "")
    core.check.eq(resp.status, 404u16)
end wiki.router.route.test_not_found

test wiki.router.route.test_page_backlinks
    let mut page_store = wiki.router.test_store()
    let mut csrf_tokens = wiki.router.test_csrf()
    core.mem.drop(store.PageStore.save_version(&mut page_store, "To", "target page\n", 1u64)?)
    core.mem.drop(store.PageStore.save_version(&mut page_store, "From", "see [[To]] here\n", 1u64)?)
    let resp = wiki.router.test_route(&mut page_store, &mut csrf_tokens, "GET", "/backlinks/To", "")
    core.check.eq(resp.status, 200u16)
    core.check.eq(resp.body.as_str().contains("/page/From"), true)
end wiki.router.route.test_page_backlinks

test wiki.router.route.test_page_backlinks_missing
    let mut page_store = wiki.router.test_store()
    let mut csrf_tokens = wiki.router.test_csrf()
    let ps = &mut page_store
    let ct = &mut csrf_tokens
    let resp = wiki.router.test_route(ps, ct, "GET", "/backlinks/NoSuch", "")
    core.check.eq(resp.status, 404u16)
end wiki.router.route.test_page_backlinks_missing

test wiki.router.route.test_page_links
    let mut page_store = wiki.router.test_store()
    let mut csrf_tokens = wiki.router.test_csrf()
    core.mem.drop(store.PageStore.save_version(&mut page_store, "From", "see [[To]] here\n", 1u64)?)
    let resp = wiki.router.test_route(&mut page_store, &mut csrf_tokens, "GET", "/links/From", "")
    core.check.eq(resp.status, 200u16)
    core.check.eq(resp.body.as_str().contains("/page/To"), true)
end wiki.router.route.test_page_links

test wiki.router.route.test_page_name_from_path
    match wiki.router.page_name_from_path("/page/Hello", "/page/") {
        Some(n) => core.check.eq(n.as_str(), "Hello")
        None => core.panic.panic("page_name_from_path /page/Hello returned None")
    }
end wiki.router.route.test_page_name_from_path

test wiki.router.route.test_page_name_from_path_edge
    match wiki.router.page_name_from_path("/page/", "/page/") {
        Some(_n) => core.panic.panic("empty name should be None")
        None => core.mem.drop(0u8)
    }
    match wiki.router.page_name_from_path("/page/a/b", "/page/") {
        Some(_n) => core.panic.panic("slash in name should be None")
        None => core.mem.drop(0u8)
    }
end wiki.router.route.test_page_name_from_path_edge

test wiki.router.route.test_post_method_not_allowed
    let mut page_store = wiki.router.test_store()
    let mut csrf_tokens = wiki.router.test_csrf()
    let resp = wiki.router.test_route(&mut page_store, &mut csrf_tokens, "POST", "/page/Hello", "")
    core.check.eq(resp.status, 405u16)
end wiki.router.route.test_post_method_not_allowed

test wiki.router.route.test_query_param
    match wiki.router.query_param("a=1&b=2&c=3", "b") {
        Some(v) => core.check.eq(v.as_str(), "2")
        None => core.panic.panic("query param b")
    }
    match wiki.router.query_param("a=1&b=2", "missing") {
        Some(_v) => core.panic.panic("missing should be None")
        None => core.mem.drop(0u8)
    }
end wiki.router.route.test_query_param

test wiki.router.route.test_save_page
    let mut page_store = wiki.router.test_store()
    let mut csrf_tokens = wiki.router.test_csrf()
    // CSRF トークンを生成
    let form_resp = wiki.router.test_route(&mut page_store, &mut csrf_tokens, "GET", "/new", "")
    core.check.eq(form_resp.status, 200u16)
    // トークンをフォームから抽出（簡易：generate_token で直接取得）
    let token = csrf.generate_token(&mut csrf_tokens)?
    // POST /save/TestPage に CSRF トークンと content を付与
    let mut body = alloc.string.String.from_str(std.alloc.SYSTEM, "csrf=")?
    core.mem.drop(body.push_str(token.as_str())?)
    core.mem.drop(body.push_str("&content=Hello+World")?)
    let ps = &mut page_store
    let ct = &mut csrf_tokens
    let b = body.as_str()
    let resp = wiki.router.test_route(ps, ct, "POST", "/save/TestPage", b)
    core.check.eq(resp.status, 303u16)
    core.check.eq(resp.location.as_str(), "/page/TestPage")
end wiki.router.route.test_save_page

test wiki.router.route.test_save_page_invalid_csrf
    let mut page_store = wiki.router.test_store()
    let mut csrf_tokens = wiki.router.test_csrf()
    let mut body = alloc.string.String.from_str(std.alloc.SYSTEM, "csrf=invalid&content=hello")?
    let ps = &mut page_store
    let ct = &mut csrf_tokens
    let b = body.as_str()
    let resp = wiki.router.test_route(ps, ct, "POST", "/save/TestPage", b)
    core.check.eq(resp.status, 403u16)
end wiki.router.route.test_save_page_invalid_csrf

test wiki.router.route.test_save_page_missing_csrf
    let mut page_store = wiki.router.test_store()
    let mut csrf_tokens = wiki.router.test_csrf()
    let mut body = alloc.string.String.from_str(std.alloc.SYSTEM, "content=hello")?
    let ps = &mut page_store
    let ct = &mut csrf_tokens
    let b = body.as_str()
    let resp = wiki.router.test_route(ps, ct, "POST", "/save/TestPage", b)
    core.check.eq(resp.status, 403u16)
end wiki.router.route.test_save_page_missing_csrf

test wiki.router.route.test_save_page_then_show
    let mut page_store = wiki.router.test_store()
    let mut csrf_tokens = wiki.router.test_csrf()
    let token = csrf.generate_token(&mut csrf_tokens)?
    let mut body = alloc.string.String.from_str(std.alloc.SYSTEM, "csrf=")?
    core.mem.drop(body.push_str(token.as_str())?)
    core.mem.drop(body.push_str("&content=# New Page\n")?)
    let ps = &mut page_store
    let ct = &mut csrf_tokens
    let b = body.as_str()
    let save_resp = wiki.router.test_route(ps, ct, "POST", "/save/NewPage", b)
    core.check.eq(save_resp.status, 303u16)
    // 保存後の表示
    let mut path = alloc.string.String.new(std.alloc.SYSTEM)
    core.mem.drop(path.push_str("/page/NewPage")?)
    let p = path.as_str()
    let show_resp = wiki.router.test_route(ps, ct, "GET", p, "")
    core.check.eq(show_resp.status, 200u16)
    core.check.eq(show_resp.body.as_str().contains("New Page"), true)
end wiki.router.route.test_save_page_then_show

test wiki.router.route.test_search
    let mut page_store = wiki.router.test_store()
    let mut csrf_tokens = wiki.router.test_csrf()
    let ps = &mut page_store
    let ct = &mut csrf_tokens
    let saved_a = store.PageStore.save_version(ps, "Alpha", "alpha beta gamma\n", 1u64)?
    core.mem.drop(saved_a)
    let saved_b = store.PageStore.save_version(ps, "Beta", "beta delta\n", 1u64)?
    core.mem.drop(saved_b)
    let resp = wiki.router.test_route(ps, ct, "GET", "/search?q=beta", "")
    core.check.eq(resp.status, 200u16)
end wiki.router.route.test_search

test wiki.router.route.test_show_version
    let mut page_store = wiki.router.test_store()
    let mut csrf_tokens = wiki.router.test_csrf()
    let ps = &mut page_store
    let ct = &mut csrf_tokens
    core.mem.drop(store.PageStore.save_version(ps, "Ver", "v1\n", 1u64)?)
    core.mem.drop(store.PageStore.save_version(ps, "Ver", "v2\n", 2u64)?)
    let resp = wiki.router.test_route(ps, ct, "GET", "/history/Ver/2", "")
    core.check.eq(resp.status, 200u16)
end wiki.router.route.test_show_version

test wiki.router.route.test_show_version_missing
    let mut page_store = wiki.router.test_store()
    let mut csrf_tokens = wiki.router.test_csrf()
    let ps = &mut page_store
    let ct = &mut csrf_tokens
    let resp = wiki.router.test_route(ps, ct, "GET", "/history/Ver/99", "")
    core.check.eq(resp.status, 404u16)
end wiki.router.route.test_show_version_missing
