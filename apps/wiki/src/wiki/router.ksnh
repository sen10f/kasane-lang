    let mut csrf_tokens = wiki.router.test_csrf()
    core.mem.drop(store.PageStore.save_version(&mut page_store, "Hist", "v1\n", 1u64)?)
    core.mem.drop(store.PageStore.save_version(&mut page_store, "Hist", "v2\n", 2u64)?)
