import shortener_https.router

const shortener_https.serve.MAX_BODY: usize = 65_536usize

const shortener_https.serve.MAX_HEAD: usize = 8192usize

fn shortener_https.serve.answer(stream: &mut std.tls.TlsStream, db: &mut shortener_https.store.Store, request: &std.http.Request) -> Result<bool, shortener_https.error.Error> uses [alloc, io.console, io.fs, io.net, time] panics never
    let keep = request.keep_alive()
    let method = request.method.as_str()
    let path = request.path.as_str()
    let reply = match core.str.from_utf8(request.body.as_slice()) {
        Ok(text) => router.route(db, method, path, text)?
        Err(_e) => router.error_reply(400u16, "bad request")?
    }
    shortener_https.serve.send(stream, &reply, keep)?
    shortener_https.serve.log_request(method, path, reply.status, keep)?
    Ok(keep)
end shortener_https.serve.answer

fn shortener_https.serve.close_stream(stream: std.tls.TlsStream) -> Result<(), shortener_https.error.Error> uses [io.net] panics never pub
    stream.close()?
    Ok(())
end shortener_https.serve.close_stream

fn shortener_https.serve.connection(conn: std.tls.TlsStream, db: &mut shortener_https.store.Store) -> Result<usize, shortener_https.error.Error> uses [alloc, io.console, io.fs, io.net, time] panics never pub
    let mut stream = conn
    let max_head = shortener_https.serve.MAX_HEAD
    let max_body = shortener_https.serve.MAX_BODY
    let mut decoder = std.http.Decoder.new(max_head, max_body)
    let outcome = shortener_https.serve.serve_all(&mut stream, db, &mut decoder)
    let closed = shortener_https.serve.close_stream(stream)
    let served = outcome?
    closed?
    Ok(served)
end shortener_https.serve.connection

fn shortener_https.serve.log_request(method: &str, path: &str, status: u16, keep: bool) -> Result<(), shortener_https.error.Error> uses [alloc, io.console, time] panics never
    let mut code = std.string.String.new()
    code.push_u64(u64.from_u16(status))?
    let mut kept = "0"
    if keep {
        kept = "1"
    }
    let fields = [("method", method), ("path", path), ("status", code.as_str()), ("keep_alive", kept)]
    core.mem.drop(std.log.info("request", &fields))
    Ok(())
end shortener_https.serve.log_request

fn shortener_https.serve.refuse(stream: &mut std.tls.TlsStream, failure: std.http.Error) -> Result<(), shortener_https.error.Error> uses [alloc, io.console, io.net, time] panics never
    let status = match failure {
        std.http.Error.BadRequest => 400u16
        std.http.Error.BodyTooLarge => 413u16
        std.http.Error.HeadTooLarge => 431u16
        std.http.Error.Unsupported => 501u16
        std.http.Error.Truncated => 0u16
        std.http.Error.Io(_x) => 0u16
        std.http.Error.Alloc(_a) => 500u16
    }
    if status == 0u16 {
        core.mem.drop(std.log.warn("connection ended early", &[("reason", "truncated")]))
        return Ok(())
    }
    let reply = router.error_reply(status, std.http.reason(status))?
    shortener_https.serve.send(stream, &reply, false)?
    shortener_https.serve.log_request("-", "-", status, false)?
    Ok(())
end shortener_https.serve.refuse

fn shortener_https.serve.send(stream: &mut std.tls.TlsStream, reply: &shortener_https.router.Reply, keep: bool) -> Result<(), shortener_https.error.Error> uses [alloc, io.net] panics never
    let mut head = std.string.String.new()
    head.push_str("Content-Type: application/json\r\n")?
    if !reply.location.is_empty() {
        head.push_str("Location: ")?
        head.push_str(reply.location.as_str())?
        head.push_str("\r\n")?
    }
    let bytes = std.http.render(reply.status, head.as_str(), reply.body.as_str().as_bytes(), keep)?
    std.http.write_all(stream, bytes.as_slice())?
    Ok(())
end shortener_https.serve.send

fn shortener_https.serve.serve_all(stream: &mut std.tls.TlsStream, db: &mut shortener_https.store.Store, decoder: &mut std.http.Decoder) -> Result<usize, shortener_https.error.Error> uses [alloc, io.console, io.fs, io.net, time] panics never
    let mut served = 0usize
    let mut more = true
    while more {
        match std.http.read_request(stream, decoder) {
            Ok(Some(request)) => {
                served = served.saturating_add(1usize)
                more = shortener_https.serve.answer(stream, db, &request)?
            }
            Ok(None) => {
                more = false
            }
            Err(failure) => {
                shortener_https.serve.refuse(stream, failure)?
                more = false
            }
        }
    }
    Ok(served)
end shortener_https.serve.serve_all
