import alloc.string

enum csvtool.error.Error derive [Debug, Clone, Copy, PartialEq, From] pub
    Alloc(alloc.alloc.AllocError)
    Io(std.io.Error)
    Usage
    BadColumn
    Corrupt
end csvtool.error.Error

fn csvtool.error.bad_column() -> csvtool.error.Error uses [] panics never pub
    csvtool.error.Error.BadColumn
end csvtool.error.bad_column

fn csvtool.error.corrupt() -> csvtool.error.Error uses [] panics never pub
    csvtool.error.Error.Corrupt
end csvtool.error.corrupt

fn csvtool.error.push_failed(value: alloc.string.PushBytesError) -> csvtool.error.Error uses [] panics never pub
    match value {
        string.PushBytesError.Alloc(a) => csvtool.error.Error.Alloc(a)
        string.PushBytesError.InvalidUtf8(_) => csvtool.error.Error.Corrupt
    }
end csvtool.error.push_failed

fn csvtool.error.usage() -> csvtool.error.Error uses [] panics never pub
    csvtool.error.Error.Usage
end csvtool.error.usage

test csvtool.error.usage.test_variants
    core.check.eq(csvtool.error.Error.Usage, csvtool.error.Error.Usage)
    core.check.eq(csvtool.error.Error.BadColumn, csvtool.error.Error.BadColumn)
    core.check.eq(csvtool.error.Error.Corrupt, csvtool.error.Error.Corrupt)
end csvtool.error.usage.test_variants
