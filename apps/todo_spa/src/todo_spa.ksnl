import todo_spa.app

fn todo_spa.ksn_event(tag: u32) -> () uses [alloc] panics may
    match app.on_event(tag) {
        Ok(u) => core.mem.drop(u)
        Err(e) => core.mem.drop(e)
    }
end todo_spa.ksn_event

fn todo_spa.ksn_fetch_done(tag: u32, status: i32) -> () uses [alloc] panics may
    match app.on_fetch(tag, status) {
        Ok(u) => core.mem.drop(u)
        Err(e) => core.mem.drop(e)
    }
end todo_spa.ksn_fetch_done

fn todo_spa.main() -> () uses [alloc] panics may
    match app.start() {
        Ok(u) => core.mem.drop(u)
        Err(e) => core.mem.drop(e)
    }
end todo_spa.main
