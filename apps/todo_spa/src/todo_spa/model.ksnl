fn todo_spa.model.after(s: &str, i: usize) -> &str uses [] panics never
    match s.split_at(i) {
        None => s
        Some((_head, tail)) => tail
    }
end todo_spa.model.after

fn todo_spa.model.before(s: &str, i: usize) -> &str uses [] panics never
    match s.split_at(i) {
        None => s
        Some((head, _tail)) => head
    }
end todo_spa.model.before

fn todo_spa.model.from_server(text: &str) -> Result<alloc.string.String<std.alloc.System>, alloc.alloc.AllocError> uses [alloc] panics may pub
    let mut out = alloc.string.String.new(std.alloc.SYSTEM)
    let mut pos = 0usize
    let mut more = true
    while more {
        let rest = todo_spa.model.after(text, pos)
        match rest.split_once("{\"id\":") {
            None => {
                more = false
            }
            Some((head, after)) => {
                core.mem.drop(head)
                match todo_spa.model.item(after)? {
                    None => {
                        more = false
                    }
                    Some((line, next)) => {
                        out.push_str(line.as_str())?
                        out.push_str("\n")?
                        pos = text.len() - next.len()
                    }
                }
            }
        }
    }
    Ok(out)
end todo_spa.model.from_server

fn todo_spa.model.item(after: &str) -> Result<Option<(alloc.string.String<std.alloc.System>, &str)>, alloc.alloc.AllocError> uses [alloc] panics may
    match after.split_once(",\"title\":\"") {
        None => Ok(None)
        Some((id_text, title_on)) => {
            todo_spa.model.item_title(id_text, title_on)
        }
    }
end todo_spa.model.item

fn todo_spa.model.item_rest['a](id_text: &str, raw: &str, tail: &'a str) -> Result<Option<(alloc.string.String<std.alloc.System>, &'a str)>, alloc.alloc.AllocError> uses [alloc] panics may
    match tail.split_once(",\"done\":") {
        None => Ok(None)
        Some((head, flag_on)) => {
            core.mem.drop(head)
            let mut flag = "0"
            if flag_on.starts_with("true") {
                flag = "1"
            }
            let mut line = alloc.string.String.new(std.alloc.SYSTEM)
            line.push_str(id_text)?
            line.push_str("\t")?
            line.push_str(flag)?
            line.push_str("\t")?
            line.push_str(raw)?
            Ok(Some((line, flag_on)))
        }
    }
end todo_spa.model.item_rest

fn todo_spa.model.item_title['a](id_text: &str, title_on: &'a str) -> Result<Option<(alloc.string.String<std.alloc.System>, &'a str)>, alloc.alloc.AllocError> uses [alloc] panics may
    match todo_spa.model.quote_end(title_on) {
        None => Ok(None)
        Some(stop) => {
            let raw = todo_spa.model.before(title_on, stop)
            let tail = todo_spa.model.after(title_on, stop + 1usize)
            todo_spa.model.item_rest(id_text, raw, tail)
        }
    }
end todo_spa.model.item_title

fn todo_spa.model.push_json_text(out: &mut alloc.string.String<std.alloc.System>, text: &str) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    for c in text.chars() {
        if c == '"' {
            out.push_str("\\\"")?
        } else if c == '\\' {
            out.push_str("\\\\")?
        } else if c == '\t' || c == '\n' || c == '\r' {
            out.push(' ')?
        } else {
            out.push(c)?
        }
    }
    Ok(())
end todo_spa.model.push_json_text

fn todo_spa.model.quote_end(s: &str) -> Option<usize> uses [] panics may
    let b = s.as_bytes()
    let mut i = 0usize
    while i < b.len() {
        if b[i] == 92u8 {
            i = i + 2usize
        } else if b[i] == 34u8 {
            return Some(i)
        } else {
            i = i + 1usize
        }
    }
    None
end todo_spa.model.quote_end

fn todo_spa.model.split_line(line: &str) -> Option<(&str, &str, &str)> uses [] panics never pub
    match line.split_once("\t") {
        None => None
        Some((id, rest)) => {
            todo_spa.model.split_rest(id, rest)
        }
    }
end todo_spa.model.split_line

fn todo_spa.model.split_rest['a](id: &'a str, rest: &'a str) -> Option<(&'a str, &'a str, &'a str)> uses [] panics never
    match rest.split_once("\t") {
        None => None
        Some((done, title)) => Some((id, done, title))
    }
end todo_spa.model.split_rest

fn todo_spa.model.unescape(raw: &str) -> Result<alloc.string.String<std.alloc.System>, alloc.alloc.AllocError> uses [alloc] panics never pub
    let mut out = alloc.string.String.new(std.alloc.SYSTEM)
    let mut esc = false
    for c in raw.chars() {
        if esc {
            esc = false
            if c == 'n' || c == 't' || c == 'r' {
                out.push(' ')?
            } else {
                out.push(c)?
            }
        } else if c == '\\' {
            esc = true
        } else {
            out.push(c)?
        }
    }
    Ok(out)
end todo_spa.model.unescape
