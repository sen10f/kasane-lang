const todo.model.MAX_TAG: usize = 64usize

const todo.model.MAX_TAGS: usize = 16usize

const todo.model.MAX_TITLE: usize = 2048usize

type todo.model.Session derive [Debug] pub
    token: alloc.string.String<std.alloc.System> pub
    user_id: i64 pub
    expires_at: i64 pub
end todo.model.Session

type todo.model.Todo derive [Debug, PartialEq, Eq] pub
    id: i64 pub
    title: alloc.string.String<std.alloc.System> pub
    done: bool pub
    created_at: alloc.string.String<std.alloc.System> pub
end todo.model.Todo

type todo.model.TodoExtra pub
    updated_at: alloc.string.String<std.alloc.System> pub
    tags: alloc.vec.Vec<alloc.string.String<std.alloc.System>, std.alloc.System> pub
    deadline: alloc.string.String<std.alloc.System> pub
    owner_id: i64 pub
end todo.model.TodoExtra

type todo.model.UpdateFields pub
    title: Option<alloc.string.String<std.alloc.System>> pub
    done: Option<bool> pub
    deadline: Option<alloc.string.String<std.alloc.System>> pub
    tags: alloc.vec.Vec<alloc.string.String<std.alloc.System>, std.alloc.System> pub
end todo.model.UpdateFields

type todo.model.User derive [Debug, PartialEq, Eq] pub
    id: i64 pub
    username: alloc.string.String<std.alloc.System> pub
    password_hash: alloc.string.String<std.alloc.System> pub
    salt: alloc.string.String<std.alloc.System> pub
    created_at: alloc.string.String<std.alloc.System> pub
end todo.model.User

fn todo.model.decode_array(doc: &std.json.Doc, at: usize) -> Result<alloc.vec.Vec<todo.model.Todo, std.alloc.System>, std.json.Error> uses [alloc] panics never pub
    let len = std.json.decode_len(std.json.Value { doc: doc, at: at })?
    let mut out = alloc.vec.Vec.new(std.alloc.SYSTEM)
    for i in core.iter.range(0usize, len) {
        let item = std.json.decode_item(std.json.Value { doc: doc, at: at }, i)?
        out.push(todo.model.from_json_value(item)?)?
    }
    Ok(out)
end todo.model.decode_array

fn todo.model.decode_extra_array(doc: &std.json.Doc, at: usize) -> Result<alloc.vec.Vec<todo.model.TodoExtra, std.alloc.System>, std.json.Error> uses [alloc] panics never pub
    let len = std.json.decode_len(std.json.Value { doc: doc, at: at })?
    let mut out = alloc.vec.Vec.new(std.alloc.SYSTEM)
    for i in core.iter.range(0usize, len) {
        let item = std.json.decode_item(std.json.Value { doc: doc, at: at }, i)?
        out.push(todo.model.from_extra_json_value(item)?)?
    }
    Ok(out)
end todo.model.decode_extra_array

fn todo.model.decode_session_array(doc: &std.json.Doc, at: usize) -> Result<alloc.vec.Vec<todo.model.Session, std.alloc.System>, std.json.Error> uses [alloc] panics never pub
    let len = std.json.decode_len(std.json.Value { doc: doc, at: at })?
    let mut out = alloc.vec.Vec.new(std.alloc.SYSTEM)
    for i in core.iter.range(0usize, len) {
        let item = std.json.decode_item(std.json.Value { doc: doc, at: at }, i)?
        out.push(todo.model.from_session_json_value(item)?)?
    }
    Ok(out)
end todo.model.decode_session_array

fn todo.model.decode_string_array(value: std.json.Value) -> Result<alloc.vec.Vec<alloc.string.String<std.alloc.System>, std.alloc.System>, std.json.Error> uses [alloc] panics never pub
    let len = std.json.decode_len(value)?
    let mut out = alloc.vec.Vec.new(std.alloc.SYSTEM)
    for i in core.iter.range(0usize, len) {
        let item = std.json.decode_item(value, i)?
        let text = std.json.decode_string(item)?
        if text.len() > todo.model.MAX_TAG {
            return Err(std.json.Error.OutOfRange)
        }
        out.push(text)?
    }
    Ok(out)
end todo.model.decode_string_array

fn todo.model.decode_user_array(doc: &std.json.Doc, at: usize) -> Result<alloc.vec.Vec<todo.model.User, std.alloc.System>, std.json.Error> uses [alloc] panics never pub
    let len = std.json.decode_len(std.json.Value { doc: doc, at: at })?
    let mut out = alloc.vec.Vec.new(std.alloc.SYSTEM)
    for i in core.iter.range(0usize, len) {
        let item = std.json.decode_item(std.json.Value { doc: doc, at: at }, i)?
        out.push(todo.model.from_user_json_value(item)?)?
    }
    Ok(out)
end todo.model.decode_user_array

fn todo.model.extra_to_json(extra: &todo.model.TodoExtra) -> Result<alloc.string.String<std.alloc.System>, alloc.alloc.AllocError> uses [alloc] panics never pub
    let mut out = alloc.string.String.new(std.alloc.SYSTEM)
    out.push_str("{\"updated_at\":")?
    todo.model.push_quoted(&mut out, extra.updated_at.as_str())?
    out.push_str(",\"tags\":")?
    todo.model.write_tags(&mut out, &extra.tags)?
    out.push_str(",\"deadline\":")?
    todo.model.write_deadline(&mut out, extra.deadline.as_str())?
    out.push_str(",\"owner_id\":")?
    out.push_i64(extra.owner_id)?
    out.push_str("}")?
    Ok(out)
end todo.model.extra_to_json

fn todo.model.from_create_value(value: std.json.Value) -> Result<(alloc.string.String<std.alloc.System>, alloc.string.String<std.alloc.System>), std.json.Error> uses [alloc, time] panics never pub
    let title_v = std.json.decode_field(value, "title", 0usize)?
    let title = std.json.decode_string(title_v)?
    if title.len() > todo.model.MAX_TITLE {
        return Err(std.json.Error.OutOfRange)
    }
    let now = std.datetime.DateTime.now()
    let created_at = now.to_rfc3339()?
    Ok((title, created_at))
end todo.model.from_create_value

fn todo.model.from_extra_json_value(value: std.json.Value) -> Result<todo.model.TodoExtra, std.json.Error> uses [alloc] panics never pub
    let updated_v = std.json.decode_field(value, "updated_at", 0usize)?
    let updated_at = std.json.decode_string(updated_v)?
    let tags_v = std.json.decode_field(value, "tags", 1usize)?
    let tags = todo.model.decode_string_array(tags_v)?
    let deadline_v = std.json.decode_field(value, "deadline", 2usize)?
    let deadline = match std.json.decode_string(deadline_v) {
        Ok(d) => d
        Err(_e) => match alloc.string.String.from_str(std.alloc.SYSTEM, "") {
            Ok(s) => s
            Err(_e2) => return Err(std.json.Error.OutOfRange)
        }
    }
    let owner_v = std.json.decode_field(value, "owner_id", 3usize)?
    let owner_id = std.json.decode_i64(owner_v)?
    let ua = updated_at
    let tg = tags
    let dl = deadline
    let od = owner_id
    Ok(todo.model.TodoExtra { updated_at: ua, tags: tg, deadline: dl, owner_id: od })
end todo.model.from_extra_json_value

fn todo.model.from_json_value(value: std.json.Value) -> Result<todo.model.Todo, std.json.Error> uses [alloc] panics never pub
    let id_v = std.json.decode_field(value, "id", 0usize)?
    let id = std.json.decode_i64(id_v)?
    let title_v = std.json.decode_field(value, "title", 1usize)?
    let title = std.json.decode_string(title_v)?
    if title.len() > todo.model.MAX_TITLE {
        return Err(std.json.Error.OutOfRange)
    }
    let done_v = std.json.decode_field(value, "done", 2usize)?
    let done = std.json.decode_bool(done_v)?
    let created_v = std.json.decode_field(value, "created_at", 3usize)?
    let created_at = std.json.decode_string(created_v)?
    let i = id
    let t = title
    let d = done
    let ca = created_at
    Ok(todo.model.Todo { id: i, title: t, done: d, created_at: ca })
end todo.model.from_json_value

fn todo.model.from_session_json_value(value: std.json.Value) -> Result<todo.model.Session, std.json.Error> uses [alloc] panics never pub
    let token_v = std.json.decode_field(value, "token", 0usize)?
    let token = std.json.decode_string(token_v)?
    let user_id_v = std.json.decode_field(value, "user_id", 1usize)?
    let user_id = std.json.decode_i64(user_id_v)?
    let expires_v = std.json.decode_field(value, "expires_at", 2usize)?
    let expires_at = std.json.decode_i64(expires_v)?
    let tk = token
    let uid = user_id
    let ea = expires_at
    Ok(todo.model.Session { token: tk, user_id: uid, expires_at: ea })
end todo.model.from_session_json_value

fn todo.model.from_update_value(value: std.json.Value) -> Result<todo.model.UpdateFields, std.json.Error> uses [alloc] panics never pub
    let title_v = std.json.decode_field(value, "title", 0usize)?
    let title = match std.json.decode_string(title_v) {
        Ok(t) => Some(t)
        Err(_e) => None
    }
    let done_v = std.json.decode_field(value, "done", 1usize)?
    let done = match std.json.decode_bool(done_v) {
        Ok(d) => Some(d)
        Err(_e) => None
    }
    let deadline_v = std.json.decode_field(value, "deadline", 2usize)?
    let deadline = match std.json.decode_string(deadline_v) {
        Ok(d) => Some(d)
        Err(_e) => None
    }
    let tags = match std.json.decode_field(value, "tags", 3usize) {
        Ok(tags_v) => todo.model.decode_string_array(tags_v)?
        Err(_e) => alloc.vec.Vec.new(std.alloc.SYSTEM)
    }
    Ok(todo.model.UpdateFields { title: title, done: done, deadline: deadline, tags: tags })
end todo.model.from_update_value

fn todo.model.from_user_json_value(value: std.json.Value) -> Result<todo.model.User, std.json.Error> uses [alloc] panics never pub
    let id_v = std.json.decode_field(value, "id", 0usize)?
    let id = std.json.decode_i64(id_v)?
    let username_v = std.json.decode_field(value, "username", 1usize)?
    let username = std.json.decode_string(username_v)?
    let hash_v = std.json.decode_field(value, "password_hash", 2usize)?
    let password_hash = std.json.decode_string(hash_v)?
    let salt_v = std.json.decode_field(value, "salt", 3usize)?
    let salt = std.json.decode_string(salt_v)?
    let created_v = std.json.decode_field(value, "created_at", 4usize)?
    let created_at = std.json.decode_string(created_v)?
    let i = id
    let un = username
    let ph = password_hash
    let sl = salt
    let ca = created_at
    Ok(todo.model.User { id: i, username: un, password_hash: ph, salt: sl, created_at: ca })
end todo.model.from_user_json_value

fn todo.model.push_digit_char(d: u8) -> char uses [] panics never
    let mut base = b'0'
    if d >= 10u8 {
        base = b'a'.wrapping_sub(10u8)
    }
    let q = '?'
    match char.try_from_u32(u32.from_u8(base.wrapping_add(d))) {
        Some(c) => c
        None => q
    }
end todo.model.push_digit_char

fn todo.model.push_quoted(out: &mut alloc.string.String<std.alloc.System>, text: &str) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    out.push_str("\"")?
    for c in text.chars() {
        if c == '"' {
            out.push_str("\\\"")?
        } else if c == '\\' {
            out.push_str("\\\\")?
        } else if c == '\n' {
            out.push_str("\\n")?
        } else if c == '\r' {
            out.push_str("\\r")?
        } else if c == '\t' {
            out.push_str("\\t")?
        } else if c.to_u32() < 32u32 {
            let high = c.to_u32().wrapping_shr(4u32)
            let low = c.to_u32() & 15u32
            out.push_str("\\u00")?
            match u8.try_from_u32(high) {
                Ok(d) => out.push(todo.model.push_digit_char(d))?
                Err(_e) => return Err(alloc.alloc.AllocError { code: 0u32 })
            }
            match u8.try_from_u32(low) {
                Ok(d) => out.push(todo.model.push_digit_char(d))?
                Err(_e) => return Err(alloc.alloc.AllocError { code: 0u32 })
            }
        } else {
            out.push(c)?
        }
    }
    out.push_str("\"")?
    Ok(())
end todo.model.push_quoted

fn todo.model.session_to_json(session: &todo.model.Session) -> Result<alloc.string.String<std.alloc.System>, alloc.alloc.AllocError> uses [alloc] panics never pub
    let mut out = alloc.string.String.new(std.alloc.SYSTEM)
    out.push_str("{\"token\":")?
    todo.model.push_quoted(&mut out, session.token.as_str())?
    out.push_str(",\"user_id\":")?
    out.push_i64(session.user_id)?
    out.push_str(",\"expires_at\":")?
    out.push_i64(session.expires_at)?
    out.push_str("}")?
    Ok(out)
end todo.model.session_to_json

fn todo.model.test_extra() -> todo.model.TodoExtra uses [alloc] panics may
    match alloc.string.String.from_str(std.alloc.SYSTEM, "2026-11-14T10:00:00Z") {
        Ok(u) => {
            let mut tags = alloc.vec.Vec.new(std.alloc.SYSTEM)
            match alloc.string.String.from_str(std.alloc.SYSTEM, "買い物") {
                Ok(tag) => match tags.push(tag) {
                    Ok(_u) => {
                    }
                    Err(_e) => core.panic.panic("test_extra")
                }
                Err(_e) => core.panic.panic("test_extra")
            }
            match alloc.string.String.from_str(std.alloc.SYSTEM, "2026-12-01T00:00:00Z") {
                Ok(d) => {
                    let dl = d
                    let o = 1i64
                    todo.model.TodoExtra { updated_at: u, tags: tags, deadline: dl, owner_id: o }
                }
                Err(_e) => core.panic.panic("test_extra")
            }
        }
        Err(_e) => core.panic.panic("test_extra")
    }
end todo.model.test_extra

fn todo.model.test_memory() -> todo.model.Todo uses [alloc] panics may
    let mut title = alloc.string.String.new(std.alloc.SYSTEM)
    core.mem.drop(title.push_str("買い物"))
    match alloc.string.String.from_str(std.alloc.SYSTEM, "2026-11-14T10:00:00Z") {
        Ok(created) => todo.model.Todo { id: 7i64, title: title, done: true, created_at: created }
        Err(_e) => core.panic.panic("test_memory")
    }
end todo.model.test_memory

fn todo.model.to_json(t: &todo.model.Todo) -> Result<alloc.string.String<std.alloc.System>, alloc.alloc.AllocError> uses [alloc] panics never pub
    let mut out = alloc.string.String.new(std.alloc.SYSTEM)
    out.push_str("{\"id\":")?
    out.push_i64(t.id)?
    out.push_str(",\"title\":")?
    todo.model.push_quoted(&mut out, t.title.as_str())?
    out.push_str(",\"done\":")?
    if t.done {
        out.push_str("true")?
    } else {
        out.push_str("false")?
    }
    out.push_str(",\"created_at\":")?
    todo.model.push_quoted(&mut out, t.created_at.as_str())?
    out.push_str("}")?
    Ok(out)
end todo.model.to_json

fn todo.model.user_to_json(user: &todo.model.User) -> Result<alloc.string.String<std.alloc.System>, alloc.alloc.AllocError> uses [alloc] panics never pub
    let mut out = alloc.string.String.new(std.alloc.SYSTEM)
    out.push_str("{\"id\":")?
    out.push_i64(user.id)?
    out.push_str(",\"username\":")?
    todo.model.push_quoted(&mut out, user.username.as_str())?
    out.push_str(",\"password_hash\":")?
    todo.model.push_quoted(&mut out, user.password_hash.as_str())?
    out.push_str(",\"salt\":")?
    todo.model.push_quoted(&mut out, user.salt.as_str())?
    out.push_str(",\"created_at\":")?
    todo.model.push_quoted(&mut out, user.created_at.as_str())?
    out.push_str("}")?
    Ok(out)
end todo.model.user_to_json

fn todo.model.write_deadline(out: &mut alloc.string.String<std.alloc.System>, deadline: &str) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    if deadline.is_empty() {
        out.push_str("null")?
    } else {
        out.push_str("\"")?
        out.push_str(deadline)?
        out.push_str("\"")?
    }
    Ok(())
end todo.model.write_deadline

fn todo.model.write_tags(out: &mut alloc.string.String<std.alloc.System>, tags: &alloc.vec.Vec<alloc.string.String<std.alloc.System>, std.alloc.System>) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    let all = tags.as_slice()
    out.push('[')?
    for i in core.iter.range(0usize, all.len()) {
        if i > 0usize {
            out.push(',')?
        }
        match all.get(i) {
            Some(t) => {
                todo.model.push_quoted(out, t.as_str())?
            }
            None => return Err(alloc.alloc.AllocError { code: 0u32 })
        }
    }
    out.push(']')?
    Ok(())
end todo.model.write_tags

test todo.model.extra_to_json.test_shape
    let e = todo.model.test_extra()
    match todo.model.extra_to_json(&e) {
        Ok(s) => {
            let want = "{\"updated_at\":\"2026-11-14T10:00:00Z\",\"tags\":[\"買い物\"],\"deadline\":\"2026-12-01T00:00:00Z\",\"owner_id\":1}"
            core.check.eq(s.as_str(), want)
        }
        Err(_e) => core.panic.panic("extra_to_json")
    }
end todo.model.extra_to_json.test_shape

test todo.model.to_json.test_shape
    let t = todo.model.test_memory()
    match todo.model.to_json(&t) {
        Ok(s) => {
            let want = "{\"id\":7,\"title\":\"買い物\",\"done\":true,\"created_at\":\"2026-11-14T10:00:00Z\"}"
            core.check.eq(s.as_str(), want)
        }
        Err(_e) => core.panic.panic("to_json")
    }
end todo.model.to_json.test_shape
