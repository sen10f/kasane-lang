fn alloc.string.String.clear[A: alloc.alloc.Allocator](self: &mut alloc.string.String<A>) -> () uses [] panics never pub
    self.buf.clear()
end alloc.string.String.clear

fn alloc.string.String.is_empty[A: alloc.alloc.Allocator](self: &alloc.string.String<A>) -> bool uses [] panics never pub
    self.buf.is_empty()
end alloc.string.String.is_empty

fn alloc.string.String.len[A: alloc.alloc.Allocator](self: &alloc.string.String<A>) -> usize uses [] panics never pub
    self.buf.len()
end alloc.string.String.len

fn alloc.string.String.push[A: alloc.alloc.Allocator](self: &mut alloc.string.String<A>, c: char) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    let code = c.to_u32()
    let mut n = 1usize
    if code >= 128u32 {
        n = 2usize
    }
    if code >= 2048u32 {
        n = 3usize
    }
    if code >= 65536u32 {
        n = 4usize
    }
    match self.reserve_bytes(n) {
        Ok(_done) => {
        }
        Err(error) => {
            return Err(error)
        }
    }
    // 先頭のバイトは長さの印 (0xC0 / 0xE0 / 0xF0) と上の桁、続きは 0x80 と下の 6 ビット (シフトで取り出す。除算は使えない)。
    let mut lead = 0u32
    if n == 2usize {
        lead = 192u32
    }
    if n == 3usize {
        lead = 224u32
    }
    if n == 4usize {
        lead = 240u32
    }
    let mut shift = 0u32
    let mut k = 1usize
    while k < n {
        shift = shift.wrapping_add(6u32)
        k = k.wrapping_add(1usize)
    }
    let mut i = 0usize
    while i < n {
        let q = code.wrapping_shr(shift)
        let value = if i == 0usize {
            lead.wrapping_add(q)
        } else {
            128u32.wrapping_add(q.wrapping_shl(26u32).wrapping_shr(26u32))
        }
        match u8.try_from_u32(value) {
            Ok(byte) => {
                match self.buf.push_within_cap(byte) {
                    Ok(_done) => {
                    }
                    Err(_lost) => {
                        return Err(alloc.alloc.AllocError { code: 1u32 })
                    }
                }
            }
            Err(_error) => {
                return Err(alloc.alloc.AllocError { code: 2u32 })
            }
        }
        shift = shift.wrapping_sub(6u32)
        i = i.wrapping_add(1usize)
    }
    Ok(())
end alloc.string.String.push

fn alloc.string.String.push_bytes[A: alloc.alloc.Allocator](self: &mut alloc.string.String<A>, bytes: &[u8]) -> Result<(), alloc.string.PushBytesError> uses [alloc] panics never pub
    match core.str.from_utf8(bytes) {
        Ok(text) => {
            match self.push_str(text) {
                Ok(_done) => {
                    Ok(())
                }
                Err(error) => {
                    Err(alloc.string.PushBytesError.Alloc(error))
                }
            }
        }
        Err(error) => {
            Err(alloc.string.PushBytesError.InvalidUtf8(error))
        }
    }
end alloc.string.String.push_bytes

fn alloc.string.String.push_i64[A: alloc.alloc.Allocator](self: &mut alloc.string.String<A>, value: i64) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    match self.reserve_bytes(21usize) {
        Ok(_done) => {
        }
        Err(error) => {
            return Err(error)
        }
    }
    let neg = value < 0i64
    if neg {
        match self.buf.push_within_cap(45u8) {
            Ok(_done) => {
            }
            Err(_lost) => {
                return Err(alloc.alloc.AllocError { code: 1u32 })
            }
        }
    }
    let start = self.buf.len()
    // 負の数は桁ごとに負の余りを取り、符号を反転して数える (`i64::MIN` も溢れない)。
    let mut v = value
    loop {
        let rest = match v.checked_div(10i64) {
            Some(q) => q
            None => return Err(alloc.alloc.AllocError { code: 2u32 })
        }
        let r = match v.checked_rem(10i64) {
            Some(d) => d
            None => return Err(alloc.alloc.AllocError { code: 2u32 })
        }
        let zero = 0i64
        let digit = if neg {
            zero.wrapping_sub(r)
        } else {
            r
        }
        match u8.try_from_i64(digit) {
            Ok(d8) => {
                match self.buf.insert_within_cap(start, d8.wrapping_add(48u8)) {
                    Ok(_done) => {
                    }
                    Err(_lost) => {
                        return Err(alloc.alloc.AllocError { code: 1u32 })
                    }
                }
            }
            Err(_error) => {
                return Err(alloc.alloc.AllocError { code: 2u32 })
            }
        }
        v = rest
        if v == 0i64 {
            break
        }
    }
    Ok(())
end alloc.string.String.push_i64

fn alloc.string.String.push_str[A: alloc.alloc.Allocator](self: &mut alloc.string.String<A>, text: &str) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    match self.buf.append_str_within_cap(text) {
        Ok(_done) => {
            return Ok(())
        }
        Err(_full) => {
        }
    }
    match self.reserve_bytes(text.len()) {
        Ok(_done) => {
        }
        Err(error) => {
            return Err(error)
        }
    }
    match self.buf.append_str_within_cap(text) {
        Ok(_done) => {
            Ok(())
        }
        Err(_lost) => {
            Err(alloc.alloc.AllocError { code: 1u32 })
        }
    }
end alloc.string.String.push_str

fn alloc.string.String.push_u64[A: alloc.alloc.Allocator](self: &mut alloc.string.String<A>, value: u64) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    match self.reserve_bytes(20usize) {
        Ok(_done) => {
        }
        Err(error) => {
            return Err(error)
        }
    }
    let start = self.buf.len()
    let mut v = value
    loop {
        let rest = match v.checked_div(10u64) {
            Some(q) => q
            None => return Err(alloc.alloc.AllocError { code: 2u32 })
        }
        let digit = match v.checked_rem(10u64) {
            Some(d) => d
            None => return Err(alloc.alloc.AllocError { code: 2u32 })
        }
        match u8.try_from_u64(digit) {
            Ok(d8) => {
                match self.buf.insert_within_cap(start, d8.wrapping_add(48u8)) {
                    Ok(_done) => {
                    }
                    Err(_lost) => {
                        return Err(alloc.alloc.AllocError { code: 1u32 })
                    }
                }
            }
            Err(_error) => {
                return Err(alloc.alloc.AllocError { code: 2u32 })
            }
        }
        v = rest
        if v == 0u64 {
            break
        }
    }
    Ok(())
end alloc.string.String.push_u64

// 残り `extra` バイトを書ける余裕を確保する (足りなければ `Buf` を `2 * cap + 4` か必要量のどちらか大きい方へ広げる)。
fn alloc.string.String.reserve_bytes[A: alloc.alloc.Allocator](self: &mut alloc.string.String<A>, extra: usize) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never
    let want = self.buf.len().wrapping_add(extra)
    let cap = self.buf.cap()
    if want > cap {
        let doubled = cap.wrapping_mul(2usize).wrapping_add(4usize)
        let target = if want > doubled {
            want
        } else {
            doubled
        }
        match self.buf.grow(target) {
            Ok(_grown) => {
            }
            Err(error) => {
                return Err(error)
            }
        }
    }
    Ok(())
end alloc.string.String.reserve_bytes
