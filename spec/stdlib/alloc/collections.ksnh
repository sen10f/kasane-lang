        Some(p) => match self.cells.get_mut(p) {
            Some(cell) => {
                let fresh = alloc.collections.HashCell.Entry(h, key, value)
                let old = core.mem.replace(cell, fresh)
                match old {
                    alloc.collections.HashCell.Entry(_, _, ov) => Ok(Some(ov))
                    alloc.collections.HashCell.Empty => Ok(None)
                    alloc.collections.HashCell.Index(_, _) => Ok(None)
                }
            }
            None => Err(alloc.alloc.AllocError {
                code: 1u32
            })
        }
        None => {
            let used = self.cells.len().wrapping_sub(self.base())
            if used >= 4_294_967_294usize {
                return Err(alloc.alloc.AllocError {
                    code: 1u32
                })
            }
            if used.wrapping_add(1usize).wrapping_mul(2usize) > self.slots {
                if self.dead > 0usize {
                    self.compact()
                }
                let n = self.len()
                if n.wrapping_add(1usize).wrapping_mul(2usize) > self.slots {
                    let want = if self.slots > 4usize {
                        self.slots.wrapping_mul(2usize)
                    } else {
                        8usize
                    }
                    match self.rebuild(want) {
                        Ok(_done) => {
                        }
                        Err(error) => return Err(error)
                    }
                } else {
                    self.reindex()
                }
            }
            let fresh = alloc.collections.HashCell.Entry(h, key, value)
            match self.cells.push_within_cap(fresh) {
                Ok(_done) => {
                }
                Err(back) => {
                    let want = self.cells.cap().wrapping_mul(2usize).wrapping_add(4usize)
                    match self.cells.grow(want) {
                        Ok(_grown) => {
                        }
                        Err(error) => return Err(error)
                    }
                    match self.cells.push_within_cap(back) {
                        Ok(_done) => {
                        }
                        Err(_) => return Err(alloc.alloc.AllocError {
                            code: 1u32
                        })
                    }
                }
            }
            let pos = self.cells.len().wrapping_sub(1usize)
            self.place(h, pos)
            Ok(None)
        }
    }
end alloc.collections.HashMap.insert

fn alloc.collections.HashMap.is_empty[K: core.cmp.Eq + core.hash.Hash, V, A: alloc.alloc.Allocator](self: &alloc.collections.HashMap<K, V, A>) -> bool uses [] panics never pub
    self.len() == 0usize
end alloc.collections.HashMap.is_empty

fn alloc.collections.HashMap.iter['a, K: core.cmp.Eq + core.hash.Hash, V, A: alloc.alloc.Allocator](self: &'a alloc.collections.HashMap<K, V, A>) -> alloc.collections.HashMapIter<'a, K, V> uses [] panics never pub
    alloc.collections.HashMapIter {
        cells: self.cells.as_slice()
        position: self.base()
    }
end alloc.collections.HashMap.iter

fn alloc.collections.HashMap.lane_get[K: core.cmp.Eq + core.hash.Hash, V, A: alloc.alloc.Allocator](self: &alloc.collections.HashMap<K, V, A>, i: usize) -> usize uses [] panics never
    if let Some(cell) = self.cells.get(i.wrapping_shr(2u32)) {
        if let alloc.collections.HashCell.Index(a, b) = cell {
            let word = if i & 3usize < 2usize {
                *a
            } else {
                *b
            }
            let lane = if i & 1usize == 1usize {
                word.wrapping_shr(32u32)
            } else {
                word
            }
            match u32.try_from_u64(lane & 4_294_967_295u64) {
                Ok(low) => return usize.from_u32(low)
                Err(_) => return 0usize
            }
        }
    }
    0usize
end alloc.collections.HashMap.lane_get

fn alloc.collections.HashMap.lane_set[K: core.cmp.Eq + core.hash.Hash, V, A: alloc.alloc.Allocator](self: &mut alloc.collections.HashMap<K, V, A>, i: usize, v: usize) -> () uses [] panics never
    if let Some(cell) = self.cells.get_mut(i.wrapping_shr(2u32)) {
        match cell {
            alloc.collections.HashCell.Index(a, b) => {
                let odd = i & 1usize == 1usize
                let keep = if odd {
                    4_294_967_295u64
                } else {
                    18_446_744_069_414_584_320u64
                }
                let narrow = match u32.try_from_usize(v) {
                    Ok(low) => low
                    Err(_) => 0u32
                }
                let wide = u64.from_u32(narrow)
                let put = if odd {
                    wide.wrapping_shl(32u32)
                } else {
                    wide
                }
                if i & 3usize < 2usize {
                    *a = *a & keep | put
                } else {
                    *b = *b & keep | put
                }
            }
            alloc.collections.HashCell.Empty => {
            }
            alloc.collections.HashCell.Entry(_, _, _) => {
            }
        }
    }
end alloc.collections.HashMap.lane_set

fn alloc.collections.HashMap.len[K: core.cmp.Eq + core.hash.Hash, V, A: alloc.alloc.Allocator](self: &alloc.collections.HashMap<K, V, A>) -> usize uses [] panics never pub
    self.cells.len().wrapping_sub(self.base()).wrapping_sub(self.dead)
end alloc.collections.HashMap.len

fn alloc.collections.HashMap.new_empty[K: core.cmp.Eq + core.hash.Hash, V, A: alloc.alloc.Allocator](allocator: A) -> alloc.collections.HashMap<K, V, A> uses [] panics never
    let cells = alloc.raw.Buf.new(allocator)
    alloc.collections.HashMap {
        cells: cells
        slots: 0usize
        dead: 0usize
    }
end alloc.collections.HashMap.new_empty

fn alloc.collections.HashMap.place[K: core.cmp.Eq + core.hash.Hash, V, A: alloc.alloc.Allocator](self: &mut alloc.collections.HashMap<K, V, A>, h: usize, pos: usize) -> () uses [] panics never
    let slots = self.slots
    if slots == 0usize {
        return
    }
    let mask = slots.wrapping_sub(1usize)
    let v = h & (4_294_967_295usize ^ mask) | pos.wrapping_sub(self.base()).wrapping_add(1usize)
    let mut i = h & mask
    for _ in core.iter.range(0usize, slots) {
        if self.lane_get(i) == 0usize {
            self.lane_set(i, v)
            return
        }
        i = i.wrapping_add(1usize) & mask
    }
end alloc.collections.HashMap.place

fn alloc.collections.HashMap.rebuild[K: core.cmp.Eq + core.hash.Hash, V, A: alloc.alloc.Allocator](self: &mut alloc.collections.HashMap<K, V, A>, slots: usize) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never
    let old = self.base()
    let n = self.cells.len().wrapping_sub(old)
    let total = slots.wrapping_shr(2u32).wrapping_add(n)
    if total > self.cells.cap() {
        match self.cells.grow(total.wrapping_mul(2usize)) {
            Ok(_grown) => {
            }
            Err(error) => return Err(error)
        }
    }
    while self.cells.len() < total {
        match self.cells.push_within_cap(alloc.collections.HashCell.Empty) {
            Ok(_done) => {
            }
            Err(_) => return Err(alloc.alloc.AllocError {
                code: 1u32
            })
        }
    }
    // 古い添字の区間と増やした空きの区間を入れ替えて、組の列を slots の後ろへ送る (挿入順は保つ)。
    let mid = old.wrapping_add(n)
    self.reverse_range(old, mid)
    self.reverse_range(mid, total)
    self.reverse_range(old, total)
    self.slots = slots
    self.reindex()
    Ok(())
end alloc.collections.HashMap.rebuild

fn alloc.collections.HashMap.reindex[K: core.cmp.Eq + core.hash.Hash, V, A: alloc.alloc.Allocator](self: &mut alloc.collections.HashMap<K, V, A>) -> () uses [] panics never
    let base = self.base()
    let total = self.cells.len()
    for i in core.iter.range(0usize, base) {
        if let Some(slot) = self.cells.get_mut(i) {
            *slot = alloc.collections.HashCell.Index(0u64, 0u64)
        }
    }
    for p in core.iter.range(base, total) {
        let live = match self.cells.get(p) {
            Some(cell) => match cell {
                alloc.collections.HashCell.Entry(_, _, _) => true
                alloc.collections.HashCell.Empty => false
                alloc.collections.HashCell.Index(_, _) => false
            }
            None => false
        }
        if live {
            let h = self.hash_at(p)
            self.place(h, p)
        }
    }
end alloc.collections.HashMap.reindex

fn alloc.collections.HashMap.remove[K: core.cmp.Eq + core.hash.Hash, V, A: alloc.alloc.Allocator](self: &mut alloc.collections.HashMap<K, V, A>, key: &K) -> Option<V> uses [] panics never pub
    match self.find(key) {
        Some(p) => match self.cells.get_mut(p) {
            Some(cell) => {
                let old = core.mem.replace(cell, alloc.collections.HashCell.Empty)
                match old {
                    alloc.collections.HashCell.Entry(_, _, v) => {
                        self.dead = self.dead.wrapping_add(1usize)
                        Some(v)
                    }
                    alloc.collections.HashCell.Empty => None
                    alloc.collections.HashCell.Index(_, _) => None
                }
            }
            None => None
        }
        None => None
    }
end alloc.collections.HashMap.remove

fn alloc.collections.HashMap.remove_str[V, A: alloc.alloc.Allocator, B: alloc.alloc.Allocator](self: &mut alloc.collections.HashMap<alloc.string.String<B>, V, A>, key: &str) -> Option<V> uses [] panics never pub
    match self.find_str(key) {
        Some(p) => match self.cells.get_mut(p) {
            Some(cell) => {
                let old = core.mem.replace(cell, alloc.collections.HashCell.Empty)
                match old {
                    alloc.collections.HashCell.Entry(_, _, v) => {
                        self.dead = self.dead.wrapping_add(1usize)
                        Some(v)
                    }
                    alloc.collections.HashCell.Empty => None
                    alloc.collections.HashCell.Index(_, _) => None
                }
            }
            None => None
        }
        None => None
    }
end alloc.collections.HashMap.remove_str

fn alloc.collections.HashMap.reverse_range[K: core.cmp.Eq + core.hash.Hash, V, A: alloc.alloc.Allocator](self: &mut alloc.collections.HashMap<K, V, A>, lo: usize, hi: usize) -> () uses [] panics never
    let mut a = lo
    let mut b = hi
    while a < b {
        b = b.wrapping_sub(1usize)
        if a < b {
            match self.cells.as_mut_slice().swap(a, b) {
                Ok(_done) => {
                }
                Err(_) => return
            }
        }
        a = a.wrapping_add(1usize)
    }
end alloc.collections.HashMap.reverse_range

impl['a, K, V] core.iter.Iterator<(&'a K, &'a V), [], never> for alloc.collections.HashMapIter<'a, K, V>
fn alloc.collections.HashMapIter.next[K, V](self: &mut alloc.collections.HashMapIter<'a, K, V>) -> Option<(&'a K, &'a V)> uses [] panics never impls core.iter.Iterator<(&'a K, &'a V), [], never>
    loop {
        if self.position >= self.cells.len() {
            return None
        }
        let p = self.position
        self.position = p.wrapping_add(1usize)
        let cells = self.cells
        match cells.get(p) {
            Some(cell) => match cell {
                alloc.collections.HashCell.Entry(_h, k, v) => {
                    let kr = k
                    let vr = v
                    return Some((kr, vr))
                }
                alloc.collections.HashCell.Empty => {
                }
                alloc.collections.HashCell.Index(_q, _qh) => {
                }
            }
            None => return None
        }
    }
end alloc.collections.HashMapIter.next

fn alloc.collections.HashSet.contains[T: core.cmp.Eq + core.hash.Hash, A: alloc.alloc.Allocator](self: &alloc.collections.HashSet<T, A>, value: &T) -> bool uses [] panics never pub
    let m = &self.map
    m.contains_key(value)
end alloc.collections.HashSet.contains

fn alloc.collections.HashSet.contains_str[A: alloc.alloc.Allocator, B: alloc.alloc.Allocator](self: &alloc.collections.HashSet<alloc.string.String<B>, A>, value: &str) -> bool uses [] panics never pub
    let m = &self.map
    m.contains_key_str(value)
end alloc.collections.HashSet.contains_str

fn alloc.collections.HashSet.insert[T: core.cmp.Eq + core.hash.Hash, A: alloc.alloc.Allocator](self: &mut alloc.collections.HashSet<T, A>, value: T) -> Result<bool, alloc.alloc.AllocError> uses [alloc] panics never pub
    match self.map.insert(value, true) {
        Ok(old) => match old {
            Some(_) => Ok(false)
            None => {
                self.count = self.count.wrapping_add(1usize)
                Ok(true)
            }
        }
        Err(error) => Err(error)
    }
end alloc.collections.HashSet.insert

fn alloc.collections.HashSet.is_empty[T: core.cmp.Eq + core.hash.Hash, A: alloc.alloc.Allocator](self: &alloc.collections.HashSet<T, A>) -> bool uses [] panics never pub
    self.count == 0usize
end alloc.collections.HashSet.is_empty

fn alloc.collections.HashSet.iter['a, T: core.cmp.Eq + core.hash.Hash, A: alloc.alloc.Allocator](self: &'a alloc.collections.HashSet<T, A>) -> alloc.collections.HashSetIter<'a, T> uses [] panics never pub
    alloc.collections.HashSetIter {
        inner: self.map.iter()
    }
end alloc.collections.HashSet.iter

fn alloc.collections.HashSet.len[T: core.cmp.Eq + core.hash.Hash, A: alloc.alloc.Allocator](self: &alloc.collections.HashSet<T, A>) -> usize uses [] panics never pub
    self.count
end alloc.collections.HashSet.len

fn alloc.collections.HashSet.new[T: core.cmp.Eq + core.hash.Hash, A: alloc.alloc.Allocator](allocator: A) -> alloc.collections.HashSet<T, A> uses [] panics never pub
    alloc.collections.HashSet {
        map: alloc.collections.HashMap.new(allocator)
        count: 0usize
    }
end alloc.collections.HashSet.new

fn alloc.collections.HashSet.remove[T: core.cmp.Eq + core.hash.Hash, A: alloc.alloc.Allocator](self: &mut alloc.collections.HashSet<T, A>, value: &T) -> bool uses [] panics never pub
    match self.map.remove(value) {
        Some(_b) => {
            self.count = self.count.wrapping_sub(1usize)
            true
        }
        None => false
    }
end alloc.collections.HashSet.remove

fn alloc.collections.HashSet.remove_str[A: alloc.alloc.Allocator, B: alloc.alloc.Allocator](self: &mut alloc.collections.HashSet<alloc.string.String<B>, A>, value: &str) -> bool uses [] panics never pub
    match self.map.remove_str(value) {
        Some(_b) => {
            self.count = self.count.wrapping_sub(1usize)
            true
        }
        None => false
    }
end alloc.collections.HashSet.remove_str

impl['a, T] core.iter.Iterator<&'a T, [], never> for alloc.collections.HashSetIter<'a, T>
fn alloc.collections.HashSetIter.next[T](self: &mut alloc.collections.HashSetIter<'a, T>) -> Option<&'a T> uses [] panics never impls core.iter.Iterator<&'a T, [], never>
    match self.inner.next() {
        Some((k, _)) => Some(k)
        None => None
    }
end alloc.collections.HashSetIter.next

fn alloc.collections.hash_key[K: core.hash.Hash](key: &K) -> usize uses [] panics never
    let mut state = core.hash.Fnv64.new()
    key.hash(&mut state)
    // 索引には下位 32 ビットを使う (どの型幅のターゲットでも `usize` に収まる)。
    match u32.try_from_u64(state.finish() & 4_294_967_295u64) {
        Ok(lo) => usize.from_u32(lo)
        Err(_) => 0usize
    }
end alloc.collections.hash_key

fn alloc.collections.hash_str(key: &str) -> usize uses [] panics never
    let mut state = core.hash.Fnv64.new()
    key.hash(&mut state)
    match u32.try_from_u64(state.finish() & 4_294_967_295u64) {
        Ok(lo) => usize.from_u32(lo)
        Err(_) => 0usize
    }
end alloc.collections.hash_str
