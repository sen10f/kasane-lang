fn alloc.collections.BtreeMap.remove[K: core.cmp.Ord, V, A: alloc.alloc.Allocator](self: &mut alloc.collections.BtreeMap<K, V, A>, key: &K) -> Option<V> uses [] panics never pub
    let nil = core.num.usize.MAX
    let i = self.find(key)
    if i == nil {
        return None
    }
    loop {
        let l = self.edge(i, 0u32)
        let r = self.edge(i, 1u32)
        if l == nil && r == nil {
            break
        }
        let mut c = l
        if l == nil {
            c = r
        } else if r != nil && self.prio(r) > self.prio(l) {
            c = r
        }
        self.rotate_up(c)
    }
    let p = self.edge(i, 2u32)
    if p == nil {
        self.root = nil
    } else if self.edge(p, 0u32) == i {
        self.set_link(p, 0u32, nil)
    } else {
        self.set_link(p, 1u32, nil)
    }
    let before = self.edge(i, 3u32)
    let after = self.edge(i, 4u32)
    if before == nil {
        self.head = after
    } else {
        self.set_link(before, 4u32, after)
    }
    if after == nil {
        self.tail = before
    } else {
        self.set_link(after, 3u32, before)
    }
    let last = self.nodes.len().wrapping_sub(1usize)
    let taken = self.nodes.swap_remove(i)
    if i != last {
        let l = self.edge(i, 0u32)
        let r = self.edge(i, 1u32)
        let q = self.edge(i, 2u32)
        let b = self.edge(i, 3u32)
        let a = self.edge(i, 4u32)
        self.set_link(l, 2u32, i)
        self.set_link(r, 2u32, i)
        if q == nil {
            self.root = i
        } else if self.edge(q, 0u32) == last {
            self.set_link(q, 0u32, i)
        } else {
            self.set_link(q, 1u32, i)
        }
        if b == nil {
            self.head = i
        } else {
            self.set_link(b, 4u32, i)
        }
        if a == nil {
            self.tail = i
        } else {
            self.set_link(a, 3u32, i)
        }
    }
    match taken {
        Some(node) => Some(node.entry.value)
        None => None
    }
