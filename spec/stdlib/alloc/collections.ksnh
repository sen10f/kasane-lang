fn alloc.collections.BtreeMap.insert[K: core.cmp.Ord, V, A: alloc.alloc.Allocator](self: &mut alloc.collections.BtreeMap<K, V, A>, key: K, value: V) -> Result<Option<V>, alloc.alloc.AllocError> uses [alloc] panics never pub
    let nil = core.num.usize.MAX
    let mut cur = self.root
    let mut par = nil
    let mut went_left = false
    while cur != nil {
        let mut ord = core.cmp.Ordering.Equal
        match self.nodes.get(cur) {
            Some(node) => {
                ord = node.entry.key.cmp(&key)
            }
            None => return Err(alloc.alloc.AllocError {
                code: 1u32
            })
        }
        match ord {
            core.cmp.Ordering.Less => {
                par = cur
                went_left = false
                cur = self.edge(cur, 1u32)
            }
            core.cmp.Ordering.Equal => match self.nodes.get_mut(cur) {
                Some(node) => {
                    node.entry.key = key
                    let old = core.mem.replace(&mut node.entry.value, value)
                    return Ok(Some(old))
                }
                None => return Err(alloc.alloc.AllocError {
                    code: 1u32
                })
            }
            core.cmp.Ordering.Greater => {
                par = cur
                went_left = true
                cur = self.edge(cur, 0u32)
            }
        }
    }
    let fresh_index = self.nodes.len()
    let mut before = nil
    let mut after = nil
    if par != nil {
        if went_left {
            after = par
            before = self.edge(par, 3u32)
        } else {
            before = par
            after = self.edge(par, 4u32)
        }
    }
    let mut state = self.seed
    state = state ^ state.wrapping_shl(13u32)
    state = state ^ state.wrapping_shr(7u32)
    state = state ^ state.wrapping_shl(17u32)
    self.seed = state
    let fresh = alloc.collections.BtreeNode {
        entry: alloc.collections.MapEntry {
            key: key
            value: value
        }
        left: nil
        right: nil
        parent: par
        prev: before
        next: after
        prio: state.wrapping_mul(11_400_714_819_323_198_485u64)
    }
    match self.nodes.push_within_cap(fresh) {
        Ok(_) => {
        }
        Err(back) => {
            let want = self.nodes.cap().wrapping_mul(2usize).wrapping_add(4usize)
            match self.nodes.grow(want) {
                Ok(_grown) => {
                }
                Err(error) => return Err(error)
            }
            match self.nodes.push_within_cap(back) {
                Ok(_) => {
                }
                Err(_) => return Err(alloc.alloc.AllocError {
                    code: 1u32
                })
            }
        }
    }
    if par == nil {
        self.root = fresh_index
    } else if went_left {
        self.set_link(par, 0u32, fresh_index)
    } else {
        self.set_link(par, 1u32, fresh_index)
    }
    if before == nil {
        self.head = fresh_index
    } else {
        self.set_link(before, 4u32, fresh_index)
    }
    if after == nil {
        self.tail = fresh_index
    } else {
        self.set_link(after, 3u32, fresh_index)
    }
    while par != nil && self.prio(fresh_index) > self.prio(par) {
        self.rotate_up(fresh_index)
        par = self.edge(fresh_index, 2u32)
    }
    Ok(None)
end alloc.collections.BtreeMap.insert

