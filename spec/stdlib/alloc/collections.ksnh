fn alloc.collections.BtreeMap.rotate_up[K: core.cmp.Ord, V, A: alloc.alloc.Allocator](self: &mut alloc.collections.BtreeMap<K, V, A>, x: usize) -> () uses [] panics never
    let p = self.edge(x, 2u32)
    let g = self.edge(p, 2u32)
    if self.edge(p, 0u32) == x {
        let b = self.edge(x, 1u32)
        self.set_link(p, 0u32, b)
        self.set_link(b, 2u32, p)
        self.set_link(x, 1u32, p)
    } else {
        let b = self.edge(x, 0u32)
        self.set_link(p, 1u32, b)
        self.set_link(b, 2u32, p)
        self.set_link(x, 0u32, p)
    }
    self.set_link(p, 2u32, x)
    self.set_link(x, 2u32, g)
    if g == core.num.usize.MAX {
        self.root = x
    } else if self.edge(g, 0u32) == p {
        self.set_link(g, 0u32, x)
    } else {
        self.set_link(g, 1u32, x)
    }
end alloc.collections.BtreeMap.rotate_up

fn alloc.collections.BtreeMap.set_link[K: core.cmp.Ord, V, A: alloc.alloc.Allocator](self: &mut alloc.collections.BtreeMap<K, V, A>, i: usize, which: u32, v: usize) -> () uses [] panics never
