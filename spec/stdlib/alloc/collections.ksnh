fn alloc.collections.BtreeMap.find[K: core.cmp.Ord, V, A: alloc.alloc.Allocator](self: &alloc.collections.BtreeMap<K, V, A>, key: &K) -> usize uses [] panics never
    let nil = core.num.usize.MAX
    let mut cur = self.root
    while cur != nil {
        let mut ord = core.cmp.Ordering.Equal
        match self.nodes.get(cur) {
            Some(node) => {
                ord = node.entry.key.cmp(key)
            }
            None => return nil
        }
        match ord {
            core.cmp.Ordering.Less => {
                cur = self.edge(cur, 1u32)
            }
            core.cmp.Ordering.Equal => return cur
            core.cmp.Ordering.Greater => {
                cur = self.edge(cur, 0u32)
            }
        }
    }
    nil
end alloc.collections.BtreeMap.find

