fn alloc.collections.HashMap.rebuild[K: core.cmp.Eq + core.hash.Hash, V, A: alloc.alloc.Allocator](self: &mut alloc.collections.HashMap<K, V, A>, slots: usize) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never
    let old = self.slots
    let n = self.cells.len().wrapping_sub(old)
    let total = slots.wrapping_add(n)
    if total > self.cells.cap() {
        match self.cells.grow(total.wrapping_mul(2usize)) {
            Ok(_grown) => {
            }
            Err(error) => return Err(error)
        }
    }
    while self.cells.len() < total {
        match self.cells.push_within_cap(alloc.collections.HashCell.Empty) {
            Ok(_done) => {
            }
            Err(_) => return Err(alloc.alloc.AllocError {
                code: 1u32
            })
        }
    }
    let mid = old.wrapping_add(n)
    self.reverse_range(old, mid)
    self.reverse_range(mid, total)
    self.reverse_range(old, total)
    self.slots = slots
    self.reindex()
    Ok(())
end alloc.collections.HashMap.rebuild

fn alloc.collections.HashMap.reindex[K: core.cmp.Eq + core.hash.Hash, V, A: alloc.alloc.Allocator](self: &mut alloc.collections.HashMap<K, V, A>) -> () uses [] panics never
    let slots = self.slots
    let total = self.cells.len()
    for i in core.iter.range(0usize, slots) {
        if let Some(slot) = self.cells.get_mut(i) {
            *slot = alloc.collections.HashCell.Empty
        }
    }
    for p in core.iter.range(slots, total) {
        let h = self.hash_at(p)
        self.place(h, p)
    }
end alloc.collections.HashMap.reindex

fn alloc.collections.HashMap.remove[K: core.cmp.Eq + core.hash.Hash, V, A: alloc.alloc.Allocator](self: &mut alloc.collections.HashMap<K, V, A>, key: &K) -> Option<V> uses [] panics never pub
