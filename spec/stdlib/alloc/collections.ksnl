fn alloc.collections.HashMap.insert[K: core.cmp.Eq + core.hash.Hash, V, A: alloc.alloc.Allocator](self: &mut alloc.collections.HashMap<K, V, A>, key: K, value: V) -> Result<Option<V>, alloc.alloc.AllocError> uses [alloc] panics never pub
    let h = alloc.collections.hash_key(&key)
    match self.find_hashed(h, &key) {
        Some(p) => match self.cells.get_mut(p) {
            Some(cell) => {
                let fresh = alloc.collections.HashCell.Entry(h, key, value)
                let old = core.mem.replace(cell, fresh)
                match old {
                    alloc.collections.HashCell.Entry(_, _, ov) => Ok(Some(ov))
                    alloc.collections.HashCell.Empty => Ok(None)
                    alloc.collections.HashCell.Index(_) => Ok(None)
                }
            }
            None => Err(alloc.alloc.AllocError {
                code: 1u32
            })
        }
        None => {
            let used = self.cells.len().wrapping_sub(self.slots)
            if used.wrapping_add(1usize).wrapping_mul(2usize) > self.slots {
                if self.dead > 0usize {
                    self.compact()
                }
                let n = self.len()
                if n.wrapping_add(1usize).wrapping_mul(2usize) > self.slots {
                    let want = if self.slots > 4usize {
                        self.slots.wrapping_mul(2usize)
                    } else {
                        8usize
                    }
                    match self.rebuild(want) {
                        Ok(_done) => {
                        }
                        Err(error) => return Err(error)
                    }
                } else {
                    self.reindex()
                }
            }
            let fresh = alloc.collections.HashCell.Entry(h, key, value)
            match self.cells.push_within_cap(fresh) {
                Ok(_done) => {
                }
                Err(back) => {
                    let want = self.cells.cap().wrapping_mul(2usize).wrapping_add(4usize)
                    match self.cells.grow(want) {
                        Ok(_grown) => {
                        }
                        Err(error) => return Err(error)
                    }
                    match self.cells.push_within_cap(back) {
                        Ok(_done) => {
                        }
                        Err(_) => return Err(alloc.alloc.AllocError {
                            code: 1u32
                        })
                    }
                }
            }
            let pos = self.cells.len().wrapping_sub(1usize)
            self.place(h, pos)
            Ok(None)
        }
    }
end alloc.collections.HashMap.insert

