fn alloc.collections.BtreeMap.find[K: core.cmp.Ord, V, A: alloc.alloc.Allocator](self: &alloc.collections.BtreeMap<K, V, A>, key: &K) -> Result<usize, usize> uses [] panics never
    let mut lo = 0usize
    let mut hi = self.entries.len()
    while lo < hi {
        let mid = lo.wrapping_add(hi.wrapping_sub(lo).wrapping_shr(1u32))
        match self.entries.get(mid) {
            Some(entry) => match entry.key.cmp(key) {
                core.cmp.Ordering.Less => {
                    lo = mid.wrapping_add(1usize)
                }
                core.cmp.Ordering.Equal => return Ok(mid)
                core.cmp.Ordering.Greater => {
                    hi = mid
                }
            }
            None => return Err(lo)
        }
    }
    Err(lo)
end alloc.collections.BtreeMap.find

