fn alloc.collections.HashMap.place[K: core.cmp.Eq + core.hash.Hash, V, A: alloc.alloc.Allocator](self: &mut alloc.collections.HashMap<K, V, A>, h: usize, pos: usize) -> () uses [] panics never
    let slots = self.slots
    if slots == 0usize {
        return
    }
    let mask = slots.wrapping_sub(1usize)
    let mut i = h & mask
    for _ in core.iter.range(0usize, slots) {
        match self.cells.get(i) {
            Some(cell) => match cell {
                alloc.collections.HashCell.Empty => {
                    if let Some(slot) = self.cells.get_mut(i) {
                        *slot = alloc.collections.HashCell.Index(pos)
                    }
                    return
                }
                alloc.collections.HashCell.Index(_q) => {
                }
                alloc.collections.HashCell.Entry(_eh, _ek, _ev) => {
                }
            }
            None => return
        }
        i = i.wrapping_add(1usize) & mask
    }
