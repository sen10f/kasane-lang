fn alloc.collections.HashMap.reverse_range[K: core.cmp.Eq + core.hash.Hash, V, A: alloc.alloc.Allocator](self: &mut alloc.collections.HashMap<K, V, A>, lo: usize, hi: usize) -> () uses [] panics never
    let mut a = lo
