fn alloc.collections.HashMap.compact[K: core.cmp.Eq + core.hash.Hash, V, A: alloc.alloc.Allocator](self: &mut alloc.collections.HashMap<K, V, A>) -> () uses [] panics never
    let total = self.cells.len()
    let mut w = self.slots
    for r in core.iter.range(self.slots, total) {
        let live = match self.cells.get(r) {
            Some(cell) => match cell {
                alloc.collections.HashCell.Entry(_, _, _) => true
                alloc.collections.HashCell.Empty => false
                alloc.collections.HashCell.Index(_) => false
            }
            None => false
        }
        if live {
            if r != w {
                match self.cells.as_mut_slice().swap(r, w) {
                    Ok(_done) => {
                    }
                    Err(_) => return
                }
            }
            w = w.wrapping_add(1usize)
        }
    }
    self.cells.truncate(w)
    self.dead = 0usize
end alloc.collections.HashMap.compact

