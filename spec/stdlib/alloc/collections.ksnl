    match self.find(&key) {
        Ok(i) => match self.entries.get_mut(i) {
            Some(entry) => {
                entry.key = key
                let old = core.mem.replace(&mut entry.value, value)
                Ok(Some(old))
            }
            None => Err(alloc.alloc.AllocError {
                code: 1u32
            })
        }
        Err(i) => {
            let fresh = alloc.collections.MapEntry {
                key: key
                value: value
            }
            match self.entries.insert_within_cap(i, fresh) {
                Ok(_) => Ok(None)
                Err(back) => {
                    let want = self.entries.cap().wrapping_mul(2usize).wrapping_add(4usize)
                    match self.entries.grow(want) {
                        Ok(_grown) => {
                        }
                        Err(error) => return Err(error)
                    }
                    match self.entries.insert_within_cap(i, back) {
                        Ok(_) => Ok(None)
                        Err(_) => Err(alloc.alloc.AllocError {
                            code: 1u32
                        })
                    }
                }
            }
        }
    }
