trait core.hash.Hash requires core.cmp.Eq pub
    fn hash[H: core.hash.Hasher](self: &Self, state: &mut H) -> () uses [] panics never
end core.hash.Hash

trait core.hash.Hasher pub
    fn finish(self: &Self) -> u64 uses [] panics never
    fn write_bytes(self: &mut Self, bytes: &[u8]) -> () uses [] panics never
end core.hash.Hasher

impl core.hash.Hasher for core.hash.Fnv64
fn core.hash.Fnv64.finish(self: &core.hash.Fnv64) -> u64 uses [] panics never impls core.hash.Hasher
    self.state
end core.hash.Fnv64.finish

fn core.hash.Fnv64.new() -> core.hash.Fnv64 const uses [] panics never pub
    core.hash.Fnv64 { state: 14_695_981_039_346_656_037u64 }
end core.hash.Fnv64.new

fn core.hash.Fnv64.write_bytes(self: &mut core.hash.Fnv64, bytes: &[u8]) -> () uses [] panics never impls core.hash.Hasher
    let mut i = 0usize
    while i < bytes.len() {
        match bytes.get(i) {
            Some(b) => {
                self.state = (self.state ^ u64.from_u8(*b)).wrapping_mul(1_099_511_628_211u64)
            }
            None => {
            }
        }
        i = i.wrapping_add(1usize)
    }
end core.hash.Fnv64.write_bytes

fn core.hash.fnv_int(state: &mut core.hash.Fnv64, x: u64, width: usize) -> () uses [] panics never
    let mut v = x
    let mut i = 0usize
    while i < width {
        let byte = v & 255u64
        state.state = (state.state ^ byte).wrapping_mul(1_099_511_628_211u64)
        v = v.wrapping_shr(8u32)
        i = i.wrapping_add(1usize)
    }
end core.hash.fnv_int
