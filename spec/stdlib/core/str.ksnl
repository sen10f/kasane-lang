fn core.str.rfind(self: &str, pattern: &str) -> Option<usize> uses [] panics never pub
    let hay = self.as_bytes()
    let pat = pattern.as_bytes()
    let n = hay.len()
    let m = pat.len()
    let mut res: Option<usize> = None
    if m > n {
        return None
    }
    let mut i = n.wrapping_sub(m)
    let mut go = true
    while go {
        let mut k = 0usize
        let mut same = true
        while k < m {
            let mut eq = false
            match hay.get(i.wrapping_add(k)) {
                Some(x) => match pat.get(k) {
                    Some(y) => {
                        eq = *x == *y
                    }
                    None => {
                        eq = false
                    }
                }
                None => {
                    eq = false
                }
            }
            if eq {
                k = k.wrapping_add(1usize)
            } else {
                same = false
                k = m
            }
        }
        if same {
            res = Some(i)
            go = false
        } else if i == 0usize {
            go = false
        } else {
            i = i.wrapping_sub(1usize)
        }
    }
    res
end core.str.rfind
