// `std.log`: 構造化ログ。1 行 1 件の JSON を標準エラーへ書く。すべて Kasane で書いた規範 (`.sig` は持たない)。
// 例: `std.log.info("started", &[("port", "8080"), ("mode", "dev")])?` は次の 1 行を書く (改行付き):
//   {"ts":"2026-11-14T10:20:30.123456789Z","level":"info","msg":"started","port":"8080","mode":"dev"}
// 時刻は UTC (`std.datetime` の RFC 3339。ナノ秒の小数は末尾の 0 を省く)。値はすべて JSON の文字列として書く
// (数値への変換はしない)。フィールドのキーは `ts` `level` `msg` と重なっても検査しない (そのまま並ぶ)。
// 水準による絞り込みはしない (呼び出し側が選ぶ)。書けなかった (確保の失敗・標準エラーへの書き込みの失敗) ときは
// `std.io.Error` を返す。確保の失敗は `OutOfMemory`。
enum std.log.Level derive [Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord] pub
    Debug
    Info
    Warn
    Error
end std.log.Level

// JSON の `level` の値。
fn std.log.Level.name(self: std.log.Level) -> &'static str uses [] panics never pub
    match self {
        std.log.Level.Debug => "debug"
        std.log.Level.Info => "info"
        std.log.Level.Warn => "warn"
        std.log.Level.Error => "error"
    }
end std.log.Level.name

// 1 行分の JSON (末尾に改行を付ける) を作る。`ts` は現在の UTC 時刻。確保の失敗は `AllocError` のまま返す。
fn std.log.build_line(level: std.log.Level, msg: &str, fields: &[(&str, &str)]) -> Result<alloc.string.String<std.alloc.System>, alloc.alloc.AllocError> uses [alloc, time] panics never
    let mut out = alloc.string.String.new(std.alloc.SYSTEM)
    let now = std.datetime.DateTime.now()
    let ts = now.to_rfc3339()?
    out.push_str("{\"ts\":\"")?
    out.push_str(ts.as_str())?
    out.push_str("\",\"level\":\"")?
    out.push_str(level.name())?
    out.push_str("\",\"msg\":")?
    std.json.push_quoted(&mut out, msg)?
    for k in core.iter.range(0usize, fields.len()) {
        match fields.get(k) {
            Some((key, value)) => {
                out.push(',')?
                std.json.push_quoted(&mut out, *key)?
                out.push(':')?
                std.json.push_quoted(&mut out, *value)?
            }
            None => return Ok(out)
        }
    }
    out.push('}')?
    out.push('\n')?
    Ok(out)
end std.log.build_line

fn std.log.debug(msg: &str, fields: &[(&str, &str)]) -> Result<(), std.io.Error> uses [alloc, io.console, time] panics never pub
    std.log.emit(std.log.Level.Debug, msg, fields)
end std.log.debug

// 1 行 (改行付き) を標準エラーへ書き切る (部分的に書かれたら残りを続けて書く)。
fn std.log.emit(level: std.log.Level, msg: &str, fields: &[(&str, &str)]) -> Result<(), std.io.Error> uses [alloc, io.console, time] panics never pub
    let line = std.log.line(level, msg, fields)?
    let bytes = line.as_bytes()
    let mut done = 0usize
    while done < bytes.len() {
        match bytes.sub(done, bytes.len()) {
            Some(rest) => {
                let n = std.io.write_stderr(rest)?
                if n == 0usize {
                    break
                }
                done = done.wrapping_add(n)
            }
            None => break
        }
    }
    Ok(())
end std.log.emit

fn std.log.error(msg: &str, fields: &[(&str, &str)]) -> Result<(), std.io.Error> uses [alloc, io.console, time] panics never pub
    std.log.emit(std.log.Level.Error, msg, fields)
end std.log.error

fn std.log.info(msg: &str, fields: &[(&str, &str)]) -> Result<(), std.io.Error> uses [alloc, io.console, time] panics never pub
    std.log.emit(std.log.Level.Info, msg, fields)
end std.log.info

// 1 行分の JSON (末尾に改行)。確保の失敗は `OutOfMemory` の `std.io.Error` に写す。
fn std.log.line(level: std.log.Level, msg: &str, fields: &[(&str, &str)]) -> Result<alloc.string.String<std.alloc.System>, std.io.Error> uses [alloc, time] panics never pub
    match std.log.build_line(level, msg, fields) {
        Ok(text) => Ok(text)
        Err(_) => Err(std.log.oom())
    }
end std.log.line

fn std.log.oom() -> std.io.Error uses [] panics never
    std.io.Error { kind: std.io.ErrorKind.OutOfMemory, code: 0i32 }
end std.log.oom

fn std.log.warn(msg: &str, fields: &[(&str, &str)]) -> Result<(), std.io.Error> uses [alloc, io.console, time] panics never pub
    std.log.emit(std.log.Level.Warn, msg, fields)
end std.log.warn
