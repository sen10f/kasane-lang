type std.datetime.DateTime derive [Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash] pub
    year: i64 pub
    month: i64 pub
    day: i64 pub
    hour: i64 pub
    minute: i64 pub
    second: i64 pub
    nanos: i64 pub
end std.datetime.DateTime

enum std.datetime.Error derive [Debug, Clone, Copy, PartialEq, Eq] pub
    Eof(usize)
    OutOfRange(usize)
    Trailing(usize)
    Unexpected(usize)
end std.datetime.Error

fn std.datetime.DateTime.now() -> std.datetime.DateTime uses [time] panics never pub
    let t = std.time.SystemTime.now()
    std.datetime.from_system_time(&t)
end std.datetime.DateTime.now

fn std.datetime.DateTime.to_rfc3339(self: &std.datetime.DateTime) -> Result<alloc.string.String<std.alloc.System>, alloc.alloc.AllocError> uses [alloc] panics never pub
    let mut out = alloc.string.String.new(std.alloc.SYSTEM)
    if self.year < 0i64 {
        out.push('-')?
        std.datetime.push_digits(&mut out, self.year.wrapping_neg(), 4usize)?
    } else {
        std.datetime.push_digits(&mut out, self.year, 4usize)?
    }
    out.push('-')?
    std.datetime.push_digits(&mut out, self.month, 2usize)?
    out.push('-')?
    std.datetime.push_digits(&mut out, self.day, 2usize)?
    out.push('T')?
    std.datetime.push_digits(&mut out, self.hour, 2usize)?
    out.push(':')?
    std.datetime.push_digits(&mut out, self.minute, 2usize)?
    out.push(':')?
    std.datetime.push_digits(&mut out, self.second, 2usize)?
    if self.nanos != 0i64 {
        out.push('.')?
        let mut frac = self.nanos
        let mut width = 9usize
        while width > 1usize && std.time.rem_floor(frac, 10i64) == 0i64 {
            frac = std.time.div_floor(frac, 10i64)
            width = width.wrapping_sub(1usize)
        }
        std.datetime.push_digits(&mut out, frac, width)?
    }
    out.push('Z')?
    Ok(out)
end std.datetime.DateTime.to_rfc3339

fn std.datetime.DateTime.unix_seconds(self: &std.datetime.DateTime) -> i64 uses [] panics never pub
    let days = std.datetime.days_from_civil(self.year, self.month, self.day)
    let secs = days.wrapping_mul(86_400i64).wrapping_add(self.hour.wrapping_mul(3600i64))
    secs.wrapping_add(self.minute.wrapping_mul(60i64)).wrapping_add(self.second)
end std.datetime.DateTime.unix_seconds

fn std.datetime.date_of_days(days: i64) -> std.datetime.DateTime uses [] panics never pub
    let z = days.wrapping_add(719_468i64)
    let era = std.time.div_floor(z, 146_097i64)
    let doe = z.wrapping_sub(era.wrapping_mul(146_097i64))
    let c1 = std.time.div_floor(doe, 1460i64)
    let c2 = std.time.div_floor(doe, 36_524i64)
    let c3 = std.time.div_floor(doe, 146_096i64)
    let yoe_num = doe.wrapping_sub(c1).wrapping_add(c2).wrapping_sub(c3)
    let yoe = std.time.div_floor(yoe_num, 365i64)
    let c4 = yoe.wrapping_mul(365i64).wrapping_add(std.time.div_floor(yoe, 4i64))
    let doy = doe.wrapping_sub(c4.wrapping_sub(std.time.div_floor(yoe, 100i64)))
    let mp = std.time.div_floor(doy.wrapping_mul(5i64).wrapping_add(2i64), 153i64)
    let c5 = std.time.div_floor(mp.wrapping_mul(153i64).wrapping_add(2i64), 5i64)
    let day = doy.wrapping_sub(c5).wrapping_add(1i64)
    let month = if mp >= 10i64 {
        mp.wrapping_sub(9i64)
    } else {
        mp.wrapping_add(3i64)
    }
    let y = yoe.wrapping_add(era.wrapping_mul(400i64))
    let year = if month <= 2i64 {
        y.wrapping_add(1i64)
    } else {
        y
    }
    std.datetime.make(year, month, day, 0i64, 0i64, 0i64, 0i64)
end std.datetime.date_of_days

fn std.datetime.days_from_civil(year: i64, month: i64, day: i64) -> i64 uses [] panics never pub
    let y = if month <= 2i64 {
        year.wrapping_sub(1i64)
    } else {
        year
    }
    let era = std.time.div_floor(y, 400i64)
    let yoe = y.wrapping_sub(era.wrapping_mul(400i64))
    let mp = if month > 2i64 {
        month.wrapping_sub(3i64)
    } else {
        month.wrapping_add(9i64)
    }
    let c1 = std.time.div_floor(mp.wrapping_mul(153i64).wrapping_add(2i64), 5i64)
    let doy = c1.wrapping_add(day).wrapping_sub(1i64)
    let c2 = yoe.wrapping_mul(365i64).wrapping_add(std.time.div_floor(yoe, 4i64))
    let doe = c2.wrapping_sub(std.time.div_floor(yoe, 100i64)).wrapping_add(doy)
    era.wrapping_mul(146_097i64).wrapping_add(doe).wrapping_sub(719_468i64)
end std.datetime.days_from_civil

fn std.datetime.days_in_month(year: i64, month: i64) -> i64 uses [] panics never pub
    if month == 2i64 {
        if std.datetime.is_leap_year(year) {
            return 29i64
        }
        return 28i64
    }
    if month == 4i64 || month == 6i64 || month == 9i64 || month == 11i64 {
        return 30i64
    }
    if month >= 1i64 && month <= 12i64 {
        return 31i64
    }
    0i64
end std.datetime.days_in_month

fn std.datetime.digit_at(b: &[u8], at: usize) -> Option<i64> uses [] panics never
    match b.get(at) {
        Some(c) => if *c >= b'0' && *c <= b'9' {
            Some(i64.from_u8(c.wrapping_sub(b'0')))
        } else {
            None
        }
        None => None
    }
end std.datetime.digit_at

fn std.datetime.expect_byte(b: &[u8], at: usize, want: u8, alt: u8) -> Result<(), std.datetime.Error> uses [] panics never
    match b.get(at) {
        Some(c) => if *c == want || *c == alt {
            Ok(())
        } else {
            Err(std.datetime.Error.Unexpected(at))
        }
        None => Err(std.datetime.Error.Eof(at))
    }
end std.datetime.expect_byte

fn std.datetime.from_system_time(t: &std.time.SystemTime) -> std.datetime.DateTime uses [] panics never pub
    std.datetime.from_unix_nanos(t.unix_nanos())
end std.datetime.from_system_time

fn std.datetime.from_unix_nanos(nanos: i64) -> std.datetime.DateTime uses [] panics never pub
    let base = std.datetime.from_unix_seconds(std.time.div_floor(nanos, 1_000_000_000i64))
    let ns = std.time.rem_floor(nanos, 1_000_000_000i64)
    std.datetime.with_time(base, base.hour, base.minute, base.second, ns)
end std.datetime.from_unix_nanos

fn std.datetime.from_unix_seconds(seconds: i64) -> std.datetime.DateTime uses [] panics never pub
    let days = std.time.div_floor(seconds, 86_400i64)
    let sod = std.time.rem_floor(seconds, 86_400i64)
    let date = std.datetime.date_of_days(days)
    let hour = std.time.div_floor(sod, 3600i64)
    let minute = std.time.div_floor(std.time.rem_floor(sod, 3600i64), 60i64)
    std.datetime.with_time(date, hour, minute, std.time.rem_floor(sod, 60i64), 0i64)
end std.datetime.from_unix_seconds

fn std.datetime.is_leap_year(year: i64) -> bool uses [] panics never pub
    if std.time.rem_floor(year, 4i64) != 0i64 {
        return false
    }
    if std.time.rem_floor(year, 100i64) != 0i64 {
        return true
    }
    std.time.rem_floor(year, 400i64) == 0i64
end std.datetime.is_leap_year

fn std.datetime.make(y: i64, m: i64, d: i64, h: i64, mi: i64, s: i64, n: i64) -> std.datetime.DateTime uses [] panics never pub
    std.datetime.DateTime { year: y, month: m, day: d, hour: h, minute: mi, second: s, nanos: n }
end std.datetime.make

fn std.datetime.parse_rfc3339(text: &str) -> Result<std.datetime.DateTime, std.datetime.Error> uses [] panics never pub
    let b = text.as_bytes()
    let year = std.datetime.read_fixed(b, 0usize, 4usize)?
    std.datetime.expect_byte(b, 4usize, b'-', b'-')?
    let month = std.datetime.read_fixed(b, 5usize, 2usize)?
    if month < 1i64 || month > 12i64 {
        return Err(std.datetime.Error.OutOfRange(5usize))
    }
    std.datetime.expect_byte(b, 7usize, b'-', b'-')?
    let day = std.datetime.read_fixed(b, 8usize, 2usize)?
    if day < 1i64 || day > std.datetime.days_in_month(year, month) {
        return Err(std.datetime.Error.OutOfRange(8usize))
    }
    std.datetime.expect_byte(b, 10usize, b'T', b't')?
    let hour = std.datetime.read_fixed(b, 11usize, 2usize)?
    if hour > 23i64 {
        return Err(std.datetime.Error.OutOfRange(11usize))
    }
    std.datetime.expect_byte(b, 13usize, b':', b':')?
    let minute = std.datetime.read_fixed(b, 14usize, 2usize)?
    if minute > 59i64 {
        return Err(std.datetime.Error.OutOfRange(14usize))
    }
    std.datetime.expect_byte(b, 16usize, b':', b':')?
    let second = std.datetime.read_fixed(b, 17usize, 2usize)?
    if second > 59i64 {
        return Err(std.datetime.Error.OutOfRange(17usize))
    }
    let mut at = 19usize
    let mut nanos = 0i64
    if b.get(at) == Some(&b'.') {
        at = at.wrapping_add(1usize)
        let start = at
        let mut kept = 0usize
        let mut scan = true
        while scan {
            match std.datetime.digit_at(b, at) {
                Some(d) => {
                    if kept < 9usize {
                        nanos = nanos.wrapping_mul(10i64).wrapping_add(d)
                        kept = kept.wrapping_add(1usize)
                    }
                    at = at.wrapping_add(1usize)
                }
                None => {
                    scan = false
                }
            }
        }
        if at == start {
            return Err(std.datetime.Error.Unexpected(at))
        }
        while kept < 9usize {
            nanos = nanos.wrapping_mul(10i64)
            kept = kept.wrapping_add(1usize)
        }
    }
    let mut offset = 0i64
    match b.get(at) {
        Some(c) => if *c == b'Z' || *c == b'z' {
            at = at.wrapping_add(1usize)
        } else if *c == b'+' || *c == b'-' {
            let oh = std.datetime.read_fixed(b, at.wrapping_add(1usize), 2usize)?
            std.datetime.expect_byte(b, at.wrapping_add(3usize), b':', b':')?
            let om = std.datetime.read_fixed(b, at.wrapping_add(4usize), 2usize)?
            if oh > 23i64 || om > 59i64 {
                return Err(std.datetime.Error.OutOfRange(at.wrapping_add(1usize)))
            }
            offset = oh.wrapping_mul(60i64).wrapping_add(om)
            if *c == b'-' {
                offset = offset.wrapping_neg()
            }
            at = at.wrapping_add(6usize)
        } else {
            return Err(std.datetime.Error.Unexpected(at))
        }
        None => return Err(std.datetime.Error.Eof(at))
    }
    if at != b.len() {
        return Err(std.datetime.Error.Trailing(at))
    }
    let local = std.datetime.make(year, month, day, hour, minute, second, 0i64)
    let secs = local.unix_seconds().wrapping_sub(offset.wrapping_mul(60i64))
    let utc = std.datetime.from_unix_seconds(secs)
    Ok(std.datetime.with_time(utc, utc.hour, utc.minute, utc.second, nanos))
end std.datetime.parse_rfc3339

fn std.datetime.push_digits(out: &mut alloc.string.String<std.alloc.System>, value: i64, width: usize) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never
    let mut p = 1i64
    for _ in core.iter.range(1usize, width) {
        p = p.wrapping_mul(10i64)
    }
    for _ in core.iter.range(0usize, width) {
        let d = std.time.rem_floor(std.time.div_floor(value, p), 10i64)
        out.push_i64(d)?
        p = std.time.div_floor(p, 10i64)
    }
    Ok(())
end std.datetime.push_digits

fn std.datetime.read_fixed(b: &[u8], at: usize, count: usize) -> Result<i64, std.datetime.Error> uses [] panics never
    let mut v = 0i64
    for k in core.iter.range(0usize, count) {
        let pos = at.wrapping_add(k)
        match std.datetime.digit_at(b, pos) {
            Some(d) => {
                v = v.wrapping_mul(10i64).wrapping_add(d)
            }
            None => {
                if pos >= b.len() {
                    return Err(std.datetime.Error.Eof(pos))
                }
                return Err(std.datetime.Error.Unexpected(pos))
            }
        }
    }
    Ok(v)
end std.datetime.read_fixed

fn std.datetime.with_time(base: std.datetime.DateTime, hour: i64, minute: i64, second: i64, nanos: i64) -> std.datetime.DateTime uses [] panics never pub
    std.datetime.make(base.year, base.month, base.day, hour, minute, second, nanos)
end std.datetime.with_time
