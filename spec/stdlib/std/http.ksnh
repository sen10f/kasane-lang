// `std.http`: HTTP/1.0・1.1 の要求の解析と応答の組み立て。すべて Kasane で書いた規範 (`.sig` は持たない)。
// 解析は受け取ったバイト列の上で行う。`Decoder` は読み残しを持つので、keep-alive の 1 接続で
// 複数の要求を順に取れる (パイプライン・同じ接続の次の要求)。読み書きは `std.io.Read` / `std.io.Write`
// の実装 (`TcpStream`、`std.tls.TlsStream` など) を境界で受ける。
// 上限: 要求行と空行までのヘッダの大きさは `max_head`、本体 (`Content-Length` または chunked の合計) は
// `max_body`。超えたら `HeadTooLarge` / `BodyTooLarge` を返し、それ以上は読まない。
// `Transfer-Encoding` は `chunked` だけを受け、ほかは `Unsupported`。`Content-Length` と併用すると `BadRequest`。
// 読み残しを持つ解析器。`feed` で受け取ったバイトを足し、`next` で 1 件ずつ取り出す。
type std.http.Decoder pub
    buf: std.vec.Vec<u8>
    max_body: usize
    max_head: usize
end std.http.Decoder

enum std.http.Error derive [Debug, Clone, Copy, PartialEq, Eq, From] pub
    Alloc(alloc.alloc.AllocError)
    BadRequest
    BodyTooLarge
    HeadTooLarge
    Io(std.io.Error)
    Truncated
    Unsupported
end std.http.Error

// 本体の枠組み: chunked なら `chunked`、そうでなければ `Content-Length` の値 `length` (上限内)。
type std.http.Framing
    chunked: bool
    length: usize
end std.http.Framing

// 解析の途中結果 (要求行とヘッダ、本体の枠組み)。本体は別に集める。
type std.http.Head
    framing: std.http.Framing
    headers: std.vec.Vec<std.http.Header>
    http11: bool
    method: std.string.String
    path: std.string.String
end std.http.Head

// 要求の 1 件。`path` は `/` で始まるものだけを受ける (絶対形の要求対象は `BadRequest`)。
type std.http.Header pub
    name: std.string.String pub
    value: std.string.String pub
end std.http.Header

type std.http.Request pub
    body: std.vec.Vec<u8> pub
    headers: std.vec.Vec<std.http.Header> pub
    http11: bool pub
    method: std.string.String pub
    path: std.string.String pub
end std.http.Request

// 上流の応答 (`std.http.ResponseDecoder` が読んだ最後の最終の応答)。status は 100 以上 999 以下。
type std.http.Response pub
    headers: std.vec.Vec<std.http.Header> pub
    http11: bool pub
    reason: std.string.String pub
    status: u16 pub
end std.http.Response

// 上流の応答を 1 バイトずつ / まとめて状態機械で読む (`Decoder` と同じ使い方: feed → 応答の頭 → take_body → finish)。
// 頭は max_head バイト、本体は応答 1 件ごとに max_body バイトで打ち切る。上限は読みながら超えた時点で止める。
// 一度解析した頭は読み直さない。本体は取り出されるまで body に溜まり、上限を超える分は溜めない。
// 応答の後ろの読み残しは spare に溜め、`reset_next` で次の応答へ進める (keep-alive の 1 接続)。
// 枠組み: Content-Length / chunked / 閉じるまで (`finish` で閉じる。閉じるまでも max_body で止める)。
// 1xx は途中の応答として読み捨てる (101 は Unsupported)。
// 注意: 要求の方法 (HEAD) を知らないので、HEAD への応答の本体は読めない (呼び手が頭だけで止める)。
type std.http.ResponseDecoder pub
    body: std.vec.Vec<u8>
    body_total: usize
    chunk_digits: usize
    chunk_n: usize
    cr: bool
    ext: bool
    has_head: bool
    head: std.vec.Vec<u8>
    line_len: usize
    max_body: usize
    max_head: usize
    phase: u8
    remaining: usize
    resp: std.http.Response
    section: usize
    spare: std.vec.Vec<u8>
end std.http.ResponseDecoder

// 先頭の `used` バイトを捨てる (読み残しを先頭に詰め直す)。
fn std.http.Decoder.consume(self: &mut std.http.Decoder, used: usize) -> Result<(), std.http.Error> uses [alloc] panics never
    let rest = std.http.copy_tail(self.buf.as_slice(), used)?
    self.buf.clear()
    self.buf.extend_from_slice(rest.as_slice())?
    Ok(())
end std.http.Decoder.consume

fn std.http.Decoder.feed(self: &mut std.http.Decoder, bytes: &[u8]) -> Result<(), std.http.Error> uses [alloc] panics never pub
    self.buf.extend_from_slice(bytes)?
    Ok(())
end std.http.Decoder.feed

fn std.http.Decoder.feed_part(self: &mut std.http.Decoder, chunk: &[u8], n: usize) -> Result<(), std.http.Error> uses [alloc] panics never pub
    match chunk.sub(0usize, n) {
        Some(part) => self.feed(part)?
        None => return Err(std.http.Error.BadRequest)
    }
    Ok(())
end std.http.Decoder.feed_part

fn std.http.Decoder.is_empty(self: &std.http.Decoder) -> bool uses [] panics never pub
    self.buf.is_empty()
end std.http.Decoder.is_empty

fn std.http.Decoder.new(max_head: usize, max_body: usize) -> std.http.Decoder uses [] panics never pub
    let buf = std.vec.Vec.new()
    std.http.Decoder {
        buf: buf
        max_body: max_body
        max_head: max_head
    }
end std.http.Decoder.new

fn std.http.Decoder.next(self: &mut std.http.Decoder) -> Result<Option<std.http.Request>, std.http.Error> uses [alloc] panics never pub
    let taken = std.http.take_request(self.buf.as_slice(), self.max_head, self.max_body)?
    match taken {
        Some((request, used)) => {
            self.consume(used)?
            Ok(Some(request))
        }
        None => Ok(None)
    }
end std.http.Decoder.next

fn std.http.Request.header(self: &std.http.Request, name: &str) -> Option<&str> uses [] panics never pub
    for k in core.iter.range(0usize, self.headers.len()) {
        match self.headers.as_slice().get(k) {
            Some(h) => if h.name.as_str().eq_ignore_ascii_case(name) {
                return Some(h.value.as_str())
            }
            None => core.mem.drop(0u8)
        }
    }
    None
end std.http.Request.header

fn std.http.Request.header_unique(self: &std.http.Request, name: &str) -> Result<Option<&str>, std.http.Error> uses [] panics never pub
    let mut found: Option<&str> = None
    for k in core.iter.range(0usize, self.headers.len()) {
        match self.headers.as_slice().get(k) {
            Some(h) => if h.name.as_str().eq_ignore_ascii_case(name) {
                if found is Some(_) {
                    return Err(std.http.Error.BadRequest)
                }
                found = Some(h.value.as_str())
            }
            None => core.mem.drop(0u8)
        }
    }
    Ok(found)
end std.http.Request.header_unique

fn std.http.Request.keep_alive(self: &std.http.Request) -> bool uses [] panics never pub
    match self.header("connection") {
        Some(v) => {
            if v.eq_ignore_ascii_case("close") {
                return false
            }
            if v.eq_ignore_ascii_case("keep-alive") {
                return true
            }
            self.http11
        }
        None => self.http11
    }
end std.http.Request.keep_alive

fn std.http.ResponseDecoder.buffered(self: &std.http.ResponseDecoder) -> usize uses [] panics never pub
    self.head.len().saturating_add(self.body.len()).saturating_add(self.spare.len())
end std.http.ResponseDecoder.buffered

fn std.http.ResponseDecoder.chunk_end_byte(self: &mut std.http.ResponseDecoder, c: u8) -> Result<(), std.http.Error> uses [] panics never
    if !self.cr {
        if c == b'\r' {
            self.cr = true
            return Ok(())
        }
        return Err(std.http.Error.BadRequest)
    }
    if c != b'\n' {
        return Err(std.http.Error.BadRequest)
    }
    self.cr = false
    self.phase = 2u8
    self.section = 0usize
    self.line_len = 0usize
    self.chunk_n = 0usize
    self.chunk_digits = 0usize
    self.ext = false
    Ok(())
end std.http.ResponseDecoder.chunk_end_byte

fn std.http.ResponseDecoder.feed(self: &mut std.http.ResponseDecoder, bytes: &[u8]) -> Result<(), std.http.Error> uses [alloc] panics never pub
    let mut i = 0usize
    while i < bytes.len() {
        let used = self.step(bytes, i)?
        i = i.saturating_add(used)
    }
    Ok(())
end std.http.ResponseDecoder.feed

fn std.http.ResponseDecoder.feed_part(self: &mut std.http.ResponseDecoder, chunk: &[u8], n: usize) -> Result<(), std.http.Error> uses [alloc] panics never pub
    match chunk.sub(0usize, n) {
        Some(part) => self.feed(part)?
        None => return Err(std.http.Error.BadRequest)
    }
    Ok(())
end std.http.ResponseDecoder.feed_part

fn std.http.ResponseDecoder.finish(self: &mut std.http.ResponseDecoder) -> Result<(), std.http.Error> uses [] panics never pub
    if self.phase == 7u8 {
        return Ok(())
    }
    if self.phase == 6u8 {
        self.phase = 7u8
        return Ok(())
    }
    Err(std.http.Error.Truncated)
end std.http.ResponseDecoder.finish

fn std.http.ResponseDecoder.finish_head(self: &mut std.http.ResponseDecoder) -> Result<(), std.http.Error> uses [alloc] panics never
    let resp = std.http.parse_response_head(self.head.as_slice())?
    self.head.clear()
    let (kind, n) = std.http.response_framing(&resp, self.max_body)?
    if resp.status < 200u16 {
        if resp.status == 101u16 {
            return Err(std.http.Error.Unsupported)
        }
        return Ok(())
    }
    self.resp = resp
    self.has_head = true
    if kind == 0u8 {
        self.phase = 6u8
    } else if kind == 1u8 {
        if n == 0usize {
            self.phase = 7u8
        } else {
            self.remaining = n
            self.phase = 1u8
        }
    } else if kind == 2u8 {
        self.phase = 2u8
        self.section = 0usize
        self.line_len = 0usize
        self.chunk_n = 0usize
        self.chunk_digits = 0usize
        self.ext = false
        self.cr = false
    } else {
        self.phase = 7u8
    }
    Ok(())
end std.http.ResponseDecoder.finish_head

fn std.http.ResponseDecoder.has_response(self: &std.http.ResponseDecoder) -> bool uses [] panics never pub
    self.has_head
end std.http.ResponseDecoder.has_response

fn std.http.ResponseDecoder.head_byte(self: &mut std.http.ResponseDecoder, c: u8) -> Result<(), std.http.Error> uses [alloc] panics never
    if self.head.len() >= self.max_head {
        return Err(std.http.Error.HeadTooLarge)
    }
    self.head.push(c)?
    if std.http.ends_crlf2(self.head.as_slice()) {
        self.finish_head()?
    }
    Ok(())
end std.http.ResponseDecoder.head_byte

fn std.http.ResponseDecoder.is_done(self: &std.http.ResponseDecoder) -> bool uses [] panics never pub
    self.phase == 7u8
end std.http.ResponseDecoder.is_done

fn std.http.ResponseDecoder.new(max_head: usize, max_body: usize) -> std.http.ResponseDecoder uses [] panics never pub
    let head = std.vec.Vec.new()
    let body = std.vec.Vec.new()
    let spare = std.vec.Vec.new()
    let resp = std.http.blank_response()
    std.http.ResponseDecoder {
        body: body
        body_total: 0usize
        chunk_digits: 0usize
        chunk_n: 0usize
        cr: false
        ext: false
        has_head: false
        head: head
        line_len: 0usize
        max_body: max_body
        max_head: max_head
        phase: 0u8
        remaining: 0usize
        resp: resp
        section: 0usize
        spare: spare
    }
end std.http.ResponseDecoder.new

fn std.http.ResponseDecoder.push_body(self: &mut std.http.ResponseDecoder, part: &[u8]) -> Result<(), std.http.Error> uses [alloc] panics never
    let total = self.body_total.saturating_add(part.len())
    if total > self.max_body {
        return Err(std.http.Error.BodyTooLarge)
    }
    self.body.extend_from_slice(part)?
    self.body_total = total
    Ok(())
end std.http.ResponseDecoder.push_body

fn std.http.ResponseDecoder.reset_next(self: &mut std.http.ResponseDecoder) -> Result<(), std.http.Error> uses [alloc] panics never pub
    if self.phase != 7u8 {
        return Err(std.http.Error.Truncated)
    }
    let mut rest = std.vec.Vec.new()
    rest.extend_from_slice(self.spare.as_slice())?
    self.spare.clear()
    self.body.clear()
    self.body_total = 0usize
    self.head.clear()
    self.has_head = false
    self.resp = std.http.blank_response()
    self.phase = 0u8
    self.feed(rest.as_slice())
end std.http.ResponseDecoder.reset_next

fn std.http.ResponseDecoder.response(self: &std.http.ResponseDecoder) -> &std.http.Response uses [] panics never pub
    &self.resp
end std.http.ResponseDecoder.response

fn std.http.ResponseDecoder.size_byte(self: &mut std.http.ResponseDecoder, c: u8) -> Result<(), std.http.Error> uses [] panics never
    self.section = self.section.saturating_add(1usize)
    if self.section > self.max_head {
        return Err(std.http.Error.HeadTooLarge)
    }
    if c == b'\n' {
        if !self.cr || self.chunk_digits == 0usize {
            return Err(std.http.Error.BadRequest)
        }
        self.cr = false
        if self.chunk_n == 0usize {
            self.phase = 5u8
            self.section = 0usize
            self.line_len = 0usize
        } else {
            self.remaining = self.chunk_n
            self.phase = 3u8
        }
        return Ok(())
    }
    if self.cr {
        return Err(std.http.Error.BadRequest)
    }
    if c == b'\r' {
        self.cr = true
        return Ok(())
    }
    if self.ext {
        if std.http.is_ctl(c) {
            return Err(std.http.Error.BadRequest)
        }
        return Ok(())
    }
    if c == b';' {
        if self.chunk_digits == 0usize {
            return Err(std.http.Error.BadRequest)
        }
        self.ext = true
        return Ok(())
    }
    let v = match std.http.hex_value(c) {
        Some(d) => d
        None => return Err(std.http.Error.BadRequest)
    }
    self.chunk_n = self.chunk_n.saturating_mul(16usize).saturating_add(v)
    self.chunk_digits = self.chunk_digits.saturating_add(1usize)
    if self.chunk_n > self.max_body {
        return Err(std.http.Error.BodyTooLarge)
    }
    Ok(())
end std.http.ResponseDecoder.size_byte

fn std.http.ResponseDecoder.step(self: &mut std.http.ResponseDecoder, data: &[u8], i: usize) -> Result<usize, std.http.Error> uses [alloc] panics never
    let phase = self.phase
    let avail = data.len().saturating_sub(i)
    if phase == 7u8 {
        if self.spare.len().saturating_add(avail) > self.max_head {
            return Err(std.http.Error.HeadTooLarge)
        }
        let rest = match data.sub(i, data.len()) {
            Some(r) => r
            None => return Err(std.http.Error.BadRequest)
        }
        self.spare.extend_from_slice(rest)?
        return Ok(avail)
    }
    if phase == 1u8 || phase == 3u8 || phase == 6u8 {
        let mut k = avail
        if phase != 6u8 && self.remaining < avail {
            k = self.remaining
        }
        let part = match data.sub(i, i.saturating_add(k)) {
            Some(p) => p
            None => return Err(std.http.Error.BadRequest)
        }
        self.push_body(part)?
        if phase != 6u8 {
            self.remaining = self.remaining.saturating_sub(k)
        }
        if phase == 1u8 && self.remaining == 0usize {
            self.phase = 7u8
        }
        if phase == 3u8 && self.remaining == 0usize {
            self.phase = 4u8
            self.cr = false
        }
        return Ok(k)
    }
    let c = std.http.byte_at(data, i)
    if phase == 0u8 {
        self.head_byte(c)?
    } else if phase == 2u8 {
        self.size_byte(c)?
    } else if phase == 4u8 {
        self.chunk_end_byte(c)?
    } else {
        self.trailer_byte(c)?
    }
    Ok(1usize)
end std.http.ResponseDecoder.step

fn std.http.ResponseDecoder.take_body(self: &mut std.http.ResponseDecoder) -> Result<std.vec.Vec<u8>, std.http.Error> uses [alloc] panics never pub
    let mut out = std.vec.Vec.new()
    out.extend_from_slice(self.body.as_slice())?
    self.body.clear()
    Ok(out)
end std.http.ResponseDecoder.take_body

fn std.http.ResponseDecoder.trailer_byte(self: &mut std.http.ResponseDecoder, c: u8) -> Result<(), std.http.Error> uses [] panics never
    self.section = self.section.saturating_add(1usize)
    if self.section > self.max_head {
        return Err(std.http.Error.HeadTooLarge)
    }
    if c == b'\n' {
        if !self.cr {
            return Err(std.http.Error.BadRequest)
        }
        self.cr = false
        if self.line_len == 0usize {
            self.phase = 7u8
            return Ok(())
        }
        self.line_len = 0usize
        return Ok(())
    }
    if self.cr {
        return Err(std.http.Error.BadRequest)
    }
    if c == b'\r' {
        self.cr = true
        return Ok(())
    }
    if std.http.is_ctl(c) {
        return Err(std.http.Error.BadRequest)
    }
    self.line_len = self.line_len.saturating_add(1usize)
    Ok(())
end std.http.ResponseDecoder.trailer_byte

fn std.http.assemble(head: std.http.Head, body: std.vec.Vec<u8>) -> std.http.Request uses [] panics never
    let headers = head.headers
    let http11 = head.http11
    let method = head.method
    let path = head.path
    std.http.Request {
        body: body
        headers: headers
        http11: http11
        method: method
        path: path
    }
end std.http.assemble

fn std.http.blank_response() -> std.http.Response uses [] panics never
    let headers = std.vec.Vec.new()
    let reason = std.string.String.new()
    std.http.Response {
        headers: headers
        http11: false
        reason: reason
        status: 0u16
    }
end std.http.blank_response

fn std.http.byte_at(data: &[u8], i: usize) -> u8 uses [] panics never
    match data.get(i) {
        Some(b) => *b
        None => 0u8
    }
end std.http.byte_at

fn std.http.check_header(name: &str, value: &str) -> Result<(), std.http.Error> uses [] panics never
    if name.is_empty() {
        return Err(std.http.Error.BadRequest)
    }
    let nb = name.as_bytes()
    let mut i = 0usize
    while i < nb.len() {
        if !std.http.is_tchar(std.http.byte_at(nb, i)) {
            return Err(std.http.Error.BadRequest)
        }
        i = i.saturating_add(1usize)
    }
    let vb = value.as_bytes()
    let mut j = 0usize
    while j < vb.len() {
        let c = std.http.byte_at(vb, j)
        if c != b'\t' && std.http.is_ctl(c) {
            return Err(std.http.Error.BadRequest)
        }
        j = j.saturating_add(1usize)
    }
    Ok(())
end std.http.check_header

fn std.http.chunk_size(data: &[u8], from: usize, to: usize, max_body: usize) -> Result<usize, std.http.Error> uses [] panics never
    let mut n = 0usize
    let mut digits = 0usize
    let mut i = from
    while i < to {
        let c = std.http.byte_at(data, i)
        if c == b';' {
            break
        }
        let v = match std.http.hex_value(c) {
            Some(d) => d
            None => return Err(std.http.Error.BadRequest)
        }
        if n > max_body {
            return Err(std.http.Error.BodyTooLarge)
        }
        n = n.saturating_mul(16usize).saturating_add(v)
        digits = digits.saturating_add(1usize)
        i = i.saturating_add(1usize)
    }
    if digits == 0usize {
        return Err(std.http.Error.BadRequest)
    }
    if n > max_body {
        return Err(std.http.Error.BodyTooLarge)
    }
    Ok(n)
end std.http.chunk_size

fn std.http.copy_tail(data: &[u8], used: usize) -> Result<std.vec.Vec<u8>, std.http.Error> uses [alloc] panics never
    let mut out = std.vec.Vec.new()
    match data.sub(used, data.len()) {
        Some(part) => out.extend_from_slice(part)?
        None => return Err(std.http.Error.BadRequest)
    }
    Ok(out)
end std.http.copy_tail

fn std.http.crlf_at(data: &[u8], i: usize) -> bool uses [] panics never
    std.http.byte_at(data, i) == b'\r' && std.http.byte_at(data, i.saturating_add(1usize)) == b'\n'
end std.http.crlf_at

fn std.http.decode_chunked(data: &[u8], max_body: usize, body: &mut std.vec.Vec<u8>) -> Result<Option<usize>, std.http.Error> uses [alloc] panics never
    let mut pos = 0usize
    loop {
        let line_end = match std.http.find_crlf(data, pos) {
            Some(e) => e
            None => return Ok(None)
        }
        let size = std.http.chunk_size(data, pos, line_end, max_body)?
        if size == 0usize {
            return std.http.skip_trailers(data, line_end.saturating_add(2usize))
        }
        let data_start = line_end.saturating_add(2usize)
        let data_end = data_start.saturating_add(size)
        let next = data_end.saturating_add(2usize)
        if data.len() < next {
            return Ok(None)
        }
        if !std.http.crlf_at(data, data_end) {
            return Err(std.http.Error.BadRequest)
        }
        if body.len().saturating_add(size) > max_body {
            return Err(std.http.Error.BodyTooLarge)
        }
        let part = match data.sub(data_start, data_end) {
            Some(p) => p
            None => return Err(std.http.Error.BadRequest)
        }
        body.extend_from_slice(part)?
        pos = next
    }
end std.http.decode_chunked

fn std.http.ends_crlf2(data: &[u8]) -> bool uses [] panics never
    let n = data.len()
    let first = std.http.crlf_at(data, n.saturating_sub(4usize))
    let second = std.http.crlf_at(data, n.saturating_sub(2usize))
    n >= 4usize && first && second
end std.http.ends_crlf2

fn std.http.find_crlf(data: &[u8], from: usize) -> Option<usize> uses [] panics never
    let len = data.len()
    let mut i = from
    while i.saturating_add(1usize) < len {
        if std.http.crlf_at(data, i) {
            return Some(i)
        }
        i = i.saturating_add(1usize)
    }
    None
end std.http.find_crlf

fn std.http.find_head_end(data: &[u8]) -> Option<usize> uses [] panics never
    let len = data.len()
    let mut i = 0usize
    while i.saturating_add(4usize) <= len {
        if std.http.crlf_at(data, i) && std.http.crlf_at(data, i.saturating_add(2usize)) {
            return Some(i.saturating_add(4usize))
        }
        i = i.saturating_add(1usize)
    }
    None
end std.http.find_head_end

fn std.http.has_bad_ctl(data: &[u8]) -> bool uses [] panics never
    let len = data.len()
    let mut i = 0usize
    while i < len {
        let b = std.http.byte_at(data, i)
        if b == b'\r' {
            if !std.http.crlf_at(data, i) {
                return true
            }
            i = i.saturating_add(2usize)
        } else {
            if b == b'\n' || std.http.is_ctl(b) {
                return true
            }
            i = i.saturating_add(1usize)
        }
    }
    false
end std.http.has_bad_ctl

fn std.http.has_bare_ctl(data: &[u8]) -> bool uses [] panics never
    let len = data.len()
    let mut i = 0usize
    while i < len {
        let b = std.http.byte_at(data, i)
        if b == 0u8 {
            return true
        }
        if b == b'\r' && !std.http.crlf_at(data, i) {
            return true
        }
        i = i.saturating_add(1usize)
    }
    false
end std.http.has_bare_ctl

fn std.http.has_ctl(data: &[u8]) -> bool uses [] panics never
    let len = data.len()
    let mut i = 0usize
    while i < len {
        let b = std.http.byte_at(data, i)
        if b < 32u8 || b == 127u8 {
            return true
        }
        i = i.saturating_add(1usize)
    }
    false
end std.http.has_ctl

fn std.http.hex_value(c: u8) -> Option<usize> uses [] panics never
    if c >= b'0' && c <= b'9' {
        return Some(usize.from_u8(c.wrapping_sub(b'0')))
    }
    if c >= b'a' && c <= b'f' {
        return Some(usize.from_u8(c.wrapping_sub(b'a').wrapping_add(10u8)))
    }
    if c >= b'A' && c <= b'F' {
        return Some(usize.from_u8(c.wrapping_sub(b'A').wrapping_add(10u8)))
    }
    None
end std.http.hex_value

fn std.http.is_ctl(c: u8) -> bool uses [] panics never
    c == 0u8 || c == 127u8 || c < 32u8 && c != 9u8
end std.http.is_ctl

fn std.http.is_method(text: &str) -> bool uses [] panics never
    if text.is_empty() {
        return false
    }
    for c in text.chars() {
        if c < 'A' || c > 'Z' {
            return false
        }
    }
    true
end std.http.is_method

fn std.http.is_tchar(c: u8) -> bool uses [] panics never
    if c >= b'A' && c <= b'Z' {
        return true
    }
    if c >= b'a' && c <= b'z' {
        return true
    }
    if c >= b'0' && c <= b'9' {
        return true
    }
    if c == b'!' || c == b'#' || c == b'$' || c == b'%' || c == b'&' || c == b'\'' {
        return true
    }
    if c == b'*' || c == b'+' || c == b'-' || c == b'.' || c == b'^' || c == b'_' {
        return true
    }
    if c == b'`' || c == b'|' || c == b'~' {
        return true
    }
    false
end std.http.is_tchar

fn std.http.parse_head(head: &[u8], max_body: usize) -> Result<std.http.Head, std.http.Error> uses [alloc] panics never
    // 行末は CRLF のみ (裸の LF / CR は request smuggling の元になる)。
    if std.http.has_bad_ctl(head) {
        return Err(std.http.Error.BadRequest)
    }
    let text = match core.str.from_utf8(head) {
        Ok(t) => t
        Err(_) => return Err(std.http.Error.BadRequest)
    }
    let (line, rest) = match text.split_once("\r\n") {
        Some(pair) => pair
        None => return Err(std.http.Error.BadRequest)
    }
    let (method_text, after) = match line.split_once(" ") {
        Some(pair) => pair
        None => return Err(std.http.Error.BadRequest)
    }
    let (path_text, version) = match after.split_once(" ") {
        Some(pair) => pair
        None => return Err(std.http.Error.BadRequest)
    }
    let mut v11 = false
    if version == "HTTP/1.1" {
        v11 = true
    } else if version != "HTTP/1.0" {
        return Err(std.http.Error.BadRequest)
    }
    if std.http.has_ctl(path_text.as_bytes()) {
        return Err(std.http.Error.BadRequest)
    }
    if !std.http.is_method(method_text) || !path_text.starts_with("/") {
        return Err(std.http.Error.BadRequest)
    }
    let mut headers = std.vec.Vec.new()
    let mut length = 0usize
    let mut has_length = false
    let mut has_encoding = false
    let mut has_host = false
    let mut chunked = false
    for field in rest.split("\r\n") {
        if !field.is_empty() {
            let (key, raw_value) = match field.split_once(":") {
                Some(pair) => pair
                None => return Err(std.http.Error.BadRequest)
            }
            // 生の値（trim 前）に HTAB 以外の制御バイトを含めない（端の \x0c を escape させない）。
            std.http.check_header(key, raw_value)?
            let value = raw_value.trim()
            if key.eq_ignore_ascii_case("host") {
                if has_host {
                    return Err(std.http.Error.BadRequest)
                }
                has_host = true
            } else if key.eq_ignore_ascii_case("content-length") {
                if has_length {
                    return Err(std.http.Error.BadRequest)
                }
                has_length = true
                length = std.http.parse_length(value, max_body)?
            } else if key.eq_ignore_ascii_case("transfer-encoding") {
                if has_encoding {
                    return Err(std.http.Error.BadRequest)
                }
                has_encoding = true
                if !value.eq_ignore_ascii_case("chunked") {
                    return Err(std.http.Error.Unsupported)
                }
                chunked = true
            }
            let name = std.string.String.from_str(key)?
            let text_value = std.string.String.from_str(value)?
            headers.push(std.http.Header {
                name: name
                value: text_value
            })?
        }
    }
    if has_encoding && has_length {
        return Err(std.http.Error.BadRequest)
    }
    if v11 && !has_host {
        return Err(std.http.Error.BadRequest)
    }
    if chunked && !v11 {
        return Err(std.http.Error.BadRequest)
    }
    let method = std.string.String.from_str(method_text)?
    let path = std.string.String.from_str(path_text)?
    let frame = std.http.Framing {
        chunked: chunked
        length: length
    }
    Ok(std.http.Head {
        framing: frame
        headers: headers
        http11: v11
        method: method
        path: path
    })
end std.http.parse_head

fn std.http.parse_length(value: &str, max_body: usize) -> Result<usize, std.http.Error> uses [] panics never
    if value.is_empty() {
        return Err(std.http.Error.BadRequest)
    }
    for c in value.chars() {
        if c < '0' || c > '9' {
            return Err(std.http.Error.BadRequest)
        }
    }
    match usize.parse(value) {
        Ok(n) => {
            if n > max_body {
                return Err(std.http.Error.BodyTooLarge)
            }
            Ok(n)
        }
        Err(_) => Err(std.http.Error.BodyTooLarge)
    }
end std.http.parse_length

fn std.http.parse_resp_length(value: &str, max_body: usize) -> Result<usize, std.http.Error> uses [] panics never
    let bytes = value.as_bytes()
    if bytes.is_empty() {
        return Err(std.http.Error.BadRequest)
    }
    let mut n = 0usize
    let mut i = 0usize
    while i < bytes.len() {
        let c = std.http.byte_at(bytes, i)
        if c < b'0' || c > b'9' {
            return Err(std.http.Error.BadRequest)
        }
        n = n.saturating_mul(10usize).saturating_add(usize.from_u8(c.wrapping_sub(b'0')))
        if n > max_body {
            return Err(std.http.Error.BodyTooLarge)
        }
        i = i.saturating_add(1usize)
    }
    Ok(n)
end std.http.parse_resp_length

fn std.http.parse_response_head(head: &[u8]) -> Result<std.http.Response, std.http.Error> uses [alloc] panics never
    if std.http.has_bad_ctl(head) {
        return Err(std.http.Error.BadRequest)
    }
    let text = match core.str.from_utf8(head) {
        Ok(t) => t
        Err(_) => return Err(std.http.Error.BadRequest)
    }
    let (line, rest) = match text.split_once("\r\n") {
        Some(pair) => pair
        None => return Err(std.http.Error.BadRequest)
    }
    let (version, after) = match line.split_once(" ") {
        Some(pair) => pair
        None => return Err(std.http.Error.BadRequest)
    }
    let mut http11 = false
    if version == "HTTP/1.1" {
        http11 = true
    } else if version != "HTTP/1.0" {
        return Err(std.http.Error.BadRequest)
    }
    let (code, reason_text) = match after.split_once(" ") {
        Some(pair) => pair
        None => (after, "")
    }
    let status = match std.http.status_code(code) {
        Some(s) => s
        None => return Err(std.http.Error.BadRequest)
    }
    let mut headers = std.vec.Vec.new()
    for field in rest.split("\r\n") {
        if !field.is_empty() {
            let (key, raw_value) = match field.split_once(":") {
                Some(pair) => pair
                None => return Err(std.http.Error.BadRequest)
            }
            let value = raw_value.trim()
            // 要求の解析と同じ検証 (is_tchar / check_header) を使う。
            std.http.check_header(key, value)?
            let name = std.string.String.from_str(key)?
            let text_value = std.string.String.from_str(value)?
            headers.push(std.http.Header {
                name: name
                value: text_value
            })?
        }
    }
    let reason = std.string.String.from_str(reason_text)?
    Ok(std.http.Response {
        headers: headers
        http11: http11
        reason: reason
        status: status
    })
end std.http.parse_response_head

fn std.http.read_request[R: linear + std.io.Read<[io.net]>](source: &mut R, decoder: &mut std.http.Decoder) -> Result<Option<std.http.Request>, std.http.Error> uses [alloc, io.net] panics never pub
    loop {
        match decoder.next()? {
            Some(request) => return Ok(Some(request))
            None => core.mem.drop(0u8)
        }
        let mut chunk = [0u8; 1024]
        let n = source.read(&mut chunk)?
        if n == 0usize {
            if decoder.is_empty() {
                return Ok(None)
            }
            return Err(std.http.Error.Truncated)
        }
        decoder.feed_part(&chunk, n)?
    }
end std.http.read_request

fn std.http.reason(status: u16) -> &'static str uses [] panics never pub
    match status {
        200u16 => "OK"
        201u16 => "Created"
        204u16 => "No Content"
        301u16 => "Moved Permanently"
        302u16 => "Found"
        400u16 => "Bad Request"
        404u16 => "Not Found"
        405u16 => "Method Not Allowed"
        413u16 => "Payload Too Large"
        431u16 => "Request Header Fields Too Large"
        500u16 => "Internal Server Error"
        501u16 => "Not Implemented"
        503u16 => "Service Unavailable"
        _ => "Unknown"
    }
end std.http.reason

fn std.http.render(status: u16, head: &str, body: &[u8], keep_alive: bool) -> Result<std.vec.Vec<u8>, std.http.Error> uses [alloc] panics never pub
    // ステータスは HTTP の範囲 (100–599) に限る。
    if status < 100u16 || status > 599u16 {
        return Err(std.http.Error.BadRequest)
    }
    // `head` の各見出し行を検証する。裸の LF / CR や CTL、トークン外の名前、
    // render が自分で付ける Content-Length / Transfer-Encoding との衝突を拒む。
    for line in head.split("\r\n") {
        if line.is_empty() {
            continue
        }
        let (key, raw_value) = match line.split_once(":") {
            Some(pair) => pair
            None => return Err(std.http.Error.BadRequest)
        }
        if key.eq_ignore_ascii_case("content-length") || key.eq_ignore_ascii_case("transfer-encoding") {
            return Err(std.http.Error.BadRequest)
        }
        // 生の値（trim 前）に HTAB 以外の制御バイトを含めない。
        std.http.check_header(key, raw_value)?
    }
    let mut out = std.vec.Vec.new()
    let mut line = std.string.String.new()
    line.push_str("HTTP/1.1 ")?
    line.push_u64(u64.from_u16(status))?
    line.push_str(" ")?
    line.push_str(std.http.reason(status))?
    line.push_str("\r\n")?
    out.extend_from_slice(line.as_str().as_bytes())?
    out.extend_from_slice(head.as_bytes())?
    let mut length = std.string.String.new()
    length.push_u64(u64.from_usize(body.len()))?
    out.extend_from_slice(b"Content-Length: ")?
    out.extend_from_slice(length.as_str().as_bytes())?
    out.extend_from_slice(b"\r\n")?
    if keep_alive {
        out.extend_from_slice(b"Connection: keep-alive\r\n\r\n")?
    } else {
        out.extend_from_slice(b"Connection: close\r\n\r\n")?
    }
    out.extend_from_slice(body)?
    Ok(out)
end std.http.render

fn std.http.response_framing(resp: &std.http.Response, max_body: usize) -> Result<(u8, usize), std.http.Error> uses [] panics never
    let mut n_len = 0usize
    let mut n_te = 0usize
    let mut length = 0usize
    let mut te_chunked = false
    for k in core.iter.range(0usize, resp.headers.len()) {
        match resp.headers.as_slice().get(k) {
            Some(h) => if h.name.as_str().eq_ignore_ascii_case("content-length") {
                n_len = n_len.saturating_add(1usize)
                length = std.http.parse_resp_length(h.value.as_str(), max_body)?
            } else if h.name.as_str().eq_ignore_ascii_case("transfer-encoding") {
                n_te = n_te.saturating_add(1usize)
                te_chunked = h.value.as_str().eq_ignore_ascii_case("chunked")
            }
            None => core.mem.drop(0u8)
        }
    }
    if n_len > 1usize || n_te > 1usize {
        return Err(std.http.Error.BadRequest)
    }
    if n_len == 1usize && n_te == 1usize {
        return Err(std.http.Error.BadRequest)
    }
    let mut kind = 0u8
    if n_te == 1usize {
        if !te_chunked {
            return Err(std.http.Error.Unsupported)
        }
        if !resp.http11 {
            return Err(std.http.Error.BadRequest)
        }
        kind = 2u8
    } else if n_len == 1usize {
        kind = 1u8
    }
    if resp.status < 200u16 || resp.status == 204u16 || resp.status == 304u16 {
        return Ok((3u8, 0usize))
    }
    Ok((kind, length))
end std.http.response_framing

fn std.http.skip_trailers(data: &[u8], from: usize) -> Result<Option<usize>, std.http.Error> uses [] panics never
    let mut pos = from
    loop {
        let stop = match std.http.find_crlf(data, pos) {
            Some(e) => e
            None => return Ok(None)
        }
        if stop == pos {
            return Ok(Some(stop.saturating_add(2usize)))
        }
        pos = stop.saturating_add(2usize)
    }
end std.http.skip_trailers

fn std.http.status_code(text: &str) -> Option<u16> uses [] panics never
    let b = text.as_bytes()
    if b.len() != 3usize {
        return None
    }
    let mut st = 0u16
    let mut i = 0usize
    while i < 3usize {
        let c = std.http.byte_at(b, i)
        if c < b'0' || c > b'9' {
            return None
        }
        st = st.wrapping_mul(10u16).wrapping_add(u16.from_u8(c.wrapping_sub(b'0')))
        i = i.saturating_add(1usize)
    }
    if st < 100u16 {
        return None
    }
    Some(st)
end std.http.status_code

fn std.http.take_request(data: &[u8], max_head: usize, max_body: usize) -> Result<Option<(std.http.Request, usize)>, std.http.Error> uses [alloc] panics never
    let head_end = match std.http.find_head_end(data) {
        Some(n) => n
        None => {
            // 頭がまだ終わっていない。見た範囲に裸の LF / CR やその他の制御バイトがあれば誤り (RFC 9112)。
            if std.http.has_bad_ctl(data) {
                return Err(std.http.Error.BadRequest)
            }
            if data.len() > max_head {
                return Err(std.http.Error.HeadTooLarge)
            }
            return Ok(None)
        }
    }
    if head_end > max_head {
        return Err(std.http.Error.HeadTooLarge)
    }
    let head_bytes = match data.sub(0usize, head_end) {
        Some(h) => h
        None => return Err(std.http.Error.BadRequest)
    }
    let head = std.http.parse_head(head_bytes, max_body)?
    if head.framing.chunked {
        let rest = match data.sub(head_end, data.len()) {
            Some(r) => r
            None => return Err(std.http.Error.BadRequest)
        }
        let mut chunks = std.vec.Vec.new()
        return match std.http.decode_chunked(rest, max_body, &mut chunks)? {
            Some(used) => {
                let request = std.http.assemble(head, chunks)
                Ok(Some((request, head_end.saturating_add(used))))
            }
            None => Ok(None)
        }
    }
    let total = head_end.saturating_add(head.framing.length)
    if data.len() < total {
        return Ok(None)
    }
    let part = match data.sub(head_end, total) {
        Some(p) => p
        None => return Err(std.http.Error.BadRequest)
    }
    let mut plain = std.vec.Vec.new()
    plain.extend_from_slice(part)?
    Ok(Some((std.http.assemble(head, plain), total)))
end std.http.take_request

fn std.http.write_all[W: linear + std.io.Write<[io.net]>](out: &mut W, bytes: &[u8]) -> Result<(), std.http.Error> uses [io.net] panics never pub
    let mut sent = 0usize
    while sent < bytes.len() {
        let rest = match bytes.sub(sent, bytes.len()) {
            Some(r) => r
            None => return Err(std.http.Error.BadRequest)
        }
        let n = out.write(rest)?
        if n == 0usize {
            let broken = std.io.Error {
                kind: std.io.ErrorKind.BrokenPipe
                code: 0i32
            }
            return Err(std.http.Error.Io(broken))
        }
        sent = sent.saturating_add(n)
    }
    out.flush()?
    Ok(())
end std.http.write_all
