type std.json.Doc pub
    links: std.vec.Vec<usize>
    nodes: std.vec.Vec<std.json.Node>
    top: usize
end std.json.Doc

enum std.json.Error derive [Debug, Clone, Copy, PartialEq, Eq, From] pub
    Alloc(alloc.alloc.AllocError)
    BadEscape(usize)
    BadNumber(usize)
    Depth(usize)
    Eof
    MissingField(usize)
    MissingPayload
    OutOfRange
    Trailing(usize)
    TypeMismatch(std.json.Kind)
    Unexpected(usize)
    UnknownVariant
end std.json.Error

trait std.json.FromJson pub
end std.json.FromJson

enum std.json.Kind derive [Debug, Clone, Copy, PartialEq, Eq] pub
    Array
    Bool
    Null
    Number
    Object
    Str
end std.json.Kind

enum std.json.Node pub
    Array(usize, usize)
    Bool(bool)
    Null
    Number(std.string.String)
    Object(usize, usize)
    Str(std.string.String)
end std.json.Node

trait std.json.ToJson pub
    fn to_json(self: &Self, out: &mut std.string.String) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never
end std.json.ToJson

type std.json.Value derive [Clone, Copy] pub
    at: usize
end std.json.Value

impl std.json.FromJson for bool

impl std.json.FromJson for i16

impl std.json.FromJson for i32

impl std.json.FromJson for i64

impl std.json.FromJson for i8

impl std.json.FromJson for isize

impl std.json.FromJson for std.string.String

impl std.json.FromJson for u16

impl std.json.FromJson for u32

impl std.json.FromJson for u64

impl std.json.FromJson for u8

impl std.json.FromJson for usize

impl[T: std.json.FromJson] std.json.FromJson for core.option.Option<T>

impl[T: std.json.FromJson] std.json.FromJson for std.vec.Vec<T>

fn std.json.Doc.root(self: &std.json.Doc) -> std.json.Value uses [] panics never pub
    std.json.Value {
        at: self.top
    }
end std.json.Doc.root

fn std.json.Doc.value_at(self: &std.json.Doc, at: usize) -> Option<std.json.Value> uses [] panics never pub
    if at >= self.nodes.len() {
        None
    } else {
        Some(std.json.Value {
            at: at
        })
    }
end std.json.Doc.value_at

impl[A: alloc.alloc.Allocator] std.json.ToJson for alloc.string.String<A>
fn std.json.ToJson.alloc.string.String.to_json[A: alloc.alloc.Allocator](self: &alloc.string.String<A>, out: &mut std.string.String) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never impls std.json.ToJson
    std.json.push_quoted(out, self.as_str())
end std.json.ToJson.alloc.string.String.to_json

impl[T: std.json.ToJson, A: alloc.alloc.Allocator] std.json.ToJson for alloc.vec.Vec<T, A>
fn std.json.ToJson.alloc.vec.Vec.to_json[T: std.json.ToJson, A: alloc.alloc.Allocator](self: &alloc.vec.Vec<T, A>, out: &mut std.string.String) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never impls std.json.ToJson
    let all = self.as_slice()
    out.push('[')?
    for k in core.iter.range(0usize, all.len()) {
        if k > 0usize {
            out.push(',')?
        }
        match all.get(k) {
            Some(x) => x.to_json(out)?
            None => return Ok(())
        }
    }
    out.push(']')
end std.json.ToJson.alloc.vec.Vec.to_json

impl std.json.ToJson for bool
fn std.json.ToJson.bool.to_json(self: &bool, out: &mut std.string.String) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never impls std.json.ToJson
    if *self {
        out.push_str("true")
    } else {
        out.push_str("false")
    }
end std.json.ToJson.bool.to_json

impl[T: std.json.ToJson] std.json.ToJson for core.option.Option<T>
fn std.json.ToJson.core.option.Option.to_json[T: std.json.ToJson](self: &Option<T>, out: &mut std.string.String) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never impls std.json.ToJson
    match self {
        Some(x) => x.to_json(out)
        None => out.push_str("null")
    }
end std.json.ToJson.core.option.Option.to_json

impl std.json.ToJson for i16
fn std.json.ToJson.i16.to_json(self: &i16, out: &mut std.string.String) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never impls std.json.ToJson
    out.push_i64(i64.from_i16(*self))
end std.json.ToJson.i16.to_json

