impl std.json.ToJson for i64
fn std.json.ToJson.i64.to_json(self: &i64, out: &mut std.string.String) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never impls std.json.ToJson
    out.push_i64(*self)
end std.json.ToJson.i64.to_json

impl std.json.ToJson for i8
fn std.json.ToJson.i8.to_json(self: &i8, out: &mut std.string.String) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never impls std.json.ToJson
