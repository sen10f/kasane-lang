    let text = std.json.number_text(doc, v)?
    match u32.parse(text) {
        Ok(x) => Ok(x)
        Err(_) => Err(std.json.Error.OutOfRange)
    }
end std.json.decode_u32

fn std.json.decode_u64(doc: &std.json.Doc, v: std.json.Value) -> Result<u64, std.json.Error> uses [] panics never pub
    let text = std.json.number_text(doc, v)?
    match u64.parse(text) {
        Ok(x) => Ok(x)
        Err(_) => Err(std.json.Error.OutOfRange)
    }
end std.json.decode_u64

fn std.json.decode_u8(doc: &std.json.Doc, v: std.json.Value) -> Result<u8, std.json.Error> uses [] panics never pub
    let text = std.json.number_text(doc, v)?
    match u8.parse(text) {
        Ok(x) => Ok(x)
        Err(_) => Err(std.json.Error.OutOfRange)
    }
end std.json.decode_u8

fn std.json.decode_usize(doc: &std.json.Doc, v: std.json.Value) -> Result<usize, std.json.Error> uses [] panics never pub
    let text = std.json.number_text(doc, v)?
    match usize.parse(text) {
        Ok(x) => Ok(x)
        Err(_) => Err(std.json.Error.OutOfRange)
    }
end std.json.decode_usize

fn std.json.decode_variant(doc: &std.json.Doc, v: std.json.Value) -> Result<(&str, Option<std.json.Value>), std.json.Error> uses [] panics never pub
    if std.json.text_at(doc, v.at) is Some(_) {
        let name = std.json.str_at(doc, v.at)?
        return Ok((name, None))
    }
    match std.json.obj_at(doc, v.at) {
        Some((first, pairs)) => {
            if pairs != 1usize {
                return Err(std.json.Error.TypeMismatch(std.json.Kind.Object))
            }
            let name = std.json.str_at(doc, std.json.link_at(doc, first)?)?
            let at = std.json.link_at(doc, first.wrapping_add(1usize))?
            Ok((name, Some(std.json.Value {
                at: at
            })))
        }
        None => Err(std.json.Error.TypeMismatch(std.json.kind_at(doc, v)))
    }
end std.json.decode_variant

fn std.json.digits(src: &[u8], pos: usize) -> usize uses [] panics never
    let mut i = pos
    loop {
        match src.get(i) {
            Some(c) => if *c >= b'0' && *c <= b'9' {
                i = i.wrapping_add(1usize)
            } else {
                break
            }
            None => break
        }
    }
    i
end std.json.digits

fn std.json.flush(doc: &mut std.json.Doc, items: &std.vec.Vec<usize>) -> Result<(), std.json.Error> uses [alloc] panics never
    let all = items.as_slice()
    for k in core.iter.range(0usize, all.len()) {
        match all.get(k) {
            Some(n) => doc.links.push(*n)?
            None => return Err(std.json.Error.Eof)
        }
    }
    Ok(())
end std.json.flush

fn std.json.hex4(src: &[u8], pos: usize) -> Result<u32, std.json.Error> uses [] panics never
    let mut value = 0u32
    for k in core.iter.range(0usize, 4usize) {
        match src.get(pos.wrapping_add(k)) {
            Some(c) => match std.json.hex_value(*c) {
                Some(d) => {
                    value = value.wrapping_shl(4u32) | d
                }
                None => return Err(std.json.Error.BadEscape(pos))
            }
            None => return Err(std.json.Error.Eof)
        }
    }
    Ok(value)
end std.json.hex4

fn std.json.hex_char(n: u32) -> char uses [] panics never
    let mut code = n.wrapping_add(87u32)
    if n < 10u32 {
        code = n.wrapping_add(48u32)
    }
    std.json.char_of(code)
end std.json.hex_char

fn std.json.hex_value(c: u8) -> Option<u32> uses [] panics never
    if c >= b'0' && c <= b'9' {
        return Some(u32.from_u8(c.wrapping_sub(b'0')))
    }
    if c >= b'a' && c <= b'f' {
        return Some(u32.from_u8(c.wrapping_sub(b'a')).wrapping_add(10u32))
    }
    if c >= b'A' && c <= b'F' {
        return Some(u32.from_u8(c.wrapping_sub(b'A')).wrapping_add(10u32))
    }
    None
end std.json.hex_value

fn std.json.is_null(doc: &std.json.Doc, v: std.json.Value) -> bool uses [] panics never pub
    match doc.nodes.as_slice().get(v.at) {
        Some(std.json.Node.Null) => true
        Some(std.json.Node.Array(_, _)) => false
        Some(std.json.Node.Bool(_)) => false
        Some(std.json.Node.Number(_)) => false
        Some(std.json.Node.Object(_, _)) => false
        Some(std.json.Node.Str(_)) => false
        None => true
    }
end std.json.is_null

fn std.json.kind_at(doc: &std.json.Doc, v: std.json.Value) -> std.json.Kind uses [] panics never pub
    match doc.nodes.as_slice().get(v.at) {
        Some(std.json.Node.Array(_, _)) => std.json.Kind.Array
        Some(std.json.Node.Bool(_)) => std.json.Kind.Bool
        Some(std.json.Node.Number(_)) => std.json.Kind.Number
        Some(std.json.Node.Object(_, _)) => std.json.Kind.Object
        Some(std.json.Node.Str(_)) => std.json.Kind.Str
        Some(std.json.Node.Null) => std.json.Kind.Null
        None => std.json.Kind.Null
    }
end std.json.kind_at

fn std.json.link_at(doc: &std.json.Doc, slot: usize) -> Result<usize, std.json.Error> uses [] panics never
    match doc.links.as_slice().get(slot) {
        Some(n) => Ok(*n)
        None => Err(std.json.Error.Eof)
    }
end std.json.link_at

fn std.json.new_doc() -> std.json.Doc uses [] panics never
    std.json.Doc {
        links: std.json.new_links()
        nodes: std.json.new_nodes()
        top: 0usize
    }
end std.json.new_doc

fn std.json.new_links() -> std.vec.Vec<usize> uses [] panics never
    std.vec.Vec.new()
end std.json.new_links

fn std.json.new_nodes() -> std.vec.Vec<std.json.Node> uses [] panics never
    std.vec.Vec.new()
end std.json.new_nodes

fn std.json.new_text() -> std.string.String uses [] panics never
    std.string.String.new()
end std.json.new_text

fn std.json.num_at(doc: &std.json.Doc, at: usize) -> Option<&str> uses [] panics never
    match doc.nodes.as_slice().get(at) {
        Some(std.json.Node.Number(s)) => Some(s.as_str())
        Some(std.json.Node.Array(_, _)) => None
        Some(std.json.Node.Bool(_)) => None
        Some(std.json.Node.Null) => None
        Some(std.json.Node.Object(_, _)) => None
        Some(std.json.Node.Str(_)) => None
        None => None
    }
end std.json.num_at

fn std.json.number_text(doc: &std.json.Doc, v: std.json.Value) -> Result<&str, std.json.Error> uses [] panics never
    match std.json.num_at(doc, v.at) {
        Some(s) => Ok(s)
        None => Err(std.json.Error.TypeMismatch(std.json.kind_at(doc, v)))
    }
end std.json.number_text

fn std.json.obj_at(doc: &std.json.Doc, at: usize) -> Option<(usize, usize)> uses [] panics never
    match doc.nodes.as_slice().get(at) {
        Some(std.json.Node.Object(first, pairs)) => Some((*first, *pairs))
        Some(std.json.Node.Array(_, _)) => None
        Some(std.json.Node.Bool(_)) => None
        Some(std.json.Node.Null) => None
        Some(std.json.Node.Number(_)) => None
        Some(std.json.Node.Str(_)) => None
        None => None
    }
end std.json.obj_at

fn std.json.parse(text: &str) -> Result<std.json.Doc, std.json.Error> uses [alloc] panics never pub
    let src = text.as_bytes()
    let mut doc = std.json.new_doc()
    let start = std.json.skip_ws(src, 0usize)
    let (root, after) = std.json.parse_value(&mut doc, src, start, 0usize)?
    let tail = std.json.skip_ws(src, after)
    if tail != src.len() {
        return Err(std.json.Error.Trailing(tail))
    }
    doc.top = root
    Ok(doc)
end std.json.parse

fn std.json.parse_array(doc: &mut std.json.Doc, src: &[u8], pos: usize, depth: usize) -> Result<(usize, usize), std.json.Error> uses [alloc] panics never stack 4096
    let mut items = std.json.new_links()
    let mut i = std.json.skip_ws(src, pos.wrapping_add(1usize))
    let mut close = i
    if src.get(i) != Some(&b']') {
        loop {
            let (child, after) = std.json.parse_value(doc, src, i, depth.wrapping_add(1usize))?
            items.push(child)?
            let j = std.json.skip_ws(src, after)
            match src.get(j) {
                Some(b',') => {
                    i = std.json.skip_ws(src, j.wrapping_add(1usize))
                }
                Some(b']') => {
                    close = j
                    break
                }
                Some(_) => return Err(std.json.Error.Unexpected(j))
                None => return Err(std.json.Error.Eof)
            }
        }
    }
    let first = doc.links.len()
    let count = items.len()
    std.json.flush(doc, &items)?
    let at = std.json.push_node(doc, std.json.Node.Array(first, count))?
    Ok((at, close.wrapping_add(1usize)))
end std.json.parse_array

fn std.json.parse_escape(src: &[u8], pos: usize, out: &mut std.string.String) -> Result<usize, std.json.Error> uses [alloc] panics never
    let next = pos.wrapping_add(2usize)
    match src.get(pos.wrapping_add(1usize)) {
        None => Err(std.json.Error.Eof)
        Some(b'u') => std.json.parse_unicode(src, pos, out)
        Some(b'"') => {
            out.push('"')?
            Ok(next)
        }
        Some(b'\\') => {
            out.push('\\')?
            Ok(next)
        }
        Some(b'/') => {
            out.push('/')?
            Ok(next)
        }
        Some(b'b') => {
            out.push(std.json.char_of(8u32))?
            Ok(next)
        }
        Some(b'f') => {
            out.push(std.json.char_of(12u32))?
            Ok(next)
        }
        Some(b'n') => {
            out.push('\n')?
            Ok(next)
        }
        Some(b'r') => {
            out.push('\r')?
            Ok(next)
        }
        Some(b't') => {
            out.push('\t')?
            Ok(next)
        }
        Some(_) => Err(std.json.Error.BadEscape(pos))
    }
end std.json.parse_escape

fn std.json.parse_literal(doc: &mut std.json.Doc, src: &[u8], pos: usize, word: &str, node: std.json.Node) -> Result<(usize, usize), std.json.Error> uses [alloc] panics never
    let want = word.as_bytes()
    let stop = pos.wrapping_add(want.len())
    match src.sub(pos, stop) {
        Some(got) => if got == want {
            let at = std.json.push_node(doc, node)?
            Ok((at, stop))
        } else {
            Err(std.json.Error.Unexpected(pos))
        }
        None => Err(std.json.Error.Eof)
    }
end std.json.parse_literal

fn std.json.parse_number(doc: &mut std.json.Doc, src: &[u8], pos: usize) -> Result<(usize, usize), std.json.Error> uses [alloc] panics never
    let mut i = pos
    if src.get(i) == Some(&b'-') {
        i = i.wrapping_add(1usize)
    }
    let int_end = std.json.digits(src, i)
    if int_end == i {
        return Err(std.json.Error.BadNumber(pos))
    }
    if src.get(i) == Some(&b'0') && int_end != i.wrapping_add(1usize) {
        return Err(std.json.Error.BadNumber(pos))
    }
    i = int_end
    if src.get(i) == Some(&b'.') {
        let frac_end = std.json.digits(src, i.wrapping_add(1usize))
        if frac_end == i.wrapping_add(1usize) {
            return Err(std.json.Error.BadNumber(pos))
        }
        i = frac_end
    }
    let e = src.get(i)
    if e == Some(&b'e') || e == Some(&b'E') {
        let mut k = i.wrapping_add(1usize)
        let sign = src.get(k)
        if sign == Some(&b'+') || sign == Some(&b'-') {
            k = k.wrapping_add(1usize)
        }
        let exp_end = std.json.digits(src, k)
        if exp_end == k {
            return Err(std.json.Error.BadNumber(pos))
        }
        i = exp_end
    }
    let mut text = std.json.new_text()
    std.json.push_range(&mut text, src, pos, i)?
    let at = std.json.push_node(doc, std.json.Node.Number(text))?
    Ok((at, i))
end std.json.parse_number

fn std.json.parse_object(doc: &mut std.json.Doc, src: &[u8], pos: usize, depth: usize) -> Result<(usize, usize), std.json.Error> uses [alloc] panics never stack 4096
    let mut items = std.json.new_links()
    let mut i = std.json.skip_ws(src, pos.wrapping_add(1usize))
    let mut close = i
    if src.get(i) != Some(&b'}') {
        loop {
            if src.get(i) != Some(&b'"') {
                return Err(std.json.Error.Unexpected(i))
            }
            let (key, after_key) = std.json.parse_string(src, i)?
            let key_at = std.json.push_node(doc, std.json.Node.Str(key))?
            let colon = std.json.skip_ws(src, after_key)
            if src.get(colon) != Some(&b':') {
                return Err(std.json.Error.Unexpected(colon))
            }
            let start = std.json.skip_ws(src, colon.wrapping_add(1usize))
            let deeper = depth.wrapping_add(1usize)
            let (value, after_value) = std.json.parse_value(doc, src, start, deeper)?
            items.push(key_at)?
            items.push(value)?
            let j = std.json.skip_ws(src, after_value)
            match src.get(j) {
                Some(b',') => {
                    i = std.json.skip_ws(src, j.wrapping_add(1usize))
                }
                Some(b'}') => {
                    close = j
                    break
                }
                Some(_) => return Err(std.json.Error.Unexpected(j))
                None => return Err(std.json.Error.Eof)
            }
        }
    }
    let first = doc.links.len()
    let pairs = items.len().wrapping_shr(1u32)
    std.json.flush(doc, &items)?
    let at = std.json.push_node(doc, std.json.Node.Object(first, pairs))?
    Ok((at, close.wrapping_add(1usize)))
end std.json.parse_object

fn std.json.parse_string(src: &[u8], pos: usize) -> Result<(std.string.String, usize), std.json.Error> uses [alloc] panics never
    let mut out = std.json.new_text()
    let mut i = pos.wrapping_add(1usize)
    let mut run = i
    loop {
        match src.get(i) {
            None => return Err(std.json.Error.Eof)
            Some(b'"') => break
            Some(b'\\') => {
                std.json.push_range(&mut out, src, run, i)?
                i = std.json.parse_escape(src, i, &mut out)?
                run = i
            }
            Some(c) => {
                if *c < 32u8 {
                    return Err(std.json.Error.Unexpected(i))
                }
                i = i.wrapping_add(1usize)
            }
        }
    }
    std.json.push_range(&mut out, src, run, i)?
    Ok((out, i.wrapping_add(1usize)))
end std.json.parse_string

fn std.json.parse_unicode(src: &[u8], pos: usize, out: &mut std.string.String) -> Result<usize, std.json.Error> uses [alloc] panics never
    let first = std.json.hex4(src, pos.wrapping_add(2usize))?
    let mut code = first
    let mut next = pos.wrapping_add(6usize)
    if first >= 56_320u32 && first <= 57_343u32 {
        return Err(std.json.Error.BadEscape(pos))
    }
    if first >= 55_296u32 && first <= 56_319u32 {
        if src.get(next) != Some(&b'\\') || src.get(next.wrapping_add(1usize)) != Some(&b'u') {
            return Err(std.json.Error.BadEscape(pos))
        }
        let low = std.json.hex4(src, next.wrapping_add(2usize))?
        if low < 56_320u32 || low > 57_343u32 {
            return Err(std.json.Error.BadEscape(pos))
        }
        let high_bits = first.wrapping_sub(55_296u32).wrapping_shl(10u32)
        code = 65_536u32.wrapping_add(high_bits).wrapping_add(low.wrapping_sub(56_320u32))
        next = next.wrapping_add(6usize)
    }
    match char.try_from_u32(code) {
        Some(c) => {
            out.push(c)?
            Ok(next)
        }
        None => Err(std.json.Error.BadEscape(pos))
    }
end std.json.parse_unicode

fn std.json.parse_value(doc: &mut std.json.Doc, src: &[u8], pos: usize, depth: usize) -> Result<(usize, usize), std.json.Error> uses [alloc] panics never stack 4096
    if depth > 128usize {
        return Err(std.json.Error.Depth(pos))
    }
    match src.get(pos) {
        None => Err(std.json.Error.Eof)
        Some(b'{') => std.json.parse_object(doc, src, pos, depth)
        Some(b'[') => std.json.parse_array(doc, src, pos, depth)
        Some(b'"') => {
            let (text, after) = std.json.parse_string(src, pos)?
            let at = std.json.push_node(doc, std.json.Node.Str(text))?
            Ok((at, after))
        }
        Some(b't') => std.json.parse_literal(doc, src, pos, "true", std.json.Node.Bool(true))
        Some(b'f') => std.json.parse_literal(doc, src, pos, "false", std.json.Node.Bool(false))
        Some(b'n') => std.json.parse_literal(doc, src, pos, "null", std.json.Node.Null)
        Some(_) => std.json.parse_number(doc, src, pos)
    }
end std.json.parse_value

fn std.json.push_control(out: &mut std.string.String, unit: u32) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never
    out.push_str("\\u00")?
    out.push(std.json.hex_char(unit.wrapping_shr(4u32) & 15u32))?
    out.push(std.json.hex_char(unit & 15u32))?
    Ok(())
end std.json.push_control

fn std.json.push_node(doc: &mut std.json.Doc, node: std.json.Node) -> Result<usize, std.json.Error> uses [alloc] panics never
    let at = doc.nodes.len()
    doc.nodes.push(node)?
    Ok(at)
end std.json.push_node

fn std.json.push_quoted(out: &mut std.string.String, text: &str) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never pub
    out.push('"')?
    for c in text.chars() {
        if c == '"' {
            out.push_str("\\\"")?
        } else if c == '\\' {
            out.push_str("\\\\")?
        } else if c == '\n' {
            out.push_str("\\n")?
        } else if c == '\r' {
            out.push_str("\\r")?
        } else if c == '\t' {
            out.push_str("\\t")?
        } else if c.to_u32() < 32u32 {
            std.json.push_control(out, c.to_u32())?
        } else {
            out.push(c)?
        }
    }
    out.push('"')?
    Ok(())
end std.json.push_quoted

fn std.json.push_range(out: &mut std.string.String, src: &[u8], from: usize, to: usize) -> Result<(), std.json.Error> uses [alloc] panics never
    match src.sub(from, to) {
        Some(bytes) => match core.str.from_utf8(bytes) {
            Ok(text) => {
                out.push_str(text)?
                Ok(())
            }
            Err(_) => Err(std.json.Error.Unexpected(from))
        }
        None => Err(std.json.Error.Eof)
    }
end std.json.push_range

fn std.json.skip_ws(src: &[u8], pos: usize) -> usize uses [] panics never
    let mut i = pos
    loop {
        match src.get(i) {
            Some(c) => if *c == b' ' || *c == b'\n' || *c == b'\t' || *c == b'\r' {
                i = i.wrapping_add(1usize)
            } else {
                break
            }
            None => break
        }
    }
    i
end std.json.skip_ws

fn std.json.str_at(doc: &std.json.Doc, at: usize) -> Result<&str, std.json.Error> uses [] panics never
    match std.json.text_at(doc, at) {
        Some(s) => Ok(s)
        None => Err(std.json.Error.TypeMismatch(std.json.Kind.Str))
    }
end std.json.str_at

fn std.json.text_at(doc: &std.json.Doc, at: usize) -> Option<&str> uses [] panics never
    match doc.nodes.as_slice().get(at) {
        Some(std.json.Node.Str(s)) => Some(s.as_str())
        Some(std.json.Node.Array(_, _)) => None
        Some(std.json.Node.Bool(_)) => None
        Some(std.json.Node.Null) => None
        Some(std.json.Node.Number(_)) => None
        Some(std.json.Node.Object(_, _)) => None
        None => None
    }
end std.json.text_at

fn std.json.to_string[T: std.json.ToJson](value: &T) -> Result<std.string.String, alloc.alloc.AllocError> uses [alloc] panics never pub
    let mut out = std.json.new_text()
    value.to_json(&mut out)?
    Ok(out)
end std.json.to_string

fn std.json.write(doc: &std.json.Doc, v: std.json.Value, out: &mut std.string.String) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never stack 4096 pub
    match doc.nodes.as_slice().get(v.at) {
        None => out.push_str("null")
        Some(std.json.Node.Null) => out.push_str("null")
        Some(std.json.Node.Bool(b)) => if *b {
            out.push_str("true")
        } else {
            out.push_str("false")
        }
        Some(std.json.Node.Number(s)) => out.push_str(s.as_str())
        Some(std.json.Node.Str(s)) => std.json.push_quoted(out, s.as_str())
        Some(std.json.Node.Array(first, count)) => {
            out.push('[')?
            for k in core.iter.range(0usize, *count) {
                if k > 0usize {
                    out.push(',')?
                }
                std.json.write_link(doc, first.wrapping_add(k), out)?
            }
            out.push(']')
        }
        Some(std.json.Node.Object(first, pairs)) => {
            out.push('{')?
            for k in core.iter.range(0usize, *pairs) {
                if k > 0usize {
                    out.push(',')?
                }
                let slot = first.wrapping_add(k.wrapping_mul(2usize))
                std.json.write_link(doc, slot, out)?
                out.push(':')?
                std.json.write_link(doc, slot.wrapping_add(1usize), out)?
            }
            out.push('}')
        }
    }
end std.json.write

fn std.json.write_link(doc: &std.json.Doc, slot: usize, out: &mut std.string.String) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never stack 4096
    match doc.links.as_slice().get(slot) {
        Some(n) => std.json.write(doc, std.json.Value {
            at: *n
        }, out)
        None => Ok(())
    }
end std.json.write_link
