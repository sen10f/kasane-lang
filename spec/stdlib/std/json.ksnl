fn std.json.Value.index(self: &std.json.Value) -> usize uses [] panics never pub
    self.at
end std.json.Value.index

fn std.json.arr_at(doc: &std.json.Doc, at: usize) -> Option<(usize, usize)> uses [] panics never
    match doc.nodes.as_slice().get(at) {
        Some(std.json.Node.Array(first, count)) => Some((*first, *count))
        Some(std.json.Node.Bool(_)) => None
        Some(std.json.Node.Null) => None
        Some(std.json.Node.Number(_)) => None
        Some(std.json.Node.Object(_, _)) => None
        Some(std.json.Node.Str(_)) => None
        None => None
    }
end std.json.arr_at

fn std.json.bool_at(doc: &std.json.Doc, at: usize) -> Option<bool> uses [] panics never
    match doc.nodes.as_slice().get(at) {
        Some(std.json.Node.Bool(b)) => Some(*b)
        Some(std.json.Node.Array(_, _)) => None
        Some(std.json.Node.Null) => None
        Some(std.json.Node.Number(_)) => None
        Some(std.json.Node.Object(_, _)) => None
        Some(std.json.Node.Str(_)) => None
        None => None
    }
end std.json.bool_at

fn std.json.char_of(code: u32) -> char uses [] panics never
    char.try_from_u32(code).unwrap_or('?')
end std.json.char_of

fn std.json.decode_bool(doc: &std.json.Doc, v: std.json.Value) -> Result<bool, std.json.Error> uses [] panics never pub
    match std.json.bool_at(doc, v.at) {
        Some(b) => Ok(b)
        None => Err(std.json.Error.TypeMismatch(std.json.kind_at(doc, v)))
    }
end std.json.decode_bool

fn std.json.decode_field(doc: &std.json.Doc, v: std.json.Value, name: &str, index: usize) -> Result<std.json.Value, std.json.Error> uses [] panics never pub
    match std.json.obj_at(doc, v.at) {
        Some((first, pairs)) => {
            for k in core.iter.range(0usize, pairs) {
                let slot = first.wrapping_add(k.wrapping_mul(2usize))
                let key = std.json.str_at(doc, std.json.link_at(doc, slot)?)?
                if key == name {
                    let at = std.json.link_at(doc, slot.wrapping_add(1usize))?
                    return Ok(std.json.Value {
                        at: at
                    })
                }
            }
            Err(std.json.Error.MissingField(index))
        }
        None => Err(std.json.Error.TypeMismatch(std.json.kind_at(doc, v)))
    }
end std.json.decode_field

fn std.json.decode_i16(doc: &std.json.Doc, v: std.json.Value) -> Result<i16, std.json.Error> uses [] panics never pub
    let text = std.json.number_text(doc, v)?
    match i16.parse(text) {
        Ok(x) => Ok(x)
        Err(_) => Err(std.json.Error.OutOfRange)
    }
end std.json.decode_i16

fn std.json.decode_i32(doc: &std.json.Doc, v: std.json.Value) -> Result<i32, std.json.Error> uses [] panics never pub
    let text = std.json.number_text(doc, v)?
    match i32.parse(text) {
        Ok(x) => Ok(x)
        Err(_) => Err(std.json.Error.OutOfRange)
    }
end std.json.decode_i32

fn std.json.decode_i64(doc: &std.json.Doc, v: std.json.Value) -> Result<i64, std.json.Error> uses [] panics never pub
    let text = std.json.number_text(doc, v)?
    match i64.parse(text) {
        Ok(x) => Ok(x)
        Err(_) => Err(std.json.Error.OutOfRange)
    }
end std.json.decode_i64

fn std.json.decode_i8(doc: &std.json.Doc, v: std.json.Value) -> Result<i8, std.json.Error> uses [] panics never pub
    let text = std.json.number_text(doc, v)?
    match i8.parse(text) {
        Ok(x) => Ok(x)
        Err(_) => Err(std.json.Error.OutOfRange)
    }
end std.json.decode_i8

fn std.json.decode_isize(doc: &std.json.Doc, v: std.json.Value) -> Result<isize, std.json.Error> uses [] panics never pub
    let text = std.json.number_text(doc, v)?
    match isize.parse(text) {
        Ok(x) => Ok(x)
        Err(_) => Err(std.json.Error.OutOfRange)
    }
end std.json.decode_isize

fn std.json.decode_item(doc: &std.json.Doc, v: std.json.Value, index: usize) -> Result<std.json.Value, std.json.Error> uses [] panics never pub
    match std.json.arr_at(doc, v.at) {
        Some((first, count)) => {
            if index >= count {
                return Err(std.json.Error.Eof)
            }
            let at = std.json.link_at(doc, first.wrapping_add(index))?
            Ok(std.json.Value {
                at: at
            })
        }
        None => Err(std.json.Error.TypeMismatch(std.json.kind_at(doc, v)))
    }
end std.json.decode_item

fn std.json.decode_len(doc: &std.json.Doc, v: std.json.Value) -> Result<usize, std.json.Error> uses [] panics never pub
    match std.json.arr_at(doc, v.at) {
        Some((_, count)) => Ok(count)
        None => Err(std.json.Error.TypeMismatch(std.json.kind_at(doc, v)))
    }
end std.json.decode_len

fn std.json.decode_payload(payload: Option<std.json.Value>) -> Result<std.json.Value, std.json.Error> uses [] panics never pub
    match payload {
        Some(x) => Ok(x)
        None => Err(std.json.Error.MissingPayload)
    }
end std.json.decode_payload

fn std.json.decode_string(doc: &std.json.Doc, v: std.json.Value) -> Result<std.string.String, std.json.Error> uses [alloc] panics never pub
    match std.json.text_at(doc, v.at) {
        Some(s) => {
            let copy = std.string.String.from_str(s)?
            Ok(copy)
        }
        None => Err(std.json.Error.TypeMismatch(std.json.kind_at(doc, v)))
    }
end std.json.decode_string

fn std.json.decode_tuple(doc: &std.json.Doc, v: std.json.Value, count: usize) -> Result<(), std.json.Error> uses [] panics never pub
    let len = std.json.decode_len(doc, v)?
    if len != count {
        return Err(std.json.Error.TypeMismatch(std.json.Kind.Array))
    }
    Ok(())
end std.json.decode_tuple

fn std.json.decode_u16(doc: &std.json.Doc, v: std.json.Value) -> Result<u16, std.json.Error> uses [] panics never pub
    let text = std.json.number_text(doc, v)?
    match u16.parse(text) {
        Ok(x) => Ok(x)
        Err(_) => Err(std.json.Error.OutOfRange)
    }
end std.json.decode_u16

