impl std.json.ToJson for std.json.Doc
fn std.json.ToJson.std.json.Doc.to_json(self: &std.json.Doc, out: &mut std.string.String) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never impls std.json.ToJson
    std.json.write(self, self.root(), out)
end std.json.ToJson.std.json.Doc.to_json

impl std.json.ToJson for u16
fn std.json.ToJson.u16.to_json(self: &u16, out: &mut std.string.String) -> Result<(), alloc.alloc.AllocError> uses [alloc] panics never impls std.json.ToJson
    out.push_u64(u64.from_u16(*self))
