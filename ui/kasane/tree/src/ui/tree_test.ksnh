type ui.tree_test.Counter derive [Debug, Clone, Copy] pub
    n: u32
end ui.tree_test.Counter

type ui.tree_test.LeafView derive [Debug, Clone, Copy] pub
    w: f32
    h: f32
end ui.tree_test.LeafView

type ui.tree_test.Suite derive [Debug, Clone, Copy] pub
    seed: usize pub
end ui.tree_test.Suite

type ui.tree_test.ViewBox pub
    v: std.boxed.Box<dyn ui.tree.View<[alloc], may> + 'static> pub
end ui.tree_test.ViewBox

impl ui.state.ViewState for ui.tree_test.Counter
fn ui.tree_test.Counter.tick(self: &mut ui.tree_test.Counter) -> () uses [] panics never impls ui.state.ViewState
    let n = self.n
    self.n = n.wrapping_add(1u32)
end ui.tree_test.Counter.tick

impl ui.tree.View<[alloc], may> for ui.tree_test.LeafView
fn ui.tree_test.LeafView.render(self: &ui.tree_test.LeafView, sink: &mut std.vec.Vec<ui.tree.Element>) -> usize uses [alloc] panics may impls ui.tree.View<[alloc], may>
    let index = sink.len()
    let el = ui.tree_test.el(ui.tree.ViewKind.Leaf, None, ui.tree_test.empty_kids())
    match sink.push(el) {
        Ok(_) => ()
        Err(_e) => core.panic.panic("ui.tree.test: oom")
    }
    index
end ui.tree_test.LeafView.render

fn ui.tree_test.el(kind: ui.tree.ViewKind, key: Option<u64>, children: std.vec.Vec<usize>) -> ui.tree.Element uses [] panics never
    ui.tree.Element {
        kind: kind
        style: ui.layout.Style.default()
        key: key
        children: children
    }
end ui.tree_test.el

fn ui.tree_test.empty_kids() -> std.vec.Vec<usize> uses [] panics never
    std.vec.Vec.new()
end ui.tree_test.empty_kids

fn ui.tree_test.new_sink() -> std.vec.Vec<ui.tree.Element> uses [] panics never
    std.vec.Vec.new()
end ui.tree_test.new_sink

fn ui.tree_test.push_block(t: &mut ui.tree.Tree) -> usize uses [alloc] panics never
    match t.push_node(ui.tree.ViewKind.Block, ui.layout.Style.default(), None) {
        Ok(i) => i
        Err(_) => 0usize
    }
end ui.tree_test.push_block

fn ui.tree_test.push_block_el(v: &mut std.vec.Vec<ui.tree.Element>, children: std.vec.Vec<usize>) -> () uses [alloc] panics never
    ui.tree_test.push_el(v, ui.tree_test.el(ui.tree.ViewKind.Block, None, children))
end ui.tree_test.push_block_el

fn ui.tree_test.push_el(v: &mut std.vec.Vec<ui.tree.Element>, e: ui.tree.Element) -> () uses [alloc] panics never
    match v.push(e) {
        Ok(_) => ()
        Err(_) => ()
    }
end ui.tree_test.push_el

fn ui.tree_test.push_kid(kids: &mut std.vec.Vec<usize>, i: usize) -> () uses [alloc] panics never
    match kids.push(i) {
        Ok(_) => ()
        Err(_) => ()
    }
end ui.tree_test.push_kid

fn ui.tree_test.push_leaf(t: &mut ui.tree.Tree) -> usize uses [alloc] panics never
    match t.push_node(ui.tree.ViewKind.Leaf, ui.layout.Style.default(), None) {
        Ok(i) => i
        Err(_) => 0usize
    }
end ui.tree_test.push_leaf

fn ui.tree_test.push_leaf_el(v: &mut std.vec.Vec<ui.tree.Element>, key: Option<u64>) -> () uses [alloc] panics never
    ui.tree_test.push_el(v, ui.tree_test.el(ui.tree.ViewKind.Leaf, key, ui.tree_test.empty_kids()))
end ui.tree_test.push_leaf_el

test ui.tree_test.Suite.test_child_at
    let mut t = ui.tree.Tree.new()
    let root = ui.tree_test.push_block(&mut t)
    let a = ui.tree_test.push_leaf(&mut t)
    let b = ui.tree_test.push_leaf(&mut t)
    core.check.is_true(t.push_child(root, a))
    core.check.is_true(t.push_child(root, b))
    match t.child_at(root, 0usize) {
        Some(v) => core.check.eq(v, a)
        None => core.check.is_true(false)
    }
    match t.child_at(root, 1usize) {
        Some(v) => core.check.eq(v, b)
        None => core.check.is_true(false)
    }
    if let Some(_) = t.child_at(root, 2usize) {
        core.check.is_true(false)
    }
    if let Some(_) = t.child_at(a, 0usize) {
        core.check.is_true(false)
    }
end ui.tree_test.Suite.test_child_at

test ui.tree_test.Suite.test_child_at_node_without_children
    let mut t = ui.tree.Tree.new()
    let root = ui.tree_test.push_block(&mut t)
    let leaf = ui.tree_test.push_leaf(&mut t)
    core.check.is_true(t.push_child(root, leaf))
    if let Some(_) = t.child_at(leaf, 0usize) {
        core.check.is_true(false)
    }
end ui.tree_test.Suite.test_child_at_node_without_children

test ui.tree_test.Suite.test_child_at_out_of_range
    let mut t = ui.tree.Tree.new()
    let root = ui.tree_test.push_block(&mut t)
    if let Some(_) = t.child_at(root, 0usize) {
        core.check.is_true(false)
    }
end ui.tree_test.Suite.test_child_at_out_of_range

test ui.tree_test.Suite.test_child_at_unknown_node
    let t = ui.tree.Tree.new()
    if let Some(_) = t.child_at(99usize, 0usize) {
        core.check.is_true(false)
    }
end ui.tree_test.Suite.test_child_at_unknown_node

test ui.tree_test.Suite.test_commit_build
    let mut t = ui.tree.Tree.new()
    let root = ui.tree_test.push_block(&mut t)
    let mut elements = std.vec.Vec.new()
    let mut root_children = ui.tree_test.empty_kids()
    ui.tree_test.push_kid(&mut root_children, 1usize)
    ui.tree_test.push_kid(&mut root_children, 2usize)
    ui.tree_test.push_block_el(&mut elements, root_children)
    ui.tree_test.push_leaf_el(&mut elements, Some(1u64))
    ui.tree_test.push_leaf_el(&mut elements, Some(2u64))
    match t.commit(root, &elements, 0usize) {
        Ok(_) => ()
        Err(_) => ()
    }
    core.check.eq(t.child_count(root), 2usize)
    match t.node_at(1usize) {
        Some(n) => core.check.eq(n.key, Some(1u64))
        None => core.check.is_true(false)
    }
    match t.node_at(2usize) {
        Some(n) => core.check.eq(n.key, Some(2u64))
        None => core.check.is_true(false)
    }
end ui.tree_test.Suite.test_commit_build

test ui.tree_test.Suite.test_commit_insert
    let mut t = ui.tree.Tree.new()
    let root = ui.tree_test.push_block(&mut t)
    let mut elements = std.vec.Vec.new()
    let mut root_children = ui.tree_test.empty_kids()
    ui.tree_test.push_kid(&mut root_children, 1usize)
    ui.tree_test.push_block_el(&mut elements, root_children)
    ui.tree_test.push_leaf_el(&mut elements, Some(1u64))
    match t.commit(root, &elements, 0usize) {
        Ok(_) => ()
        Err(_) => ()
    }
    core.check.eq(t.child_count(root), 1usize)
    let mut elements2 = std.vec.Vec.new()
    let mut root_children2 = ui.tree_test.empty_kids()
    ui.tree_test.push_kid(&mut root_children2, 1usize)
    ui.tree_test.push_kid(&mut root_children2, 2usize)
    ui.tree_test.push_block_el(&mut elements2, root_children2)
    ui.tree_test.push_leaf_el(&mut elements2, Some(1u64))
    ui.tree_test.push_leaf_el(&mut elements2, Some(2u64))
    match t.commit(root, &elements2, 0usize) {
        Ok(_) => ()
        Err(_) => ()
    }
    core.check.eq(t.child_count(root), 2usize)
    match t.node_at(2usize) {
        Some(n) => core.check.eq(n.key, Some(2u64))
        None => core.check.is_true(false)
    }
end ui.tree_test.Suite.test_commit_insert

test ui.tree_test.Suite.test_commit_remove
    let mut t = ui.tree.Tree.new()
    let root = ui.tree_test.push_block(&mut t)
    let mut elements = std.vec.Vec.new()
    let mut root_children = ui.tree_test.empty_kids()
    ui.tree_test.push_kid(&mut root_children, 1usize)
    ui.tree_test.push_kid(&mut root_children, 2usize)
    ui.tree_test.push_block_el(&mut elements, root_children)
    ui.tree_test.push_leaf_el(&mut elements, Some(1u64))
    ui.tree_test.push_leaf_el(&mut elements, Some(2u64))
    match t.commit(root, &elements, 0usize) {
        Ok(_) => ()
        Err(_) => ()
    }
    core.check.eq(t.child_count(root), 2usize)
    let mut elements2 = std.vec.Vec.new()
    let mut root_children2 = ui.tree_test.empty_kids()
    ui.tree_test.push_kid(&mut root_children2, 1usize)
    ui.tree_test.push_block_el(&mut elements2, root_children2)
    ui.tree_test.push_leaf_el(&mut elements2, Some(1u64))
    match t.commit(root, &elements2, 0usize) {
        Ok(_) => ()
        Err(_) => ()
    }
    core.check.eq(t.child_count(root), 1usize)
end ui.tree_test.Suite.test_commit_remove

test ui.tree_test.Suite.test_commit_returns_index
    let mut t = ui.tree.Tree.new()
    let root = ui.tree_test.push_block(&mut t)
    let mut elements = std.vec.Vec.new()
    ui.tree_test.push_block_el(&mut elements, ui.tree_test.empty_kids())
    match t.commit(root, &elements, 0usize) {
        Ok(i) => core.check.eq(i, root)
        Err(_) => core.check.is_true(false)
    }
end ui.tree_test.Suite.test_commit_returns_index

test ui.tree_test.Suite.test_composite_render
    let leaf = ui.tree_test.LeafView {
        w: 1.0f32
        h: 2.0f32
    }
    let mut sink = ui.tree_test.new_sink()
    let child_index = leaf.render(&mut sink)
    let mut sink2 = ui.tree_test.new_sink()
    let child_el = ui.tree_test.el(ui.tree.ViewKind.Leaf, None, ui.tree_test.empty_kids())
    match sink2.push(child_el) {
        Ok(_) => ()
        Err(_e) => core.panic.panic("oom")
    }
    let mut block_children = ui.tree_test.empty_kids()
    ui.tree_test.push_kid(&mut block_children, child_index)
    let block_el = ui.tree_test.el(ui.tree.ViewKind.Block, None, block_children)
    match sink2.push(block_el) {
        Ok(_) => ()
        Err(_e) => core.panic.panic("oom")
    }
    core.check.eq(sink2.len(), 2usize)
end ui.tree_test.Suite.test_composite_render

test ui.tree_test.Suite.test_find_key
    let mut t = ui.tree.Tree.new()
    let root = ui.tree_test.push_block(&mut t)
    let mut elements = std.vec.Vec.new()
    let mut root_children = ui.tree_test.empty_kids()
    ui.tree_test.push_kid(&mut root_children, 1usize)
    ui.tree_test.push_kid(&mut root_children, 2usize)
    ui.tree_test.push_block_el(&mut elements, root_children)
    ui.tree_test.push_leaf_el(&mut elements, Some(7u64))
    ui.tree_test.push_leaf_el(&mut elements, Some(8u64))
    match t.commit(root, &elements, 0usize) {
        Ok(_) => ()
        Err(_) => core.check.is_true(false)
    }
    match t.find_key(7u64) {
        Some(v) => core.check.eq(v, 1usize)
        None => core.check.is_true(false)
    }
    match t.find_key(8u64) {
        Some(v) => core.check.eq(v, 2usize)
        None => core.check.is_true(false)
    }
end ui.tree_test.Suite.test_find_key

test ui.tree_test.Suite.test_find_key_missing
    let mut t = ui.tree.Tree.new()
    let _root = ui.tree_test.push_block(&mut t)
    if let Some(_) = t.find_key(1u64) {
        core.check.is_true(false)
    }
end ui.tree_test.Suite.test_find_key_missing

test ui.tree_test.Suite.test_keyed_reorder
    let mut t = ui.tree.Tree.new()
    let root = ui.tree_test.push_block(&mut t)
    let mut elements = std.vec.Vec.new()
    let mut root_children = ui.tree_test.empty_kids()
    ui.tree_test.push_kid(&mut root_children, 1usize)
    ui.tree_test.push_kid(&mut root_children, 2usize)
    ui.tree_test.push_block_el(&mut elements, root_children)
    ui.tree_test.push_leaf_el(&mut elements, Some(1u64))
    ui.tree_test.push_leaf_el(&mut elements, Some(2u64))
    match t.commit(root, &elements, 0usize) {
        Ok(_) => ()
        Err(_) => ()
    }
    core.check.eq(t.child_count(root), 2usize)
    let mut elements2 = std.vec.Vec.new()
    let mut root_children2 = ui.tree_test.empty_kids()
    ui.tree_test.push_kid(&mut root_children2, 2usize)
    ui.tree_test.push_kid(&mut root_children2, 1usize)
    ui.tree_test.push_block_el(&mut elements2, root_children2)
    ui.tree_test.push_leaf_el(&mut elements2, Some(1u64))
    ui.tree_test.push_leaf_el(&mut elements2, Some(2u64))
    match t.commit(root, &elements2, 0usize) {
        Ok(_) => ()
        Err(_) => ()
    }
    core.check.eq(t.child_count(root), 2usize)
    match t.node_at(1usize) {
        Some(n) => core.check.eq(n.key, Some(1u64))
        None => core.check.is_true(false)
    }
    match t.node_at(2usize) {
        Some(n) => core.check.eq(n.key, Some(2u64))
        None => core.check.is_true(false)
    }
    match t.node_at(3usize) {
        Some(_) => core.check.is_true(false)
        None => core.check.is_true(true)
    }
end ui.tree_test.Suite.test_keyed_reorder

test ui.tree_test.Suite.test_new
    let t = ui.tree.Tree.new()
    core.check.eq(t.child_count(0usize), 0usize)
end ui.tree_test.Suite.test_new

test ui.tree_test.Suite.test_parent_of
    let mut t = ui.tree.Tree.new()
    let root = ui.tree_test.push_block(&mut t)
    let a = ui.tree_test.push_leaf(&mut t)
    core.check.is_true(t.push_child(root, a))
    match t.parent_of(a) {
        Some(v) => core.check.eq(v, root)
        None => core.check.is_true(false)
    }
end ui.tree_test.Suite.test_parent_of

test ui.tree_test.Suite.test_parent_of_deep
    let mut t = ui.tree.Tree.new()
    let root = ui.tree_test.push_block(&mut t)
    let child = ui.tree_test.push_block(&mut t)
    let grand = ui.tree_test.push_leaf(&mut t)
    core.check.is_true(t.push_child(root, child))
    core.check.is_true(t.push_child(child, grand))
    match t.parent_of(grand) {
        Some(v) => core.check.eq(v, child)
        None => core.check.is_true(false)
    }
    match t.parent_of(child) {
        Some(v) => core.check.eq(v, root)
        None => core.check.is_true(false)
    }
end ui.tree_test.Suite.test_parent_of_deep

test ui.tree_test.Suite.test_parent_of_root_none
    let mut t = ui.tree.Tree.new()
    let root = ui.tree_test.push_block(&mut t)
    if let Some(_) = t.parent_of(root) {
        core.check.is_true(false)
    }
end ui.tree_test.Suite.test_parent_of_root_none

test ui.tree_test.Suite.test_parent_of_unknown_node
    let t = ui.tree.Tree.new()
    if let Some(_) = t.parent_of(99usize) {
        core.check.is_true(false)
    }
end ui.tree_test.Suite.test_parent_of_unknown_node

test ui.tree_test.Suite.test_push_child
    let mut t = ui.tree.Tree.new()
    let parent = ui.tree_test.push_block(&mut t)
    let child = ui.tree_test.push_leaf(&mut t)
    core.check.is_true(t.push_child(parent, child))
    core.check.eq(t.child_count(parent), 1usize)
    match t.node_at(child) {
        Some(_) => core.check.is_true(true)
        None => core.check.is_true(false)
    }
end ui.tree_test.Suite.test_push_child

test ui.tree_test.Suite.test_push_node_indices
    let mut t = ui.tree.Tree.new()
    core.check.eq(ui.tree_test.push_block(&mut t), 0usize)
    core.check.eq(ui.tree_test.push_block(&mut t), 1usize)
    core.check.eq(ui.tree_test.push_leaf(&mut t), 2usize)
    core.check.eq(t.child_count(0usize), 0usize)
    core.check.eq(t.child_count(1usize), 0usize)
    core.check.eq(t.child_count(2usize), 0usize)
end ui.tree_test.Suite.test_push_node_indices

test ui.tree_test.Suite.test_state_insert
    let t = ui.tree.Tree.new()
    let c = ui.tree_test.Counter {
        n: 0u32
    }
    match std.boxed.Box.new(c) {
        Ok(b) => {
            let entry = ui.tree.StateEntry {
                value: alloc.boxed.Box.into_dyn(b)
            }
            match t.state_ref().insert(entry) {
                Ok(h) => core.check.eq(h.index, 0usize)
                Err(_) => core.check.is_true(false)
            }
            core.check.eq(t.state_ref().len(), 1usize)
        }
        Err(_) => core.check.is_true(false)
    }
end ui.tree_test.Suite.test_state_insert

test ui.tree_test.Suite.test_state_insert_two
    let t = ui.tree.Tree.new()
    match std.boxed.Box.new(ui.tree_test.Counter {
        n: 0u32
    }) {
        Ok(b) => {
            match t.state_ref().insert(ui.tree.StateEntry {
                value: alloc.boxed.Box.into_dyn(b)
            }) {
                Ok(h0) => core.check.eq(h0.index, 0usize)
                Err(_) => core.check.is_true(false)
            }
        }
        Err(_) => core.check.is_true(false)
    }
    match std.boxed.Box.new(ui.tree_test.Counter {
        n: 0u32
    }) {
        Ok(b) => {
            match t.state_ref().insert(ui.tree.StateEntry {
                value: alloc.boxed.Box.into_dyn(b)
            }) {
                Ok(h1) => core.check.eq(h1.index, 1usize)
                Err(_) => core.check.is_true(false)
            }
            core.check.eq(t.state_ref().len(), 2usize)
        }
        Err(_) => core.check.is_true(false)
    }
end ui.tree_test.Suite.test_state_insert_two

test ui.tree_test.Suite.test_state_remove
    let t = ui.tree.Tree.new()
    match std.boxed.Box.new(ui.tree_test.Counter {
        n: 0u32
    }) {
        Ok(b) => {
            match t.state_ref().insert(ui.tree.StateEntry {
                value: alloc.boxed.Box.into_dyn(b)
            }) {
                Ok(h) => {
                    core.check.eq(t.state_ref().len(), 1usize)
                    let removed: Option<ui.tree.StateEntry> = t.state_ref().remove(h)
                    match removed {
                        Some(_) => core.check.is_true(true)
                        None => core.check.is_true(false)
                    }
                    core.check.eq(t.state_ref().len(), 1usize)
                }
                Err(_) => core.check.is_true(false)
            }
        }
        Err(_) => core.check.is_true(false)
    }
end ui.tree_test.Suite.test_state_remove

test ui.tree_test.Suite.test_state_tick
    let mut t = ui.tree.Tree.new()
    match std.boxed.Box.new(ui.tree_test.Counter {
        n: 5u32
    }) {
        Ok(b) => {
            match t.state_ref().insert(ui.tree.StateEntry {
                value: alloc.boxed.Box.into_dyn(b)
            }) {
                Ok(h) => {
                    t.state_tick(h)
                    core.check.eq(t.state_ref().len(), 1usize)
                }
                Err(_) => core.check.is_true(false)
            }
        }
        Err(_) => core.check.is_true(false)
    }
end ui.tree_test.Suite.test_state_tick

test ui.tree_test.Suite.test_view_box_dyn
    let view = ui.tree_test.LeafView {
        w: 5.0f32
        h: 7.0f32
    }
    match std.boxed.Box.new(view) {
        Ok(b) => {
            let boxed = ui.tree_test.ViewBox {
                v: alloc.boxed.Box.into_dyn(b)
            }
            let mut sink = ui.tree_test.new_sink()
            let index = boxed.v.render(&mut sink)
            core.check.eq(index, 0usize)
            core.check.eq(sink.len(), 1usize)
        }
        Err(_) => core.check.is_true(false)
    }
end ui.tree_test.Suite.test_view_box_dyn
