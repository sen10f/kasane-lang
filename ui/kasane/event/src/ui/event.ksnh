enum ui.event.Action derive [Debug, Clone, Copy, PartialEq] pub
    NoOp
    Redraw
    Focus(usize)
    Capture(Option<usize>)
    Quit
end ui.event.Action

type ui.event.Ctx pub
    focus: Option<usize>
    capture: Option<usize>
    tab_order: std.vec.Vec<usize>
    text: std.vec.Vec<u8>
end ui.event.Ctx

enum ui.event.Event derive [Debug] pub
    PointerMove(f32, f32)
    PointerDown(f32, f32, u8)
    PointerUp(f32, f32, u8)
    Wheel(f32, f32, f32, f32)
    KeyDown(u32, ui.event.Modifiers)
    KeyUp(u32, ui.event.Modifiers)
    TextInput(std.vec.Vec<u8>)
    IMEStart
    IMEUpdate(std.vec.Vec<u8>)
    IMECommit(std.vec.Vec<u8>)
    FocusGained
    FocusLost
    Resize(f32, f32)
    DPIChange(f32)
    Quit
end ui.event.Event

type ui.event.Modifiers derive [Debug, Clone, Copy, PartialEq] pub
    shift: bool pub
    ctrl: bool pub
    alt: bool pub
end ui.event.Modifiers

trait ui.event.View pub
    fn on_event(self: &Self, event: &ui.event.Event, ctx: &mut ui.event.Ctx) -> ui.event.Action uses [] panics never
end ui.event.View

fn ui.event.Ctx.blur(self: &mut ui.event.Ctx) -> () uses [] panics never pub
    self.focus = None
end ui.event.Ctx.blur

fn ui.event.Ctx.focus_next(self: &mut ui.event.Ctx) -> () uses [] panics never pub
    let len = self.tab_order.len()
    if len == 0usize {
        return
    }
    let current = match self.focus {
        Some(f) => f
        None => {
            let first = match self.tab_order.get(0usize) {
                Some(v) => *v
                None => return
            }
            self.focus = Some(first)
            return
        }
    }
    let mut pos = 0usize
    let mut found = false
    let mut i = 0usize
    while i < len {
        let v = match self.tab_order.get(i) {
            Some(v) => *v
            None => break
        }
        if v == current {
            pos = i
            found = true
            break
        }
        i = i.wrapping_add(1usize)
    }
    let next_pos = if found {
        match pos.wrapping_add(1usize).checked_rem(len) {
            Some(v) => v
            None => 0usize
        }
    } else {
        0usize
    }
    let next = match self.tab_order.get(next_pos) {
        Some(v) => *v
        None => return
    }
    self.focus = Some(next)
end ui.event.Ctx.focus_next

fn ui.event.Ctx.focus_previous(self: &mut ui.event.Ctx) -> () uses [] panics never pub
    let len = self.tab_order.len()
    if len == 0usize {
        return
    }
    let current = match self.focus {
        Some(f) => f
        None => {
            let last = match self.tab_order.get(len.wrapping_sub(1usize)) {
                Some(v) => *v
                None => return
            }
            self.focus = Some(last)
            return
        }
    }
    let mut pos = 0usize
    let mut found = false
    let mut i = 0usize
    while i < len {
        let v = match self.tab_order.get(i) {
            Some(v) => *v
            None => break
        }
        if v == current {
            pos = i
            found = true
            break
        }
        i = i.wrapping_add(1usize)
    }
    let prev_pos = if found {
        if pos == 0usize {
            len.wrapping_sub(1usize)
        } else {
            pos.wrapping_sub(1usize)
        }
    } else {
        len.wrapping_sub(1usize)
    }
    let prev = match self.tab_order.get(prev_pos) {
        Some(v) => *v
        None => return
    }
    self.focus = Some(prev)
end ui.event.Ctx.focus_previous

fn ui.event.Ctx.get_capture(self: &ui.event.Ctx) -> Option<usize> uses [] panics never pub
    self.capture
end ui.event.Ctx.get_capture

fn ui.event.Ctx.get_focus(self: &ui.event.Ctx) -> Option<usize> uses [] panics never pub
    self.focus
end ui.event.Ctx.get_focus

fn ui.event.Ctx.new() -> ui.event.Ctx uses [] panics never pub
    let tab_order = std.vec.Vec.new()
    let text = std.vec.Vec.new()
    ui.event.Ctx { focus: None, capture: None, tab_order: tab_order, text: text }
end ui.event.Ctx.new

fn ui.event.Ctx.release_capture(self: &mut ui.event.Ctx) -> () uses [] panics never pub
    self.capture = None
end ui.event.Ctx.release_capture

fn ui.event.Ctx.set_capture(self: &mut ui.event.Ctx, node: usize) -> () uses [] panics never pub
    self.capture = Some(node)
end ui.event.Ctx.set_capture

fn ui.event.Ctx.set_focus(self: &mut ui.event.Ctx, node: usize) -> () uses [] panics never pub
    self.focus = Some(node)
end ui.event.Ctx.set_focus

fn ui.event.Ctx.tab_push(self: &mut ui.event.Ctx, node: usize) -> () uses [alloc] panics never pub
    match self.tab_order.push(node) {
        Ok(_u) => ()
        Err(_e) => ()
    }
end ui.event.Ctx.tab_push

fn ui.event.Modifiers.default() -> ui.event.Modifiers uses [] panics never pub
    ui.event.Modifiers { shift: false, ctrl: false, alt: false }
end ui.event.Modifiers.default

fn ui.event.hit_test(layout: &ui.layout.Tree, root: usize, x: f32, y: f32) -> Option<usize> uses [] panics never stack 4096 pub
    let root_rect = layout.rect(root)
    if !ui.event.rect_contains(root_rect, x, y) {
        return None
    }
    let count = layout.child_count(root)
    if count > 0usize {
        let mut i = count
        while i > 0usize {
            i = i.wrapping_sub(1usize)
            let child = match layout.child_at(root, i) {
                Some(c) => c
                None => break
            }
            let child_hit = ui.event.hit_test(layout, child, x, y)
            match child_hit {
                Some(c) => return Some(c)
                None => ()
            }
        }
    }
    Some(root)
end ui.event.hit_test

fn ui.event.rect_contains(rect: ui.layout.Rect, x: f32, y: f32) -> bool uses [] panics never pub
    x >= rect.x && x < rect.x + rect.width && y >= rect.y && y < rect.y + rect.height
end ui.event.rect_contains

fn ui.event.replay(ctx: &mut ui.event.Ctx, events: &std.vec.Vec<ui.event.Event>, layout: &ui.layout.Tree, _tree: &ui.tree.Tree, root: usize, _x: f32, _y: f32) -> () uses [] panics never pub
    let mut i = 0usize
    let len = events.len()
    while i < len {
        let event = match events.get(i) {
            Some(e) => e
            None => break
        }
        match event {
            ui.event.Event.PointerDown(px, py, _) => {
                let target = ui.event.hit_test(layout, root, *px, *py)
                match target {
                    Some(t) => ctx.set_capture(t)
                    None => ()
                }
            }
            ui.event.Event.PointerUp(_, _, _) => ctx.release_capture()
            ui.event.Event.KeyDown(key, _) => if *key == 9u32 {
                ctx.focus_next()
            }
            ui.event.Event.KeyUp(_, _) => ()
            ui.event.Event.TextInput(_) => ()
            ui.event.Event.IMECommit(_) => ()
            ui.event.Event.IMEStart => ()
            ui.event.Event.IMEUpdate(_) => ()
            ui.event.Event.FocusGained => ()
            ui.event.Event.FocusLost => ctx.blur()
            ui.event.Event.PointerMove(_, _) => ()
            ui.event.Event.Wheel(_, _, _, _) => ()
            ui.event.Event.Resize(_, _) => ()
            ui.event.Event.DPIChange(_) => ()
            ui.event.Event.Quit => ()
        }
        i = i.wrapping_add(1usize)
    }
end ui.event.replay

fn ui.event.route(ctx: &ui.event.Ctx, layout: &ui.layout.Tree, _tree: &ui.tree.Tree, root: usize, event: &ui.event.Event, x: f32, y: f32) -> Option<usize> uses [] panics never pub
    match event {
        ui.event.Event.PointerMove(px, py) => match ctx.capture {
            Some(cap) => Some(cap)
            None => ui.event.hit_test(layout, root, *px, *py)
        }
        ui.event.Event.PointerDown(px, py, _) => ui.event.hit_test(layout, root, *px, *py)
        ui.event.Event.PointerUp(px, py, _) => match ctx.capture {
            Some(cap) => Some(cap)
            None => ui.event.hit_test(layout, root, *px, *py)
        }
        ui.event.Event.Wheel(_, _, _, _) => ui.event.hit_test(layout, root, x, y)
        ui.event.Event.KeyDown(_, _) => ctx.focus
        ui.event.Event.KeyUp(_, _) => ctx.focus
        ui.event.Event.TextInput(_) => ctx.focus
        ui.event.Event.IMECommit(_) => ctx.focus
        ui.event.Event.IMEStart => ctx.focus
        ui.event.Event.IMEUpdate(_) => ctx.focus
        ui.event.Event.FocusGained => match ctx.focus {
            Some(_) => None
            None => ui.event.hit_test(layout, root, x, y)
        }
        ui.event.Event.FocusLost => None
        ui.event.Event.Resize(_, _) => None
        ui.event.Event.DPIChange(_) => None
        ui.event.Event.Quit => None
    }
end ui.event.route
