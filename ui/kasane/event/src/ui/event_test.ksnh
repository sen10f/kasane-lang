test ui.event_test.Target.test_route_key_down_with_modifiers
    let mut tree = ui.layout.Tree.new()
    let root = tree.push_node(ui.layout.Style.default())
    tree.layout_at(root, 0.0f32, 0.0f32, 100.0f32, 100.0f32)
    let utree = ui.tree.Tree.new()
    let mut ctx = ui.event.Ctx.new()
    ctx.set_focus(root)
    let modifiers = ui.event.Modifiers {
        shift: true
        ctrl: false
        alt: false
    }
    let ev = ui.event.Event.KeyDown(65u32, modifiers)
    let routed = ui.event.route(&ctx, &tree, &utree, root, &ev, 0.0f32, 0.0f32)
    core.check.eq(routed, Some(root))
end ui.event_test.Target.test_route_key_down_with_modifiers

test ui.event_test.Target.test_route_quit_returns_none
    let mut tree = ui.layout.Tree.new()
    let root = tree.push_node(ui.layout.Style.default())
    tree.layout_at(root, 0.0f32, 0.0f32, 100.0f32, 100.0f32)
    let utree = ui.tree.Tree.new()
    let ctx = ui.event.Ctx.new()
    let ev = ui.event.Event.Quit
    let routed = ui.event.route(&ctx, &tree, &utree, root, &ev, 0.0f32, 0.0f32)
