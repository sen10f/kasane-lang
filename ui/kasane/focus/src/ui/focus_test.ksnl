type ui.focus_test.Target pub
    _dummy: bool
end ui.focus_test.Target

test ui.focus_test.Target.test_arrow_horizontal
    let mut m = ui.focus.FocusManager.new()
    core.mem.drop(m.scope_new(1usize, None, ui.focus.Dir.Left, false))
    core.mem.drop(m.scope_add_node(1usize, 10usize))
    core.mem.drop(m.scope_add_node(1usize, 20usize))
    core.mem.drop(m.scope_add_node(1usize, 30usize))
    core.mem.drop(m.focus_node(10usize))
    core.mem.drop(m.focus_move(ui.focus.Dir.Right))
    core.check.eq(m.get_focus(), Some(20usize))
    core.mem.drop(m.focus_move(ui.focus.Dir.Right))
    core.check.eq(m.get_focus(), Some(30usize))
    core.mem.drop(m.focus_move(ui.focus.Dir.Right))
    core.check.eq(m.get_focus(), Some(30usize))
    core.mem.drop(m.focus_move(ui.focus.Dir.Left))
    core.check.eq(m.get_focus(), Some(20usize))
end ui.focus_test.Target.test_arrow_horizontal

