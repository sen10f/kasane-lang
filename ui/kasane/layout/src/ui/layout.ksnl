test ui.layout.Tree.test_row_gap
    let mut tree = ui.layout.Tree.new()
    let mut r = ui.layout.Style.default()
    r.ali = ui.layout.AlignItems.Stretch
    r.space.gap = 20.0f32
    let root = tree.push_node(r)
    let mut s0 = ui.layout.Style.default()
    s0.size.w = Some(100.0f32)
    let c0 = tree.push_node(s0)
    let mut s1 = ui.layout.Style.default()
    s1.size.w = Some(100.0f32)
    let c1 = tree.push_node(s1)
    let mut s2 = ui.layout.Style.default()
    s2.size.w = Some(100.0f32)
    let c2 = tree.push_node(s2)
    tree.push_child(root, c0)
    tree.push_child(root, c1)
    tree.push_child(root, c2)
    tree.layout(root, 500.0f32, 200.0f32)
    let e0 = ui.layout.Rect { x: 0.0f32, y: 0.0f32, width: 100.0f32, height: 200.0f32 }
    let e1 = ui.layout.Rect { x: 120.0f32, y: 0.0f32, width: 100.0f32, height: 200.0f32 }
    let e2 = ui.layout.Rect { x: 240.0f32, y: 0.0f32, width: 100.0f32, height: 200.0f32 }
    core.check.eq(tree.rect(c0), e0)
    core.check.eq(tree.rect(c1), e1)
    core.check.eq(tree.rect(c2), e2)
end ui.layout.Tree.test_row_gap

test ui.layout.Tree.test_row_grow_stretch
    let mut tree = ui.layout.Tree.new()
    let mut r = ui.layout.Style.default()
