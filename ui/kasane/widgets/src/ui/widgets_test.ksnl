test ui.widgets_test.Target.test_text_replace_selection
    let mut ti = ui.widgets.TextInput.new()
    let mut ctx = ui.event.Ctx.new()
    let focus = ui.event.Event.FocusGained
    core.mem.drop(ti.on_event(&focus, &mut ctx))
    let ev = ui.event.Event.TextInput(ui.widgets_test.ascii_bytes())
    core.mem.drop(ti.on_event(&ev, &mut ctx))
    ti.ss = 1usize
    ti.se = 3usize
    let mut bytes = alloc.vec.Vec.new(std.alloc.SYSTEM)
    match bytes.push(0x58u8) {
        Ok(_u) => ()
        Err(_e) => ()
    }
    let ev2 = ui.event.Event.TextInput(bytes)
    let action = ti.on_event(&ev2, &mut ctx)
    core.check.eq(ti.text.len(), 2usize)
    core.check.eq(ti.caret, 2usize)
    core.check.eq(ti.ss, 2usize)
    core.check.eq(ti.se, 2usize)
    core.check.eq(action, ui.event.Action.Redraw)
end ui.widgets_test.Target.test_text_replace_selection

