test ui.widgets_test.Target.test_text_ime_commit
    let mut ti = ui.widgets.TextInput.new()
    let mut ctx = ui.event.Ctx.new()
    let focus = ui.event.Event.FocusGained
    core.mem.drop(ti.on_event(&focus, &mut ctx))
    let ev = ui.event.Event.IMEUpdate(ui.widgets_test.japanese_a_bytes())
    core.mem.drop(ti.on_event(&ev, &mut ctx))
    core.check.eq(ti.comp.len(), 3usize)
    let commit = ui.event.Event.IMECommit(ui.widgets_test.japanese_a_bytes())
    core.mem.drop(ti.on_event(&commit, &mut ctx))
    core.check.eq(ti.text.len(), 3usize)
    core.check.eq(ti.caret, 3usize)
    core.check.eq(ti.comp.len(), 0usize)
end ui.widgets_test.Target.test_text_ime_commit

