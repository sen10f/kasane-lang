test ui.widgets_test.Target.test_list_wheel_clamps
    let mut list = ui.widgets.List.new()
    list.rc = 10usize
    list.ih = 24.0f32
    list.vh = 100.0f32
    list.sy = 140.0f32
    let mut ctx = ui.event.Ctx.new()
    let ev = ui.event.Event.Wheel(0.0f32, -200.0f32, 0.0f32, 0.0f32)
    core.mem.drop(list.on_event(&ev, &mut ctx))
    core.check.eq(list.sy, 0.0f32)
    let ev2 = ui.event.Event.Wheel(0.0f32, 500.0f32, 0.0f32, 0.0f32)
    core.mem.drop(list.on_event(&ev2, &mut ctx))
    core.check.eq(list.sy, 140.0f32)
end ui.widgets_test.Target.test_list_wheel_clamps

test ui.widgets_test.Target.test_text_backspace
    let mut ti = ui.widgets.TextInput.new()
    let mut ctx = ui.event.Ctx.new()
    let focus = ui.event.Event.FocusGained
    core.mem.drop(ti.on_event(&focus, &mut ctx))
    let ev = ui.event.Event.TextInput(ui.widgets_test.ascii_bytes())
    core.mem.drop(ti.on_event(&ev, &mut ctx))
    core.check.eq(ti.caret, 3usize)
    let back = ui.event.Event.KeyDown(8u32, ui.widgets_test.mods())
    core.mem.drop(ti.on_event(&back, &mut ctx))
    core.check.eq(ti.text.len(), 2usize)
    core.check.eq(ti.caret, 2usize)
end ui.widgets_test.Target.test_text_backspace

test ui.widgets_test.Target.test_text_delete_forward
    let mut ti = ui.widgets.TextInput.new()
    let mut ctx = ui.event.Ctx.new()
    let focus = ui.event.Event.FocusGained
    core.mem.drop(ti.on_event(&focus, &mut ctx))
    let ev = ui.event.Event.TextInput(ui.widgets_test.ascii_bytes())
    core.mem.drop(ti.on_event(&ev, &mut ctx))
    ti.caret = 0usize
    ti.ss = 0usize
    ti.se = 0usize
    let dele = ui.event.Event.KeyDown(46u32, ui.widgets_test.mods())
    core.mem.drop(ti.on_event(&dele, &mut ctx))
    core.check.eq(ti.text.len(), 2usize)
    core.check.eq(ti.caret, 0usize)
end ui.widgets_test.Target.test_text_delete_forward

