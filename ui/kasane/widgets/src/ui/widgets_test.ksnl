test ui.widgets_test.Target.test_list_key_at
    let mut list = ui.widgets.List.new()
    list.rc = 2usize
    match list.keys.push(100u64) {
        Ok(_u) => ()
        Err(_e) => ()
    }
    match list.keys.push(200u64) {
        Ok(_u) => ()
        Err(_e) => ()
    }
    core.check.eq(list.key(0usize), Some(100u64))
    core.check.eq(list.key(1usize), Some(200u64))
    core.check.eq(list.key(2usize), None)
end ui.widgets_test.Target.test_list_key_at

test ui.widgets_test.Target.test_list_key_home_end
    let mut list = ui.widgets.List.new()
    list.rc = 10usize
    list.ih = 24.0f32
    list.vh = 100.0f32
    list.sy = 100.0f32
    let mut ctx = ui.event.Ctx.new()
    let home = ui.event.Event.KeyDown(36u32, ui.widgets_test.mods())
    core.mem.drop(list.on_event(&home, &mut ctx))
    core.check.eq(list.sy, 0.0f32)
    let end_ev = ui.event.Event.KeyDown(35u32, ui.widgets_test.mods())
    core.mem.drop(list.on_event(&end_ev, &mut ctx))
    core.check.eq(list.sy, 140.0f32)
end ui.widgets_test.Target.test_list_key_home_end

test ui.widgets_test.Target.test_list_key_up_down
    let mut list = ui.widgets.List.new()
    list.rc = 5usize
    let mut ctx = ui.event.Ctx.new()
    let down = ui.event.Event.KeyDown(40u32, ui.widgets_test.mods())
    core.mem.drop(list.on_event(&down, &mut ctx))
    core.check.eq(list.sel, Some(0usize))
    core.mem.drop(list.on_event(&down, &mut ctx))
    core.check.eq(list.sel, Some(1usize))
    let up = ui.event.Event.KeyDown(38u32, ui.widgets_test.mods())
    core.mem.drop(list.on_event(&up, &mut ctx))
    core.check.eq(list.sel, Some(0usize))
    core.mem.drop(list.on_event(&up, &mut ctx))
    core.check.eq(list.sel, Some(0usize))
end ui.widgets_test.Target.test_list_key_up_down

