type ui.widgets_test.Target pub
    _dummy: bool
end ui.widgets_test.Target

fn ui.widgets_test.ascii_bytes() -> alloc.vec.Vec<u8, std.alloc.System> uses [alloc] panics never pub
    let mut bytes = alloc.vec.Vec.new(std.alloc.SYSTEM)
    match bytes.push(0x61u8) {
        Ok(_u) => ()
        Err(_e) => ()
    }
    match bytes.push(0x62u8) {
        Ok(_u) => ()
        Err(_e) => ()
    }
    match bytes.push(0x63u8) {
        Ok(_u) => ()
        Err(_e) => ()
    }
    bytes
end ui.widgets_test.ascii_bytes

fn ui.widgets_test.japanese_a_bytes() -> alloc.vec.Vec<u8, std.alloc.System> uses [alloc] panics never pub
    let mut bytes = alloc.vec.Vec.new(std.alloc.SYSTEM)
    match bytes.push(0xe3u8) {
        Ok(_u) => ()
        Err(_e) => ()
    }
    match bytes.push(0x81u8) {
        Ok(_u) => ()
        Err(_e) => ()
    }
    match bytes.push(0x82u8) {
        Ok(_u) => ()
        Err(_e) => ()
    }
    bytes
end ui.widgets_test.japanese_a_bytes

fn ui.widgets_test.mods() -> ui.event.Modifiers uses [] panics never pub
    ui.event.Modifiers { shift: false, ctrl: false, alt: false }
end ui.widgets_test.mods

fn ui.widgets_test.rect() -> ui.layout.Rect uses [] panics never pub
    ui.layout.Rect { x: 0.0f32, y: 0.0f32, width: 100.0f32, height: 40.0f32 }
end ui.widgets_test.rect

test ui.widgets_test.Target.test_button_click
    let mut b = ui.widgets.Button.new()
    let rect = ui.widgets_test.rect()
    let mut ctx = ui.event.Ctx.new()
    let down = ui.event.Event.PointerDown(50.0f32, 20.0f32, 1u8)
    core.mem.drop(b.on_event(&down, rect, &mut ctx))
    let up = ui.event.Event.PointerUp(50.0f32, 20.0f32, 1u8)
    let action = b.on_event(&up, rect, &mut ctx)
    core.check.eq(b.pressed, false)
    core.check.eq(b.clicked, true)
    core.check.eq(action, ui.event.Action.Redraw)
end ui.widgets_test.Target.test_button_click

