// ksn bindgen --c の生成物 (module ksnui_text)。直接編集しない
// 飛ばしたもの: #define KSNUI_TEXT_H は飛ばした: 整数定数でない ()
type ksnui_text.KsnuiShapedGlyph layout c derive [Clone, Copy] pub
    glyph_id: u32
    cluster: u32
    x_advance: f32
    y_advance: f32
    x_offset: f32
    y_offset: f32
end ksnui_text.KsnuiShapedGlyph

extern ksnui_text.raw_ksnui_text_line_height(font_path: *const i8, size_px: f32) -> f32 link "ksnui_text_line_height"

extern ksnui_text.raw_ksnui_text_raster(path: *const i8, size: f32, glyph_id: u32, w: *mut i32, h: *mut i32, left: *mut i32, top: *mut i32, buf: *mut u8, cap: u64) -> i32 link "ksnui_text_raster"

extern ksnui_text.raw_ksnui_text_shape(font_path: *const i8, size_px: f32, utf8: *const i8, out: *mut ksnui_text.KsnuiShapedGlyph, cap: u64) -> u64 link "ksnui_text_shape"

fn ksnui_text.ksnui_text_line_height(font_path: *const i8, size_px: f32) -> f32 uses [] panics may pub
    unsafe "bindgen" "C の関数 ksnui_text_line_height を呼ぶ" {
        ksnui_text.raw_ksnui_text_line_height(font_path, size_px)
    }
end ksnui_text.ksnui_text_line_height

fn ksnui_text.ksnui_text_raster(path: *const i8, size: f32, glyph_id: u32, w: *mut i32, h: *mut i32, left: *mut i32, top: *mut i32, buf: *mut u8, cap: u64) -> i32 uses [] panics may pub
    unsafe "bindgen" "C の関数 ksnui_text_raster を呼ぶ" {
        ksnui_text.raw_ksnui_text_raster(path, size, glyph_id, w, h, left, top, buf, cap)
    }
end ksnui_text.ksnui_text_raster

fn ksnui_text.ksnui_text_shape(font_path: *const i8, size_px: f32, utf8: *const i8, out: *mut ksnui_text.KsnuiShapedGlyph, cap: u64) -> u64 uses [] panics may pub
    unsafe "bindgen" "C の関数 ksnui_text_shape を呼ぶ" {
        ksnui_text.raw_ksnui_text_shape(font_path, size_px, utf8, out, cap)
    }
end ksnui_text.ksnui_text_shape
