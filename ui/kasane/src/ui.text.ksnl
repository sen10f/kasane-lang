test ui.text.Line.test_measure_wrapped_single_line
    let advances = [10.0f32, 20.0f32, 30.0f32]
    let classes = [ui.text.BreakClass.Normal; 3]
    let mut out = [ui.text.Line { start: 0usize, to: 0usize, width: 0.0f32 }; 4]
    let (w, h) = ui.text.measure_wrapped(&advances, &classes, 10.0f32, 100.0f32, &mut out)
    core.check.eq(w, 60.0f32)
    core.check.eq(h, 10.0f32)
end ui.text.Line.test_measure_wrapped_single_line

