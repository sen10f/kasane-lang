    let classes = [normal, cluster_cont, normal]
    let mut out = [ui.text.Line { start: 0usize, to: 0usize, width: 0.0f32 }; 3]
    let n = ui.text.break_lines(&advances, &classes, 25.0f32, &mut out)
    core.check.eq(n, 2usize)
    core.check.eq(out[0usize].start, 0usize)
    core.check.eq(out[0usize].to, 2usize)
    core.check.eq(out[0usize].width, 30.0f32)
    core.check.eq(out[1usize].start, 2usize)
    core.check.eq(out[1usize].to, 3usize)
    core.check.eq(out[1usize].width, 30.0f32)
end ui.text.Line.test_break_lines_cluster_cont_not_breakable

