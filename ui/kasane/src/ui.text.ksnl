test ui.text.Line.test_break_lines_all_fit_one_line
    let advances = [10.0f32, 20.0f32, 30.0f32]
    let classes = [ui.text.BreakClass.Normal; 3]
    let mut out = [ui.text.Line { start: 0usize, to: 0usize, width: 0.0f32 }; 4]
    let n = ui.text.break_lines(&advances, &classes, 100.0f32, &mut out)
    core.check.eq(n, 1usize)
    core.check.eq(out[0usize].start, 0usize)
    core.check.eq(out[0usize].to, 3usize)
    core.check.eq(out[0usize].width, 60.0f32)
end ui.text.Line.test_break_lines_all_fit_one_line

test ui.text.Line.test_break_lines_breaks_when_wider
    let advances = [10.0f32, 20.0f32, 30.0f32, 40.0f32]
    let classes = [ui.text.BreakClass.Normal; 4]
    let mut out = [ui.text.Line { start: 0usize, to: 0usize, width: 0.0f32 }; 4]
    let n = ui.text.break_lines(&advances, &classes, 50.0f32, &mut out)
    core.check.eq(n, 3usize)
    core.check.eq(out[0usize].start, 0usize)
    core.check.eq(out[0usize].to, 2usize)
    core.check.eq(out[0usize].width, 30.0f32)
    core.check.eq(out[1usize].start, 2usize)
    core.check.eq(out[1usize].to, 3usize)
    core.check.eq(out[1usize].width, 30.0f32)
    core.check.eq(out[2usize].start, 3usize)
    core.check.eq(out[2usize].to, 4usize)
    core.check.eq(out[2usize].width, 40.0f32)
end ui.text.Line.test_break_lines_breaks_when_wider

