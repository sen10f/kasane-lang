test ui.text.Line.test_shape_and_measure_hello_kasane
    let font_path = "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"
    let text = "こんにちは Kasane"
    if std.fs.exists(font_path) {
        let zero = ui.text.zero_glyph()
        let mut glyphs = [zero; 256]
        let n = usize.from_u64(ui.text.shape_text(font_path, 0u32, 24.0f32, text, &mut glyphs))
        core.check.is_true(n <= 256usize)
        if n > 0usize {
            let (w, h) = ui.text.measure(font_path, 0u32, 24.0f32, text)
            core.check.is_true(w > 0.0f32)
            core.check.is_true(h > 0.0f32)
        }
    }
end ui.text.Line.test_shape_and_measure_hello_kasane
