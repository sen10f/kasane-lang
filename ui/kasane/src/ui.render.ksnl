        Ok(_u) => ()
        Err(_e) => ()
    }
    let c1 = ui.render.rgba(0.9f32, 0.2f32, 0.4f32, 1.0f32)
    let r1 = ui.render.mk_rect(70.0f32, 20.0f32, 60.0f32, 30.0f32, 6.0f32, c1)
