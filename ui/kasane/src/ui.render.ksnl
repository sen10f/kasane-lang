    }
end ui.render.scene_rects

fn ui.render.scene_shadow(list: &mut alloc.vec.Vec<ui.render.Item, std.alloc.System>) -> () uses [alloc] panics never pub
    let c0 = ui.render.rgba(0.0f32, 0.0f32, 0.0f32, 0.4f32)
    let s0 = ui.render.mk_shadow(40.0f32, 40.0f32, 60.0f32, 50.0f32, 6.0f32, c0, 4.0f32, 4.0f32)
