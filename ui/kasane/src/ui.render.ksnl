    }
end ui.render.scene_shadow

test ui.render.GpuCtx.test_batch_clip
    let mut list = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let clip0 = ui.render.mk_clip(30.0f32, 30.0f32, 40.0f32, 40.0f32)
    match list.push(ui.render.Item.ClipPush(clip0)) {
        Ok(_u) => ()
        Err(_e) => core.panic.panic("oom")
    }
    let c0 = ui.render.rgba(0.4f32, 0.4f32, 0.4f32, 1.0f32)
    let r0 = ui.render.mk_rect(10.0f32, 10.0f32, 100.0f32, 100.0f32, 2.0f32, c0)
    match list.push(ui.render.Item.Rect(r0)) {
        Ok(_u) => ()
        Err(_e) => core.panic.panic("oom")
    }
    match list.push(ui.render.Item.ClipPop) {
        Ok(_u) => ()
        Err(_e) => core.panic.panic("oom")
    }
    let c1 = ui.render.rgba(1.0f32, 0.0f32, 0.0f32, 1.0f32)
    let r1 = ui.render.mk_rect(50.0f32, 50.0f32, 10.0f32, 10.0f32, 0.0f32, c1)
    match list.push(ui.render.Item.Rect(r1)) {
        Ok(_u) => ()
        Err(_e) => core.panic.panic("oom")
    }
    let mut out = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let mut k = 0usize
    let z = 0.0f32
    let q = ui.gpu.KsnuiRect { x: z, y: z, w: z, h: z, r: z, cr: z, cg: z, cb: z, ca: z }
    while k < 16usize {
        match out.push(q) {
            Ok(_u) => ()
            Err(_e) => core.panic.panic("oom")
        }
        k = k.wrapping_add(1usize)
    }
    let n = ui.render.batch_rects(list.as_slice(), out.as_mut_slice())
    core.check.eq(n, 2usize)
    match out.as_slice().get(0usize) {
        Some(r) => {
            core.check.eq(r.x, 30.0f32)
            core.check.eq(r.y, 30.0f32)
            core.check.eq(r.w, 40.0f32)
            core.check.eq(r.h, 40.0f32)
        }
        None => core.panic.panic("empty")
    }
    match out.as_slice().get(1usize) {
        Some(r) => core.check.eq(r.x, 50.0f32)
        None => core.panic.panic("empty")
    }
end ui.render.GpuCtx.test_batch_clip

test ui.render.GpuCtx.test_batch_cull
    let mut list = alloc.vec.Vec.new(std.alloc.SYSTEM)
    match list.push(ui.render.Item.ClipPush(ui.render.mk_clip(0.0f32, 0.0f32, 10.0f32, 10.0f32))) {
        Ok(_u) => ()
        Err(_e) => core.panic.panic("oom")
    }
    let c0 = ui.render.rgba(1.0f32, 0.0f32, 0.0f32, 1.0f32)
    let r0 = ui.render.mk_rect(100.0f32, 100.0f32, 10.0f32, 10.0f32, 0.0f32, c0)
    match list.push(ui.render.Item.Rect(r0)) {
        Ok(_u) => ()
        Err(_e) => core.panic.panic("oom")
    }
    match list.push(ui.render.Item.ClipPop) {
        Ok(_u) => ()
        Err(_e) => core.panic.panic("oom")
    }
    let mut out = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let mut k = 0usize
    let z = 0.0f32
    let q = ui.gpu.KsnuiRect { x: z, y: z, w: z, h: z, r: z, cr: z, cg: z, cb: z, ca: z }
    while k < 1usize {
        match out.push(q) {
            Ok(_u) => ()
            Err(_e) => core.panic.panic("oom")
        }
        k = k.wrapping_add(1usize)
    }
    let n = ui.render.batch_rects(list.as_slice(), out.as_mut_slice())
    core.check.eq(n, 0usize)
end ui.render.GpuCtx.test_batch_cull

test ui.render.GpuCtx.test_batch_order
    let mut list = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let c0 = ui.render.rgba(1.0f32, 0.0f32, 0.0f32, 1.0f32)
    let r0 = ui.render.mk_rect(0.0f32, 0.0f32, 10.0f32, 10.0f32, 0.0f32, c0)
    match list.push(ui.render.Item.Rect(r0)) {
        Ok(_u) => ()
        Err(_e) => core.panic.panic("oom")
    }
    let c1 = ui.render.rgba(0.0f32, 1.0f32, 0.0f32, 1.0f32)
    let r1 = ui.render.mk_rect(20.0f32, 0.0f32, 10.0f32, 10.0f32, 0.0f32, c1)
    match list.push(ui.render.Item.Rect(r1)) {
        Ok(_u) => ()
        Err(_e) => core.panic.panic("oom")
    }
    let c2 = ui.render.rgba(0.0f32, 0.0f32, 1.0f32, 1.0f32)
    let r2 = ui.render.mk_rect(40.0f32, 0.0f32, 10.0f32, 10.0f32, 0.0f32, c2)
    match list.push(ui.render.Item.Rect(r2)) {
        Ok(_u) => ()
        Err(_e) => core.panic.panic("oom")
    }
    let mut out = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let mut k = 0usize
    let z = 0.0f32
    let q = ui.gpu.KsnuiRect { x: z, y: z, w: z, h: z, r: z, cr: z, cg: z, cb: z, ca: z }
    while k < 16usize {
        match out.push(q) {
            Ok(_u) => ()
            Err(_e) => core.panic.panic("oom")
        }
        k = k.wrapping_add(1usize)
    }
    let n = ui.render.batch_rects(list.as_slice(), out.as_mut_slice())
    core.check.eq(n, 3usize)
    match out.as_slice().get(0usize) {
        Some(r) => core.check.eq(r.x, 0.0f32)
        None => core.panic.panic("empty")
    }
    match out.as_slice().get(1usize) {
        Some(r) => core.check.eq(r.x, 20.0f32)
        None => core.panic.panic("empty")
    }
    match out.as_slice().get(2usize) {
        Some(r) => core.check.eq(r.x, 40.0f32)
        None => core.panic.panic("empty")
    }
end ui.render.GpuCtx.test_batch_order

test ui.render.GpuCtx.test_batch_shadow
    let mut list = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let c0 = ui.render.rgba(0.0f32, 0.0f32, 0.0f32, 0.4f32)
    let s0 = ui.render.mk_shadow(40.0f32, 40.0f32, 60.0f32, 50.0f32, 6.0f32, c0, 4.0f32, 4.0f32)
    match list.push(ui.render.Item.Shadow(s0)) {
        Ok(_u) => ()
        Err(_e) => core.panic.panic("oom")
    }
    let c1 = ui.render.rgba(0.2f32, 0.7f32, 0.3f32, 1.0f32)
    let r1 = ui.render.mk_rect(40.0f32, 40.0f32, 60.0f32, 50.0f32, 6.0f32, c1)
    match list.push(ui.render.Item.Rect(r1)) {
        Ok(_u) => ()
        Err(_e) => core.panic.panic("oom")
    }
    let mut out = alloc.vec.Vec.new(std.alloc.SYSTEM)
    let mut k = 0usize
    let z = 0.0f32
    let q = ui.gpu.KsnuiRect { x: z, y: z, w: z, h: z, r: z, cr: z, cg: z, cb: z, ca: z }
    while k < 16usize {
        match out.push(q) {
            Ok(_u) => ()
            Err(_e) => core.panic.panic("oom")
        }
        k = k.wrapping_add(1usize)
    }
    let n = ui.render.batch_rects(list.as_slice(), out.as_mut_slice())
