    let clip0 = ui.render.mk_clip(30.0f32, 30.0f32, 40.0f32, 40.0f32)
    match list.push(ui.render.Item.ClipPush(clip0)) {
        Ok(_u) => ()
        Err(_e) => ()
    }
    let c0 = ui.render.rgba(0.4f32, 0.4f32, 0.4f32, 1.0f32)
    let r0 = ui.render.mk_rect(10.0f32, 10.0f32, 100.0f32, 100.0f32, 2.0f32, c0)
    match list.push(ui.render.Item.Rect(r0)) {
        Ok(_u) => ()
        Err(_e) => ()
    }
    match list.push(ui.render.Item.ClipPop) {
        Ok(_u) => ()
        Err(_e) => ()
    }
end ui.render.scene_clip

fn ui.render.scene_rects(list: &mut alloc.vec.Vec<ui.render.Item, std.alloc.System>) -> () uses [alloc] panics never pub
    let c0 = ui.render.rgba(0.2f32, 0.6f32, 0.9f32, 1.0f32)
    let r0 = ui.render.mk_rect(10.0f32, 10.0f32, 50.0f32, 40.0f32, 4.0f32, c0)
