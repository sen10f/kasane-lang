type ui.platform_test.Target pub
    _dummy: bool
end ui.platform_test.Target

fn ui.platform_test.libksnui_available() -> bool uses [io.fs] panics never pub
    let a = std.fs.exists("../native/libksnui.so")
    let b = std.fs.exists("../../../native/libksnui.so")
    let c = std.fs.exists("../native/libksnui.a")
    let d = std.fs.exists("../../../native/libksnui.a")
    let available = a || b || c || d
    available
end ui.platform_test.libksnui_available

fn ui.platform_test.zero_ev() -> ui.plat.KsnuiEvent uses [] panics never pub
    let ev = unsafe "ptr" "ゼロ埋めの事象を読む" {
        let mut buf = [0u8; 48]
        let ev_ptr = core.ptr.cast::<u8, ui.plat.KsnuiEvent>(core.ptr.from_mut(&mut buf))
        core.ptr.read(core.ptr.as_const(ev_ptr))
    }
    ev
end ui.platform_test.zero_ev

test ui.platform_test.Target.test_modifiers_from
    let none = ui.platform.modifiers_from(0i32)
    core.check.eq(none.shift, false)
    core.check.eq(none.ctrl, false)
    core.check.eq(none.alt, false)
    let shift = ui.platform.modifiers_from(ui.platform.KMOD_SHIFT)
    core.check.eq(shift.shift, true)
    core.check.eq(shift.ctrl, false)
    core.check.eq(shift.alt, false)
    let ctrl = ui.platform.modifiers_from(ui.platform.KMOD_CTRL)
    core.check.eq(ctrl.shift, false)
    core.check.eq(ctrl.ctrl, true)
    core.check.eq(ctrl.alt, false)
    let alt = ui.platform.modifiers_from(ui.platform.KMOD_ALT)
    core.check.eq(alt.shift, false)
    core.check.eq(alt.ctrl, false)
    core.check.eq(alt.alt, true)
    let mods_all = ui.platform.KMOD_SHIFT | ui.platform.KMOD_CTRL | ui.platform.KMOD_ALT
    let all = ui.platform.modifiers_from(mods_all)
    core.check.eq(all.shift, true)
    core.check.eq(all.ctrl, true)
    core.check.eq(all.alt, true)
end ui.platform_test.Target.test_modifiers_from

test ui.platform_test.Target.test_text_of
    let mut pool = [0u8; 8]
    pool[0usize] = 104u8
    pool[1usize] = 101u8
    pool[2usize] = 108u8
    pool[3usize] = 108u8
    pool[4usize] = 111u8
    let out = ui.platform.text_of(&pool, 0u32, 5u32)
    core.check.eq(out.len(), 5usize)
    let b0 = match out.get(0usize) {
        Some(b) => *b
        None => 0u8
    }
    core.check.eq(b0, 104u8)
    let b4 = match out.get(4usize) {
        Some(b) => *b
        None => 0u8
    }
    core.check.eq(b4, 111u8)
end ui.platform_test.Target.test_text_of

test ui.platform_test.Target.test_text_of_short_pool
    let pool = [0u8; 2]
    let out = ui.platform.text_of(&pool, 10u32, 5u32)
    core.check.eq(out.len(), 0usize)
end ui.platform_test.Target.test_text_of_short_pool

test ui.platform_test.Target.test_translate_ime_commit
    let mut ev = ui.platform_test.zero_ev()
    ev.event_type = ui.platform.EV_IME_COMMIT
    let pool = [0u8; 4]
    let got = ui.platform.translate_event(&ev, &pool)
    core.check.is_true(got is Some(ui.event.Event.IMECommit(_)))
end ui.platform_test.Target.test_translate_ime_commit

test ui.platform_test.Target.test_translate_ime_composition
    let mut ev = ui.platform_test.zero_ev()
    ev.event_type = ui.platform.EV_IME_COMPOSITION
    ev.text_off = 0u32
    ev.text_len = 2u32
    let mut pool = [0u8; 4]
    pool[0usize] = 99u8
    pool[1usize] = 111u8
    let got = ui.platform.translate_event(&ev, &pool)
    core.check.is_true(got is Some(ui.event.Event.IMEUpdate(_)))
end ui.platform_test.Target.test_translate_ime_composition

