test ui.platform_test.Target.test_window_open_close_headless
    if !ui.platform_test.libksnui_available() {
        let msg = "SKIP: libksnui がビルドされていません（ui/native/libksnui.so または .a が見つかりません）"
        core.mem.drop(std.io.print_line(msg))
    } else {
        let win = ui.platform.window_create("ksn ui.platform 煙テスト", 160i32, 120i32)
        if ui.platform.window_is_null(&win) {
            core.mem.drop(std.io.print_line("SKIP: SDL の窓を開けませんでした（ディスプレイまたはドライバがありません）"))
        } else {
            core.check.eq(ui.platform.window_is_null(&win), false)
        }
        ui.platform.window_close(win)
    }
end ui.platform_test.Target.test_window_open_close_headless
