test ui.scroll_test.Target.test_set_offset_clamps_and_reports
    let mut ctx = ui.scroll_test.ctx_both()
    let changed = ctx.set_offset(1000.0f32, 1000.0f32)
    let (ox, oy) = ctx.offset()
    core.check.eq(changed, true)
    core.check.eq(ox, 600.0f32)
    core.check.eq(oy, 500.0f32)
    let changed2 = ctx.set_offset(600.0f32, 500.0f32)
    core.check.eq(changed2, false)
end ui.scroll_test.Target.test_set_offset_clamps_and_reports

