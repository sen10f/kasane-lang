type ui.app_test.Suite derive [Debug, Clone, Copy] pub
    seed: usize pub
end ui.app_test.Suite

fn ui.app_test.el(kind: ui.tree.ViewKind, key: Option<u64>, children: std.vec.Vec<usize>) -> ui.tree.Element uses [] panics never
    ui.tree.Element { kind: kind, style: ui.layout.Style.default(), key: key, children: children }
end ui.app_test.el

fn ui.app_test.empty_kids() -> std.vec.Vec<usize> uses [] panics never
    std.vec.Vec.new()
end ui.app_test.empty_kids

fn ui.app_test.make_rect(x: f32, y: f32, w: f32, h: f32) -> ui.app.Rect uses [] panics never
    ui.app.Rect { x: x, y: y, width: w, height: h }
end ui.app_test.make_rect

fn ui.app_test.push_el(v: &mut std.vec.Vec<ui.tree.Element>, e: ui.tree.Element) -> () uses [alloc] panics never
    match v.push(e) {
        Ok(_) => ()
        Err(_) => ()
    }
end ui.app_test.push_el

fn ui.app_test.push_kid(kids: &mut std.vec.Vec<usize>, i: usize) -> () uses [alloc] panics never
    match kids.push(i) {
        Ok(_) => ()
        Err(_) => ()
    }
end ui.app_test.push_kid

test ui.app_test.Suite.test_apply_add_child
    let mut app = ui.app.App.new(())
    let mut elements1 = std.vec.Vec.new()
    let root1 = ui.app_test.el(ui.tree.ViewKind.Block, None, ui.app_test.empty_kids())
    ui.app_test.push_el(&mut elements1, root1)
    match app.apply((), &elements1, 0usize) {
        Ok(_) => ()
        Err(_) => core.check.is_true(false)
    }
    let mut elements2 = std.vec.Vec.new()
    let mut root_children2 = ui.app_test.empty_kids()
    ui.app_test.push_kid(&mut root_children2, 1usize)
    let root2 = ui.app_test.el(ui.tree.ViewKind.Block, None, root_children2)
    ui.app_test.push_el(&mut elements2, root2)
    let child2 = ui.app_test.el(ui.tree.ViewKind.Leaf, Some(1u64), ui.app_test.empty_kids())
    ui.app_test.push_el(&mut elements2, child2)
    match app.apply((), &elements2, 0usize) {
        Ok(f) => {
            core.check.eq(f.patch.added.len(), 1usize)
            core.check.is_true(!f.patch.is_empty())
        }
        Err(_) => core.check.is_true(false)
    }
end ui.app_test.Suite.test_apply_add_child

test ui.app_test.Suite.test_apply_change_kind
    let mut app = ui.app.App.new(())
    let mut elements1 = std.vec.Vec.new()
