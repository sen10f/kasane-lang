    }
    app.set_node_rect(1usize, ui.app_test.make_rect(10.0f32, 20.0f32, 100.0f32, 50.0f32))
    let mut elements2 = std.vec.Vec.new()
    let mut root_children2 = ui.app_test.empty_kids()
    ui.app_test.push_kid(&mut root_children2, 2usize)
    let root2 = ui.app_test.el(ui.tree.ViewKind.Block, None, root_children2)
    ui.app_test.push_el(&mut elements2, root2)
    let child2 = ui.app_test.el(ui.tree.ViewKind.Leaf, Some(2u64), ui.app_test.empty_kids())
    ui.app_test.push_el(&mut elements2, child2)
    match app.apply((), &elements2, 0usize) {
        Ok(f) => core.check.is_true(!f.dirty.is_empty())
        Err(_) => core.check.is_true(false)
    }
end ui.app_test.Suite.test_dirty_rect_union_added_and_removed

test ui.app_test.Suite.test_enqueue
    let mut app = ui.app.App.new(())
    app.enqueue(1u64)
    core.check.eq(app.pending_len(), 1usize)
    app.enqueue(2u64)
    core.check.eq(app.pending_len(), 2usize)
end ui.app_test.Suite.test_enqueue

test ui.app_test.Suite.test_enqueue_then_apply
    let mut app = ui.app.App.new(())
    app.enqueue(42u64)
    core.check.eq(app.pending_len(), 1usize)
    let mut elements = std.vec.Vec.new()
    let root_el = ui.app_test.el(ui.tree.ViewKind.Block, None, ui.app_test.empty_kids())
    ui.app_test.push_el(&mut elements, root_el)
    match app.apply((), &elements, 0usize) {
        Ok(_) => ()
        Err(_) => core.check.is_true(false)
    }
end ui.app_test.Suite.test_enqueue_then_apply

test ui.app_test.Suite.test_new
    let app = ui.app.App.new(())
    core.check.eq(app.pending_len(), 0usize)
end ui.app_test.Suite.test_new

test ui.app_test.Suite.test_node_rect_at_empty
    let app = ui.app.App.new(())
    let r = app.node_rect_at(0usize)
    core.check.is_true(r.is_empty())
end ui.app_test.Suite.test_node_rect_at_empty

test ui.app_test.Suite.test_node_rect_at_out_of_bounds
    let app = ui.app.App.new(())
    let r = app.node_rect_at(999usize)
    core.check.is_true(r.is_empty())
end ui.app_test.Suite.test_node_rect_at_out_of_bounds

test ui.app_test.Suite.test_set_node_rect
    let mut app = ui.app.App.new(())
    app.set_node_rect(0usize, ui.app_test.make_rect(1.0f32, 2.0f32, 3.0f32, 4.0f32))
    let r = app.node_rect_at(0usize)
    core.check.eq(r.x, 1.0f32)
    core.check.eq(r.y, 2.0f32)
    core.check.eq(r.width, 3.0f32)
    core.check.eq(r.height, 4.0f32)
end ui.app_test.Suite.test_set_node_rect
