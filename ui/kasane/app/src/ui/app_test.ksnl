    ui.app_test.push_el(&mut elements1, root1)
    let child1 = ui.app_test.el(ui.tree.ViewKind.Leaf, Some(1u64), ui.app_test.empty_kids())
    ui.app_test.push_el(&mut elements1, child1)
    match app.apply((), &elements1, 0usize) {
        Ok(_) => ()
        Err(_) => core.check.is_true(false)
    }
    let mut elements2 = std.vec.Vec.new()
    let mut root_children2 = ui.app_test.empty_kids()
    ui.app_test.push_kid(&mut root_children2, 1usize)
    let root2 = ui.app_test.el(ui.tree.ViewKind.Block, None, root_children2)
    ui.app_test.push_el(&mut elements2, root2)
    let child2 = ui.app_test.el(ui.tree.ViewKind.Block, Some(1u64), ui.app_test.empty_kids())
    ui.app_test.push_el(&mut elements2, child2)
    match app.apply((), &elements2, 0usize) {
        Ok(f) => {
            core.check.eq(f.patch.changed.len(), 1usize)
            core.check.is_true(!f.patch.is_empty())
        }
        Err(_) => core.check.is_true(false)
    }
end ui.app_test.Suite.test_apply_change_kind

test ui.app_test.Suite.test_apply_frame_increments
    let mut app = ui.app.App.new(())
    let mut elements = std.vec.Vec.new()
    let root_el = ui.app_test.el(ui.tree.ViewKind.Block, None, ui.app_test.empty_kids())
    ui.app_test.push_el(&mut elements, root_el)
    match app.apply((), &elements, 0usize) {
        Ok(_) => core.check.eq(1u64, 1u64)
        Err(_) => core.check.is_true(false)
    }
    match app.apply((), &elements, 0usize) {
        Ok(_) => ()
        Err(_) => core.check.is_true(false)
    }
end ui.app_test.Suite.test_apply_frame_increments

test ui.app_test.Suite.test_apply_keyed_insert
    let mut app = ui.app.App.new(())
    let mut elements1 = std.vec.Vec.new()
    let mut root_children1 = ui.app_test.empty_kids()
    ui.app_test.push_kid(&mut root_children1, 1usize)
    let root1 = ui.app_test.el(ui.tree.ViewKind.Block, None, root_children1)
    ui.app_test.push_el(&mut elements1, root1)
    let child1 = ui.app_test.el(ui.tree.ViewKind.Leaf, Some(1u64), ui.app_test.empty_kids())
    ui.app_test.push_el(&mut elements1, child1)
    match app.apply((), &elements1, 0usize) {
        Ok(_) => ()
        Err(_) => core.check.is_true(false)
    }
    let mut elements2 = std.vec.Vec.new()
    let mut root_children2 = ui.app_test.empty_kids()
    ui.app_test.push_kid(&mut root_children2, 1usize)
    ui.app_test.push_kid(&mut root_children2, 2usize)
    let root2 = ui.app_test.el(ui.tree.ViewKind.Block, None, root_children2)
    ui.app_test.push_el(&mut elements2, root2)
    let leaf1 = ui.app_test.el(ui.tree.ViewKind.Leaf, Some(1u64), ui.app_test.empty_kids())
    ui.app_test.push_el(&mut elements2, leaf1)
    let leaf2 = ui.app_test.el(ui.tree.ViewKind.Leaf, Some(2u64), ui.app_test.empty_kids())
    ui.app_test.push_el(&mut elements2, leaf2)
    match app.apply((), &elements2, 0usize) {
        Ok(f) => {
            core.check.eq(f.patch.added.len(), 1usize)
            core.check.is_true(f.patch.moved.len() == 0usize)
        }
        Err(_) => core.check.is_true(false)
    }
end ui.app_test.Suite.test_apply_keyed_insert

test ui.app_test.Suite.test_apply_keyed_reorder
    let mut app = ui.app.App.new(())
    let mut elements1 = std.vec.Vec.new()
    let mut root_children1 = ui.app_test.empty_kids()
    ui.app_test.push_kid(&mut root_children1, 1usize)
    ui.app_test.push_kid(&mut root_children1, 2usize)
    let root1 = ui.app_test.el(ui.tree.ViewKind.Block, None, root_children1)
    ui.app_test.push_el(&mut elements1, root1)
    let leaf1 = ui.app_test.el(ui.tree.ViewKind.Leaf, Some(1u64), ui.app_test.empty_kids())
    ui.app_test.push_el(&mut elements1, leaf1)
    let leaf2 = ui.app_test.el(ui.tree.ViewKind.Leaf, Some(2u64), ui.app_test.empty_kids())
    ui.app_test.push_el(&mut elements1, leaf2)
    match app.apply((), &elements1, 0usize) {
        Ok(_) => ()
        Err(_) => core.check.is_true(false)
    }
    let mut elements2 = std.vec.Vec.new()
    let mut root_children2 = ui.app_test.empty_kids()
    ui.app_test.push_kid(&mut root_children2, 2usize)
    ui.app_test.push_kid(&mut root_children2, 1usize)
    let root2 = ui.app_test.el(ui.tree.ViewKind.Block, None, root_children2)
    ui.app_test.push_el(&mut elements2, root2)
    let leaf3 = ui.app_test.el(ui.tree.ViewKind.Leaf, Some(1u64), ui.app_test.empty_kids())
    ui.app_test.push_el(&mut elements2, leaf3)
    let leaf4 = ui.app_test.el(ui.tree.ViewKind.Leaf, Some(2u64), ui.app_test.empty_kids())
    ui.app_test.push_el(&mut elements2, leaf4)
    match app.apply((), &elements2, 0usize) {
        Ok(f) => {
            core.check.eq(f.patch.moved.len(), 2usize)
            core.check.is_true(f.patch.added.len() == 0usize)
            core.check.is_true(f.patch.removed.len() == 0usize)
        }
        Err(_) => core.check.is_true(false)
    }
end ui.app_test.Suite.test_apply_keyed_reorder

