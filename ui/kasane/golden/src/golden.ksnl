fn golden.scene_round_border(out: &str) -> () uses [io.console] panics may
    let dev = golden.gpu_create(160i32, 120i32)
    let is_null = unsafe "ptr" "check null device" {
        core.ptr.is_null(dev)
    }
    if is_null {
        core.mem.drop(std.io.print_line("FAIL: gpu_create"))
        return
    }
    core.mem.drop(golden.gpu_begin(dev))
    let x = 10.0f32
    let y = 10.0f32
    let w = 80.0f32
    let h = 56.0f32
    let rad = 12.0f32
    let border = golden.mk_rect(x, y, w, h, rad, 0.9f32, 0.6f32, 0.2f32, 1.0f32)
    let x2 = 18.0f32
    let y2 = 18.0f32
    let w2 = 64.0f32
    let h2 = 40.0f32
    let rad2 = 6.0f32
    let fill = golden.mk_rect(x2, y2, w2, h2, rad2, 0.2f32, 0.6f32, 0.9f32, 1.0f32)
    let rects_p = unsafe "ptr" "rects pointer" {
        core.ptr.from_ref(&[border, fill])
    }
    golden.gpu_draw_rects(dev, rects_p, 2u64)
    golden.finish(dev, out)
end golden.scene_round_border

fn golden.scene_text(out: &str) -> () uses [io.console] panics may
    let dev = golden.gpu_create(160i32, 120i32)
    let is_null = unsafe "ptr" "check null device" {
        core.ptr.is_null(dev)
    }
    if is_null {
        core.mem.drop(std.io.print_line("FAIL: gpu_create"))
        return
    }
    core.mem.drop(golden.gpu_begin(dev))
    let size = 24.0f32
    let mut font_path = [0u8; 55]
    let font_src = "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc".as_bytes()
    let mut fi = 0usize
    while fi < 54usize {
        font_path[fi] = font_src[fi]
        fi = fi + 1usize
    }
    let font_p = unsafe "ptr" "font path pointer" {
        core.ptr.from_ref(&font_path[0usize])
    }
    let mut text = [0u8; 23]
    let text_src = "こんにちは Kasane".as_bytes()
    let mut ti = 0usize
    while ti < 22usize {
        text[ti] = text_src[ti]
        ti = ti + 1usize
    }
    let text_p = unsafe "ptr" "text pointer" {
        core.ptr.from_ref(&text[0usize])
    }
    let mut glyphs = [0u8; 768]
    let glyphs_p = unsafe "ptr" "glyphs pointer" {
        core.ptr.cast::<u8, golden.Glyph>(core.ptr.from_mut(&mut glyphs))
    }
    let n_glyphs = golden.text_shape(font_p, size, text_p, glyphs_p, 32u64)
    if n_glyphs == 0u64 {
        core.mem.drop(std.io.print_line("FAIL: shape"))
        golden.gpu_destroy(dev)
        return
    }
    let mut atlas = [0u8; 65_536]
    let atlas_p = unsafe "ptr" "atlas pointer" {
        core.ptr.from_mut(&mut atlas)
    }
    let mut quads = [0u8; 1536]
    let quads_p = unsafe "ptr" "quads pointer" {
        core.ptr.cast::<u8, golden.KsnuiGlyphQuad>(core.ptr.from_mut(&mut quads))
    }
    let mut atlas_x = 4i32
    let mut atlas_y = 4i32
    let mut max_row_h = 0i32
    let mut pen_x = 40.0f32
    let mut i = 0u64
    let cap = 65_536u64
    while i < n_glyphs {
        let idx = usize.from_u64(i)
        let g = unsafe "ptr" "read glyph" {
            core.ptr.read(core.ptr.add(glyphs_p, idx))
        }
        let gid = g.glyph_id
        let mut gbuf = [0u8; 65_536]
        let gbuf_p = unsafe "ptr" "glyph buffer pointer" {
            core.ptr.from_mut(&mut gbuf)
        }
        let mut gw = 0i32
        let mut gh = 0i32
        let mut left = 0i32
        let mut top = 0i32
        let gw_p = unsafe "ptr" "gw pointer" {
            core.ptr.from_mut(&mut gw)
        }
        let gh_p = unsafe "ptr" "gh pointer" {
            core.ptr.from_mut(&mut gh)
        }
        let left_p = unsafe "ptr" "left pointer" {
            core.ptr.from_mut(&mut left)
        }
        let top_p = unsafe "ptr" "top pointer" {
            core.ptr.from_mut(&mut top)
        }
        let rc = golden.text_raster(font_p, size, gid, gw_p, gh_p, left_p, top_p, gbuf_p, cap)
        if rc != 0i32 {
            i = i.wrapping_add(1u64)
            continue
        }
        let gw_u = match u32.try_from_i32(gw) {
            Ok(v) => v
            Err(_) => 0u32
        }
        let gh_u = match u32.try_from_i32(gh) {
            Ok(v) => v
            Err(_) => 0u32
        }
        if atlas_x + gw + 2i32 > 256i32 {
            atlas_x = 4i32
            atlas_y = atlas_y + max_row_h + 2i32
            max_row_h = 0i32
        }
        if atlas_y + gh > 256i32 {
            break
        }
        let mut row = 0i32
        while row < gh {
            let mut col = 0i32
            while col < gw {
                let src_off = row * gw + col
                let dst_off = (atlas_y + row) * 256i32 + atlas_x + col
                let s = match u32.try_from_i32(src_off) {
                    Ok(v) => usize.from_u32(v)
                    Err(_) => 0usize
                }
                let d = match u32.try_from_i32(dst_off) {
                    Ok(v) => usize.from_u32(v)
                    Err(_) => 0usize
                }
                atlas[d] = gbuf[s]
                col = col + 1i32
            }
            row = row + 1i32
        }
        let mut q = golden.zero_quad()
        q.x = pen_x + g.x_offset
        q.y = 90.0f32 - f32.from_i32_nearest(gh) + f32.from_i32_nearest(top)
        q.w = f32.from_u32_nearest(gw_u)
        q.h = f32.from_u32_nearest(gh_u)
        q.u0 = f32.from_i32_nearest(atlas_x) / 256.0f32
        q.v0 = f32.from_i32_nearest(atlas_y) / 256.0f32
        q.u1 = f32.from_i32_nearest(atlas_x + gw) / 256.0f32
        q.v1 = f32.from_i32_nearest(atlas_y + gh) / 256.0f32
        q.cr = 1.0f32
        q.cg = 1.0f32
        q.cb = 1.0f32
        q.ca = 1.0f32
        unsafe "ptr" "write quad" {
            core.ptr.write(core.ptr.add(quads_p, idx), q)
        }
        pen_x = pen_x + g.x_advance
        atlas_x = atlas_x + gw + 2i32
        if gh > max_row_h {
            max_row_h = gh
        }
        i = i.wrapping_add(1u64)
    }
    let n_valid = i
    let quads_p_const = unsafe "ptr" "quads const pointer" {
        core.ptr.as_const(quads_p)
    }
    golden.gpu_atlas_upload(dev, atlas_p)
    golden.gpu_draw_glyphs(dev, quads_p_const, n_valid)
    golden.finish(dev, out)
end golden.scene_text

fn golden.text_raster(path: *const u8, size: f32, gid: u32, gw: *mut i32, gh: *mut i32, left: *mut i32, top: *mut i32, buf: *mut u8, cap: u64) -> i32 uses [] panics may pub
    unsafe "bindgen" "raster glyph" {
        golden.raw_ksnui_text_raster(path, size, 0u32, gid, gw, gh, left, top, buf, cap)
    }
end golden.text_raster

fn golden.text_shape(path: *const u8, size: f32, utf8: *const u8, out: *mut golden.Glyph, cap: u64) -> u64 uses [] panics may pub
    unsafe "bindgen" "shape text" {
        golden.raw_ksnui_text_shape(path, size, 0u32, utf8, out, cap)
    }
end golden.text_shape

fn golden.zero_quad() -> golden.KsnuiGlyphQuad uses [] panics never pub
    let mut z = [0u8; 48]
    let z_p = unsafe "ptr" "zero quad pointer" {
        core.ptr.cast::<u8, golden.KsnuiGlyphQuad>(core.ptr.from_mut(&mut z))
    }
    unsafe "ptr" "read zero quad" {
        core.ptr.read(z_p)
    }
end golden.zero_quad
