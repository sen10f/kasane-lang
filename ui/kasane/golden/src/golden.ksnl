    let x = 20.0f32
    let y = 30.0f32
    let w = 100.0f32
    let h = 40.0f32
    let rad = 6.0f32
    let base = golden.mk_rect(x, y, w, h, rad, 0.4f32, 0.4f32, 0.4f32, 1.0f32)
    let bx = 70.0f32
    let by = 34.0f32
    let bw = 50.0f32
    let bh = 32.0f32
    let brad = 4.0f32
    let cover = golden.mk_rect(bx, by, bw, bh, brad, 0.1f32, 0.1f32, 0.1f32, 1.0f32)
