type golden.Glyph layout c derive [Clone, Copy] pub
    glyph_id: u32
    cluster: u32
    x_advance: f32
    y_advance: f32
    x_offset: f32
    y_offset: f32
end golden.Glyph

type golden.KsnuiGlyphQuad layout c derive [Clone, Copy] pub
    x: f32
    y: f32
    w: f32
    h: f32
    u0: f32
    v0: f32
    u1: f32
    v1: f32
    cr: f32
    cg: f32
    cb: f32
    ca: f32
end golden.KsnuiGlyphQuad

type golden.KsnuiRect layout c derive [Clone, Copy] pub
    x: f32
    y: f32
    w: f32
    h: f32
    r: f32
    cr: f32
    cg: f32
    cb: f32
    ca: f32
end golden.KsnuiRect

extern golden.raw_ksnui_gpu_atlas_upload(dev: *mut u8, w: i32, h: i32, pixels: *const u8) -> () link "ksnui_gpu_atlas_upload"

extern golden.raw_ksnui_gpu_begin(dev: *mut u8, r: f32, g: f32, b: f32, a: f32) -> i32 link "ksnui_gpu_begin"

extern golden.raw_ksnui_gpu_create(window: *mut u8, w: i32, h: i32) -> *mut u8 link "ksnui_gpu_create"

extern golden.raw_ksnui_gpu_destroy(dev: *mut u8) -> () link "ksnui_gpu_destroy"

extern golden.raw_ksnui_gpu_draw_glyphs(dev: *mut u8, quads: *const golden.KsnuiGlyphQuad, n: u64) -> () link "ksnui_gpu_draw_glyphs"

extern golden.raw_ksnui_gpu_draw_rects(dev: *mut u8, rects: *const golden.KsnuiRect, n: u64) -> () link "ksnui_gpu_draw_rects"

extern golden.raw_ksnui_gpu_end(dev: *mut u8) -> () link "ksnui_gpu_end"

extern golden.raw_ksnui_gpu_readback(dev: *mut u8, out: *mut u8, cap: u64) -> u64 link "ksnui_gpu_readback"

extern golden.raw_ksnui_png_write(path: *const u8, w: i32, h: i32, rgba: *const u8) -> i32 link "ksnui_png_write"

extern golden.raw_ksnui_text_raster(path: *const u8, size: f32, face_index: u32, glyph_id: u32, gw: *mut i32, gh: *mut i32, left: *mut i32, top: *mut i32, buf: *mut u8, cap: u64) -> i32 link "ksnui_text_raster"

extern golden.raw_ksnui_text_shape(font_path: *const u8, size: f32, face_index: u32, utf8: *const u8, out: *mut golden.Glyph, cap: u64) -> u64 link "ksnui_text_shape"

fn golden.finish(dev: *mut u8, out: &str) -> () uses [io.console] panics may
    golden.gpu_end(dev)
    let mut rgba = [0u8; 76_800]
    let rgba_p = unsafe "ptr" "rgba pointer" {
        core.ptr.from_mut(&mut rgba)
    }
    let got = golden.gpu_readback(dev, rgba_p, 76_800u64)
    if got != 76_800u64 {
        core.mem.drop(std.io.print_line("FAIL: readback"))
        golden.gpu_destroy(dev)
        return
    }
    let path_p = unsafe "ptr" "png path pointer" {
        core.ptr.from_ref(out.as_bytes())
    }
    core.mem.drop(golden.png_write(path_p, 160i32, 120i32, rgba_p))
    golden.gpu_destroy(dev)
    core.mem.drop(std.io.print_line("golden OK"))
end golden.finish

fn golden.gpu_atlas_upload(dev: *mut u8, pixels: *const u8) -> () uses [] panics may pub
    unsafe "bindgen" "upload atlas" {
        golden.raw_ksnui_gpu_atlas_upload(dev, 256i32, 256i32, pixels)
    }
end golden.gpu_atlas_upload

fn golden.gpu_begin(dev: *mut u8) -> i32 uses [] panics may pub
    unsafe "bindgen" "begin frame" {
        golden.raw_ksnui_gpu_begin(dev, 0.1f32, 0.1f32, 0.1f32, 1.0f32)
    }
end golden.gpu_begin

fn golden.gpu_create(w: i32, h: i32) -> *mut u8 uses [] panics may pub
    unsafe "bindgen" "create headless GPU device" {
        golden.raw_ksnui_gpu_create(core.ptr.null_mut(), w, h)
    }
end golden.gpu_create

fn golden.gpu_destroy(dev: *mut u8) -> () uses [] panics may pub
    unsafe "bindgen" "destroy device" {
        golden.raw_ksnui_gpu_destroy(dev)
    }
end golden.gpu_destroy

fn golden.gpu_draw_glyphs(dev: *mut u8, quads: *const golden.KsnuiGlyphQuad, n: u64) -> () uses [] panics may pub
    unsafe "bindgen" "draw glyphs" {
        golden.raw_ksnui_gpu_draw_glyphs(dev, quads, n)
    }
end golden.gpu_draw_glyphs

fn golden.gpu_draw_rects(dev: *mut u8, rects: *const golden.KsnuiRect, n: u64) -> () uses [] panics may pub
    unsafe "bindgen" "draw rects" {
        golden.raw_ksnui_gpu_draw_rects(dev, rects, n)
    }
end golden.gpu_draw_rects

fn golden.gpu_end(dev: *mut u8) -> () uses [] panics may pub
    unsafe "bindgen" "end frame" {
        golden.raw_ksnui_gpu_end(dev)
    }
end golden.gpu_end

fn golden.gpu_readback(dev: *mut u8, out: *mut u8, cap: u64) -> u64 uses [] panics may pub
    unsafe "bindgen" "readback pixels" {
        golden.raw_ksnui_gpu_readback(dev, out, cap)
    }
end golden.gpu_readback

fn golden.main() -> () uses [env, io.console] panics may
    if std.env.arg_count() < 3usize {
        core.mem.drop(std.io.print_line("usage: ksn run golden.main <scene> <出力 PNG>"))
        return
    }
    let scene = match std.env.arg(1usize) {
        Some(s) => s
        None => {
            core.mem.drop(std.io.print_line("FAIL: 引数が足りない"))
            return
        }
    }
    let out = match std.env.arg(2usize) {
        Some(p) => p
        None => {
            core.mem.drop(std.io.print_line("FAIL: 引数が足りない"))
            return
        }
    }
    if scene == "rect" {
        golden.scene_rect(out)
    } else if scene == "round_border" {
        golden.scene_round_border(out)
    } else if scene == "clip" {
        golden.scene_clip(out)
    } else if scene == "text" {
        golden.scene_text(out)
    } else if scene == "alpha" {
        golden.scene_alpha(out)
    } else {
        core.mem.drop(std.io.print_line("FAIL: 不明なシーン名"))
    }
end golden.main

fn golden.mk_rect(x: f32, y: f32, w: f32, h: f32, r: f32, a: f32, b: f32, c: f32, d: f32) -> golden.KsnuiRect uses [] panics never pub
    golden.KsnuiRect {
        x: x
        y: y
        w: w
        h: h
        r: r
        cr: a
        cg: b
        cb: c
        ca: d
    }
end golden.mk_rect

fn golden.png_write(path: *const u8, w: i32, h: i32, rgba: *const u8) -> i32 uses [] panics may pub
    unsafe "bindgen" "write PNG" {
        golden.raw_ksnui_png_write(path, w, h, rgba)
    }
end golden.png_write

fn golden.scene_alpha(out: &str) -> () uses [io.console] panics may
    let dev = golden.gpu_create(160i32, 120i32)
    let is_null = unsafe "ptr" "check null device" {
        core.ptr.is_null(dev)
    }
    if is_null {
        core.mem.drop(std.io.print_line("FAIL: gpu_create"))
        return
    }
    core.mem.drop(golden.gpu_begin(dev))
    let ax = 20.0f32
    let ay = 20.0f32
    let aw = 70.0f32
    let ah = 50.0f32
    let arad = 6.0f32
    let a = golden.mk_rect(ax, ay, aw, ah, arad, 0.2f32, 0.6f32, 0.9f32, 0.6f32)
    let bx = 50.0f32
    let by = 35.0f32
    let bw = 70.0f32
    let bh = 50.0f32
    let b_rad = 6.0f32
    let b = golden.mk_rect(bx, by, bw, bh, b_rad, 0.9f32, 0.6f32, 0.2f32, 0.6f32)
    let rects_p = unsafe "ptr" "rects pointer" {
        core.ptr.from_ref(&[a, b])
    }
    golden.gpu_draw_rects(dev, rects_p, 2u64)
    golden.finish(dev, out)
end golden.scene_alpha

