test ui.theme.Theme.test_light_and_dark_differ
    let light = ui.theme.theme_light()
    let dark = ui.theme.theme_dark()
    core.check.is_true(light.color.bg.r != dark.color.bg.r)
    core.check.is_true(light.color.prim.r != dark.color.prim.r)
end ui.theme.Theme.test_light_and_dark_differ

test ui.theme.Theme.test_theme_dark_colors
    let t = ui.theme.theme_dark()
    core.check.is_true(t.color.bg.r < 0.2f32)
    core.check.is_true(t.color.on_bg.r > 0.8f32)
    core.check.eq(t.font.heading, 20.0f32)
end ui.theme.Theme.test_theme_dark_colors

test ui.theme.Theme.test_theme_light_colors
    let t = ui.theme.theme_light()
    let (rr, gg, bb, aa) = t.color.bg.to_srgb()
    core.check.is_true(rr > 0.99f32)
    core.check.is_true(gg > 0.99f32)
    core.check.is_true(bb > 0.99f32)
    core.check.eq(aa, 1.0f32)
    core.check.eq(t.space.spacing, 8.0f32)
    core.check.eq(t.space.radius_medium, 8.0f32)
    core.check.eq(t.font.body, 14.0f32)
end ui.theme.Theme.test_theme_light_colors
