const hashmap.EXPECT_HITS: u32 = 5_999_000u32

const hashmap.EXPECT_MISSES: u32 = 2000u32

const hashmap.N: u32 = 2000u32

fn hashmap.main() -> Result<(), std.io.Error> uses [alloc] panics may
    match hashmap.run(hashmap.N) {
        Ok((hits, misses)) => {
            core.check.eq(hits, hashmap.EXPECT_HITS)
            core.check.eq(misses, hashmap.EXPECT_MISSES)
        }
        Err(_e) => core.panic.panic("oom")
    }
    Ok(())
end hashmap.main

fn hashmap.run(n: u32) -> Result<(u32, u32), alloc.alloc.AllocError> uses [alloc] panics never pub
    let mut m = std.collections.HashMap.new()
    for i in core.iter.range(0u32, n) {
        core.mem.drop(m.insert(i, i.wrapping_mul(3u32).wrapping_add(1u32))?)
    }
    let mut hits = 0u32
    let mut misses = 0u32
    let mut k = 0u32
    let limit = n.wrapping_mul(2u32)
    while k < limit {
        match m.get(&k) {
            Some(v) => {
                hits = hits.wrapping_add(*v)
            }
            None => {
                misses = misses.wrapping_add(1u32)
            }
        }
        k = k.wrapping_add(1u32)
    }
    Ok((hits, misses))
end hashmap.run
