const closure.EXPECT: u64 = 314_999_250_000u64

const closure.N: u64 = 300_000u64

fn closure.apply_n[F: core.ops.Fn<(u64,), u64, E, P>, E: uses, P: panics](f: F, n: u64) -> u64 uses [E] panics P pub
    let mut acc = 0u64
    for i in core.iter.range(0u64, n) {
        acc = acc.wrapping_add(f(i))
    }
    acc
end closure.apply_n

fn closure.main() -> Result<(), std.io.Error> uses [] panics may
    let k = 7u64
    let total = closure.apply_n(
        fn(x: u64) -> u64 capture [&k] {
            x.wrapping_mul(*k).wrapping_add(1u64)
        },
        closure.N,
    )
    core.check.eq(total, closure.EXPECT)
    Ok(())
end closure.main
