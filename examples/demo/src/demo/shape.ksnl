enum demo.shape.Shape derive [Debug] pub
    Circle(i32)
    Rect(i32, i32)
    Empty
end demo.shape.Shape

fn demo.shape.area(s: demo.shape.Shape) -> i32 uses [] panics never pub
    match s {
        demo.shape.Shape.Circle(r) => r.wrapping_mul(3i32)
        demo.shape.Shape.Rect(w, h) => w.wrapping_mul(h)
        demo.shape.Shape.Empty => 0i32
    }
end demo.shape.area
