type tour.Acc derive [Debug, Clone] pub
    total: i64
    hits: u32
end tour.Acc

enum tour.Shape derive [Debug, Clone, PartialEq] pub
    Circle(i32)
    Rect(i32, i32)
    Unit
end tour.Shape

fn tour.Acc.add(self: &mut tour.Acc, v: i64) -> () uses [] panics never pub
    self.total = self.total.wrapping_add(v)
    self.hits = self.hits.wrapping_add(1u32)
end tour.Acc.add

fn tour.csv_sum(line: &str) -> i64 uses [] panics never pub
    let mut total = 0i64
    for cell in line.split(",") {
        let v = match i64.parse(cell.trim()) {
            Ok(n) => n
            Err(_) => 0i64
        }
        total = total.wrapping_add(v)
    }
    total
end tour.csv_sum

fn tour.floats() -> f64 uses [] panics never pub
    let a = 9.0f64
    let b = a.sqrt()
    let c = b * 2.0 + 1.5
    c.floor()
end tour.floats

fn tour.ints() -> u8 uses [] panics never pub
    let a = 250u8
    let b = a.saturating_add(10u8)
    let c = a.wrapping_add(10u8)
    let d = match a.checked_add(10u8) {
        Some(_) => 1u8
        None => 2u8
    }
    b.wrapping_add(c).wrapping_add(d)
end tour.ints

fn tour.loops() -> u32 uses [] panics never pub
    let mut total = 0u32
    let mut i = 0u32
    loop {
        i = i.wrapping_add(1u32)
        if i > 20u32 {
            break
        }
        if i & 1u32 == 1u32 {
            continue
        }
        total = total.wrapping_add(i)
    }
    total
end tour.loops

fn tour.main() -> Result<(), std.io.Error> uses [alloc, io.console] panics may
    core.check.eq(tour.floats(), 7.0)
    core.check.eq(tour.ints(), 5u8)
    core.check.eq(tour.loops(), 110u32)
    core.check.eq(tour.shapes(), 30i32)
    let mut acc = tour.Acc { total: 0i64, hits: 0u32 }
    acc.add(5i64)
    acc.add(7i64)
    let snapshot = acc.clone()
    acc.add(1i64)
    core.check.eq(snapshot.total, 12i64)
    core.check.eq(acc.total, 13i64)
    core.check.eq(acc.hits, 3u32)
    let mut v = std.vec.Vec.new()
    let r1 = v.push(10u8)
    let r2 = v.push(20u8)
    let r3 = v.push(30u8)
    core.check.eq(r1, Ok(()))
    core.check.eq(r2, Ok(()))
    core.check.eq(r3, Ok(()))
    core.check.eq(v.len(), 3usize)
    core.check.eq(v.pop(), Some(30u8))
    core.check.eq(v.get(1usize), Some(&20u8))
    core.check.eq(v.remove(0usize), Some(10u8))
    core.check.eq(v.is_empty(), false)
    let arr = [1u8, 2u8, 3u8, 4u8, 5u8]
    let mid = arr.sub(1usize, 4usize)
    core.check.eq(mid, Some(&[2u8, 3u8, 4u8]))
    core.check.eq(arr.first(), Some(&1u8))
    core.check.eq(arr.last(), Some(&5u8))
    core.check.eq(arr.contains(&3u8), true)
    let mut s = std.string.String.new()
    let p1 = s.push_str("héllo")
    let p2 = s.push('!')
    core.check.eq(p1, Ok(()))
    core.check.eq(p2, Ok(()))
    core.check.eq(s.len(), 7usize)
    core.check.eq(s.as_str(), "héllo!")
    core.check.eq("abc".starts_with("ab"), true)
    core.check.eq("abc".find("c"), Some(2usize))
    let c = 'q'
    core.check.eq(c.to_ascii_uppercase(), 'Q')
    core.check.eq(c.to_u32(), 113u32)
    core.check.eq(char.try_from_u32(65u32), Some('A'))
    let t = (1u8, true, 'z')
    let (x, y, z) = t
    core.check.eq(x, 1u8)
    core.check.eq(y, true)
    core.check.eq(z, 'z')
    let mut m = std.collections.BtreeMap.new()
    let i1 = m.insert(3u8, 30u8)
    let i2 = m.insert(1u8, 10u8)
    let i3 = m.insert(3u8, 33u8)
    core.check.eq(i1, Ok(None))
    core.check.eq(i2, Ok(None))
    core.check.eq(i3, Ok(Some(30u8)))
    core.check.eq(m.len(), 2usize)
    core.check.eq(m.get(3u8), Some(&33u8))
    core.check.eq(m.contains_key(2u8), false)
    core.check.eq(m.remove(1u8), Some(10u8))
    core.check.eq(core.num.u8.MAX, 255u8)
    core.check.eq(core.num.i32.MIN, -2_147_483_648i32)
    core.check.eq(i32.try_from_i64(5_000_000_000i64) is Err(_), true)
    core.check.eq(u8.from_str_radix("ff", 16u32), Ok(255u8))
    core.check.eq(7u32.leading_zeros(), 29u32)
    core.check.eq(12u8.count_ones(), 2u32)
    core.check.eq(tour.csv_sum("1, 20,-3 ,x"), 18i64)
    core.check.eq("key=value".split_once("="), Some(("key", "value")))
    core.check.eq("<b>".strip_prefix("<"), Some("b>"))
    let mut num = std.string.String.new()
    core.check.eq(num.push_i64(-42i64), Ok(()))
    core.check.eq(num.as_str(), "-42")
    std.io.print_line("tour ok")
end tour.main

fn tour.shapes() -> i32 uses [] panics never pub
    let a = tour.Shape.Circle(3i32)
    let b = tour.Shape.Rect(4i32, 6i32)
    let c = tour.Shape.Unit
    let mut sum = 0i32
    for s in [a, b, c] {
        sum = sum.wrapping_add(match s {
            tour.Shape.Circle(r) => r.wrapping_mul(2i32)
            tour.Shape.Rect(w, h) => w.wrapping_mul(h)
            tour.Shape.Unit => 0i32
        })
    }
    sum
end tour.shapes

test tour.csv_sum.test_cells
    core.check.eq(tour.csv_sum(" 5 ,6,,7"), 18i64)
    core.check.eq(tour.csv_sum(""), 0i64)
end tour.csv_sum.test_cells

test tour.floats.test_value
    core.check.eq(tour.floats(), 7.0)
end tour.floats.test_value

test tour.ints.test_wrap
    core.check.eq(tour.ints(), 5u8)
end tour.ints.test_wrap
