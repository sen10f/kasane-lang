import shortener.http

fn shortener.tests.loopback.listen() -> std.net.TcpListener uses [io.net] panics may
    match std.net.listen("127.0.0.1:0") {
        Ok(l) => l
        Err(_e) => core.panic.panic("listen failed")
    }
end shortener.tests.loopback.listen

fn shortener.tests.loopback.memory() -> shortener.store.Store uses [alloc] panics may
    match shortener.store.Store.new("") {
        Ok(s) => s
        Err(_e) => core.panic.panic("new failed")
    }
end shortener.tests.loopback.memory

fn shortener.tests.loopback.send(listener: &std.net.TcpListener, db: &mut shortener.store.Store, method: &str, path: &str, body: &str) -> shortener.http.Reply uses [alloc, io.fs, io.net] panics may
    let text = match http.build_request(method, path, body) {
        Ok(t) => t
        Err(_e) => core.panic.panic("build failed")
    }
    match shortener.client.exchange(listener, db, text.as_str()) {
        Ok(r) => r
        Err(_e) => core.panic.panic("exchange failed")
    }
end shortener.tests.loopback.send

test shortener.tests.loopback.test_bad_requests_get_400
    let listener = shortener.tests.loopback.listen()
    let mut db = shortener.tests.loopback.memory()
    let garbage = shortener.client.exchange(&listener, &mut db, "garbage\r\n\r\n")
    let no_version = shortener.client.exchange(&listener, &mut db, "GET /x\r\n\r\n")
    let big = "POST /shorten HTTP/1.1\r\nContent-Length: 99999\r\n\r\n"
    let too_big = shortener.client.exchange(&listener, &mut db, big)
    core.mem.drop(listener.close())
    match garbage {
        Ok(r) => {
            core.check.eq(r.status, 400u16)
            core.check.eq(r.body.as_str(), "{\"error\":\"bad request\"}")
        }
        Err(_e) => core.panic.panic("garbage")
    }
    match no_version {
        Ok(r) => core.check.eq(r.status, 400u16)
        Err(_e) => core.panic.panic("no version")
    }
    match too_big {
        Ok(r) => core.check.eq(r.status, 413u16)
        Err(_e) => core.panic.panic("too big")
    }
    core.check.eq(db.len(), 0usize)
end shortener.tests.loopback.test_bad_requests_get_400

test shortener.tests.loopback.test_serves_queued_connections_in_order
    let listener = shortener.tests.loopback.listen()
    let mut db = shortener.tests.loopback.memory()
    match shortener.client.queued_pair(&listener, &mut db) {
        Ok((first, second)) => {
            core.check.eq(first.status, 201u16)
            core.check.eq(first.body.as_str(), "{\"code\":\"1000\",\"url\":\"http://q.test/1\"}")
            core.check.eq(second.status, 201u16)
            core.check.eq(second.body.as_str(), "{\"code\":\"1001\",\"url\":\"http://q.test/2\"}")
        }
        Err(_e) => core.panic.panic("queued pair")
    }
    core.mem.drop(listener.close())
    core.check.eq(db.len(), 2usize)
end shortener.tests.loopback.test_serves_queued_connections_in_order

test shortener.tests.loopback.test_shorten_and_fetch
    let listener = shortener.tests.loopback.listen()
    let mut db = shortener.tests.loopback.memory()
    let url = "http://a.test/p"
    let created = shortener.tests.loopback.send(&listener, &mut db, "POST", "/shorten", url)
    let fetched = shortener.tests.loopback.send(&listener, &mut db, "GET", "/1000", "")
    let missing = shortener.tests.loopback.send(&listener, &mut db, "GET", "/1001", "")
    let stats = shortener.tests.loopback.send(&listener, &mut db, "GET", "/stats", "")
    let denied = shortener.tests.loopback.send(&listener, &mut db, "PUT", "/1000", "")
    core.mem.drop(listener.close())
    core.check.eq(created.status, 201u16)
    core.check.eq(created.body.as_str(), "{\"code\":\"1000\",\"url\":\"http://a.test/p\"}")
    core.check.eq(fetched.status, 302u16)
    core.check.eq(fetched.location.as_str(), "http://a.test/p")
    core.check.eq(missing.status, 404u16)
    core.check.eq(stats.body.as_str(), "{\"links\":1}")
    core.check.eq(denied.status, 405u16)
end shortener.tests.loopback.test_shorten_and_fetch
