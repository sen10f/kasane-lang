enum shortener.error.Error derive [Debug, Clone, Copy, PartialEq] pub
    Alloc
    BadRequest
    Closed
    Corrupt
    Full
    Io
    Mismatch
    Net(i32)
    TooLarge
end shortener.error.Error

impl core.convert.From<alloc.alloc.AllocError> for shortener.error.Error
fn shortener.error.Error.from_value_alloc_error(_value: alloc.alloc.AllocError) -> shortener.error.Error uses [] panics never impls core.convert.From<alloc.alloc.AllocError>
    shortener.error.Error.Alloc
end shortener.error.Error.from_value_alloc_error

impl core.convert.From<std.io.Error> for shortener.error.Error
fn shortener.error.Error.from_value_io_error(_value: std.io.Error) -> shortener.error.Error uses [] panics never impls core.convert.From<std.io.Error>
    shortener.error.Error.Io
end shortener.error.Error.from_value_io_error

impl core.convert.From<std.net.Error> for shortener.error.Error
fn shortener.error.Error.from_value_net_error(value: std.net.Error) -> shortener.error.Error uses [] panics never impls core.convert.From<std.net.Error>
    shortener.error.Error.Net(value.code)
end shortener.error.Error.from_value_net_error

impl core.convert.From<core.num.ParseIntError> for shortener.error.Error
fn shortener.error.Error.from_value_parse_int_error(_value: core.num.ParseIntError) -> shortener.error.Error uses [] panics never impls core.convert.From<core.num.ParseIntError>
    shortener.error.Error.BadRequest
end shortener.error.Error.from_value_parse_int_error

impl core.convert.From<alloc.string.PushBytesError> for shortener.error.Error
fn shortener.error.Error.from_value_push_bytes_error(value: alloc.string.PushBytesError) -> shortener.error.Error uses [] panics never impls core.convert.From<alloc.string.PushBytesError>
    match value {
        alloc.string.PushBytesError.Alloc(_a) => shortener.error.Error.Alloc
        alloc.string.PushBytesError.InvalidUtf8(_u) => shortener.error.Error.BadRequest
    }
end shortener.error.Error.from_value_push_bytes_error

impl core.convert.From<core.str.Utf8Error> for shortener.error.Error
fn shortener.error.Error.from_value_utf8_error(_value: core.str.Utf8Error) -> shortener.error.Error uses [] panics never impls core.convert.From<core.str.Utf8Error>
    shortener.error.Error.BadRequest
end shortener.error.Error.from_value_utf8_error
