enum shortener.error.Error derive [Debug, Clone, Copy, PartialEq, From] pub
    Alloc(alloc.alloc.AllocError)
    BadRequest
    Closed
    Corrupt
    Full
    Io(std.io.Error)
    Mismatch
    Net(std.net.Error)
    TooLarge
end shortener.error.Error

fn shortener.error.bad_number(_value: core.num.ParseIntError) -> shortener.error.Error uses [] panics never pub
    shortener.error.Error.BadRequest
end shortener.error.bad_number

fn shortener.error.bad_text(_value: core.str.Utf8Error) -> shortener.error.Error uses [] panics never pub
    shortener.error.Error.BadRequest
end shortener.error.bad_text

fn shortener.error.io_failed() -> shortener.error.Error uses [] panics never pub
    shortener.error.Error.Io(std.io.Error { kind: std.io.ErrorKind.Other, code: 0i32 })
end shortener.error.io_failed

fn shortener.error.push_failed(value: alloc.string.PushBytesError) -> shortener.error.Error uses [] panics never pub
    match value {
        alloc.string.PushBytesError.Alloc(a) => shortener.error.Error.Alloc(a)
        alloc.string.PushBytesError.InvalidUtf8(_u) => shortener.error.Error.BadRequest
    }
end shortener.error.push_failed
