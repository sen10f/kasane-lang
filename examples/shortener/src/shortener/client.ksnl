import shortener.error
import shortener.http
import shortener.server
import shortener.wire

fn shortener.client.address(port: u16) -> Result<alloc.string.String<std.alloc.System>, shortener.error.Error> uses [alloc] panics never pub
    let mut out = alloc.string.String.new(std.alloc.SYSTEM)
    out.push_str("127.0.0.1:")?
    out.push_u64(u64.from_u16(port))?
    Ok(out)
end shortener.client.address

fn shortener.client.converse(stream: &mut std.net.TcpStream, listener: &std.net.TcpListener, db: &mut shortener.store.Store, request: &str) -> Result<shortener.http.Reply, shortener.error.Error> uses [alloc, io.fs, io.net] panics never
    wire.write_all(stream, request.as_bytes())?
    server.serve_one(listener, db)?
    let raw = wire.read_to_close(stream)?
    http.parse_reply(raw.as_slice())
end shortener.client.converse

fn shortener.client.exchange(listener: &std.net.TcpListener, db: &mut shortener.store.Store, request: &str) -> Result<shortener.http.Reply, shortener.error.Error> uses [alloc, io.fs, io.net] panics never pub
    let port = listener.local_port()?
    let target = shortener.client.address(port)?
    let mut stream = std.net.connect(target.as_str())?
    let result = shortener.client.converse(&mut stream, listener, db, request)
    core.mem.drop(stream.close())
    result
end shortener.client.exchange

fn shortener.client.queued_inner(first: &mut std.net.TcpStream, second: &mut std.net.TcpStream, listener: &std.net.TcpListener, db: &mut shortener.store.Store, one: &str, two: &str) -> Result<(shortener.http.Reply, shortener.http.Reply), shortener.error.Error> uses [alloc, io.fs, io.net] panics never
    wire.write_all(first, one.as_bytes())?
    wire.write_all(second, two.as_bytes())?
    core.mem.drop(server.serve(listener, db, 2usize)?)
    let raw_one = wire.read_to_close(first)?
    let raw_two = wire.read_to_close(second)?
    let reply_one = http.parse_reply(raw_one.as_slice())?
    let reply_two = http.parse_reply(raw_two.as_slice())?
    Ok((reply_one, reply_two))
end shortener.client.queued_inner

fn shortener.client.queued_pair(listener: &std.net.TcpListener, db: &mut shortener.store.Store) -> Result<(shortener.http.Reply, shortener.http.Reply), shortener.error.Error> uses [alloc, io.fs, io.net] panics never pub
    let port = listener.local_port()?
    let target = shortener.client.address(port)?
    let one = http.build_request("POST", "/shorten", "http://q.test/1")?
    let two = http.build_request("POST", "/shorten", "http://q.test/2")?
    let mut first = std.net.connect(target.as_str())?
    let mut second = match std.net.connect(target.as_str()) {
        Ok(s) => s
        Err(e) => {
            core.mem.drop(first.close())
            return Err(error.Error.from_value_net_error(e))
        }
    }
    let a = one.as_str()
    let b = two.as_str()
    let result = shortener.client.queued_inner(&mut first, &mut second, listener, db, a, b)
    core.mem.drop(first.close())
    core.mem.drop(second.close())
    result
end shortener.client.queued_pair

fn shortener.client.test_listen() -> std.net.TcpListener uses [io.net] panics may
    match std.net.listen("127.0.0.1:0") {
        Ok(l) => l
        Err(_e) => core.panic.panic("listen failed")
    }
end shortener.client.test_listen

fn shortener.client.test_memory() -> shortener.store.Store uses [alloc] panics may
    match shortener.store.Store.new("") {
        Ok(s) => s
        Err(_e) => core.panic.panic("new failed")
    }
end shortener.client.test_memory

fn shortener.client.test_send(listener: &std.net.TcpListener, db: &mut shortener.store.Store, method: &str, path: &str, body: &str) -> shortener.http.Reply uses [alloc, io.fs, io.net] panics may
    let text = match http.build_request(method, path, body) {
        Ok(t) => t
        Err(_e) => core.panic.panic("build failed")
    }
    match shortener.client.exchange(listener, db, text.as_str()) {
        Ok(r) => r
        Err(_e) => core.panic.panic("exchange failed")
    }
end shortener.client.test_send

test shortener.client.exchange.test_bad_requests_get_400
    let listener = shortener.client.test_listen()
    let mut db = shortener.client.test_memory()
    let garbage = shortener.client.exchange(&listener, &mut db, "garbage\r\n\r\n")
    let no_version = shortener.client.exchange(&listener, &mut db, "GET /x\r\n\r\n")
    let big = "POST /shorten HTTP/1.1\r\nContent-Length: 99999\r\n\r\n"
    let too_big = shortener.client.exchange(&listener, &mut db, big)
    core.mem.drop(listener.close())
    match garbage {
        Ok(r) => {
            core.check.eq(r.status, 400u16)
            core.check.eq(r.body.as_str(), "{\"error\":\"bad request\"}")
        }
        Err(_e) => core.panic.panic("garbage")
    }
    match no_version {
        Ok(r) => core.check.eq(r.status, 400u16)
        Err(_e) => core.panic.panic("no version")
    }
    match too_big {
        Ok(r) => core.check.eq(r.status, 413u16)
        Err(_e) => core.panic.panic("too big")
    }
    core.check.eq(db.len(), 0usize)
end shortener.client.exchange.test_bad_requests_get_400

test shortener.client.exchange.test_shorten_and_fetch
    let listener = shortener.client.test_listen()
    let mut db = shortener.client.test_memory()
    let url = "http://a.test/p"
    let created = shortener.client.test_send(&listener, &mut db, "POST", "/shorten", url)
    let fetched = shortener.client.test_send(&listener, &mut db, "GET", "/1000", "")
    let missing = shortener.client.test_send(&listener, &mut db, "GET", "/1001", "")
    let stats = shortener.client.test_send(&listener, &mut db, "GET", "/stats", "")
    let denied = shortener.client.test_send(&listener, &mut db, "PUT", "/1000", "")
    core.mem.drop(listener.close())
    core.check.eq(created.status, 201u16)
    core.check.eq(created.body.as_str(), "{\"code\":\"1000\",\"url\":\"http://a.test/p\"}")
    core.check.eq(fetched.status, 302u16)
    core.check.eq(fetched.location.as_str(), "http://a.test/p")
    core.check.eq(missing.status, 404u16)
    core.check.eq(stats.body.as_str(), "{\"links\":1}")
    core.check.eq(denied.status, 405u16)
end shortener.client.exchange.test_shorten_and_fetch

test shortener.client.queued_pair.test_serves_queued_connections_in_order
    let listener = shortener.client.test_listen()
    let mut db = shortener.client.test_memory()
    match shortener.client.queued_pair(&listener, &mut db) {
        Ok((first, second)) => {
            core.check.eq(first.status, 201u16)
            core.check.eq(first.body.as_str(), "{\"code\":\"1000\",\"url\":\"http://q.test/1\"}")
            core.check.eq(second.status, 201u16)
            core.check.eq(second.body.as_str(), "{\"code\":\"1001\",\"url\":\"http://q.test/2\"}")
        }
        Err(_e) => core.panic.panic("queued pair")
    }
    core.mem.drop(listener.close())
    core.check.eq(db.len(), 2usize)
end shortener.client.queued_pair.test_serves_queued_connections_in_order
