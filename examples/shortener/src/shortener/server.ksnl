import shortener.error
import shortener.http
import shortener.router
import shortener.wire

fn shortener.server.respond(stream: &mut std.net.TcpStream, db: &mut shortener.store.Store) -> Result<(), shortener.error.Error> uses [alloc, io.fs, io.net] panics never pub
    let response = match wire.read_request(stream) {
        Ok(request) => router.route(db, &request)?
        Err(error.Error.BadRequest) => router.error_response(400u16, "bad request")?
        Err(error.Error.TooLarge) => router.error_response(413u16, "payload too large")?
        Err(other) => return Err(other)
    }
    let text = http.render_response(&response)?
    wire.write_all(stream, text.as_str().as_bytes())
end shortener.server.respond

fn shortener.server.serve(listener: &std.net.TcpListener, db: &mut shortener.store.Store, count: usize) -> Result<usize, shortener.error.Error> uses [alloc, io.fs, io.net] panics never pub
    for _i in core.iter.range(0usize, count) {
        shortener.server.serve_one(listener, db)?
    }
    Ok(count)
end shortener.server.serve

fn shortener.server.serve_one(listener: &std.net.TcpListener, db: &mut shortener.store.Store) -> Result<(), shortener.error.Error> uses [alloc, io.fs, io.net] panics never pub
    let mut stream = listener.accept().map_err(error.net)?
    let handled = shortener.server.respond(&mut stream, db)
    core.mem.drop(stream.close())
    match handled {
        Ok(_u) => Ok(())
        Err(error.Error.Alloc) => Err(error.Error.Alloc)
        Err(error.Error.Full) => Err(error.Error.Full)
        Err(error.Error.Corrupt) => Err(error.Error.Corrupt)
        Err(error.Error.Mismatch) => Err(error.Error.Mismatch)
        Err(error.Error.BadRequest) => Ok(())
        Err(error.Error.Closed) => Ok(())
        Err(error.Error.Io) => Ok(())
        Err(error.Error.Net(_code)) => Ok(())
        Err(error.Error.TooLarge) => Ok(())
    }
end shortener.server.serve_one
