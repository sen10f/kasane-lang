# Kasane 開発用の環境変数のテンプレート。
# 使い方: このファイルを .env に写して値を埋める (cp .env.example .env)。
# .env は .gitignore 済みでコミットされない。scripts/setup.sh が読み込む。
# クラウドの開発環境では、.env を使わず、環境設定の「環境変数 / シークレット」に同じ名前で登録する。

# --- LLM ベンチ (bench/run_bench.py --provider nim) ---
# ホスト版 NVIDIA NIM の API キー (nvapi- で始まる)。値は絶対にコミット・共有しない。
NVIDIA_API_KEY=
# モデルは --provider nim の既定 (nvidia/nemotron-3.5-lightning-30b-a3b)。変えるときは --model で渡す。

# --- ksn のビルドキャッシュ (任意) ---
# 既定は ~/.ksn/cache、上限は 2GiB (仕様 6 章)。
# KSN_CACHE_DIR=
# KSN_CACHE_MAX=2147483648

# --- 型検査 (任意。移行期間だけの逃げ道) ---
# 既定は fail-closed (型が決まらなければ E2044)。0 で旧来の「黙る」動作に戻す。1 リリースだけ残る。
# KSN_STRICT_TYPES=1

# --- 検査器の選択 (任意。移行期間だけ) ---
# 既定は s4 (TAST 上の規則 + 残す旧パス)。old / new / shadow は 1 リリースだけ残る (ロールバック用)。
# KSN_CHECKER=s4

# --- 手元の開発機だけ ---
# 不安定な CPU コアを避けてフル検証を回す (scripts/setup.sh --test が taskset で除外する)。
# 2026-11 時点の開発機 (i9-13900KF) では CPU 10 と 11。クラウドでは空のままにする。
# KSN_AVOID_CPUS=10,11
